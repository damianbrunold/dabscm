(define (inline->text x) (cond ((string? x) x) ((eq? (car x) 'link) (string-append (inlines->text (cadr x)) " <" (caddr x) ">")) ((eq? (car x) 'break) "\n") ((eq? (car x) 'code) (cadr x)) (else (inlines->text (cdr x)))))

(define (block->text b) (case (car b) ((heading) (let ((t (inlines->text (cddr b)))) (string-append t "\n" (make-string (string-length t) (if (= (cadr b) 1) #\= #\-))))) ((paragraph) (inlines->text (cdr b))) ((bullet-list) (string-join (map (lambda (it) (string-append "* " (item->text it))) (cdr b)) "\n")) ((ordered-list) (string-join (map (lambda (it n) (string-append (number->string n) ". " (item->text it))) (cddr b) (iota (length (cddr b)) (cadr b))) "\n")) ((code-block) (string-join (map (lambda (l) (string-append "    " l)) (string-tokenize (caddr b) (char-set-complement (char-set #\newline)))) "\n")) (else "")))
(define (item->text it) (inlines->text (filter (lambda (x) (or (string? x) (memq (car x) '(strong emph code link break)))) (cdr it))))
(define (markdown->text md) (string-join (map block->text (parse-markdown md)) "\n\n"))

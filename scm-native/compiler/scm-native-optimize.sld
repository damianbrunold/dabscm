(define-library (scm native optimize)
  (export optimize
          open-coded-arity
          known-global-lambda)
  (import (scheme base)
          (scheme cxr)
          (srfi 1)
          (srfi 69)
          (scm native ast)
          (scm native expand))
  (begin
    ;; Simple whole-program rewrites before ANF (Phase 2; the real optimizer
    ;; is Phase 3):
    ;;   * a global defined exactly once, to a primitive, and never assigned
    ;;     (such as car in (scheme base)) is replaced by the primitive
    ;;   * calls of primitives with the right arity become open-coded prim
    ;;     nodes; arithmetic with more arguments is folded

    (define open-coded
      '((car . 1) (cdr . 1) (cons . 2) (set-car! . 2) (set-cdr! . 2)
        (pair? . 1) (null? . 1) (not . 1) (eq? . 2) (eqv? . 2)
        (+ . 2) (- . 2) (* . 2) (< . 2) (> . 2) (<= . 2) (>= . 2) (= . 2)
        (zero? . 1) (vector-ref . 2) (vector-set! . 3) (vector-length . 1)
        (char->integer . 1)))

    (define (open-coded-arity op)
      (let ((p (assq op open-coded)))
        (and p (cdr p))))

    ;; modules: list of (name . body); the aliases are found over all of them
    (define (optimize modules)
      (let* ((all `(seq ,@(map cdr modules)))
             (aliases (primitive-aliases all)))
        (set! known-lambdas (global-lambdas all))
        (let* ((rewritten (map (lambda (m) (cons (car m) (rewrite (cdr m) aliases))) modules))
               (records (record-procedures `(seq ,@(map cdr rewritten)))))
          (map (lambda (m) (cons (car m) (simplify (inline (specialize-records (cdr m) records) 0))))
               rewritten))))

    ;; --- records --------------------------------------------------------------
    ;; define-record-type expands to (in (scheme base)'s terms)
    ;;   (define T (make-record-type 'name '(tag ...)))
    ;;   (define make (record-constructor T '(tag ...)))
    ;;   (define pred (record-predicate T))
    ;;   (define get (record-accessor T 'tag))  (define set (record-modifier T 'tag))
    ;; With these globals defined once and never assigned, calls of the
    ;; procedures become open-coded record operations.

    (define (scheme-base-global? g name)
      (and (equal? (glob-lib g) '(scheme base)) (eq? (glob-sym g) name)))

    ;; glob -> (kind T . data): (accessor T index tag) (modifier T index tag)
    ;; (predicate T) (constructor T size index ...)
    (define (record-procedures ast)
      (let ((defs (make-hash-table eq?)))
        (define (single g)
          (let ((rhss (hash-table-ref/default defs g '())))
            (and (= (length rhss) 1) (not (glob-assigned? g)) (car rhss))))
        (define (call-of? e name)
          (and (eq? (node-kind e) 'call) (eq? (node-kind (cadr e)) 'gref)
               (scheme-base-global? (cadr (cadr e)) name)))
        ;; record types: glob -> field tags
        (define (type-tags e)
          (and (eq? (node-kind e) 'gref)
               (let ((rhs (single (cadr e))))
                 (and rhs (call-of? rhs 'make-record-type) (= (length (cddr rhs)) 2)
                      (eq? (node-kind (cadddr rhs)) 'const) (list? (cadr (cadddr rhs)))
                      (cadr (cadddr rhs))))))
        (define (index tags tag)
          (let loop ((ts tags) (i 1))
            (cond ((null? ts) #f) ((eq? (car ts) tag) i) (else (loop (cdr ts) (+ i 1))))))
        (let walk ((e ast))
          (case (node-kind e)
            ((gdef)
             (hash-table-set! defs (cadr e) (cons (caddr e) (hash-table-ref/default defs (cadr e) '())))
             (walk (caddr e)))
            ((const lref gref primref) #t)
            ((lset gset) (walk (caddr e)))
            ((lambda) (walk (lam-body (cadr e))))
            ((if seq call) (for-each walk (cdr e)))
            ((prim) (for-each walk (cddr e)))
            ((let letrec) (for-each (lambda (b) (walk (cadr b))) (cadr e)) (walk (caddr e)))
            (else #t)))
        (let ((result (make-hash-table eq?)))
          (hash-table-walk
           defs
           (lambda (g rhss)
             (let ((rhs (single g)))
               (when (and rhs (eq? (node-kind rhs) 'call) (pair? (cddr rhs)))
                 (let* ((type-ref (caddr rhs))
                        (tags (type-tags type-ref))
                        (type (and tags (cadr type-ref)))
                        (arg2 (and (pair? (cdddr rhs)) (cadddr rhs)))
                        (const2 (and arg2 (eq? (node-kind arg2) 'const) (cadr arg2))))
                   (when tags
                     (cond ((and (call-of? rhs 'record-accessor) (symbol? const2) (index tags const2))
                            (hash-table-set! result g (list 'accessor type (index tags const2) const2)))
                           ((and (call-of? rhs 'record-modifier) (symbol? const2) (index tags const2))
                            (hash-table-set! result g (list 'modifier type (index tags const2) const2)))
                           ((and (call-of? rhs 'record-predicate) (null? (cdddr rhs)))
                            (hash-table-set! result g (list 'predicate type)))
                           ((and (call-of? rhs 'record-constructor) (list? const2)
                                 (every (lambda (tag) (index tags tag)) const2))
                            (hash-table-set! result g
                                             (cons* 'constructor type (+ 1 (length tags))
                                                    (map (lambda (tag) (index tags tag)) const2)))))))))))
          result)))

    (define (specialize-records e records)
      (define (r x) (specialize-records x records))
      (case (node-kind e)
        ((const lref gref primref) e)
        ((lset gset gdef) (list (car e) (cadr e) (r (caddr e))))
        ((lambda) (lam-body-set! (cadr e) (r (lam-body (cadr e)))) e)
        ((if seq) (cons (car e) (map r (cdr e))))
        ((prim) `(prim ,(cadr e) ,@(map r (cddr e))))
        ((let letrec) `(,(car e) ,(map (lambda (b) (list (car b) (r (cadr b)))) (cadr e)) ,(r (caddr e))))
        ((call)
         (let* ((f (cadr e))
                (args (map r (cddr e)))
                (info (and (eq? (node-kind f) 'gref) (hash-table-ref/default records (cadr f) #f)))
                (n (length args)))
           (cond ((not info) `(call ,(r f) ,@args))
                 ((and (eq? (car info) 'accessor) (= n 1))
                  `(prim %record-get ,(car args) (gref ,(cadr info)) (const ,(caddr info)) (const ,(cadddr info))))
                 ((and (eq? (car info) 'modifier) (= n 2))
                  `(prim %record-set ,(car args) ,(cadr args) (gref ,(cadr info)) (const ,(caddr info)) (const ,(cadddr info))))
                 ((and (eq? (car info) 'predicate) (= n 1))
                  `(prim %record-is ,(car args) (gref ,(cadr info))))
                 ((and (eq? (car info) 'constructor) (= n (length (cdddr info))))
                  `(prim %record-make (gref ,(cadr info)) (const ,(caddr info))
                         (const ,(cdddr info)) ,@args))
                 (else `(call ,f ,@args)))))
        (else (error "specialize-records: unknown node" e))))

    ;; --- inlining ------------------------------------------------------------
    ;; Calls of small known global procedures (no rest parameter, no nested
    ;; lambda, not recursive) become a let of the arguments over a copy of
    ;; the body. Inlined bodies are inlined into in turn, up to a depth.

    (define inline-size 12)
    (define inline-depth 3)

    (define (node-size e)
      (case (node-kind e)
        ((const lref gref primref) 1)
        ((lambda) 1000)
        ((lset gset gdef) (+ 1 (node-size (caddr e))))
        ((if seq call) (fold (lambda (x acc) (+ acc (node-size x))) 1 (cdr e)))
        ((prim) (fold (lambda (x acc) (+ acc (node-size x))) 1 (cddr e)))
        ((let letrec) (fold (lambda (b acc) (+ acc (node-size (cadr b)))) (+ 1 (node-size (caddr e))) (cadr e)))
        (else 1000)))

    (define (mentions-glob? e g)
      (case (node-kind e)
        ((gref) (eq? (cadr e) g))
        ((gset gdef) (or (eq? (cadr e) g) (mentions-glob? (caddr e) g)))
        ((const lref primref) #f)
        ((lset) (mentions-glob? (caddr e) g))
        ((lambda) (mentions-glob? (lam-body (cadr e)) g))
        ((if seq call) (any (lambda (x) (mentions-glob? x g)) (cdr e)))
        ((prim) (any (lambda (x) (mentions-glob? x g)) (cddr e)))
        ((let letrec) (or (any (lambda (b) (mentions-glob? (cadr b) g)) (cadr e)) (mentions-glob? (caddr e) g)))
        (else #t)))

    ;; Does e refer only to variables bound in it or listed in vars?
    (define (closed? e vars)
      (case (node-kind e)
        ((lref) (and (memq (cadr e) vars) #t))
        ((lset) (and (memq (cadr e) vars) (closed? (caddr e) vars)))
        ((const gref primref) #t)
        ((gset gdef) (closed? (caddr e) vars))
        ((if seq call) (every (lambda (x) (closed? x vars)) (cdr e)))
        ((prim) (every (lambda (x) (closed? x vars)) (cddr e)))
        ((let) (and (every (lambda (b) (closed? (cadr b) vars)) (cadr e))
                    (closed? (caddr e) (append (map car (cadr e)) vars))))
        (else #f)))

    (define inlinable (make-hash-table eq?)) ; glob -> lam or 'no

    (define (inlinable-lambda g)
      (let ((cached (hash-table-ref/default inlinable g #f)))
        (cond ((eq? cached 'no) #f)
              (cached cached)
              (else
               (let* ((l (known-global-lambda g))
                      (ok (and l
                               (not (lam-rest l))
                               (<= (node-size (lam-body l)) inline-size)
                               (not (mentions-glob? (lam-body l) g))
                               (closed? (lam-body l) (lam-params l)))))
                 (hash-table-set! inlinable g (if ok l 'no))
                 (and ok l))))))

    ;; A copy of e with fresh variables for those in renames (alist old -> new)
    ;; and for every variable e binds
    (define (copy e renames)
      (define (v x) (cond ((assq x renames) => cdr) (else x)))
      (case (node-kind e)
        ((const gref primref) e)
        ((lref) `(lref ,(v (cadr e))))
        ((lset) `(lset ,(v (cadr e)) ,(copy (caddr e) renames)))
        ((gset gdef) (list (car e) (cadr e) (copy (caddr e) renames)))
        ((if seq call) (cons (car e) (map (lambda (x) (copy x renames)) (cdr e))))
        ((prim) `(prim ,(cadr e) ,@(map (lambda (x) (copy x renames)) (cddr e))))
        ((let)
         (let* ((fresh (map (lambda (b) (cons (car b) (fresh-var (car b)))) (cadr e)))
                (renames2 (append fresh renames)))
           `(let ,(map (lambda (b f) (list (cdr f) (copy (cadr b) renames))) (cadr e) fresh)
              ,(copy (caddr e) renames2))))
        (else (error "copy: unexpected node" e))))

    (define (fresh-var old)
      (let ((v (make-var (var-name old))))
        (when (var-assigned? old) (var-assigned! v))
        v))

    (define (inline e depth)
      (define (r x) (inline x depth))
      (case (node-kind e)
        ((const lref gref primref) e)
        ((lset gset gdef) (list (car e) (cadr e) (r (caddr e))))
        ((lambda) (lam-body-set! (cadr e) (r (lam-body (cadr e)))) e)
        ((if seq) (cons (car e) (map r (cdr e))))
        ((prim) `(prim ,(cadr e) ,@(map r (cddr e))))
        ((let letrec) `(,(car e) ,(map (lambda (b) (list (car b) (r (cadr b)))) (cadr e)) ,(r (caddr e))))
        ((call)
         (let* ((f (cadr e))
                (args (map r (cddr e)))
                (l (and (< depth inline-depth) (eq? (node-kind f) 'gref) (inlinable-lambda (cadr f)))))
           (if (and l (= (length args) (length (lam-params l))))
               (let* ((fresh (map (lambda (p) (cons p (fresh-var p))) (lam-params l)))
                      (body (copy (lam-body l) fresh)))
                 (inline (if (null? fresh)
                             body
                             `(let ,(map (lambda (f a) (list (cdr f) a)) fresh args) ,body))
                         (+ depth 1)))
               `(call ,(r f) ,@args))))
        (else (error "inline: unknown node" e))))

    ;; --- simplification -----------------------------------------------------
    ;; (if <constant> a b), (if (not e) a b)
    (define (simplify e)
      (define s simplify)
      (case (node-kind e)
        ((const lref gref primref) e)
        ((lset gset gdef) (list (car e) (cadr e) (s (caddr e))))
        ((lambda) (lam-body-set! (cadr e) (s (lam-body (cadr e)))) e)
        ((seq call) (cons (car e) (map s (cdr e))))
        ((prim) `(prim ,(cadr e) ,@(map s (cddr e))))
        ((let letrec) `(,(car e) ,(map (lambda (b) (list (car b) (s (cadr b)))) (cadr e)) ,(s (caddr e))))
        ((if)
         (let ((test (s (cadr e)))
               (then (s (caddr e)))
               (else (s (cadddr e))))
           (cond ((eq? (node-kind test) 'const) (if (cadr test) then else))
                 ((and (eq? (node-kind test) 'prim) (eq? (cadr test) 'not))
                  `(if ,(caddr test) ,else ,then))
                 (else `(if ,test ,then ,else)))))
        (else (error "simplify: unknown node" e))))

    ;; glob -> lam, for globals defined once, to a lambda, and never assigned:
    ;; calls of them can jump to the lambda's code directly
    (define known-lambdas (make-hash-table eq?))
    (define (known-global-lambda g) (hash-table-ref/default known-lambdas g #f))

    (define (global-lambdas ast)
      (let ((defs (make-hash-table eq?)))
        (let walk ((e ast))
          (case (node-kind e)
            ((gdef)
             (hash-table-set! defs (cadr e) (cons (caddr e) (hash-table-ref/default defs (cadr e) '())))
             (walk (caddr e)))
            ((const lref gref primref) #t)
            ((lset gset) (walk (caddr e)))
            ((lambda) (walk (lam-body (cadr e))))
            ((if seq call) (for-each walk (cdr e)))
            ((prim) (for-each walk (cddr e)))
            ((let letrec) (for-each (lambda (b) (walk (cadr b))) (cadr e)) (walk (caddr e)))
            (else (error "global-lambdas: unknown node" e))))
        (let ((known (make-hash-table eq?)))
          (hash-table-walk defs
                           (lambda (g rhss)
                             (when (and (= (length rhss) 1)
                                        (eq? (node-kind (car rhss)) 'lambda)
                                        (not (glob-assigned? g)))
                               (hash-table-set! known g (cadr (car rhss))))))
          known)))

    ;; glob -> primitive name, for globals that are constant primitives
    (define (primitive-aliases ast)
      (let ((defs (make-hash-table eq?)))
        (let walk ((e ast))
          (case (node-kind e)
            ((gdef)
             (hash-table-set! defs (cadr e)
                              (cons (caddr e) (hash-table-ref/default defs (cadr e) '())))
             (walk (caddr e)))
            ((const lref gref primref) #t)
            ((lset gset) (walk (caddr e)))
            ((lambda) (walk (lam-body (cadr e))))
            ((if seq call) (for-each walk (cdr e)))
            ((prim) (for-each walk (cddr e)))
            ((let letrec) (for-each (lambda (b) (walk (cadr b))) (cadr e)) (walk (caddr e)))
            (else (error "primitive-aliases: unknown node" e))))
        (let ((aliases (make-hash-table eq?)))
          (hash-table-walk defs
                           (lambda (g rhss)
                             (when (and (= (length rhss) 1)
                                        (eq? (node-kind (car rhss)) 'primref)
                                        (not (glob-assigned? g)))
                               (hash-table-set! aliases g (cadr (car rhss))))))
          aliases)))

    (define (rewrite e aliases)
      (define (r e) (rewrite e aliases))
      (case (node-kind e)
        ((const lref primref) e)
        ((gref)
         (let ((p (hash-table-ref/default aliases (cadr e) #f)))
           (if p `(primref ,p) e)))
        ((gdef gset lset) (list (car e) (cadr e) (r (caddr e))))
        ((lambda)
         (lam-body-set! (cadr e) (r (lam-body (cadr e))))
         e)
        ((if seq) (cons (car e) (map r (cdr e))))
        ((prim) `(prim ,(cadr e) ,@(map r (cddr e))))
        ((call)
         (let ((f (r (cadr e)))
               (args (map r (cddr e))))
           (or (and (eq? (node-kind f) 'primref) (open-code (cadr f) args))
               `(call ,f ,@args))))
        ((let letrec)
         `(,(car e) ,(map (lambda (b) (list (car b) (r (cadr b)))) (cadr e)) ,(r (caddr e))))
        (else (error "rewrite: unknown node" e))))

    (define (open-code op args)
      (let ((arity (open-coded-arity op))
            (n (length args)))
        (cond ((not arity) #f)
              ((= n arity) `(prim ,op ,@args))
              ((and (memq op '(+ * -)) (> n 2))
               (fold (lambda (a acc) `(prim ,op ,acc ,a)) `(prim ,op ,(car args) ,(cadr args)) (cddr args)))
              ((and (eq? op '-) (= n 1)) `(prim - (const 0) ,(car args)))
              ((and (eq? op '+) (= n 0)) '(const 0))
              ((and (eq? op '*) (= n 0)) '(const 1))
              ((and (memq op '(+ *)) (= n 1) ) #f)
              (else #f))))))

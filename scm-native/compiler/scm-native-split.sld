(define-library (scm native split)
  (export split-module)
  (import (scheme base)
          (scheme char)
          (srfi 69)
          (srfi 132))
  (begin
    ;; A large generated module (a test program such as chibi's r7rs tests:
    ;; 15 MB of Zig) as several Zig files that are compiled in parallel. LLVM
    ;; takes more than linear time in the size of a module (8.7 s per MB at 3
    ;; MB, 24 s per MB at 15 MB), so parts also take less time in total.
    ;;
    ;; The emitter's module-level names are the functions Ln (lambdas) and Kn
    ;; (continuations), the return descriptions kn (of Kn) and the variables
    ;; cn (constants), sn (symbols) and pn. Part 0 has everything but the
    ;; functions (and their kn): the variables, the exported functions
    ;; (init, entry, the program's tables), and the extern declarations,
    ;; which every part gets. The functions go into parts 1, 2, ... in their
    ;; order, about target characters each. A name that another part uses
    ;; is exported under scmx_<module>_<name> there (@export), declared
    ;; extern in the user, and renamed in its text. Only those names lose
    ;; their internal linkage (inlining across parts).
    ;;
    ;; (split-module sym text target): the list of the parts' texts, (text)
    ;; when text is at most target characters or has no functions to move.

    (define (split-module sym text target)
      (if (<= (string-length text) target)
          (list text)
          (let* ((lines (split-lines text))
                 (items (parse-items lines)))
            (assign-and-emit sym lines items target text))))

    (define (split-lines text)
      (let ((n (string-length text)))
        (let loop ((i 0) (start 0) (acc '()))
          (cond ((= i n)
                 (list->vector (reverse (if (< start n) (cons (substring text start n) acc) acc))))
                ((char=? (string-ref text i) #\newline)
                 (loop (+ i 1) (+ i 1) (cons (substring text start i) acc)))
                (else (loop (+ i 1) start acc))))))

    (define (prefix? p s)
      (and (>= (string-length s) (string-length p))
           (string=? p (substring s 0 (string-length p)))))

    ;; c followed by one or more digits, up to end (exclusive) of s from i
    (define (numbered? s i end letters)
      (and (> (- end i) 1)
           (memv (string-ref s i) letters)
           (let loop ((j (+ i 1)))
             (or (= j end)
                 (and (char-numeric? (string-ref s j)) (loop (+ j 1)))))))

    (define (index-of s ch from)
      (let loop ((i from))
        (cond ((>= i (string-length s)) #f)
              ((char=? (string-ref s i) ch) i)
              (else (loop (+ i 1))))))

    ;; Items: #(kind name start end size), kind header, extern, fn, ret
    ;; (name: its continuation's) or main; an item is a line at column 0
    ;; and the indented, empty and closing lines after it.
    (define (parse-items lines)
      (let ((n (vector-length lines)))
        (define (continuation? l)
          (or (= (string-length l) 0)
              (char=? (string-ref l 0) #\space)
              (char=? (string-ref l 0) #\})))
        (let loop ((i 0) (acc '()))
          (if (>= i n)
              (reverse acc)
              (let* ((l (vector-ref lines i))
                     (end (let skip ((j (+ i 1)))
                            (if (and (< j n) (continuation? (vector-ref lines j))) (skip (+ j 1)) j)))
                     (size (let sum ((j i) (s 0))
                             (if (= j end) s (sum (+ j 1) (+ s 1 (string-length (vector-ref lines j))))))))
                (if (continuation? l)
                    ;; text before the first item: with the header
                    (loop end (cons (vector 'header #f i end size) acc))
                    (loop end (cons (classify l i end size) acc))))))))

    (define (classify l start end size)
      (cond ((or (prefix? "//" l) (prefix? "const std " l) (prefix? "const rt " l)
                 (prefix? "const Thread " l) (prefix? "const Word " l))
             (vector 'header #f start end size))
            ((prefix? "extern " l) (vector 'extern #f start end size))
            ((and (prefix? "fn " l)
                  (let ((p (index-of l #\( 3)))
                    (and p (numbered? l 3 p '(#\K #\L)) p)))
             => (lambda (p) (vector 'fn (substring l 3 p) start end size)))
            ((and (prefix? "const k" l)
                  (let ((c (index-of l #\: 6)))
                    (and c (numbered? l 6 c '(#\k))
                         (prefix? ": rt.RetInfo" (substring l c (string-length l)))
                         c)))
             => (lambda (c) (vector 'ret (string-append "K" (substring l 7 c)) start end size)))
            (else (vector 'main #f start end size))))

    (define (item-kind it) (vector-ref it 0))
    (define (item-name it) (vector-ref it 1))
    (define (item-start it) (vector-ref it 2))
    (define (item-end it) (vector-ref it 3))
    (define (item-size it) (vector-ref it 4))

    ;; the extern declaration of part 0's export fn or export var line, or #f
    (define (export->extern l)
      (cond ((and (prefix? "export fn " l) (index-of l #\{ 0))
             => (lambda (b)
                  (let loop ((e b))
                    (if (and (> e 0) (char=? (string-ref l (- e 1)) #\space))
                        (loop (- e 1))
                        (string-append "extern" (substring l 6 e) ";")))))
            ((and (prefix? "export var " l) (index-of l #\= 0))
             => (lambda (q)
                  (string-append "extern" (substring l 6 (- q 1)) ";")))
            (else #f)))

    (define (assign-and-emit sym lines items target text)
      (let ((owner (make-hash-table string=?)) ; name -> part
            (part-of-fn (make-hash-table string=?)))
        ;; the functions into parts 1, 2, ...
        (let loop ((its items) (part 1) (size 0))
          (when (pair? its)
            (let ((it (car its)))
              (if (eq? (item-kind it) 'fn)
                  (let* ((new? (and (> size 0) (> (+ size (item-size it)) target)))
                         (p (if new? (+ part 1) part)))
                    (hash-table-set! part-of-fn (item-name it) p)
                    (hash-table-set! owner (item-name it) p)
                    (loop (cdr its) p (+ (if new? 0 size) (item-size it))))
                  (loop (cdr its) part size)))))
        (let ((nparts (+ 1 (hash-table-fold part-of-fn (lambda (k p m) (max p m)) 0))))
          (if (< nparts 2)
              (list text)
              (emit-parts sym lines items owner part-of-fn nparts)))))

    (define (emit-parts sym lines items owner part-of-fn nparts)
      (define (part-of it)
        (case (item-kind it)
          ((fn) (hash-table-ref owner (item-name it)))
          ((ret) (hash-table-ref/default part-of-fn (item-name it) 0))
          (else 0)))
      ;; the module-level names and their parts: kn with its Kn; the
      ;; variables of part 0
      (for-each (lambda (it)
                  (case (item-kind it)
                    ((ret)
                     (hash-table-set! owner (string-append "k" (substring (item-name it) 1
                                                                          (string-length (item-name it))))
                                      (part-of it)))
                    ((main)
                     (let ((l (vector-ref lines (item-start it))))
                       (when (prefix? "var " l)
                         (let ((c (index-of l #\: 4)))
                           (when (and c (numbered? l 4 c '(#\c #\s #\p)))
                             (hash-table-set! owner (substring l 4 c) 0))))))))
                items)
      (let ((ports (make-vector nparts #f))
            (needed (make-vector nparts #f))   ; part -> names it uses from others
            (exported (make-vector nparts #f)) ; part -> names others use
            (moved (make-vector nparts '()))   ; part -> @export lines of the module's
                                               ; comptime blocks, with their function
            (shared '())                       ; header and extern lines
            (part0-externs '()))
        (define (mangled name) (string-append "scmx_" sym "_" name))
        (define (rewrite-line l part out)
          (let ((n (string-length l)))
            (let loop ((i 0) (seg 0))
              (define (flush-to j) (write-string l out seg j))
              (if (>= i n)
                  (flush-to n)
                  (let ((c (string-ref l i)))
                    (cond ((or (char=? c #\") (char=? c #\'))
                           ;; a string or character literal
                           (let skip ((j (+ i 1)))
                             (cond ((>= j n) (loop n seg))
                                   ((char=? (string-ref l j) #\\) (skip (+ j 2)))
                                   ((char=? (string-ref l j) c) (loop (+ j 1) seg))
                                   (else (skip (+ j 1))))))
                          ((and (char=? c #\/) (< (+ i 1) n) (char=? (string-ref l (+ i 1)) #\/))
                           (flush-to n))
                          ((or (char-alphabetic? c) (char=? c #\_) (char=? c #\@))
                           (let* ((j (let id ((j (+ i 1)))
                                       (if (and (< j n)
                                                (let ((d (string-ref l j)))
                                                  (or (char-alphabetic? d) (char-numeric? d)
                                                      (char=? d #\_))))
                                           (id (+ j 1))
                                           j)))
                                  (field? (and (> i 0) (char=? (string-ref l (- i 1)) #\.)))
                                  (p (and (not field?)
                                          (numbered? l i j '(#\K #\L #\k #\c #\s #\p))
                                          (hash-table-ref/default owner (substring l i j) #f))))
                             (if (and p (not (= p part)))
                                 (let ((name (substring l i j)))
                                   (flush-to i)
                                   (write-string (mangled name) out)
                                   (hash-table-set! (vector-ref needed part) name #t)
                                   (hash-table-set! (vector-ref exported p) name #t)
                                   (loop j j))
                                 (loop j seg))))
                          (else (loop (+ i 1) seg))))))))
        (define (emit-item it)
          (let* ((part (part-of it))
                 (out (vector-ref ports part)))
            (when (and (= part 0) (eq? (item-kind it) 'main))
              (let ((e (export->extern (vector-ref lines (item-start it)))))
                (when e (set! part0-externs (cons e part0-externs)))))
            (do ((i (item-start it) (+ i 1))) ((= i (item-end it)))
              (rewrite-line (vector-ref lines i) part out)
              (newline out))))
        (do ((i 0 (+ i 1))) ((= i nparts))
          (vector-set! ports i (open-output-string))
          (vector-set! needed i (make-hash-table string=?))
          (vector-set! exported i (make-hash-table string=?)))
        (for-each
         (lambda (it)
           (case (item-kind it)
             ((header extern)
              (do ((i (item-start it) (+ i 1))) ((= i (item-end it)))
                (set! shared (cons (vector-ref lines i) shared))))
             ((main)
              (if (and (string=? (vector-ref lines (item-start it)) "comptime {")
                       (let only-exports? ((i (+ (item-start it) 1)))
                         (or (= i (item-end it))
                             (let ((l (vector-ref lines i)))
                               (and (or (prefix? "    @export(&" l) (prefix? "}" l)
                                        (string=? l ""))
                                    (only-exports? (+ i 1)))))))
                  ;; the module's exports (scml_<module>_entry): each into the
                  ;; part of what it exports
                  (do ((i (+ (item-start it) 1) (+ i 1))) ((= i (item-end it)))
                    (let* ((l (vector-ref lines i))
                           (a (index-of l #\& 0))
                           (c (and a (index-of l #\, a)))
                           (p (if c (hash-table-ref/default owner (substring l (+ a 1) c) 0) 0)))
                      (when (prefix? "    @export(" l)
                        (vector-set! moved p (cons l (vector-ref moved p))))))
                  (emit-item it)))
             (else (emit-item it))))
         items)
        (let ((shared-text (apply string-append
                                  (map (lambda (l) (string-append l "\n")) (reverse shared))))
              (part0-extern-text (apply string-append
                                        (map (lambda (l) (string-append l "\n")) (reverse part0-externs)))))
          (define (sorted-names table)
            (list-sort string<? (hash-table-keys table)))
          (define (extern-decl name)
            (let ((m (mangled name)))
              (case (string-ref name 0)
                ((#\K #\L) (string-append "extern fn " m "(t: *Thread) callconv(.c) void;\n"))
                ((#\k) (string-append "extern const " m ": rt.RetInfo;\n"))
                (else (string-append "extern var " m ": Word;\n")))))
          (let loop ((i 0) (acc '()))
            (if (= i nparts)
                (reverse acc)
                (let ((out (open-output-string)))
                  (write-string shared-text out)
                  (unless (= i 0) (write-string part0-extern-text out))
                  (for-each (lambda (name) (write-string (extern-decl name) out))
                            (sorted-names (vector-ref needed i)))
                  (let ((ex (sorted-names (vector-ref exported i)))
                        (mv (reverse (vector-ref moved i))))
                    (when (or (pair? ex) (pair? mv))
                      (write-string "comptime {\n" out)
                      (for-each (lambda (l) (write-string l out) (newline out)) mv)
                      (for-each (lambda (name)
                                  (write-string (string-append "    @export(&" name ", .{ .name = \""
                                                               (mangled name) "\" });\n")
                                                out))
                                ex)
                      (write-string "}\n" out)))
                  (write-string (get-output-string (vector-ref ports i)) out)
                  (loop (+ i 1) (cons (get-output-string out) acc))))))))))

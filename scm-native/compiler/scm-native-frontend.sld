(define-library (scm native frontend)
  (export frontend
          open-coded-arity)
  (import (scheme base)
          (scheme cxr)
          (srfi 1)
          (scm native ast))
  (begin
    ;; Phase 1 stand-in for the expander: turns a program in plain Scheme
    ;; (no macros) into Core IR, desugaring the usual derived forms. Phase 2
    ;; replaces it with the real expander, which produces the same Core IR.
    ;;
    ;; (frontend forms primitive-names) => (values ast global-names)

    ;; Primitives the emitter open-codes, with their arity
    (define open-coded
      '((car . 1) (cdr . 1) (cons . 2) (set-car! . 2) (set-cdr! . 2)
        (pair? . 1) (null? . 1) (not . 1) (eq? . 2) (eqv? . 2)
        (+ . 2) (- . 2) (* . 2) (< . 2) (> . 2) (<= . 2) (>= . 2) (= . 2)
        (zero? . 1) (vector-ref . 2) (vector-set! . 3) (vector-length . 1)
        (char->integer . 1)))

    (define (open-coded-arity op)
      (let ((p (assq op open-coded)))
        (and p (cdr p))))

    (define special-forms
      '(define lambda let let* letrec letrec* begin if set! quote quasiquote
        cond case and or when unless do))

    (define (frontend forms primitive-names)
      (define globals (collect-defines forms))
      (define (global? s) (memq s globals))
      (define (primitive? s) (memq s primitive-names))

      (define (lookup s env)
        (cond ((assq s env) => (lambda (p) `(lref ,(cdr p))))
              ((or (global? s) (primitive? s)) `(gref ,s))
              (else (error "unbound variable" s))))

      ;; A head symbol names a special form unless it is bound locally or
      ;; defined by the program.
      (define (special? s env)
        (and (symbol? s) (memq s special-forms) (not (assq s env)) (not (global? s))))

      (define (builtin? s env)
        (and (symbol? s) (not (assq s env)) (not (global? s)) (primitive? s)))

      (define (x e env)
        (cond ((symbol? e) (lookup e env))
              ((pair? e)
               (let ((head (car e)))
                 (if (special? head env)
                     (x-special head e env)
                     (x-application e env))))
              ((null? e) (error "empty application" e))
              (else `(const ,e))))

      (define (x-body forms env name)
        ;; leading internal defines become letrec*
        (let loop ((forms (flatten-begins forms)) (defs '()))
          (if (and (pair? forms) (pair? (car forms)) (special? 'define env)
                   (eq? (caar forms) 'define))
              (loop (cdr forms) (cons (normalize-define (car forms)) defs))
              (if (null? defs)
                  (x-seq forms env)
                  (x-letrec* (reverse defs) forms env)))))

      (define (x-seq forms env)
        (cond ((null? forms) `(const ,the-unspecified))
              ((null? (cdr forms)) (x (car forms) env))
              (else `(seq ,@(map (lambda (f) (x f env)) forms)))))

      (define (x-lambda formals body env name)
        (let loop ((f formals) (params '()))
          (cond ((pair? f) (loop (cdr f) (cons (make-var (car f)) params)))
                (else
                 (let* ((params (reverse params))
                        (rest (and (symbol? f) (make-var f)))
                        (env2 (append (map (lambda (v) (cons (var-name v) v))
                                           (if rest (append params (list rest)) params))
                                      env)))
                   `(lambda ,(make-lam params rest (x-body body env2 name) name)))))))

      ;; bindings: list of (name init-form); inits see the new variables
      (define (x-letrec* bindings body env)
        (let* ((vars (map (lambda (b) (make-var (car b))) bindings))
               (env2 (append (map (lambda (v) (cons (var-name v) v)) vars) env))
               (inits (map (lambda (b v) (x-named (cadr b) env2 (var-name v))) bindings vars))
               (body (x-body body env2 #f)))
          (if (every (lambda (i) (eq? (node-kind i) 'lambda)) inits)
              `(letrec ,(map list vars inits) ,body)
              (begin
                (for-each var-assigned! vars)
                `(let ,(map (lambda (v) (list v `(const ,the-unspecified))) vars)
                   (seq ,@(map (lambda (v i) `(lset ,v ,i)) vars inits) ,body))))))

      ;; a lambda gets the name it is bound to, for error messages
      (define (x-named e env name)
        (if (and (pair? e) (eq? (car e) 'lambda) (special? 'lambda env))
            (x-lambda (cadr e) (cddr e) env name)
            (x e env)))

      (define (x-let bindings body env)
        (let* ((vars (map (lambda (b) (make-var (car b))) bindings))
               (inits (map (lambda (b) (x-named (cadr b) env (car b))) bindings))
               (env2 (append (map (lambda (v) (cons (var-name v) v)) vars) env)))
          (if (null? vars)
              (x-body body env #f)
              `(let ,(map list vars inits) ,(x-body body env2 #f)))))

      (define (x-special head e env)
        (case head
          ((quote) `(const ,(cadr e)))
          ((if)
           `(if ,(x (cadr e) env)
                ,(x (caddr e) env)
                ,(if (pair? (cdddr e)) (x (cadddr e) env) `(const ,the-unspecified))))
          ((define)
           (let ((d (normalize-define e)))
             (if (assq (car d) env)
                 (error "define not at the beginning of a body" e)
                 `(gdef ,(car d) ,(x-named (cadr d) env (car d))))))
          ((set!)
           (let ((target (cadr e))
                 (val (x (caddr e) env)))
             (cond ((assq target env)
                    => (lambda (p) (var-assigned! (cdr p)) `(lset ,(cdr p) ,val)))
                   ((global? target) `(gset ,target ,val))
                   (else (error "set! of an undefined variable" target)))))
          ((lambda) (x-lambda (cadr e) (cddr e) env #f))
          ((begin) (x-seq (cdr e) env))
          ((let)
           (if (symbol? (cadr e))
               ;; named let
               (let* ((name (cadr e))
                      (bindings (caddr e))
                      (v (make-var name))
                      (env2 (cons (cons name v) env))
                      (lam (x-lambda (map car bindings) (cdddr e) env2 name)))
                 `(letrec ((,v ,lam))
                    (call (lref ,v) ,@(map (lambda (b) (x (cadr b) env)) bindings))))
               (x-let (cadr e) (cddr e) env)))
          ((let*)
           (if (or (null? (cadr e)) (null? (cdadr e)))
               (x-let (cadr e) (cddr e) env)
               (x-let (list (caadr e)) `((let* ,(cdadr e) ,@(cddr e))) env)))
          ((letrec letrec*) (x-letrec* (cadr e) (cddr e) env))
          ((and)
           (cond ((null? (cdr e)) '(const #t))
                 ((null? (cddr e)) (x (cadr e) env))
                 (else `(if ,(x (cadr e) env) ,(x `(and ,@(cddr e)) env) (const #f)))))
          ((or)
           (cond ((null? (cdr e)) '(const #f))
                 ((null? (cddr e)) (x (cadr e) env))
                 (else
                  (let ((v (new-var)))
                    `(let ((,v ,(x (cadr e) env)))
                       (if (lref ,v) (lref ,v) ,(x `(or ,@(cddr e)) env)))))))
          ((when) `(if ,(x (cadr e) env) ,(x-seq (cddr e) env) ,`(const ,the-unspecified)))
          ((unless) `(if ,(x (cadr e) env) ,`(const ,the-unspecified) ,(x-seq (cddr e) env)))
          ((cond) (x-cond (cdr e) env))
          ((case) (x-case e env))
          ((do) (x-do e env))
          ((quasiquote) (x (qq (cadr e) 1) env))
          (else (error "unknown special form" head))))

      (define (x-cond clauses env)
        (if (null? clauses)
            `(const ,the-unspecified)
            (let ((c (car clauses)))
              (cond ((eq? (car c) 'else) (x-seq (cdr c) env))
                    ((null? (cdr c)) (x `(or ,(car c) (cond ,@(cdr clauses))) env))
                    ((eq? (cadr c) '=>)
                     (let ((v (new-var)))
                       `(let ((,v ,(x (car c) env)))
                          (if (lref ,v)
                              (call ,(x (caddr c) env) (lref ,v))
                              ,(x-cond (cdr clauses) env)))))
                    (else `(if ,(x (car c) env)
                               ,(x-seq (cdr c) env)
                               ,(x-cond (cdr clauses) env)))))))

      (define (x-case e env)
        (let ((k (new-var)))
          `(let ((,k ,(x (cadr e) env)))
             ,(let loop ((clauses (cddr e)))
                (if (null? clauses)
                    `(const ,the-unspecified)
                    (let ((c (car clauses)))
                      (if (eq? (car c) 'else)
                          (x-seq (cdr c) env)
                          `(if ,(fold-right (lambda (d rest)
                                              `(if (prim eqv? (lref ,k) (const ,d)) (const #t) ,rest))
                                            '(const #f)
                                            (car c))
                               ,(x-seq (cdr c) env)
                               ,(loop (cdr clauses))))))))))

      (define (x-do e env)
        (let* ((specs (cadr e))
               (test (caddr e))
               (body (cdddr e))
               (loop-name (string->symbol "%do-loop")))
          (x `(let ,loop-name ,(map (lambda (s) (list (car s) (cadr s))) specs)
                (if ,(car test)
                    (begin (if #f #f) ,@(cdr test))
                    (begin ,@body
                           (,loop-name ,@(map (lambda (s) (if (pair? (cddr s)) (caddr s) (car s)))
                                              specs)))))
             env)))

      (define (x-application e env)
        (let ((head (car e))
              (args (map (lambda (a) (x a env)) (cdr e))))
          (cond ((and (builtin? head env) (open-code head args)) => (lambda (n) n))
                (else `(call ,(x head env) ,@args)))))

      ;; Phase 1: import forms are skipped (all primitives are available)
      (let ((ast (x-seq (remove (lambda (f) (and (pair? f) (eq? (car f) 'import)))
                                (flatten-begins forms))
                        '())))
        (values ast globals)))

    ;; Open-coded primitive node, or #f. Arithmetic with more arguments is
    ;; folded into the two-argument operation.
    (define (open-code op args)
      (let ((arity (open-coded-arity op))
            (n (length args)))
        (cond ((not arity) #f)
              ((= n arity) `(prim ,op ,@args))
              ((and (memq op '(+ *)) (> n 2))
               (fold (lambda (a acc) `(prim ,op ,acc ,a)) `(prim ,op ,(car args) ,(cadr args)) (cddr args)))
              ((and (eq? op '-) (> n 2))
               (fold (lambda (a acc) `(prim - ,acc ,a)) `(prim - ,(car args) ,(cadr args)) (cddr args)))
              ((and (eq? op '-) (= n 1)) `(prim - (const 0) ,(car args)))
              ((and (eq? op '+) (= n 0)) '(const 0))
              ((and (eq? op '*) (= n 0)) '(const 1))
              (else #f))))

    (define (normalize-define e)
      ;; (define (f . args) body ...) => (f (lambda args body ...))
      (let ((target (cadr e)))
        (if (pair? target)
            (if (pair? (car target))
                (normalize-define `(define ,(car target) (lambda ,(cdr target) ,@(cddr e))))
                (list (car target) `(lambda ,(cdr target) ,@(cddr e))))
            (list target (if (pair? (cddr e)) (caddr e) '(if #f #f))))))

    (define (flatten-begins forms)
      (append-map (lambda (f)
                    (if (and (pair? f) (eq? (car f) 'begin))
                        (flatten-begins (cdr f))
                        (list f)))
                  forms))

    (define (collect-defines forms)
      (delete-duplicates
       (filter-map (lambda (f)
                     (and (pair? f) (eq? (car f) 'define)
                          (car (normalize-define f))))
                   (flatten-begins forms))))

    (define (qq t depth)
      (cond ((not (pair? t))
             (if (vector? t)
                 `(list->vector ,(qq (vector->list t) depth))
                 `(quote ,t)))
            ((eq? (car t) 'unquote)
             (if (= depth 1)
                 (cadr t)
                 `(list 'unquote ,(qq (cadr t) (- depth 1)))))
            ((eq? (car t) 'quasiquote)
             `(list 'quasiquote ,(qq (cadr t) (+ depth 1))))
            ((and (pair? (car t)) (eq? (caar t) 'unquote-splicing) (= depth 1))
             `(append ,(cadar t) ,(qq (cdr t) depth)))
            (else `(cons ,(qq (car t) depth) ,(qq (cdr t) depth)))))))

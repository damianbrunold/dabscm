;; Generate runtime/library_exports.zig: the exports of every library in
;; scm-lib/libraries with their kind (syntax, procedure or value), as the
;; JVM implementation reports them through %module-exports and %module-ref.
;;
;; Native programs use the table for %load-module, %module-exports and
;; %module-ref (e.g. (scm source) for scm lint and scm fmt), also for
;; libraries that are not linked into the program.
;;
;; Usage: scm scm-native/tools/gen-library-exports.scm
;; Run it again when the libraries' exports change.

(import (scheme base)
        (scheme file)
        (scheme process-context)
        (scheme read)
        (scheme write)
        (srfi 69)
        (srfi 132)
        (scm fs)
        (scm module))

(define native-dir (directory-name (directory-name (absolute-path (car (command-line))))))
(define libs-dir (join-path (directory-name native-dir) "scm-lib" "libraries"))
(define out-file (join-path native-dir "runtime" "library_exports.zig"))

(define (string-suffix? suffix s)
  (and (>= (string-length s) (string-length suffix))
       (string=? suffix (substring s (- (string-length s) (string-length suffix)) (string-length s)))))

(define (string-prefix? p s)
  (and (<= (string-length p) (string-length s))
       (string=? p (substring s 0 (string-length p)))))

;; the library name of an .sld file, or #f
(define (library-name file)
  (guard (e (#t #f))
    (let ((form (call-with-input-file file read)))
      (and (pair? form) (eq? (car form) 'define-library) (cadr form)))))

;; as (scm source)'s value-kind
(define (value-kind v)
  (let ((s (let ((o (open-output-string))) (write v o) (get-output-string o))))
    (cond ((or (string-prefix? "#<macro" s) (string-prefix? "#<core-form" s)) 'syntax)
          ((procedure? v) 'procedure)
          (else 'value))))

;; the identity of each distinct binding value (eq? across all libraries):
;; a re-export has the same id as its original
(define ids (make-hash-table eq?))
(define next-id 0)
(define (value-id v)
  (or (hash-table-ref/default ids v #f)
      (begin (set! next-id (+ next-id 1))
             (hash-table-set! ids v next-id)
             next-id)))

(define (library-exports name)
  (guard (e (#t (display "  skipped (cannot load): " (current-error-port))
                (write name (current-error-port))
                (newline (current-error-port))
                #f))
    (%load-module name)
    (map (lambda (s)
           (guard (e (#t (list s 'unknown 0)))
             (let ((v (%module-ref name s)))
               (list s (value-kind v) (value-id v)))))
         (%module-exports name))))

(define (name->string name)
  (let ((o (open-output-string)))
    (write name o)
    (get-output-string o)))

(define (zig-string s)
  (let ((o (open-output-string)))
    (write-char #\" o)
    (string-for-each (lambda (c)
                       (cond ((char=? c #\") (write-string "\\\"" o))
                             ((char=? c #\\) (write-string "\\\\" o))
                             (else (write-char c o))))
                     s)
    (write-char #\" o)
    (get-output-string o)))

(define (filter keep? l)
  (cond ((null? l) '())
        ((keep? (car l)) (cons (car l) (filter keep? (cdr l))))
        (else (filter keep? (cdr l)))))

;; libraries built into the JVM implementation, without an .sld file
(define builtin-libraries '((scm core)))

(define libraries
  (let loop ((files (list-sort string<? (filter (lambda (f) (string-suffix? ".sld" f)) (directory-files libs-dir))))
             (acc '()))
    (if (null? files)
        (append (filter (lambda (x) x)
                        (map (lambda (name) (let ((e (library-exports name))) (and e (cons name e))))
                             builtin-libraries))
                (reverse acc))
        (let ((name (library-name (join-path libs-dir (car files)))))
          (if name
              (let ((exports (library-exports name)))
                (loop (cdr files) (if exports (cons (cons name exports) acc) acc)))
              (loop (cdr files) acc))))))

(call-with-output-file out-file
  (lambda (p)
    (write-string "//! Generated by tools/gen-library-exports.scm from the JVM implementation's\n" p)
    (write-string "//! libraries; do not edit. The exports of each library and their kind.\n\n" p)
    (write-string "pub const Kind = enum(u8) { syntax, procedure, value, unknown };\n" p)
    (write-string "/// id: the binding's identity (the same for a re-export), 0 if unknown\n" p)
    (write-string "pub const Export = struct { name: []const u8, kind: Kind, id: u32 };\n" p)
    (write-string "pub const Library = struct { name: []const u8, exports: []const Export };\n\n" p)
    (write-string "/// library names as written, e.g. \"(scheme base)\"\n" p)
    (write-string "pub const libraries = [_]Library{\n" p)
    (for-each
     (lambda (lib)
       (write-string (string-append "    .{ .name = " (zig-string (name->string (car lib))) ", .exports = &.{\n") p)
       (for-each (lambda (e)
                   (write-string (string-append "        .{ .name = " (zig-string (symbol->string (car e)))
                                                ", .kind = ." (symbol->string (cadr e))
                                                ", .id = " (number->string (caddr e)) " },\n")
                                 p))
                 (cdr lib))
       (write-string "    } },\n" p))
     libraries)
    (write-string "};\n\n" p)
    (write-string (string-append "pub const id_count = " (number->string (+ next-id 1)) ";\n") p)))

(display "wrote ") (display out-file) (display ": ") (display (length libraries)) (display " libraries") (newline)

;; Generate runtime/primitive_docs.zig: the documentation texts of the
;; primitives the native runtime implements, as the JVM implementation's
;; procedure-doc gives them (its Primitive.info()).
;;
;; Usage: scm scm-native/tools/gen-primitive-docs.scm
;; Run it again when primitives are added or their texts change.

(import (scheme base)
        (scheme eval)
        (scheme file)
        (scheme process-context)
        (scheme write)
        (srfi 132)
        (scm doc)
        (scm fs)
        (scm io))

(define native-dir (directory-name (directory-name (normalized-path (absolute-path (car (command-line)))))))
(define runtime-dir (join-path native-dir "runtime"))
(define out-file (join-path runtime-dir "primitive_docs.zig"))

(define (string-prefix? p s)
  (and (<= (string-length p) (string-length s))
       (string=? p (substring s 0 (string-length p)))))

(define (string-suffix? suffix s)
  (and (>= (string-length s) (string-length suffix))
       (string=? suffix (substring s (- (string-length s) (string-length suffix)) (string-length s)))))

(define (filter keep? l)
  (cond ((null? l) '())
        ((keep? (car l)) (cons (car l) (filter keep? (cdr l))))
        (else (filter keep? (cdr l)))))

;; the names of `pub const @"%name"` in runtime/prims*.zig
(define prefix "pub const @\"%")
(define names
  (list-sort
   string<?
   (apply append
          (map (lambda (file)
                 (filter (lambda (x) x)
                         (map (lambda (line)
                                (and (string-prefix? prefix line)
                                     (let loop ((i (string-length prefix)))
                                       (if (char=? (string-ref line i) #\")
                                           (substring line (string-length prefix) i)
                                           (loop (+ i 1))))))
                              (read-file-lines (join-path runtime-dir file)))))
               (filter (lambda (f) (and (string-prefix? "prims" f) (string-suffix? ".zig" f)))
                       (directory-files runtime-dir))))))

(define env (environment '(scheme base)))

(define (doc name)
  (guard (e (#t #f))
    (let ((p (eval (list '%primitive name) env)))
      (and (procedure? p) (procedure-doc p)))))

(define (zig-string s)
  (let ((o (open-output-string)))
    (write-char #\" o)
    (string-for-each
     (lambda (c)
       (cond ((char=? c #\") (write-string "\\\"" o))
             ((char=? c #\\) (write-string "\\\\" o))
             ((char=? c #\newline) (write-string "\\n" o))
             ((char=? c #\tab) (write-string "\\t" o))
             ((char<? c #\space) (write-string "\\x" o)
                                 (write-string (string-pad-hex (char->integer c)) o))
             (else (write-char c o))))
     s)
    (write-char #\" o)
    (get-output-string o)))

(define (string-pad-hex n)
  (let ((s (number->string n 16)))
    (if (< (string-length s) 2) (string-append "0" s) s)))

(define count 0)
(call-with-output-file out-file
  (lambda (p)
    (write-string "//! Generated by tools/gen-primitive-docs.scm from the JVM implementation;\n" p)
    (write-string "//! do not edit. The texts procedure-doc gives for primitives, sorted by name.\n\n" p)
    (write-string "pub const Doc = struct { name: []const u8, doc: []const u8 };\n\n" p)
    (write-string "pub const docs = [_]Doc{\n" p)
    (for-each (lambda (name)
                (let ((d (doc name)))
                  (when (string? d)
                    (set! count (+ count 1))
                    (write-string (string-append "    .{ .name = " (zig-string name) ", .doc = " (zig-string d) " },\n") p))))
              names)
    (write-string "};\n" p)))

(display "wrote ") (display out-file) (display ": ") (display count) (display " primitives") (newline)

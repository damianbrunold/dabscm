;; A thread blocked in a port operation on a socket while another thread
;; collects: compiled code kept the objects it uses after the operation in
;; locals across the call, as for a primitive that never collects, but the
;; collection moved them (found with SCM_NATIVE_GC_STRESS)
(import (scheme base) (scheme write) (srfi 18) (scm net sockets))
(define listener (tcp-listen 18931))
(define client (tcp-connect "127.0.0.1" 18931))
(define server (tcp-accept listener))
(define in (socket-input-port server))
(define out (socket-output-port client))
(define rounds 20)
(define (reader)
  (let loop ((i 0) (acc '()))
    (if (= i rounds)
        (reverse acc)
        (let* ((v (vector i (* i 2) (list i)))
               (c (read-char in))
               (w (make-vector 64 c)))
          (loop (+ i 1)
                (cons (list (vector-ref v 1) (car (vector-ref v 2)) (vector-ref w 63)) acc))))))
(define th (make-thread reader))
(thread-start! th)
(define (garbage n)
  (let loop ((k 0) (acc '()))
    (if (< k n) (loop (+ k 1) (if (= 0 (modulo k 1000)) '() (cons k acc))) (length acc))))
(let loop ((i 0))
  (when (< i rounds)
    (thread-sleep! 0.01)
    (garbage 1500000)
    (write-char #\x out)
    (flush-output-port out)
    (loop (+ i 1))))
(write (thread-join! th))
(newline)
(socket-close client)
(socket-close server)
(socket-close listener)

(import (scheme base) (scheme write))
(define (assv k l) (cond ((null? l) #f) ((eqv? (car (car l)) k) (car l)) (else (assv k (cdr l)))))
(define (map1 f l) (if (null? l) '() (cons (f (car l)) (map1 f (cdr l)))))
(define (for-each1 f l) (unless (null? l) (f (car l)) (for-each1 f (cdr l))))
;; cond, case, and, or, when, unless, do, named let, deep recursion,
;; long tail-recursive loops, call/cc escapes and re-entry
(define (classify n)
  (cond ((< n 0) 'negative)
        ((= n 0) 'zero)
        ((assv n '((1 . one) (2 . two))) => cdr)
        (else 'many)))
(write (map1 classify '(-5 0 1 2 7)))
(newline)
(define (kind x)
  (case x
    ((1 2 3) 'small)
    ((a b) 'letter)
    (else 'other)))
(write (map1 kind '(1 3 a z 99)))
(newline)
(write (list (and) (and 1 2) (and 1 #f 3) (or) (or #f 2) (or #f #f)))
(newline)
(write (do ((i 0 (+ i 1)) (acc '() (cons i acc))) ((= i 5) acc)))
(newline)
;; a loop of ten million iterations must run in constant stack space
(write (let loop ((i 0) (s 0)) (if (= i 10000000) s (loop (+ i 1) (+ s i)))))
(newline)
;; deep non-tail recursion: one million frames
(define (build n) (if (= n 0) '() (cons n (build (- n 1)))))
(define (sum l acc) (if (null? l) acc (sum (cdr l) (+ acc (car l)))))
(write (sum (build 1000000) 0))
(newline)
;; call/cc: escape from a loop
(define (find-first pred l)
  (call-with-current-continuation
   (lambda (return)
     (for-each1 (lambda (x) (when (pred x) (return x))) l)
     #f)))
(write (list (find-first (lambda (x) (> x 3)) '(1 2 3 4 5)) (find-first (lambda (x) (> x 9)) '(1 2))))
(newline)
;; call/cc: re-entering a continuation several times (inside a body: at
;; top level, the JVM implementation's continuation ends with the form)
(define (reenter)
  (let* ((k #f)
         (count 0)
         (result (+ 100 (call/cc (lambda (c) (set! k c) 1)))))
    (set! count (+ count 1))
    (if (< count 3)
        (k count)
        (list result count))))
(write (reenter))
(newline)
(when #f 'never)
(unless #f (write 'unless-ok))
(newline)

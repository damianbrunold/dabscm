(import (scheme base) (scheme write) (scheme char))
;; constants, quasiquote, vectors, strings, characters, symbols
(write '(1 "two" #\3 four (5 . 6) #(7 8) 9.5 -0.25 #t #f ()))
(newline)
(define x 42)
(define l '(a b c))
(write `(x ,x ,@l end (nested ,(+ x 1))))
(newline)
(define v (make-vector 5 0))
(let loop ((i 0))
  (when (< i 5)
    (vector-set! v i (* i 10))
    (loop (+ i 1))))
(write (list v (vector-length v) (vector-ref v 3) (vector->list v) (list->vector '(1 2))))
(newline)
(define s (make-string 3 #\a))
(string-set! s 1 #\b)
(write (list s (string-length s) (string-ref s 1) (string-append s "-" "xyz")
             (substring "hello world" 6 11) (string->symbol "sym") (symbol->string 'abc)
             (string->list "abc") (list->string (list #\x #\y)) (number->string 255)
             (string=? "a" "a") (string<? "a" "b")))
(newline)
(define u (string-copy "abc"))
(string-set! u 0 (integer->char 955))
(write (list u (string-length u) (char->integer (string-ref u 0))))
(newline)
(display (list "display" #\c 'sym "λ unicode ü"))
(newline)
(write (list (eq? 'a 'a) (eqv? 1.5 1.5) (equal? '(1 (2 #(3))) '(1 (2 #(3)))) (equal? "ab" "ab")
             (eq? '() '()) (eqv? 2 2) (equal? 1 1.0)))
(newline)
(write (list (char->integer #\A) (integer->char 66) (char=? #\a #\a) (char<? #\a #\b)))
(newline)
(write (reverse '(1 2 3)))
(write (append '(1) '(2 3) '() '(4)))
(write (length '(1 2 3)))
(newline)

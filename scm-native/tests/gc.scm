(import (scheme base) (scheme write))
(define (cadr x) (car (cdr x)))
;; allocation-heavy work that needs many collections; live data survives
(define (make-tree d)
  (if (= d 0)
      (cons 0 0)
      (cons (make-tree (- d 1)) (make-tree (- d 1)))))
(define (count-tree t)
  (if (pair? (car t))
      (+ (count-tree (car t)) (count-tree (cdr t)))
      1))
(define keep (make-tree 16))
(define (churn n acc)
  (if (= n 0)
      acc
      (churn (- n 1) (+ acc (count-tree (make-tree 10))))))
(write (list (churn 200 0) (count-tree keep)))
(newline)
(define v (make-vector 1000 '()))
(let loop ((i 0))
  (when (< i 100000)
    (let ((j (remainder i 1000)))
      (vector-set! v j (cons i (if (> (length (vector-ref v j)) 5) '() (vector-ref v j)))))
    (loop (+ i 1))))
(write (vector-ref v 999))
(newline)
(define strs
  (let loop ((i 0) (acc '()))
    (if (= i 20000) acc (loop (+ i 1) (cons (number->string i) acc)))))
(write (list (length strs) (car strs) (string-append (car strs) (cadr strs))))
(newline)

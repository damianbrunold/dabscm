(import (scheme base) (scheme write))
;; loops compiled as Zig loops: allocation in the loop body (collections with
;; loop variables and outer values live), nested loops, closures over loop
;; variables, swapped parameters
(define (build n tag)
  (let loop ((i 0) (acc '()))
    (if (= i n)
        acc
        (loop (+ i 1) (cons (cons tag i) acc)))))
(define l (build 2000000 'x))
(write (list (length l) (car l) (car (reverse l))))
(newline)
(define (closures n)
  (let ((base 1000))
    (let loop ((i 0) (fs '()))
      (if (= i n)
          (let sum ((fs fs) (s 0)) (if (null? fs) s (sum (cdr fs) (+ s ((car fs))))))
          (loop (+ i 1) (cons (lambda () (+ base i)) fs))))))
(write (closures 300000))
(newline)
(define (nested n)
  (let outer ((i 0) (acc '()))
    (if (= i n)
        (length acc)
        (outer (+ i 1)
               (let inner ((j 0) (acc acc))
                 (if (= j i) acc (inner (+ j 1) (cons (vector i j) acc))))))))
(write (nested 1500))
(newline)
(define (swap n)
  (let loop ((a 1) (b 2) (k n))
    (if (= k 0) (list a b) (loop b a (- k 1)))))
(write (list (swap 10) (swap 11)))
(newline)
(define-record-type cell (make-cell v next) cell? (v cell-v) (next cell-next))
(define (chain n)
  (let loop ((i 0) (c #f))
    (if (= i n)
        (let walk ((c c) (s 0)) (if c (walk (cell-next c) (+ s (cell-v c))) s))
        (loop (+ i 1) (make-cell i c)))))
(write (chain 1000000))
(newline)

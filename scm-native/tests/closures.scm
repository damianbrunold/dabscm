(import (scheme base) (scheme write))
(define (cadr x) (car (cdr x)))
(define (caddr x) (car (cdr (cdr x))))
;; closures, set!, counters, letrec, mutual recursion
(define (make-counter)
  (let ((n 0))
    (lambda () (set! n (+ n 1)) n)))
(define c1 (make-counter))
(define c2 (make-counter))
(c1) (c1) (c2)
(write (list (c1) (c2)))
(newline)
(define (even2? n) (if (= n 0) #t (odd2? (- n 1))))
(define (odd2? n) (if (= n 0) #f (even2? (- n 1))))
(write (list (even2? 100001) (odd2? 100001)))
(newline)
(define (f x)
  (letrec ((ev? (lambda (n) (if (= n 0) #t (od? (- n 1)))))
           (od? (lambda (n) (if (= n 0) #f (ev? (- n 1))))))
    (list (ev? x) (od? x) (let ((y (* x 2))) (lambda (z) (+ x y z))))))
(define r (f 7))
(write (list (car r) (cadr r) ((caddr r) 100)))
(newline)
(define acc '())
(define (push! x) (set! acc (cons x acc)))
(let loop ((i 0))
  (when (< i 5)
    (push! (* i i))
    (loop (+ i 1))))
(write acc)
(newline)
;; assigned parameter captured by a closure
(define (g x)
  (let ((get (lambda () x)))
    (set! x (+ x 1))
    (get)))
(write (g 41))
(newline)
;; internal defines, variadic procedures, apply
(define (h . args)
  (define n (length args))
  (define (sum l) (if (null? l) 0 (+ (car l) (sum (cdr l)))))
  (list n (sum args)))
(write (list (h) (h 1 2 3) (apply h 1 2 '(3 4)) (apply + 1 2 '(3 4 5))))
(newline)
(define (opt a b . rest) (list a b rest))
(write (list (opt 1 2) (opt 1 2 3 4)))
(newline)

[Unit]
Description=starter-admin health probe (restarts the app if /healthz fails)
After=starter-admin.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/systemctl is-active --quiet starter-admin.service
# Host/port come from the config; two strikes before a restart.
ExecStart=/opt/starter-admin/deploy/healthcheck.sh /etc/starter-admin/config.scm starter-admin.service

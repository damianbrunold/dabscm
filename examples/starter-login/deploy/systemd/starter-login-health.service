[Unit]
Description=starter-login health probe (restarts the app if /healthz fails)
After=starter-login.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/systemctl is-active --quiet starter-login.service
# Host/port come from the config; two strikes before a restart.
ExecStart=/opt/starter-login/deploy/healthcheck.sh /etc/starter-login/config.scm starter-login.service

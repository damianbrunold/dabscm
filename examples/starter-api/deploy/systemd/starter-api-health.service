[Unit]
Description=starter-api health probe (restarts the app if /healthz fails)
After=starter-api.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/systemctl is-active --quiet starter-api.service
# Host/port come from the config; two strikes before a restart.
ExecStart=/opt/starter-api/deploy/healthcheck.sh /etc/starter-api/config.scm starter-api.service

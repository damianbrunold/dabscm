[Unit]
Description=starter-public health probe (restarts the app if /healthz fails)
After=starter-public.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/systemctl is-active --quiet starter-public.service
# Host/port come from the config; two strikes before a restart.
ExecStart=/opt/starter-public/deploy/healthcheck.sh /etc/starter-public/config.scm starter-public.service

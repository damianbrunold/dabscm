[Unit]
Description=starter-public scheme webapp
After=network-online.target
Wants=network-online.target
# Allow a few quick restarts, but if we crash-loop more than 5 times in
# 60s, give up rather than burn CPU.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Adjust to the unprivileged user/paths you deploy under.
User=www
Group=www
WorkingDirectory=/opt/starter-public
# Path to the scm interpreter binary.
ExecStart=/usr/local/bin/scm main.scm

# Restart on any exit. Combined with the daily restart timer this makes
# the service self-healing across OOMs and unexpected exceptions.
Restart=always
RestartSec=3s
# Give the HTTP server (10s graceful drain by default) time to finish.
TimeoutStopSec=15s

StandardOutput=journal
StandardError=journal

# --- hardening ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
# The app only reads its files; grant writes only if you add a data dir.
ReadWritePaths=/opt/starter-public/data

[Install]
WantedBy=multi-user.target

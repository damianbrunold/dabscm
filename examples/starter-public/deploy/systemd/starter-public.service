[Unit]
Description=starter-public scheme webapp
After=network-online.target
Wants=network-online.target
# Allow a few quick restarts, but if we crash-loop more than 5 times in
# 60s, give up rather than burn CPU.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=starter-public
Group=starter-public
WorkingDirectory=/opt/starter-public
# deploy/install.sh replaces the scm path with $SCM.
ExecStart=/usr/local/bin/scm bin/server.scm /etc/starter-public/config.scm

# Restart on any exit. Combined with the daily restart timer this makes
# the service self-healing across OOMs and unexpected exceptions.
Restart=always
RestartSec=3s
# The JVM exits with 128+SIGTERM on a normal stop.
SuccessExitStatus=143
# Give the HTTP server (10s graceful drain by default) time to finish.
TimeoutStopSec=15s

# Logs go to journald: journalctl -u starter-public -f
StandardOutput=journal
StandardError=journal

# --- hardening ---
# The app only reads its files: the whole file system is read-only for it.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target

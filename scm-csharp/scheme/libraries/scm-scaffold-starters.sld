;; Generated by update-scheme-files.scm from examples/starter-*: do not edit.
;; The starter applications' files for (scm scaffold).
(define-library (scm scaffold starters)
  (import (scheme base))
  (export starter-files)
  (begin
    ;; ((starter (relative-path . content) ...) ...)
    (define starter-files
      '(
        ("starter-public"
         (".gitignore" . "# Local config, created by the first run.\nconfig.scm\n")
         ("README.md" . "# starter-public\n\nA minimal **public** web app (no authentication): one page that renders a\ntable from a JSON file, with light/dark theming.\n\nUse it as a starting point for any read-only public page: a status board, a\nsmall catalogue, a landing page backed by data.\n\n## What it demonstrates\n\n- Routing, and serving static files with cache-busting URLs\n  (`(scm net http route)`, `(scm net http static)`): `asset` emits\n  `/static/css/app.css?v=<mtime>`, which browsers cache for a year; an edited\n  file gets a new URL without a restart.\n- The middleware stack from `(scm net http middleware)`: one access-log line\n  per request, security headers with a strict Content-Security-Policy, and\n  errors logged in full but shown to the visitor only as a generic 500 page.\n- Safe, auto-escaping HTML rendering (`(scm html builder)`): data can never\n  inject markup.\n- No inline JavaScript or style attributes, as the CSP requires: all of it is\n  under `static/`.\n- Light/dark mode that follows the OS setting, with a toggle whose choice is\n  remembered (`static/js/theme-init.js` applies it before the first paint, so\n  there is no flash). The CSS defines each colour once, with `light-dark()`.\n- Mounting under a URL prefix (`url-prefix` in the config).\n- A config file read as data, created on the first run.\n- Tests that call the app's handler directly, with no server running.\n- A `/healthz` endpoint for the health probe.\n\n## Layout\n\n```\nbin/server.scm        load the config, serve the app\nbin/dev-server.scm    auto-reloading dev supervisor\nbin/init-config.scm   write a new config file (used by deploy/install.sh)\nsrc/app-config.sld    config reading and first-run creation\nsrc/app-web.sld       routes, pages, middleware: make-app\nconfig.example.scm    the config template, with every setting\ndata/items.json       the data shown in the table\nstatic/css/app.css    theme tokens + layout\nstatic/js/            theme-init.js (in <head>) and theme-toggle.js\ntests/                test_pure_*.scm, run without a server\ndeploy/               systemd units, health probe, nginx example, install script\n```\n\n## Run\n\n```sh\nscm bin/server.scm               # http://127.0.0.1:8070\nscm bin/dev-server.scm           # same, restarts when src/ or the config changes\n```\n\nThe first run creates `config.scm` from `config.example.scm`; edit it to\nchange the host, port or URL prefix. `scm bin/server.scm path/to/config.scm`\nuses another config file.\n\n## Test\n\n```sh\nfor t in tests/test_*.scm; do scm \"$t\" || exit 1; done\n```\n\n## Adapt\n\n- Replace `data/items.json` and `items-table` in `src/app-web.sld` with your\n  own data and markup.\n- Add routes in `make-app` with `router-add!`; wrap paths in\n  `(string-append prefix ...)` and build links with `url`, so the app keeps\n  working under a prefix.\n- Add assets under `static/` and link them with `(asset \"path\")`.\n\n## Deploy\n\nThe app binds loopback only; put a TLS-terminating reverse proxy in front\n(`deploy/nginx.conf.example`). Then, on the server, from the app directory:\n\n```sh\nsudo deploy/install.sh               # SCM=/path/to/scm if not /usr/local/bin/scm\n```\n\nThis copies the app to `/opt/starter-public`, creates\n`/etc/starter-public/config.scm` on the first install, adds a\n`starter-public` system user, and enables three units: the service\n(`Restart=always`, read-only file system), a per-minute health probe that\nrestarts the app if `/healthz` fails twice (it reads the port from the\nconfig), and a daily 04:00 restart. Rerun it to deploy a new version; the\nconfig is kept.\n")
         ("config.example.scm" . ";; starter-public configuration: a list of (define name value) forms, read\n;; as data by src/app-config.sld. bin/server.scm reads config.scm; the first\n;; run creates it from this file. Every setting is optional.\n\n;; Bind loopback only; a reverse proxy (deploy/nginx.conf.example) fronts\n;; the public interface and terminates TLS.\n(define http-host \"127.0.0.1\")\n(define http-port 8070)\n\n;; Path the app is mounted under, e.g. \"/inventory\"; \"\" for the host root.\n;; The reverse proxy must pass paths through unchanged.\n(define url-prefix \"\")\n\n;; Relative paths are relative to the app directory.\n(define static-dir \"static\")\n(define data-file \"data/items.json\")\n")
         ("bin/dev-server.scm" . ";; Development supervisor: runs bin/server.scm and restarts it whenever a\n;; source file changes (src/*.sld, bin/server.scm, config.scm). Also\n;; auto-retries on a backoff if the server exits on its own. In-flight\n;; requests are dropped on restart, like Flask's reloader.\n;;\n;; Static files and data/items.json need no restart: they are read from\n;; disk on each request.\n;;\n;; Usage: scm bin/dev-server.scm\n\n(import (scheme base)\n        (scheme process-context)\n        (scm fs)\n        (scm reloader))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n\n(define (watched)\n  (append (files-with-suffix (string-append root \"/src\") \".sld\")\n          (list (string-append root \"/bin/server.scm\")\n                (string-append root \"/config.scm\"))))\n\n(supervise (list \"scm\" (string-append root \"/bin/server.scm\"))\n           watched\n           `((label . \"starter-public\")\n             (work-dir . ,root)\n             (root . ,root)))\n")
         ("bin/init-config.scm" . ";; Usage: scm bin/init-config.scm <target>\n;;\n;; Writes a new config file at target from config.example.scm. Used by\n;; deploy/install.sh; refuses to overwrite an existing file.\n\n(import (scheme base)\n        (scheme write)\n        (scheme process-context)\n        (scm module)\n        (scm fs))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config))\n\n(define args (cdr (command-line)))\n(when (null? args)\n  (display \"usage: scm bin/init-config.scm <target>\\n\")\n  (exit 1))\n\n(create-config! (string-append root \"/config.example.scm\") (car args))\n(display (string-append \"created \" (car args) \"\\n\"))\n")
         ("bin/server.scm" . ";; Usage: scm bin/server.scm [config-path]\n;;\n;; Reads the config (config-path, or else config.scm, which the first run\n;; creates from config.example.scm) and serves the app.\n\n(import (scheme base)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm log)\n        (scm net http server))\n\n;; Resolve the project root from this script's path so it runs from anywhere,\n;; and make src/ importable.\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config) (app web))\n\n(define cfg (load-config root (cdr (command-line))))\n(define host (config-ref cfg 'http-host \"127.0.0.1\"))\n(define port (config-ref cfg 'http-port 8070))\n(define prefix (config-ref cfg 'url-prefix \"\"))\n\n(define app\n  (make-app\n   `((url-prefix . ,prefix)\n     (static-dir . ,(resolve-path root (config-ref cfg 'static-dir \"static\")))\n     (data-file  . ,(resolve-path root (config-ref cfg 'data-file \"data/items.json\"))))))\n\n(log-info \"app\" (string-append \"starter-public listening on http://\" host \":\"\n                               (number->string port) prefix \"/\"))\n(serve-forever port app 0 host)\n")
         ("data/items.json" . "[\n  { \"name\": \"Widgets\",   \"count\": 42 },\n  { \"name\": \"Gadgets\",   \"count\": 17 },\n  { \"name\": \"Sprockets\", \"count\": 88 },\n  { \"name\": \"Cogs\",      \"count\": 5  },\n  { \"name\": \"Flanges\",   \"count\": 23 }\n]\n")
         ("deploy/healthcheck.sh" . "#!/bin/sh\n# Health probe for starter-public, run every minute by\n# starter-public-health.service: GET /healthz on the host/port from the\n# config. Two strikes: on failure wait 5s and probe again; only then restart\n# the unit, so one slow request cannot bounce the daemon.\n#\n# Usage: healthcheck.sh <config.scm> <unit>\nconf=$1\nunit=$2\n\n# The string or number of a (define name value) line in the config.\nvalue() {\n  sed -n \"s/^[[:space:]]*(define[[:space:]][[:space:]]*$1[[:space:]][[:space:]]*\\\"\\{0,1\\}\\([^\\\" )]*\\).*/\\1/p\" \"$conf\" | head -n 1\n}\n\nport=$(value http-port)\nhost=$(value http-host)\ncase \"$host\" in ''|0.0.0.0|::) host=127.0.0.1 ;; esac\nurl=\"http://$host:${port:-8070}/healthz\"\n\nprobe() { curl -fsS --max-time 5 \"$url\" >/dev/null; }\n\nif ! probe; then\n  sleep 5\n  if ! probe; then\n    echo \"$unit: $url failed twice; restarting\"\n    systemctl restart \"$unit\"\n  fi\nfi\n")
         ("deploy/install.sh" . "#!/bin/sh\n# Installs starter-public as a systemd service. Run as root on the target\n# host from the app directory: sudo deploy/install.sh. Idempotent: rerun it\n# to deploy a new version (the config in /etc is kept).\n#\n#   /opt/starter-public               the app (replaced on each install)\n#   /etc/starter-public/config.scm    the config (created once, then yours)\n#\n# The service runs as the system user starter-public. Set SCM to the scm\n# launcher if it is not /usr/local/bin/scm.\nset -eu\n\nAPP=starter-public\nSCM=${SCM:-/usr/local/bin/scm}\nSRC=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n\nid -u \"$APP\" >/dev/null 2>&1 ||\n  useradd --system --home-dir /nonexistent --no-create-home \\\n          --shell /usr/sbin/nologin \"$APP\"\n\n# The app: code, static files and data, owned by root, readable by all.\nrm -rf \"/opt/$APP.new\"\nmkdir -p \"/opt/$APP.new\"\ncp -r \"$SRC/bin\" \"$SRC/src\" \"$SRC/static\" \"$SRC/data\" \"$SRC/deploy\" \\\n      \"$SRC/config.example.scm\" \"/opt/$APP.new/\"\nrm -rf \"/opt/$APP\"\nmv \"/opt/$APP.new\" \"/opt/$APP\"\n\n# The config: created from config.example.scm on the first install only.\nmkdir -p \"/etc/$APP\"\nif [ ! -f \"/etc/$APP/config.scm\" ]; then\n  \"$SCM\" \"/opt/$APP/bin/init-config.scm\" \"/etc/$APP/config.scm\"\nfi\nchown root:\"$APP\" \"/etc/$APP/config.scm\"\nchmod 640 \"/etc/$APP/config.scm\"\n\nfor unit in \"$APP.service\" \\\n            \"$APP-health.service\" \"$APP-health.timer\" \\\n            \"$APP-restart.service\" \"$APP-restart.timer\"; do\n  sed \"s|/usr/local/bin/scm|$SCM|\" \"$SRC/deploy/systemd/$unit\" \\\n    > \"/etc/systemd/system/$unit\"\ndone\n\nsystemctl daemon-reload\nsystemctl enable \"$APP.service\" \"$APP-health.timer\" \"$APP-restart.timer\"\nsystemctl restart \"$APP.service\"\nsystemctl start \"$APP-health.timer\" \"$APP-restart.timer\"\n\necho \"Installed. Config: /etc/$APP/config.scm. Logs: journalctl -u $APP -f\"\n")
         ("deploy/nginx.conf.example" . "# Reverse proxy in front of starter-public. The app binds 127.0.0.1 only;\n# nginx terminates TLS on the public interface and forwards to it.\n\nupstream starter_public_backend {\n    server 127.0.0.1:8070;\n    keepalive 16;\n}\n\nserver {\n    listen 443 ssl;\n    http2 on;\n    server_name example.com;\n\n    # ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;\n    # ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;\n\n    # At the host root. To mount the app under a path instead, set\n    # (define url-prefix \"/inventory\") in the config and use\n    # \"location /inventory/\" here. proxy_pass without a URI part passes\n    # the path through unchanged, which is what the app expects.\n    location / {\n        proxy_pass         http://starter_public_backend;\n        proxy_http_version 1.1;\n        proxy_set_header   Connection        \"\";\n        proxy_set_header   Host              $host;\n        proxy_set_header   X-Real-IP         $remote_addr;\n        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;\n        proxy_set_header   X-Forwarded-Proto $scheme;\n        proxy_read_timeout 30s;\n    }\n}\n")
         ("deploy/systemd/starter-public-health.service" . "[Unit]\nDescription=starter-public health probe (restarts the app if /healthz fails)\nAfter=starter-public.service\n\n[Service]\nType=oneshot\nExecCondition=/usr/bin/systemctl is-active --quiet starter-public.service\n# Host/port come from the config; two strikes before a restart.\nExecStart=/opt/starter-public/deploy/healthcheck.sh /etc/starter-public/config.scm starter-public.service\n")
         ("deploy/systemd/starter-public-health.timer" . "[Unit]\nDescription=Run the starter-public health probe every minute\n\n[Timer]\n# Wait a minute after boot so the app can bind its socket first.\nOnBootSec=60s\nOnUnitActiveSec=60s\nAccuracySec=15s\nUnit=starter-public-health.service\n\n[Install]\nWantedBy=timers.target\n")
         ("deploy/systemd/starter-public-restart.service" . "[Unit]\nDescription=Daily restart of starter-public (clears slow leaks, picks up config)\n\n[Service]\nType=oneshot\nExecStart=/bin/systemctl try-restart starter-public.service\n")
         ("deploy/systemd/starter-public-restart.timer" . "[Unit]\nDescription=Daily restart of starter-public at 04:00\n\n[Timer]\nOnCalendar=*-*-* 04:00:00\n# If the machine was off at 04:00, restart on the next boot.\nPersistent=true\nRandomizedDelaySec=2m\nUnit=starter-public-restart.service\n\n[Install]\nWantedBy=timers.target\n")
         ("deploy/systemd/starter-public.service" . "[Unit]\nDescription=starter-public scheme webapp\nAfter=network-online.target\nWants=network-online.target\n# Allow a few quick restarts, but if we crash-loop more than 5 times in\n# 60s, give up rather than burn CPU.\nStartLimitIntervalSec=60\nStartLimitBurst=5\n\n[Service]\nType=simple\nUser=starter-public\nGroup=starter-public\nWorkingDirectory=/opt/starter-public\n# deploy/install.sh replaces the scm path with $SCM.\nExecStart=/usr/local/bin/scm bin/server.scm /etc/starter-public/config.scm\n\n# Restart on any exit. Combined with the daily restart timer this makes\n# the service self-healing across OOMs and unexpected exceptions.\nRestart=always\nRestartSec=3s\n# The JVM exits with 128+SIGTERM on a normal stop.\nSuccessExitStatus=143\n# Give the HTTP server (10s graceful drain by default) time to finish.\nTimeoutStopSec=15s\n\n# Logs go to journald: journalctl -u starter-public -f\nStandardOutput=journal\nStandardError=journal\n\n# --- hardening ---\n# The app only reads its files: the whole file system is read-only for it.\nNoNewPrivileges=yes\nPrivateTmp=yes\nProtectSystem=strict\nProtectHome=yes\n\n[Install]\nWantedBy=multi-user.target\n")
         ("src/app-config.sld" . ";; (app config) — reads config.scm and creates it on the first run.\n;;\n;; The config file is a list of (define name expression) forms. It is read\n;; as data, not loaded: each expression is evaluated on its own in a\n;; (scheme base) environment, so (* 60 60 24 7) works but the file cannot\n;; reach into the app. The result is an alist, read with config-ref.\n\n(define-library (app config)\n  (import (scheme base)\n          (scheme eval)\n          (scheme file)\n          (scheme read)\n          (scheme write)\n          (scm crypto)\n          (scm fs)\n          (scm io)\n          (scm string))\n  (export load-config\n          read-config\n          create-config!\n          config-ref\n          resolve-path)\n  (begin\n\n    ;; config.example.scm carries this placeholder where a secret belongs;\n    ;; create-config! replaces it with a fresh random key.\n    (define secret-placeholder \"REPLACE_WITH_BASE64_SECRET\")\n\n    (define (read-config path)\n      \"Syntax: (read-config path)\nLibrary: (app config)\nDescription: Reads the (define name expression) forms in path and returns\n  an alist of (name . value). Any other form is an error.\"\n      (let ((env (environment '(scheme base))))\n        (call-with-input-file path\n          (lambda (port)\n            (let loop ((acc '()))\n              (let ((form (read port)))\n                (cond\n                  ((eof-object? form) (reverse acc))\n                  ((and (pair? form) (eq? (car form) 'define)\n                        (pair? (cdr form)) (symbol? (cadr form))\n                        (pair? (cddr form)) (null? (cdddr form)))\n                   (loop (cons (cons (cadr form) (eval (caddr form) env)) acc)))\n                  (else (error \"config: expected (define name value)\" form)))))))))\n\n    (define (create-config! example target)\n      \"Syntax: (create-config! example target)\nLibrary: (app config)\nDescription: Writes target as a copy of example, with each secret\n  placeholder replaced by a fresh base64 key, readable by the owner only.\n  Refuses to overwrite an existing file.\"\n      (when (file-exists? target)\n        (error \"config already exists\" target))\n      (let ((text (string-replace-all (read-file-string example)\n                                      secret-placeholder\n                                      (base64-encode (random-bytes 32)))))\n        (call-with-output-file target\n          (lambda (p) (write-string text p)))\n        (chmod target \"600\")))\n\n    (define (load-config root args)\n      \"Syntax: (load-config root args)\nLibrary: (app config)\nDescription: Reads the config named by the first command-line argument in\n  args, or else root/config.scm. On the first run, when root/config.scm\n  does not exist yet, it is created from config.example.scm.\"\n      (if (pair? args)\n          (read-config (car args))\n          (let ((path (string-append root \"/config.scm\")))\n            (unless (file-exists? path)\n              (create-config! (string-append root \"/config.example.scm\") path)\n              (display (string-append \"created \" path \"\\n\") (current-error-port)))\n            (read-config path))))\n\n    (define (config-ref cfg name default)\n      \"Syntax: (config-ref cfg name default)\nLibrary: (app config)\nDescription: The value of name in cfg, or default if the file has none.\"\n      (let ((p (assq name cfg)))\n        (if p (cdr p) default)))\n\n    (define (resolve-path root path)\n      \"Syntax: (resolve-path root path)\nLibrary: (app config)\nDescription: path itself if absolute, else path relative to root.\"\n      (if (and (> (string-length path) 0) (char=? (string-ref path 0) #\\/))\n          path\n          (string-append root \"/\" path)))))\n")
         ("src/app-web.sld" . ";; (app web) — the whole web app: routes, page rendering, middleware.\n;;\n;; make-app returns the server-level handler (lambda (req) resp), so\n;; bin/server.scm only has to serve it and the tests can call it directly\n;; with a request, no socket involved.\n;;\n;; Pages follow a strict Content-Security-Policy (see security-headers in\n;; (scm net http middleware)): no inline <script> and no style=\"\" attributes.\n;; All JavaScript and CSS lives under static/.\n\n(define-library (app web)\n  (import (scheme base)\n          (scm io)\n          (scm json simple)\n          (scm html builder)\n          (scm net http request)\n          (scm net http response)\n          (scm net http route)\n          (scm net http static)\n          (scm net http middleware))\n  (export make-app)\n  (begin\n\n    ;; --- URL prefix ---------------------------------------------------\n\n    ;; The app can be mounted under a path (\"/inventory\"), with the reverse\n    ;; proxy passing paths through unchanged. Every route and every link\n    ;; goes through url / asset, which read the current site.\n    (define-record-type site\n      (make-site prefix static-url)\n      site?\n      (prefix site-prefix)\n      (static-url site-static-url))\n\n    (define current-site (make-parameter #f))\n\n    ;; \"\" or \"/\" -> \"\"; \"inventory/\" -> \"/inventory\"\n    (define (normalize-prefix p)\n      (let* ((s (if (and (> (string-length p) 0) (char=? (string-ref p 0) #\\/))\n                    p\n                    (string-append \"/\" p)))\n             (n (string-length s)))\n        (if (char=? (string-ref s (- n 1)) #\\/)\n            (substring s 0 (- n 1))\n            s)))\n\n    (define (url path) (string-append (site-prefix (current-site)) path))\n\n    ;; /static/<rel>?v=<mtime>: browsers cache it for a year, and an edited\n    ;; file gets a new URL without a restart.\n    (define (asset rel) ((site-static-url (current-site)) rel))\n\n    ;; --- data ---------------------------------------------------------\n\n    ;; Read on each request so edits show up without a restart. json-parse\n    ;; turns a JSON array of objects into a vector of alists.\n    (define (load-items data-file)\n      (vector->list (json-parse (read-file-string data-file))))\n\n    ;; --- HTML ---------------------------------------------------------\n\n    ;; Both icons are always in the page; the CSS shows the one that fits\n    ;; the active theme. Fixed markup, so raw is safe here.\n    (define theme-icons\n      (raw (string-append\n            \"<svg class=\\\"i-sun\\\" viewBox=\\\"0 0 24 24\\\" width=\\\"20\\\" height=\\\"20\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" aria-hidden=\\\"true\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\"/><path d=\\\"M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4\\\"/></svg>\"\n            \"<svg class=\\\"i-moon\\\" viewBox=\\\"0 0 24 24\\\" width=\\\"20\\\" height=\\\"20\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" aria-hidden=\\\"true\\\"><path d=\\\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\\\"/></svg>\")))\n\n    (define (page title body)\n      (string-append\n       (html->string\n        (html5\n         '(@ (lang \"en\"))\n         `(head\n           (meta (@ (charset \"utf-8\")))\n           (meta (@ (name \"viewport\") (content \"width=device-width, initial-scale=1\")))\n           (title ,title)\n           (link (@ (rel \"icon\") (href ,(asset \"favicon.svg\"))))\n           (link (@ (rel \"stylesheet\") (href ,(asset \"css/app.css\"))))\n           ;; Not deferred: applies a remembered theme before first paint.\n           (script (@ (src ,(asset \"js/theme-init.js\"))))\n           (script (@ (src ,(asset \"js/theme-toggle.js\")) (defer #t))))\n         `(body\n           (header (@ (class \"app-header\"))\n             (h1 (a (@ (href ,(url \"/\"))) \"Inventory\"))\n             (button (@ (class \"icon-btn js-theme-toggle\") (type \"button\")\n                        (aria-label \"Toggle dark mode\"))\n               ,theme-icons))\n           (main ,body))))\n       \"\\n\"))\n\n    ;; Values go through the auto-escaping builder: data can never inject\n    ;; markup.\n    (define (items-table items)\n      `(table (@ (class \"data\"))\n         (thead (tr (th \"Name\") (th (@ (class \"num\")) \"Count\")))\n         (tbody\n          ,@(map (lambda (it)\n                   `(tr (td ,(json-ref it \"name\" \"\"))\n                        (td (@ (class \"num\"))\n                            ,(number->string (json-ref it \"count\" 0)))))\n                 items))))\n\n    (define (error-page req)\n      (html-response\n       (page \"Error\" '(section (h2 \"Something went wrong\")\n                               (p \"The error has been logged.\")))))\n\n    ;; --- app ----------------------------------------------------------\n\n    (define (setting settings key)\n      (let ((p (assq key settings)))\n        (if p (cdr p) (error \"make-app: missing setting\" key))))\n\n    (define (make-app settings)\n      \"Syntax: (make-app settings)\nLibrary: (app web)\nDescription: Builds the app's request handler. settings is an alist with\n  url-prefix (\\\"\\\" at the host root), static-dir and data-file (absolute\n  paths).\"\n      (let* ((prefix (normalize-prefix (setting settings 'url-prefix)))\n             (static-dir (setting settings 'static-dir))\n             (data-file (setting settings 'data-file))\n             (site (make-site prefix\n                              (make-static-url static-dir\n                                               (string-append prefix \"/static\"))))\n             (router (make-router)))\n\n        (router-add! router \"GET\" (string-append prefix \"/\")\n          (lambda (req params)\n            (html-response (page \"Inventory\" (items-table (load-items data-file))))))\n\n        (router-add! router \"GET\" (string-append prefix \"/static/*\")\n          (make-static-handler static-dir))\n\n        ;; Outside the prefix: the health probe talks to the app directly.\n        (router-add! router \"GET\" \"/healthz\"\n          (lambda (req params) (text-response \"ok\\n\")))\n\n        ;; Outermost first: log every request, add the security headers,\n        ;; make the site current for url/asset, and turn errors into a\n        ;; logged 500 page.\n        (let ((handler (with-error-handler (router->handler router) error-page)))\n          (with-access-log\n           (with-security-headers\n            (lambda (req)\n              (parameterize ((current-site site))\n                (handler req))))))))))\n")
         ("static/favicon.svg" . "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\"><rect width=\"32\" height=\"32\" rx=\"6\" fill=\"#2563eb\"/><path d=\"M9 11h14M9 16h14M9 21h9\" stroke=\"#fff\" stroke-width=\"2.5\" stroke-linecap=\"round\"/></svg>\n")
         ("static/css/app.css" . "/* Theme tokens. Colours are only written here, each as\n   light-dark(<light>, <dark>). The palette follows the OS setting unless\n   the user pinned one with the toggle: theme-init.js / theme-toggle.js\n   set data-theme on <html>, which fixes color-scheme. Works without\n   JavaScript too (then it simply follows the OS). */\n:root {\n  color-scheme: light dark;\n\n  --bg:     light-dark(#ffffff, #16181d);\n  --fg:     light-dark(#1a1a1a, #e8e8e8);\n  --muted:  light-dark(#666666, #9aa0aa);\n  --border: light-dark(#e2e2e2, #2c2f36);\n  --row:    light-dark(#fafafa, #1d2026);\n  --accent: light-dark(#2563eb, #6ea8fe);\n}\n:root[data-theme=\"light\"] { color-scheme: light; }\n:root[data-theme=\"dark\"]  { color-scheme: dark; }\n\n/* The toggle shows a moon in light mode and a sun in dark mode. */\n.i-sun { display: none; }\n:root[data-theme=\"dark\"] .i-sun  { display: inline; }\n:root[data-theme=\"dark\"] .i-moon { display: none; }\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"]) .i-sun  { display: inline; }\n  :root:not([data-theme=\"light\"]) .i-moon { display: none; }\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  font: 16px/1.5 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  color: var(--fg);\n  background: var(--bg);\n}\n\na { color: var(--accent); }\n\n.app-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding: 0.75rem 1.25rem;\n  border-bottom: 1px solid var(--border);\n}\n.app-header h1 { font-size: 1.25rem; margin: 0; }\n.app-header h1 a { color: inherit; text-decoration: none; }\n\n.icon-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 2.25rem;\n  height: 2.25rem;\n  padding: 0;\n  color: var(--fg);\n  background: transparent;\n  border: 1px solid var(--border);\n  border-radius: 0.5rem;\n  cursor: pointer;\n}\n.icon-btn:hover { border-color: var(--accent); color: var(--accent); }\n\nmain { max-width: 720px; margin: 2rem auto; padding: 0 1.25rem; }\n\ntable.data { width: 100%; border-collapse: collapse; }\ntable.data th, table.data td {\n  padding: 0.5rem 0.75rem;\n  text-align: left;\n  border-bottom: 1px solid var(--border);\n}\ntable.data thead th { color: var(--muted); font-weight: 600; }\ntable.data tbody tr:nth-child(even) { background: var(--row); }\ntable.data .num { text-align: right; font-variant-numeric: tabular-nums; }\n")
         ("static/js/theme-init.js" . "// Loaded in <head> without defer: applies a theme the user pinned with the\n// toggle before the first paint, so the page never flashes the wrong\n// palette. Nothing pinned: the CSS follows the OS setting.\n(function () {\n  try {\n    var t = localStorage.getItem(\"theme\");\n    if (t === \"dark\" || t === \"light\") {\n      document.documentElement.setAttribute(\"data-theme\", t);\n    }\n  } catch (e) {}\n})();\n")
         ("static/js/theme-toggle.js" . "// Wires every .js-theme-toggle button: flips the theme in effect (the\n// pinned one, else the OS setting) and remembers the choice.\n(function () {\n  function current() {\n    var t = document.documentElement.getAttribute(\"data-theme\");\n    if (t === \"dark\" || t === \"light\") return t;\n    return window.matchMedia(\"(prefers-color-scheme: dark)\").matches\n      ? \"dark\"\n      : \"light\";\n  }\n  document.querySelectorAll(\".js-theme-toggle\").forEach(function (btn) {\n    btn.addEventListener(\"click\", function () {\n      var next = current() === \"dark\" ? \"light\" : \"dark\";\n      document.documentElement.setAttribute(\"data-theme\", next);\n      try {\n        localStorage.setItem(\"theme\", next);\n      } catch (e) {}\n    });\n  });\n})();\n")
         ("tests/test_pure_config.scm" . ";; Tests for (app config). Run: scm tests/test_pure_config.scm\n\n(import (scheme base)\n        (scheme file)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm io)\n        (scm string)\n        (scm test))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config))\n\n(test-runner-factory scm-test-runner)\n(test-begin \"starter-public config\")\n\n(define tmp (mktempdir '(prefix . \"starter-public-config\")))\n(define (tmp-file name content)\n  (let ((path (string-append tmp \"/\" name)))\n    (call-with-output-file path (lambda (p) (write-string content p)))\n    path))\n\n(test-group \"read-config\"\n  (let ((cfg (read-config (tmp-file \"a.scm\" \"(define port 8070)\\n(define ttl (* 60 60))\\n(define name \\\"x\\\")\"))))\n    (test-equal 8070 (config-ref cfg 'port 0))\n    (test-equal 3600 (config-ref cfg 'ttl 0))\n    (test-equal \"x\" (config-ref cfg 'name #f))\n    (test-equal 'none (config-ref cfg 'missing 'none)))\n  (test-error (read-config (tmp-file \"b.scm\" \"(display 1)\"))))\n\n(test-group \"the example config reads\"\n  (let ((cfg (read-config (string-append root \"/config.example.scm\"))))\n    (test-equal 8070 (config-ref cfg 'http-port 0))\n    (test-equal \"\" (config-ref cfg 'url-prefix #f))))\n\n(test-group \"create-config!\"\n  (let ((ex (tmp-file \"example.scm\" \"(define secret \\\"REPLACE_WITH_BASE64_SECRET\\\")\"))\n        (target (string-append tmp \"/config.scm\")))\n    (create-config! ex target)\n    (let ((s (config-ref (read-config target) 'secret #f)))\n      (test-assert \"secret replaced\" (not (string=? s \"REPLACE_WITH_BASE64_SECRET\")))\n      (test-equal 44 (string-length s)))\n    (test-error \"no overwrite\" (create-config! ex target))\n    (delete-file target)\n    (delete-file ex)))\n\n(test-group \"load-config creates config.scm on the first run\"\n  (let ((app (string-append tmp \"/app\")))\n    (make-directory app)\n    (call-with-output-file (string-append app \"/config.example.scm\")\n      (lambda (p) (write-string \"(define http-port 1234)\" p)))\n    (test-equal 1234\n      (config-ref (load-config app '()) 'http-port 0))\n    (test-assert (file-exists? (string-append app \"/config.scm\")))\n    (delete-file (string-append app \"/config.scm\"))\n    (delete-file (string-append app \"/config.example.scm\"))\n    (delete-directory app)))\n\n(test-group \"resolve-path\"\n  (test-equal \"/etc/x\" (resolve-path \"/app\" \"/etc/x\"))\n  (test-equal \"/app/data/x\" (resolve-path \"/app\" \"data/x\")))\n\n(delete-file (string-append tmp \"/a.scm\"))\n(delete-file (string-append tmp \"/b.scm\"))\n(delete-directory tmp)\n\n(test-end \"starter-public config\")\n")
         ("tests/test_pure_web.scm" . ";; Tests for (app web): requests go straight to the handler from make-app,\n;; no server or socket. Run: scm tests/test_pure_web.scm\n\n(import (scheme base)\n        (scheme file)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm log)\n        (scm string)\n        (scm test)\n        (scm net http request)\n        (scm net http response))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app web))\n\n(test-runner-factory scm-test-runner)\n(test-begin \"starter-public web\")\n\n(define tmp (mktempdir '(prefix . \"starter-public-test\")))\n(define data-file (string-append tmp \"/items.json\"))\n(call-with-output-file data-file\n  (lambda (p)\n    (write-string \"[{\\\"name\\\": \\\"<script>x</script>\\\", \\\"count\\\": 3}]\" p)))\n\n(define (app-with prefix file)\n  (make-app `((url-prefix . ,prefix)\n              (static-dir . ,(string-append root \"/static\"))\n              (data-file . ,file))))\n\n;; Requests are logged to the log port; keep the test output clean.\n(define (get app url)\n  (parameterize ((log-port (open-output-string)))\n    (app (make-http-request \"GET\" url '() #f))))\n\n(define (body resp)\n  (let ((b (http-response-body resp)))\n    (if (bytevector? b) (utf8->string b) b)))\n\n(define (has? s part) (and (string-contains-from s part 0) #t))\n\n(define app (app-with \"\" data-file))\n\n(test-group \"home page\"\n  (let ((r (get app \"/\")))\n    (test-equal 200 (http-response-status r))\n    (test-assert \"data is escaped\" (has? (body r) \"&lt;script&gt;x&lt;/script&gt;\"))\n    (test-assert \"lang\" (has? (body r) \"<html lang=\\\"en\\\">\"))\n    (test-assert \"versioned stylesheet\" (has? (body r) \"/static/css/app.css?v=\"))\n    (test-assert \"security headers\"\n      (has? (http-response-header r \"Content-Security-Policy\") \"script-src 'self'\"))))\n\n(test-group \"strict CSP holds\"\n  ;; Every <script> must load a file and no element may carry style=\"\".\n  (let ((html (body (get app \"/\"))))\n    (test-assert \"no inline script\" (not (has? html \"<script>\")))\n    (test-assert \"no style attribute\" (not (has? html \" style=\")))))\n\n(test-group \"static and health\"\n  (let ((r (get app \"/static/css/app.css\")))\n    (test-equal 200 (http-response-status r))\n    (test-equal \"text/css; charset=utf-8\" (http-response-header r \"Content-Type\")))\n  (test-equal 404 (http-response-status (get app \"/static/../config.example.scm\")))\n  (test-equal 404 (http-response-status (get app \"/nope\")))\n  (test-equal \"ok\\n\" (body (get app \"/healthz\"))))\n\n(test-group \"url prefix\"\n  (let ((app (app-with \"/inventory/\" data-file)))\n    (test-equal 200 (http-response-status (get app \"/inventory/\")))\n    (test-equal 200 (http-response-status (get app \"/inventory\")))\n    (test-equal 404 (http-response-status (get app \"/\")))\n    (test-assert (has? (body (get app \"/inventory/\")) \"href=\\\"/inventory/static/css/app.css?v=\"))\n    (test-equal 200 (http-response-status (get app \"/inventory/static/js/theme-init.js\")))\n    (test-equal \"ok\\n\" (body (get app \"/healthz\")))))\n\n(test-group \"errors are logged, not shown\"\n  (let* ((app (app-with \"\" (string-append tmp \"/missing.json\")))\n         (log (open-output-string))\n         (r (parameterize ((log-port log))\n              (app (make-http-request \"GET\" \"/\" '() #f)))))\n    (test-equal 500 (http-response-status r))\n    (test-assert \"error page\" (has? (body r) \"Something went wrong\"))\n    (test-assert \"no detail in page\" (not (has? (body r) \"missing.json\")))\n    (test-assert \"detail in log\" (has? (get-output-string log) \"ERROR [http] GET /\"))\n    (test-assert \"access log\" (has? (get-output-string log) \"GET / -> 500\"))))\n\n(delete-file data-file)\n(delete-directory tmp)\n\n(test-end \"starter-public web\")\n"))
        ("starter-login"
         (".gitignore" . "# Local config (holds the session secret) and the user store.\nconfig.scm\ndata/users.scm\ndata/users.scm.tmp\n")
         ("README.md" . "# starter-login\n\nA web app **with sign-in**. Everything in `starter-public` plus a login page,\nsessions, and a profile page where the signed-in user can change their\npassword or sign out. Users are managed with a CLI; there is no public\nsign-up.\n\nUse it as a starting point for a small private app: an internal dashboard, a\nsingle-team tool, anything behind a login but without per-user roles (for\nroles and user management in the browser, see `starter-admin`).\n\n## What it demonstrates\n\n- **Password hashing** with `(scm crypto password)`: PBKDF2-SHA256, 600 000\n  iterations, random salt, constant-time check. Signing in with an unknown\n  username takes as long as with a wrong password, and older, weaker hashes\n  are upgraded at the next sign-in (`src/app-auth.sld`).\n- **Stateless sessions** with `(scm net http session)`: a signed cookie, no\n  server-side store. The cookie is `HttpOnly`, `SameSite=Strict`, `Secure` in\n  production, and scoped to the URL prefix.\n- **Sessions that end when they should**: every request looks the user up\n  again, and the cookie carries a stamp of the password hash, so deleting a\n  user or changing a password ends their other sessions.\n- **No CSRF tokens needed**: `SameSite=Strict` keeps the browser from sending\n  the session cookie with a form another site submits.\n- A **file-backed user store** (`users.scm` in `data-dir`, a plain Scheme\n  datum) written atomically, by the CLI and the password-change handler.\n- Failed sign-ins are slowed down and get one generic error message.\n- From `starter-public`: the middleware stack (access log, strict CSP and\n  other security headers, logged 500s), cache-busted static files,\n  `light-dark()` theming without inline JavaScript, the URL prefix, the\n  config created on the first run, and tests without a server.\n\n## Layout\n\n```\nbin/server.scm        load the config, serve the app\nbin/dev-server.scm    auto-reloading dev supervisor\nbin/user.scm          add / passwd / delete / list users (CLI)\nbin/init-config.scm   write a new config file (used by deploy/install.sh)\nbin/gen-secret.scm    print a new session secret (for key rotation)\nsrc/app-config.sld    config reading and first-run creation\nsrc/app-site.sld      URL prefix: url, asset, cookie-path\nsrc/app-users.sld     the user store\nsrc/app-auth.sld      sign-in, sessions, password changes\nsrc/app-views.sld     HTML rendering\nsrc/app-web.sld       routes and middleware: make-app\nconfig.example.scm    the config template, with every setting\ndata/items.json       sample data shown after sign-in\nstatic/               CSS, theme scripts, favicon\ntests/                test_pure_*.scm, run without a server\ndeploy/               systemd units, health probe, nginx example, install script\n```\n\n## Run\n\n```sh\nscm bin/user.scm add alice       # prompts for a password (at least 8 characters)\nscm bin/server.scm               # http://127.0.0.1:8071\nscm bin/dev-server.scm           # same, restarts when src/ or the config changes\n```\n\nThe first run of either creates `config.scm` from `config.example.scm`, with\na fresh random `session-secret`. Then open the site, sign in as `alice`, and\ntry the Profile page.\n\n## Test\n\n```sh\nfor t in tests/test_*.scm; do scm \"$t\" || exit 1; done\n```\n\n## Adapt\n\n- Add pages in `make-app` (`src/app-web.sld`) with `route!`, which adds the\n  URL prefix. Wrap a handler in `signed-in` to require a session; it then\n  receives the user entry as a third argument.\n- Build links and redirects with `url` and asset links with `asset`.\n- The user store is deliberately simple; swap `src/app-users.sld` for a\n  database module when you outgrow a flat file (see `starter-admin`).\n- To rotate the session secret, make `session-secret` a list with a new key\n  (`scm bin/gen-secret.scm`) first; drop the old key once its sessions have\n  expired.\n\n## Deploy\n\nThe app binds loopback only; put a TLS-terminating reverse proxy in front\n(`deploy/nginx.conf.example`). Then, on the server, from the app directory:\n\n```sh\nsudo deploy/install.sh               # SCM=/path/to/scm if not /usr/local/bin/scm\nsudo -u starter-login /usr/local/bin/scm /opt/starter-login/bin/user.scm \\\n     --config /etc/starter-login/config.scm add alice\n```\n\nThis copies the app to `/opt/starter-login` and creates\n`/etc/starter-login/config.scm` on the first install, with a fresh secret,\n`secure-cookies?` on, and the user store in `/var/lib/starter-login`. It adds\na `starter-login` system user and enables the service (`Restart=always`,\nread-only file system except its state directory), a per-minute health probe\nthat restarts the app if `/healthz` fails twice, and a daily 04:00 restart.\nRerun it to deploy a new version; the config and users are kept.\n")
         ("config.example.scm" . ";; starter-login configuration: a list of (define name value) forms, read\n;; as data by src/app-config.sld. bin/server.scm reads config.scm; the first\n;; run creates it from this file, with a fresh session-secret.\n\n;; Bind loopback only; a reverse proxy (deploy/nginx.conf.example) fronts\n;; the public interface and terminates TLS.\n(define http-host \"127.0.0.1\")\n(define http-port 8071)\n\n;; Path the app is mounted under, e.g. \"/team\"; \"\" for the host root. The\n;; reverse proxy must pass paths through unchanged.\n(define url-prefix \"\")\n\n;; Signs the session cookies (base64 of 32 random bytes). To rotate it,\n;; list the new key first: (\"new\" \"old\"); sessions signed with the old key\n;; stay valid until you remove it. bin/gen-secret.scm prints a new key.\n(define session-secret \"REPLACE_WITH_BASE64_SECRET\")\n(define session-max-age (* 60 60 24 7))   ; 7 days\n\n;; Cookies are sent over HTTPS only when #t. Keep #f for http://127.0.0.1\n;; during development; deploy/install.sh sets #t.\n(define secure-cookies? #f)\n\n;; Relative paths are relative to the app directory. data-dir holds the\n;; user store (users.scm) and must be writable.\n(define static-dir \"static\")\n(define items-file \"data/items.json\")\n(define data-dir \"data\")\n")
         ("bin/dev-server.scm" . ";; Development supervisor: restarts bin/server.scm whenever a watched file\n;; changes (all .sld under src/, bin/server.scm, and the config file), and\n;; auto-retries on a backoff if it exits on its own.\n;;\n;; Usage: scm bin/dev-server.scm\n\n(import (scheme base)\n        (scheme process-context)\n        (scm fs)\n        (scm reloader))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n\n(define (watched)\n  (append (files-with-suffix (string-append root \"/src\") \".sld\")\n          (list (string-append root \"/bin/server.scm\")\n                (string-append root \"/config.scm\"))))\n\n(supervise (list \"scm\" (string-append root \"/bin/server.scm\"))\n           watched\n           `((label . \"starter-login\")\n             (work-dir . ,root)\n             (root . ,root)))\n")
         ("bin/gen-secret.scm" . ";; Usage: scm bin/gen-secret.scm\n;;\n;; Prints a fresh base64 secret (32 random bytes) for session-secret.\n\n(import (scheme base)\n        (scheme write)\n        (scm crypto))\n\n(display (base64-encode (random-bytes 32)))\n(newline)\n")
         ("bin/init-config.scm" . ";; Usage: scm bin/init-config.scm <target>\n;;\n;; Writes a new config file at target from config.example.scm. Used by\n;; deploy/install.sh; refuses to overwrite an existing file.\n\n(import (scheme base)\n        (scheme write)\n        (scheme process-context)\n        (scm module)\n        (scm fs))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config))\n\n(define args (cdr (command-line)))\n(when (null? args)\n  (display \"usage: scm bin/init-config.scm <target>\\n\")\n  (exit 1))\n\n(create-config! (string-append root \"/config.example.scm\") (car args))\n(display (string-append \"created \" (car args) \"\\n\"))\n")
         ("bin/server.scm" . ";; Usage: scm bin/server.scm [config-path]\n;;\n;; Reads the config (config-path, or else config.scm, which the first run\n;; creates from config.example.scm with a fresh secret) and serves the app.\n\n(import (scheme base)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm log)\n        (scm net http server))\n\n;; Resolve the project root from this script's path so it runs from anywhere,\n;; and make src/ importable.\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config) (app web))\n\n(define cfg (load-config root (cdr (command-line))))\n(define host (config-ref cfg 'http-host \"127.0.0.1\"))\n(define port (config-ref cfg 'http-port 8071))\n(define prefix (config-ref cfg 'url-prefix \"\"))\n(define (path key default) (resolve-path root (config-ref cfg key default)))\n\n(define app\n  (make-app\n   `((url-prefix      . ,prefix)\n     (static-dir      . ,(path 'static-dir \"static\"))\n     (items-file      . ,(path 'items-file \"data/items.json\"))\n     (users-file      . ,(string-append (path 'data-dir \"data\") \"/users.scm\"))\n     (session-secret  . ,(config-secret cfg 'session-secret))\n     (session-max-age . ,(config-ref cfg 'session-max-age (* 60 60 24 7)))\n     (secure-cookies? . ,(config-ref cfg 'secure-cookies? #t)))))\n\n(log-info \"app\" (string-append \"starter-login listening on http://\" host \":\"\n                               (number->string port) prefix \"/\"))\n(serve-forever port app 0 host)\n")
         ("bin/user.scm" . ";; Usage: scm bin/user.scm [--config path] add <username>\n;;        scm bin/user.scm [--config path] passwd <username>\n;;        scm bin/user.scm [--config path] delete <username>\n;;        scm bin/user.scm [--config path] list\n;;\n;; Manages the user store. There is no sign-up page: users exist only once\n;; added here. Passwords are prompted for twice and read without echo.\n;; Changing or deleting a user ends their sessions.\n\n(import (scheme base)\n        (scheme write)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm terminal))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (scm crypto password) (app config) (app users) (app auth))\n\n(define (fail msg) (display msg (current-error-port)) (newline (current-error-port)) (exit 1))\n\n(define usage\n  \"usage: scm bin/user.scm [--config path] add|passwd|delete <username> | list\")\n\n(define args (cdr (command-line)))\n(define config-args\n  (if (and (pair? args) (string=? (car args) \"--config\") (pair? (cdr args)))\n      (list (cadr args))\n      '()))\n(define command-args (if (null? config-args) args (cddr args)))\n\n(define cfg (load-config root config-args))\n(define users-file\n  (string-append (resolve-path root (config-ref cfg 'data-dir \"data\")) \"/users.scm\"))\n\n(define (ask-new-password)\n  (let* ((a (read-password \"Password: \"))\n         (b (if (eof-object? a) a (read-password \"Confirm:  \"))))\n    (cond ((or (eof-object? a) (eof-object? b)) (fail \"aborted\"))\n          ((not (string=? a b)) (fail \"passwords do not match\"))\n          ((< (string-length a) min-password-length)\n           (fail \"password must be at least 8 characters\"))\n          (else a))))\n\n(define (the-name)\n  (if (and (pair? (cdr command-args)) (null? (cddr command-args)))\n      (cadr command-args)\n      (fail usage)))\n\n(if (null? command-args)\n    (fail usage)\n    (let ((cmd (car command-args)))\n      (cond\n        ((string=? cmd \"add\")\n         (let ((name (the-name)))\n           (unless (valid-username? name)\n             (fail \"invalid username (letters, digits, . _ -; at most 64)\"))\n           (when (find-user users-file name)\n             (fail (string-append \"user exists: \" name \" (use passwd)\")))\n           (save-user! users-file name (password-hash (ask-new-password)))\n           (display (string-append \"added \" name \"\\n\"))))\n        ((string=? cmd \"passwd\")\n         (let ((name (the-name)))\n           (unless (find-user users-file name) (fail (string-append \"no such user: \" name)))\n           (save-user! users-file name (password-hash (ask-new-password)))\n           (display (string-append \"password changed for \" name \"\\n\"))))\n        ((string=? cmd \"delete\")\n         (let ((name (the-name)))\n           (unless (find-user users-file name) (fail (string-append \"no such user: \" name)))\n           (delete-user! users-file name)\n           (display (string-append \"deleted \" name \"\\n\"))))\n        ((string=? cmd \"list\")\n         (for-each (lambda (u) (display (user-name u)) (newline))\n                   (load-users users-file)))\n        (else (fail usage)))))\n")
         ("data/items.json" . "[\n  { \"name\": \"Widgets\",   \"count\": 42 },\n  { \"name\": \"Gadgets\",   \"count\": 17 },\n  { \"name\": \"Sprockets\", \"count\": 88 },\n  { \"name\": \"Cogs\",      \"count\": 5  },\n  { \"name\": \"Flanges\",   \"count\": 23 }\n]\n")
         ("deploy/healthcheck.sh" . "#!/bin/sh\n# Health probe for starter-login, run every minute by\n# starter-login-health.service: GET /healthz on the host/port from the\n# config. Two strikes: on failure wait 5s and probe again; only then restart\n# the unit, so one slow request cannot bounce the daemon.\n#\n# Usage: healthcheck.sh <config.scm> <unit>\nconf=$1\nunit=$2\n\n# The string or number of a (define name value) line in the config.\nvalue() {\n  sed -n \"s/^[[:space:]]*(define[[:space:]][[:space:]]*$1[[:space:]][[:space:]]*\\\"\\{0,1\\}\\([^\\\" )]*\\).*/\\1/p\" \"$conf\" | head -n 1\n}\n\nport=$(value http-port)\nhost=$(value http-host)\ncase \"$host\" in ''|0.0.0.0|::) host=127.0.0.1 ;; esac\nurl=\"http://$host:${port:-8071}/healthz\"\n\nprobe() { curl -fsS --max-time 5 \"$url\" >/dev/null; }\n\nif ! probe; then\n  sleep 5\n  if ! probe; then\n    echo \"$unit: $url failed twice; restarting\"\n    systemctl restart \"$unit\"\n  fi\nfi\n")
         ("deploy/install.sh" . "#!/bin/sh\n# Installs starter-login as a systemd service. Run as root on the target\n# host from the app directory: sudo deploy/install.sh. Idempotent: rerun it\n# to deploy a new version (the config in /etc is kept).\n#\n#   /opt/starter-login               the app (replaced on each install)\n#   /etc/starter-login/config.scm    the config (created once, then yours)\n#   /var/lib/starter-login            the user store (systemd StateDirectory)\n#\n# The service runs as the system user starter-login. Set SCM to the scm\n# launcher if it is not /usr/local/bin/scm.\nset -eu\n\nAPP=starter-login\nSCM=${SCM:-/usr/local/bin/scm}\nSRC=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n\nid -u \"$APP\" >/dev/null 2>&1 ||\n  useradd --system --home-dir /nonexistent --no-create-home \\\n          --shell /usr/sbin/nologin \"$APP\"\n\n# The app: code, static files and data, owned by root, readable by all.\nrm -rf \"/opt/$APP.new\"\nmkdir -p \"/opt/$APP.new\"\nmkdir -p \"/opt/$APP.new/data\"\ncp -r \"$SRC/bin\" \"$SRC/src\" \"$SRC/static\" \"$SRC/deploy\" \\\n      \"$SRC/config.example.scm\" \"/opt/$APP.new/\"\ncp \"$SRC/data/items.json\" \"/opt/$APP.new/data/\"\nrm -rf \"/opt/$APP\"\nmv \"/opt/$APP.new\" \"/opt/$APP\"\n\n# The config: created from config.example.scm on the first install only,\n# with a fresh session secret, HTTPS-only cookies and the user store in\n# /var/lib.\nmkdir -p \"/etc/$APP\"\nif [ ! -f \"/etc/$APP/config.scm\" ]; then\n  \"$SCM\" \"/opt/$APP/bin/init-config.scm\" \"/etc/$APP/config.scm\"\n  sed -i -e 's|^(define secure-cookies? #f)|(define secure-cookies? #t)|' \\\n         -e \"s|^(define data-dir \\\"data\\\")|(define data-dir \\\"/var/lib/$APP\\\")|\" \\\n         \"/etc/$APP/config.scm\"\nfi\nchown root:\"$APP\" \"/etc/$APP/config.scm\"\nchmod 640 \"/etc/$APP/config.scm\"\n\nfor unit in \"$APP.service\" \\\n            \"$APP-health.service\" \"$APP-health.timer\" \\\n            \"$APP-restart.service\" \"$APP-restart.timer\"; do\n  sed \"s|/usr/local/bin/scm|$SCM|\" \"$SRC/deploy/systemd/$unit\" \\\n    > \"/etc/systemd/system/$unit\"\ndone\n\nsystemctl daemon-reload\nsystemctl enable \"$APP.service\" \"$APP-health.timer\" \"$APP-restart.timer\"\nsystemctl restart \"$APP.service\"\nsystemctl start \"$APP-health.timer\" \"$APP-restart.timer\"\n\necho \"Installed. Config: /etc/$APP/config.scm. Logs: journalctl -u $APP -f\"\necho \"Add a user: sudo -u $APP $SCM /opt/$APP/bin/user.scm --config /etc/$APP/config.scm add <name>\"\n")
         ("deploy/nginx.conf.example" . "# Reverse proxy in front of starter-login. The app binds 127.0.0.1 only;\n# nginx terminates TLS on the public interface and forwards to it.\n\nupstream starter_login_backend {\n    server 127.0.0.1:8071;\n    keepalive 16;\n}\n\nserver {\n    listen 443 ssl;\n    http2 on;\n    server_name example.com;\n\n    # ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;\n    # ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;\n\n    # At the host root. To mount the app under a path instead, set\n    # (define url-prefix \"/team\") in the config and use\n    # \"location /team/\" here. proxy_pass without a URI part passes\n    # the path through unchanged, which is what the app expects.\n    location / {\n        proxy_pass         http://starter_login_backend;\n        proxy_http_version 1.1;\n        proxy_set_header   Connection        \"\";\n        proxy_set_header   Host              $host;\n        proxy_set_header   X-Real-IP         $remote_addr;\n        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;\n        proxy_set_header   X-Forwarded-Proto $scheme;\n        proxy_read_timeout 30s;\n    }\n}\n")
         ("deploy/systemd/starter-login-health.service" . "[Unit]\nDescription=starter-login health probe (restarts the app if /healthz fails)\nAfter=starter-login.service\n\n[Service]\nType=oneshot\nExecCondition=/usr/bin/systemctl is-active --quiet starter-login.service\n# Host/port come from the config; two strikes before a restart.\nExecStart=/opt/starter-login/deploy/healthcheck.sh /etc/starter-login/config.scm starter-login.service\n")
         ("deploy/systemd/starter-login-health.timer" . "[Unit]\nDescription=Run the starter-login health probe every minute\n\n[Timer]\nOnBootSec=60s\nOnUnitActiveSec=60s\nAccuracySec=15s\nUnit=starter-login-health.service\n\n[Install]\nWantedBy=timers.target\n")
         ("deploy/systemd/starter-login-restart.service" . "[Unit]\nDescription=Daily restart of starter-login (clears slow leaks, picks up config)\n\n[Service]\nType=oneshot\nExecStart=/bin/systemctl try-restart starter-login.service\n")
         ("deploy/systemd/starter-login-restart.timer" . "[Unit]\nDescription=Daily restart of starter-login at 04:00\n\n[Timer]\nOnCalendar=*-*-* 04:00:00\nPersistent=true\nRandomizedDelaySec=2m\nUnit=starter-login-restart.service\n\n[Install]\nWantedBy=timers.target\n")
         ("deploy/systemd/starter-login.service" . "[Unit]\nDescription=starter-login scheme webapp\nAfter=network-online.target\nWants=network-online.target\n# Allow a few quick restarts, but if we crash-loop more than 5 times in\n# 60s, give up rather than burn CPU.\nStartLimitIntervalSec=60\nStartLimitBurst=5\n\n[Service]\nType=simple\nUser=starter-login\nGroup=starter-login\nWorkingDirectory=/opt/starter-login\n# deploy/install.sh replaces the scm path with $SCM.\nExecStart=/usr/local/bin/scm bin/server.scm /etc/starter-login/config.scm\n\n# Restart on any exit. Combined with the daily restart timer this makes\n# the service self-healing across OOMs and unexpected exceptions.\nRestart=always\nRestartSec=3s\n# The JVM exits with 128+SIGTERM on a normal stop.\nSuccessExitStatus=143\n# Give the HTTP server (10s graceful drain by default) time to finish.\nTimeoutStopSec=15s\n\n# Logs go to journald: journalctl -u starter-login -f\nStandardOutput=journal\nStandardError=journal\n\n# The user store: /var/lib/starter-login, created and owned by the\n# service user. The rest of the file system is read-only for the app.\nStateDirectory=starter-login\nStateDirectoryMode=0700\n\n# --- hardening ---\nNoNewPrivileges=yes\nPrivateTmp=yes\nProtectSystem=strict\nProtectHome=yes\n\n[Install]\nWantedBy=multi-user.target\n")
         ("src/app-auth.sld" . ";; (app auth) — sign-in, sessions and password changes.\n;;\n;; Passwords are hashed with (scm crypto password): PBKDF2-SHA256 with a\n;; random salt, verified in constant time. A sign-in with an unknown username\n;; does the same hashing work as one with a wrong password, so response\n;; times do not reveal which usernames exist. Hashes made with fewer\n;; iterations than the current default are upgraded at the next sign-in.\n;;\n;; Sessions are signed cookies from (scm net http session): no server-side\n;; store. The cookie carries the username and a stamp derived from the\n;; password hash, and every request looks the user up again: deleting a\n;; user or changing a password ends that user's other sessions.\n\n(define-library (app auth)\n  (import (scheme base)\n          (scm crypto)\n          (scm crypto password)\n          (scm net http session)\n          (app users))\n  (export make-auth\n          sign-in\n          session-user\n          start-session\n          end-session\n          change-password!\n          min-password-length)\n  (begin\n\n    (define min-password-length 8)\n\n    (define-record-type auth\n      (%make-auth session users-file)\n      auth?\n      (session auth-session)\n      (users-file auth-users-file))\n\n    (define (make-auth session-config users-file)\n      \"Syntax: (make-auth session-config users-file)\nLibrary: (app auth)\nDescription: Ties a (scm net http session) config to the user store.\"\n      (%make-auth session-config users-file))\n\n    ;; Changes whenever the password (and so the hash) changes.\n    (define (password-stamp hash)\n      (base64-encode (bytevector-copy (sha256-hash (string->utf8 hash)) 0 12)))\n\n    (define (sign-in auth username password)\n      \"Syntax: (sign-in auth username password)\nLibrary: (app auth)\nDescription: The user entry if password is right for username, else #f.\n  Upgrades an outdated password hash on success.\"\n      (let* ((path (auth-users-file auth))\n             (user (find-user path username)))\n        (cond\n          ((not (password-verify password (and user (user-hash user)))) #f)\n          ((password-needs-rehash? (user-hash user))\n           (save-user! path username (password-hash password))\n           (find-user path username))\n          (else user))))\n\n    (define (session-user auth req)\n      \"Syntax: (session-user auth req)\nLibrary: (app auth)\nDescription: The signed-in user's entry, or #f if there is no valid session\n  or the user was deleted or changed the password since.\"\n      (let ((s (session-ref (auth-session auth) req)))\n        (and (pair? s)\n             (let* ((name (assq 'user s))\n                    (stamp (assq 'stamp s))\n                    (user (and name (string? (cdr name))\n                               (find-user (auth-users-file auth) (cdr name)))))\n               (and user stamp\n                    (equal? (cdr stamp) (password-stamp (user-hash user)))\n                    user)))))\n\n    (define (start-session auth user)\n      \"Syntax: (start-session auth user)\nLibrary: (app auth)\nDescription: The Set-Cookie header pair that signs user in.\"\n      (session-set-cookie (auth-session auth)\n                          `((user . ,(user-name user))\n                            (stamp . ,(password-stamp (user-hash user))))))\n\n    (define (end-session auth)\n      \"Syntax: (end-session auth)\nLibrary: (app auth)\nDescription: The Set-Cookie header pair that signs out.\"\n      (session-clear-cookie (auth-session auth)))\n\n    (define (change-password! auth user new-password)\n      \"Syntax: (change-password! auth user new-password)\nLibrary: (app auth)\nDescription: Stores a new hash for user and returns the updated entry.\n  Other sessions of the user end; start a new one for this browser.\"\n      (save-user! (auth-users-file auth) (user-name user) (password-hash new-password))\n      (find-user (auth-users-file auth) (user-name user)))))\n")
         ("src/app-config.sld" . ";; (app config) — reads config.scm and creates it on the first run.\n;;\n;; The config file is a list of (define name expression) forms. It is read\n;; as data, not loaded: each expression is evaluated on its own in a\n;; (scheme base) environment, so (* 60 60 24 7) works but the file cannot\n;; reach into the app. The result is an alist, read with config-ref.\n\n(define-library (app config)\n  (import (scheme base)\n          (scheme eval)\n          (scheme file)\n          (scheme read)\n          (scheme write)\n          (scm crypto)\n          (scm fs)\n          (scm io)\n          (scm string))\n  (export load-config\n          read-config\n          create-config!\n          config-ref\n          config-secret\n          resolve-path)\n  (begin\n\n    ;; config.example.scm carries this placeholder where a secret belongs;\n    ;; create-config! replaces it with a fresh random key.\n    (define secret-placeholder \"REPLACE_WITH_BASE64_SECRET\")\n\n    (define (read-config path)\n      \"Syntax: (read-config path)\nLibrary: (app config)\nDescription: Reads the (define name expression) forms in path and returns\n  an alist of (name . value). Any other form is an error.\"\n      (let ((env (environment '(scheme base))))\n        (call-with-input-file path\n          (lambda (port)\n            (let loop ((acc '()))\n              (let ((form (read port)))\n                (cond\n                  ((eof-object? form) (reverse acc))\n                  ((and (pair? form) (eq? (car form) 'define)\n                        (pair? (cdr form)) (symbol? (cadr form))\n                        (pair? (cddr form)) (null? (cdddr form)))\n                   (loop (cons (cons (cadr form) (eval (caddr form) env)) acc)))\n                  (else (error \"config: expected (define name value)\" form)))))))))\n\n    (define (create-config! example target)\n      \"Syntax: (create-config! example target)\nLibrary: (app config)\nDescription: Writes target as a copy of example, with each secret\n  placeholder replaced by a fresh base64 key, readable by the owner only.\n  Refuses to overwrite an existing file.\"\n      (when (file-exists? target)\n        (error \"config already exists\" target))\n      (let ((text (string-replace-all (read-file-string example)\n                                      secret-placeholder\n                                      (base64-encode (random-bytes 32)))))\n        (call-with-output-file target\n          (lambda (p) (write-string text p)))\n        (chmod target \"600\")))\n\n    (define (load-config root args)\n      \"Syntax: (load-config root args)\nLibrary: (app config)\nDescription: Reads the config named by the first command-line argument in\n  args, or else root/config.scm. On the first run, when root/config.scm\n  does not exist yet, it is created from config.example.scm.\"\n      (if (pair? args)\n          (read-config (car args))\n          (let ((path (string-append root \"/config.scm\")))\n            (unless (file-exists? path)\n              (create-config! (string-append root \"/config.example.scm\") path)\n              (display (string-append \"created \" path \"\\n\") (current-error-port)))\n            (read-config path))))\n\n    (define (config-ref cfg name default)\n      \"Syntax: (config-ref cfg name default)\nLibrary: (app config)\nDescription: The value of name in cfg, or default if the file has none.\"\n      (let ((p (assq name cfg)))\n        (if p (cdr p) default)))\n\n    (define (config-secret cfg name)\n      \"Syntax: (config-secret cfg name)\nLibrary: (app config)\nDescription: The secret stored under name: a base64 string, or a list of\n  them (newest first) while rotating keys. Raises if it is missing or still\n  the placeholder from config.example.scm.\"\n      (let* ((s (config-ref cfg name #f))\n             (keys (if (string? s) (list s) s)))\n        (unless (and (pair? keys)\n                     (let loop ((ks keys))\n                       (or (null? ks)\n                           (and (string? (car ks))\n                                (not (string=? (car ks) secret-placeholder))\n                                (loop (cdr ks))))))\n          (error \"config: set a secret (scm bin/gen-secret.scm prints one)\" name))\n        s))\n\n    (define (resolve-path root path)\n      \"Syntax: (resolve-path root path)\nLibrary: (app config)\nDescription: path itself if absolute, else path relative to root.\"\n      (if (and (> (string-length path) 0) (char=? (string-ref path 0) #\\/))\n          path\n          (string-append root \"/\" path)))))\n")
         ("src/app-site.sld" . ";; (app site) — the URL prefix and asset URLs.\n;;\n;; The app can be mounted under a path (\"/team\"), with the reverse proxy\n;; passing paths through unchanged. Every route, link and redirect goes\n;; through url, and static files through asset. make-app in (app web) makes\n;; its site current for each request with with-site.\n\n(define-library (app site)\n  (import (scheme base)\n          (scm net http static))\n  (export make-site\n          site-prefix\n          with-site\n          url\n          asset\n          cookie-path)\n  (begin\n\n    (define-record-type site\n      (%make-site prefix static-url)\n      site?\n      (prefix site-prefix)\n      (static-url site-static-url))\n\n    (define current-site (make-parameter #f))\n\n    ;; \"\" or \"/\" -> \"\"; \"team/\" -> \"/team\"\n    (define (normalize-prefix p)\n      (let* ((s (if (and (> (string-length p) 0) (char=? (string-ref p 0) #\\/))\n                    p\n                    (string-append \"/\" p)))\n             (n (string-length s)))\n        (if (char=? (string-ref s (- n 1)) #\\/)\n            (substring s 0 (- n 1))\n            s)))\n\n    (define (make-site prefix static-dir)\n      \"Syntax: (make-site prefix static-dir)\nLibrary: (app site)\nDescription: A site mounted at prefix (\\\"\\\" for the host root) that serves\n  static-dir under prefix/static.\"\n      (let ((p (normalize-prefix prefix)))\n        (%make-site p (make-static-url static-dir (string-append p \"/static\")))))\n\n    (define (with-site site handler)\n      \"Syntax: (with-site site handler)\nLibrary: (app site)\nDescription: Wraps handler so url and asset refer to site while it runs.\"\n      (lambda (req)\n        (parameterize ((current-site site))\n          (handler req))))\n\n    (define (url path)\n      \"Syntax: (url path)\nLibrary: (app site)\nDescription: path under the current site's prefix: (url \\\"/login\\\").\"\n      (string-append (site-prefix (current-site)) path))\n\n    (define (asset rel)\n      \"Syntax: (asset rel)\nLibrary: (app site)\nDescription: The URL of static/rel with a ?v=<mtime> cache buster.\"\n      ((site-static-url (current-site)) rel))\n\n    (define (cookie-path site)\n      \"Syntax: (cookie-path site)\nLibrary: (app site)\nDescription: The cookie Path for site: \\\"/\\\", or \\\"/prefix/\\\" so that the\n  session cookie stays with this app when several share a host.\"\n      (string-append (site-prefix site) \"/\"))))\n")
         ("src/app-users.sld" . ";; (app users) — the user store, a plain Scheme data file.\n;;\n;; users.scm holds one datum: a list of (username hash created) entries. It\n;; is written by the CLI (bin/user.scm) and by the app (password changes,\n;; hash upgrades), never by hand. Writes go through a temp file + rename so\n;; a reader never sees a half-written file, and a mutex serializes the\n;; app's own writes. (The CLI is a separate process; the last write wins.)\n;;\n;; This module is storage only; passwords and sessions live in (app auth).\n\n(define-library (app users)\n  (import (scheme base)\n          (scheme char)\n          (scheme file)\n          (scheme read)\n          (scheme time)\n          (scheme write)\n          (scm fs)\n          (srfi 18))\n  (export load-users\n          find-user\n          user-name\n          user-hash\n          user-created\n          save-user!\n          delete-user!\n          valid-username?)\n  (begin\n\n    (define (user-name u) (car u))\n    (define (user-hash u) (cadr u))\n    (define (user-created u) (caddr u))\n\n    (define (load-users path)\n      \"Syntax: (load-users path)\nLibrary: (app users)\nDescription: The list of (username hash created) entries in path, or '()\n  if the file does not exist yet.\"\n      (if (file-exists? path)\n          (let ((datum (call-with-input-file path read)))\n            (if (eof-object? datum) '() datum))\n          '()))\n\n    (define (find-user path name)\n      \"Syntax: (find-user path name)\nLibrary: (app users)\nDescription: The (username hash created) entry for name, or #f.\"\n      (assoc name (load-users path)))\n\n    (define write-lock (make-mutex))\n\n    (define (update-users! path proc)\n      (dynamic-wind\n        (lambda () (mutex-lock! write-lock))\n        (lambda ()\n          (let ((dir (directory-name path))\n                (tmp (string-append path \".tmp\")))\n            (unless (directory-exists? dir) (make-directory dir))\n            (call-with-output-file tmp\n              (lambda (p) (write (proc (load-users path)) p) (newline p)))\n            (move-file tmp path)))\n        (lambda () (mutex-unlock! write-lock))))\n\n    (define (save-user! path name hash)\n      \"Syntax: (save-user! path name hash)\nLibrary: (app users)\nDescription: Stores hash for name: replaces the entry (keeping its created\n  time) or appends a new one.\"\n      (update-users! path\n        (lambda (users)\n          (let loop ((us users))\n            (cond\n              ((null? us)\n               (list (list name hash (exact (floor (current-second))))))\n              ((string=? (user-name (car us)) name)\n               (cons (list name hash (user-created (car us))) (cdr us)))\n              (else (cons (car us) (loop (cdr us)))))))))\n\n    (define (delete-user! path name)\n      \"Syntax: (delete-user! path name)\nLibrary: (app users)\nDescription: Removes name's entry, if there is one.\"\n      (update-users! path\n        (lambda (users)\n          (let loop ((us users))\n            (cond ((null? us) '())\n                  ((string=? (user-name (car us)) name) (cdr us))\n                  (else (cons (car us) (loop (cdr us)))))))))\n\n    (define (valid-username? s)\n      \"Syntax: (valid-username? s)\nLibrary: (app users)\nDescription: True if s is 1-64 characters of letters, digits and . _ -\"\n      (and (string? s)\n           (<= 1 (string-length s) 64)\n           (let loop ((i 0))\n             (or (= i (string-length s))\n                 (let ((c (string-ref s i)))\n                   (and (or (char-alphabetic? c) (char-numeric? c)\n                            (memv c '(#\\. #\\_ #\\-)))\n                        (loop (+ i 1))))))))))\n")
         ("src/app-views.sld" . ";; (app views) — HTML rendering. All dynamic values flow through the\n;; auto-escaping (scm html builder), so user data can never inject markup.\n;; Only fixed strings (the SVG icons) are emitted raw. No inline scripts or\n;; style attributes: the Content-Security-Policy forbids them.\n\n(define-library (app views)\n  (import (scheme base)\n          (scm html builder)\n          (scm json simple)\n          (app site))\n  (export login-page home-page profile-page error-page)\n  (begin\n\n    (define theme-icons\n      (raw (string-append\n            \"<svg class=\\\"i-sun\\\" viewBox=\\\"0 0 24 24\\\" width=\\\"20\\\" height=\\\"20\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" aria-hidden=\\\"true\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\"/><path d=\\\"M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4\\\"/></svg>\"\n            \"<svg class=\\\"i-moon\\\" viewBox=\\\"0 0 24 24\\\" width=\\\"20\\\" height=\\\"20\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" aria-hidden=\\\"true\\\"><path d=\\\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\\\"/></svg>\")))\n\n    ;; who: #f when signed out, otherwise the username (links to the\n    ;; profile page, which is where signing out lives).\n    (define (page title who body)\n      (string-append\n       (html->string\n        (html5\n         '(@ (lang \"en\"))\n         `(head\n           (meta (@ (charset \"utf-8\")))\n           (meta (@ (name \"viewport\") (content \"width=device-width, initial-scale=1\")))\n           (title ,(string-append title \" · Starter Login\"))\n           (link (@ (rel \"icon\") (href ,(asset \"favicon.svg\"))))\n           (link (@ (rel \"stylesheet\") (href ,(asset \"css/app.css\"))))\n           (script (@ (src ,(asset \"js/theme-init.js\"))))\n           (script (@ (src ,(asset \"js/theme-toggle.js\")) (defer #t))))\n         `(body\n           (header (@ (class \"app-header\"))\n             (h1 (a (@ (href ,(url \"/\"))) \"Starter Login\"))\n             (nav (@ (class \"nav\"))\n               ,@(if who\n                     `((a (@ (href ,(url \"/profile\")) (class \"who\")) ,who))\n                     '())\n               (button (@ (class \"icon-btn js-theme-toggle\") (type \"button\")\n                          (aria-label \"Toggle dark mode\"))\n                 ,theme-icons)))\n           (main ,body))))\n       \"\\n\"))\n\n    ;; msg: #f, or (kind . text) with kind 'error or 'success.\n    (define (notice msg)\n      (if msg\n          `(p (@ (class ,(string-append \"notice \" (symbol->string (car msg)))))\n              ,(cdr msg))\n          \"\"))\n\n    (define (login-page error?)\n      (page \"Sign in\" #f\n        `(section (@ (class \"card narrow\"))\n           (h2 \"Sign in\")\n           ,(notice (and error? '(error . \"Invalid username or password.\")))\n           (form (@ (method \"post\") (action ,(url \"/login\")))\n             (label \"Username\"\n               (input (@ (name \"username\") (autocomplete \"username\")\n                         (autofocus #t) (required #t))))\n             (label \"Password\"\n               (input (@ (name \"password\") (type \"password\")\n                         (autocomplete \"current-password\") (required #t))))\n             (button (@ (type \"submit\") (class \"primary\")) \"Sign in\")))))\n\n    (define (items-table items)\n      `(table (@ (class \"data\"))\n         (thead (tr (th \"Name\") (th (@ (class \"num\")) \"Count\")))\n         (tbody\n          ,@(map (lambda (it)\n                   `(tr (td ,(json-ref it \"name\" \"\"))\n                        (td (@ (class \"num\"))\n                            ,(number->string (json-ref it \"count\" 0)))))\n                 items))))\n\n    (define (home-page username items)\n      (page \"Home\" username\n        `(section\n           (p \"Signed in as \" (strong ,username) \".\")\n           ,(items-table items))))\n\n    (define (profile-page username msg)\n      (page \"Profile\" username\n        `(section (@ (class \"card narrow\"))\n           (h2 \"Profile\")\n           ,(notice msg)\n           (p \"Change the password for \" (strong ,username) \".\")\n           (form (@ (method \"post\") (action ,(url \"/profile/password\")))\n             (label \"Current password\"\n               (input (@ (name \"current\") (type \"password\")\n                         (autocomplete \"current-password\") (required #t))))\n             (label \"New password\"\n               (input (@ (name \"new\") (type \"password\") (minlength \"8\")\n                         (autocomplete \"new-password\") (required #t))))\n             (label \"Confirm new password\"\n               (input (@ (name \"confirm\") (type \"password\") (minlength \"8\")\n                         (autocomplete \"new-password\") (required #t))))\n             (button (@ (type \"submit\") (class \"primary\")) \"Update password\"))\n           (form (@ (method \"post\") (action ,(url \"/logout\")) (class \"logout-form\"))\n             (button (@ (type \"submit\")) \"Sign out\")))))\n\n    (define (error-page)\n      (page \"Error\" #f\n        '(section (h2 \"Something went wrong\")\n                  (p \"The error has been logged.\"))))))\n")
         ("src/app-web.sld" . ";; (app web) — routes, request handlers and the middleware stack.\n;;\n;; make-app returns the server-level handler (lambda (req) resp): bin/server.scm\n;; serves it, and the tests call it directly with a request.\n;;\n;; Forms need no CSRF token: the session cookie is SameSite=Strict, so the\n;; browser never sends it with a request that another site started.\n\n(define-library (app web)\n  (import (scheme base)\n          (srfi 18)\n          (scm io)\n          (scm json simple)\n          (scm net http request)\n          (scm net http response)\n          (scm net http route)\n          (scm net http forms)\n          (scm net http static)\n          (scm net http session)\n          (scm net http middleware)\n          (app site)\n          (app users)\n          (app auth)\n          (app views))\n  (export make-app)\n  (begin\n\n    (define cookie-name \"starter_login_session\")\n\n    (define (load-items path)\n      (vector->list (json-parse (read-file-string path))))\n\n    (define (setting settings key)\n      (let ((p (assq key settings)))\n        (if p (cdr p) (error \"make-app: missing setting\" key))))\n\n    ;; 303 to a path in the app, optionally with header pairs (cookies).\n    (define (redirect path . headers)\n      (make-http-response 303 (cons (cons \"Location\" (url path)) headers) \"\"))\n\n    ;; A failed password check costs the client half a second, which slows\n    ;; down guessing.\n    (define (penalty) (thread-sleep! 0.5))\n\n    (define (make-app settings)\n      \"Syntax: (make-app settings)\nLibrary: (app web)\nDescription: Builds the app's request handler. settings is an alist:\n  url-prefix, static-dir, items-file, users-file (absolute paths),\n  session-secret, session-max-age (seconds), secure-cookies?.\"\n      (let* ((site (make-site (setting settings 'url-prefix)\n                              (setting settings 'static-dir)))\n             (prefix (site-prefix site))\n             (auth (make-auth\n                    (make-session-config\n                     cookie-name\n                     (setting settings 'session-secret)\n                     (setting settings 'session-max-age)\n                     `((path . ,(cookie-path site))\n                       (secure? . ,(setting settings 'secure-cookies?))))\n                    (setting settings 'users-file)))\n             (items-file (setting settings 'items-file))\n             (router (make-router)))\n\n        (define (route! method path handler)\n          (router-add! router method (string-append prefix path) handler))\n\n        ;; Runs handler with the signed-in user as a third argument, or\n        ;; sends the browser to the sign-in page.\n        (define (signed-in handler)\n          (lambda (req params)\n            (let ((user (session-user auth req)))\n              (if user (handler req params user) (redirect \"/login\")))))\n\n        (route! \"GET\" \"/static/*\" (make-static-handler (setting settings 'static-dir)))\n\n        (route! \"GET\" \"/\"\n          (signed-in\n            (lambda (req params user)\n              (html-response (home-page (user-name user) (load-items items-file))))))\n\n        (route! \"GET\" \"/login\"\n          (lambda (req params)\n            (if (session-user auth req)\n                (redirect \"/\")\n                (html-response (login-page #f)))))\n\n        (route! \"POST\" \"/login\"\n          (lambda (req params)\n            (let* ((form (http-request-form req))\n                   (user (sign-in auth (form-ref form \"username\" \"\")\n                                  (form-ref form \"password\" \"\"))))\n              (if user\n                  (redirect \"/\" (start-session auth user))\n                  (begin (penalty) (html-response (login-page #t)))))))\n\n        (route! \"POST\" \"/logout\"\n          (lambda (req params) (redirect \"/login\" (end-session auth))))\n\n        (route! \"GET\" \"/profile\"\n          (signed-in\n            (lambda (req params user)\n              (let ((done? (assoc \"updated\" (url-query-params (http-request-url req)))))\n                (html-response\n                 (profile-page (user-name user)\n                               (and done? '(success . \"Password updated.\"))))))))\n\n        (route! \"POST\" \"/profile/password\"\n          (signed-in\n            (lambda (req params user)\n              (let* ((form (http-request-form req))\n                     (new (form-ref form \"new\" \"\"))\n                     (fail (lambda (text)\n                             (html-response\n                              (profile-page (user-name user) (cons 'error text))))))\n                (cond\n                  ((not (sign-in auth (user-name user) (form-ref form \"current\" \"\")))\n                   (penalty)\n                   (fail \"Current password is incorrect.\"))\n                  ((< (string-length new) min-password-length)\n                   (fail \"New password must be at least 8 characters.\"))\n                  ((not (string=? new (form-ref form \"confirm\" \"\")))\n                   (fail \"New passwords do not match.\"))\n                  (else\n                   ;; The new hash ends all other sessions; this browser\n                   ;; gets a fresh cookie.\n                   (let ((user (change-password! auth user new)))\n                     (redirect \"/profile?updated\" (start-session auth user)))))))))\n\n        ;; Outside the prefix: the health probe talks to the app directly.\n        (router-add! router \"GET\" \"/healthz\"\n          (lambda (req params) (text-response \"ok\\n\")))\n\n        ;; Outermost first: log every request, add the security headers,\n        ;; make the site current for url/asset, and turn errors into a\n        ;; logged 500 page.\n        (with-access-log\n         (with-security-headers\n          (with-site site\n           (with-error-handler (router->handler router)\n                               (lambda (req) (html-response (error-page)))))))))))\n")
         ("static/favicon.svg" . "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\"><rect width=\"32\" height=\"32\" rx=\"6\" fill=\"#2563eb\"/><path d=\"M9 11h14M9 16h14M9 21h9\" stroke=\"#fff\" stroke-width=\"2.5\" stroke-linecap=\"round\"/></svg>\n")
         ("static/css/app.css" . "/* Theme tokens. Colours are only written here, each as\n   light-dark(<light>, <dark>). The palette follows the OS setting unless\n   the user pinned one with the toggle: theme-init.js / theme-toggle.js\n   set data-theme on <html>, which fixes color-scheme. Works without\n   JavaScript too (then it simply follows the OS). */\n:root {\n  color-scheme: light dark;\n\n  --bg:     light-dark(#ffffff, #16181d);\n  --fg:     light-dark(#1a1a1a, #e8e8e8);\n  --muted:  light-dark(#666666, #9aa0aa);\n  --border: light-dark(#e2e2e2, #2c2f36);\n  --row:    light-dark(#fafafa, #1d2026);\n  --accent: light-dark(#2563eb, #6ea8fe);\n  --card:   light-dark(#fbfbfb, #1b1e24);\n  --danger: light-dark(#b91c1c, #f87171);\n  --ok:     light-dark(#15803d, #4ade80);\n  --on-accent: light-dark(#ffffff, #0f172a);\n}\n:root[data-theme=\"light\"] { color-scheme: light; }\n:root[data-theme=\"dark\"]  { color-scheme: dark; }\n\n/* The toggle shows a moon in light mode and a sun in dark mode. */\n.i-sun { display: none; }\n:root[data-theme=\"dark\"] .i-sun  { display: inline; }\n:root[data-theme=\"dark\"] .i-moon { display: none; }\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"]) .i-sun  { display: inline; }\n  :root:not([data-theme=\"light\"]) .i-moon { display: none; }\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  font: 16px/1.5 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  color: var(--fg);\n  background: var(--bg);\n}\n\na { color: var(--accent); }\n\n.app-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding: 0.75rem 1.25rem;\n  border-bottom: 1px solid var(--border);\n}\n.app-header h1 { font-size: 1.25rem; margin: 0; }\n.app-header h1 a { color: inherit; text-decoration: none; }\n\n.nav { display: flex; align-items: center; gap: 1rem; }\n.nav a { color: var(--accent); text-decoration: none; }\n.nav a:hover { text-decoration: underline; }\n/* The username link is quieter than a regular nav link. */\n.nav a.who { color: var(--muted); }\n.nav a.who:hover { color: var(--accent); }\n\n.icon-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 2.25rem;\n  height: 2.25rem;\n  padding: 0;\n  color: var(--fg);\n  background: transparent;\n  border: 1px solid var(--border);\n  border-radius: 0.5rem;\n  cursor: pointer;\n}\n.icon-btn:hover { border-color: var(--accent); color: var(--accent); }\n\nmain { max-width: 720px; margin: 2rem auto; padding: 0 1.25rem; }\n\ntable.data { width: 100%; border-collapse: collapse; }\ntable.data th, table.data td {\n  padding: 0.5rem 0.75rem;\n  text-align: left;\n  border-bottom: 1px solid var(--border);\n}\ntable.data thead th { color: var(--muted); font-weight: 600; }\ntable.data tbody tr:nth-child(even) { background: var(--row); }\ntable.data .num { text-align: right; font-variant-numeric: tabular-nums; }\n\n.card {\n  background: var(--card);\n  border: 1px solid var(--border);\n  border-radius: 0.75rem;\n  padding: 1.5rem;\n}\n.narrow { max-width: 22rem; margin: 3rem auto; }\n\nform label { display: block; margin-bottom: 0.85rem; font-weight: 600; }\nform input {\n  display: block;\n  width: 100%;\n  margin-top: 0.25rem;\n  padding: 0.5rem 0.6rem;\n  font: inherit;\n  color: var(--fg);\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 0.4rem;\n}\nform input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }\n\nbutton.primary {\n  margin-top: 0.5rem;\n  padding: 0.55rem 1.1rem;\n  font: inherit;\n  font-weight: 600;\n  color: var(--on-accent);\n  background: var(--accent);\n  border: 0;\n  border-radius: 0.4rem;\n  cursor: pointer;\n}\nbutton.primary:hover { filter: brightness(1.05); }\n\n/* Sign out, separated from the password form at the bottom of the card. */\n.logout-form {\n  margin-top: 1.25rem;\n  padding-top: 1rem;\n  border-top: 1px solid var(--border);\n}\n.logout-form button {\n  padding: 0.5rem 1.1rem;\n  font: inherit;\n  color: var(--fg);\n  background: transparent;\n  border: 1px solid var(--border);\n  border-radius: 0.4rem;\n  cursor: pointer;\n}\n.logout-form button:hover { border-color: var(--accent); color: var(--accent); }\n\n.notice { padding: 0.6rem 0.8rem; border-radius: 0.4rem; margin: 0 0 1rem; }\n.notice.error { color: var(--danger); border: 1px solid var(--danger); }\n.notice.success { color: var(--ok); border: 1px solid var(--ok); }\n")
         ("static/js/theme-init.js" . "// Loaded in <head> without defer: applies a theme the user pinned with the\n// toggle before the first paint, so the page never flashes the wrong\n// palette. Nothing pinned: the CSS follows the OS setting.\n(function () {\n  try {\n    var t = localStorage.getItem(\"theme\");\n    if (t === \"dark\" || t === \"light\") {\n      document.documentElement.setAttribute(\"data-theme\", t);\n    }\n  } catch (e) {}\n})();\n")
         ("static/js/theme-toggle.js" . "// Wires every .js-theme-toggle button: flips the theme in effect (the\n// pinned one, else the OS setting) and remembers the choice.\n(function () {\n  function current() {\n    var t = document.documentElement.getAttribute(\"data-theme\");\n    if (t === \"dark\" || t === \"light\") return t;\n    return window.matchMedia(\"(prefers-color-scheme: dark)\").matches\n      ? \"dark\"\n      : \"light\";\n  }\n  document.querySelectorAll(\".js-theme-toggle\").forEach(function (btn) {\n    btn.addEventListener(\"click\", function () {\n      var next = current() === \"dark\" ? \"light\" : \"dark\";\n      document.documentElement.setAttribute(\"data-theme\", next);\n      try {\n        localStorage.setItem(\"theme\", next);\n      } catch (e) {}\n    });\n  });\n})();\n")
         ("tests/test_pure_config.scm" . ";; Tests for (app config). Run: scm tests/test_pure_config.scm\n\n(import (scheme base)\n        (scheme file)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm io)\n        (scm string)\n        (scm test))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config))\n\n(test-runner-factory scm-test-runner)\n(test-begin \"starter-login config\")\n\n(define tmp (mktempdir '(prefix . \"starter-login-config\")))\n(define (tmp-file name content)\n  (let ((path (string-append tmp \"/\" name)))\n    (call-with-output-file path (lambda (p) (write-string content p)))\n    path))\n\n(test-group \"read-config\"\n  (let ((cfg (read-config (tmp-file \"a.scm\" \"(define port 8071)\\n(define ttl (* 60 60))\\n(define name \\\"x\\\")\"))))\n    (test-equal 8071 (config-ref cfg 'port 0))\n    (test-equal 3600 (config-ref cfg 'ttl 0))\n    (test-equal \"x\" (config-ref cfg 'name #f))\n    (test-equal 'none (config-ref cfg 'missing 'none)))\n  (test-error (read-config (tmp-file \"b.scm\" \"(display 1)\"))))\n\n(test-group \"the example config reads\"\n  (let ((cfg (read-config (string-append root \"/config.example.scm\"))))\n    (test-equal 8071 (config-ref cfg 'http-port 0))\n    (test-equal \"\" (config-ref cfg 'url-prefix #f))))\n\n(test-group \"create-config!\"\n  (let ((ex (tmp-file \"example.scm\" \"(define secret \\\"REPLACE_WITH_BASE64_SECRET\\\")\"))\n        (target (string-append tmp \"/config.scm\")))\n    (create-config! ex target)\n    (let ((s (config-ref (read-config target) 'secret #f)))\n      (test-assert \"secret replaced\" (not (string=? s \"REPLACE_WITH_BASE64_SECRET\")))\n      (test-equal 44 (string-length s)))\n    (test-error \"no overwrite\" (create-config! ex target))\n    (delete-file target)\n    (delete-file ex)))\n\n(test-group \"load-config creates config.scm on the first run\"\n  (let ((app (string-append tmp \"/app\")))\n    (make-directory app)\n    (call-with-output-file (string-append app \"/config.example.scm\")\n      (lambda (p) (write-string \"(define http-port 1234)\" p)))\n    (test-equal 1234\n      (config-ref (load-config app '()) 'http-port 0))\n    (test-assert (file-exists? (string-append app \"/config.scm\")))\n    (delete-file (string-append app \"/config.scm\"))\n    (delete-file (string-append app \"/config.example.scm\"))\n    (delete-directory app)))\n\n(test-group \"config-secret\"\n  (test-equal \"abc\" (config-secret '((s . \"abc\")) 's))\n  (test-equal '(\"new\" \"old\") (config-secret '((s . (\"new\" \"old\"))) 's))\n  (test-error (config-secret '() 's))\n  (test-error (config-secret '((s . \"REPLACE_WITH_BASE64_SECRET\")) 's))\n  (test-error (config-secret '((s . (\"new\" \"REPLACE_WITH_BASE64_SECRET\"))) 's)))\n\n(test-group \"resolve-path\"\n  (test-equal \"/etc/x\" (resolve-path \"/app\" \"/etc/x\"))\n  (test-equal \"/app/data/x\" (resolve-path \"/app\" \"data/x\")))\n\n(delete-file (string-append tmp \"/a.scm\"))\n(delete-file (string-append tmp \"/b.scm\"))\n(delete-directory tmp)\n\n(test-end \"starter-login config\")\n")
         ("tests/test_pure_web.scm" . ";; Tests for the web app: sign-in, sessions, profile, prefix. Requests go\n;; straight to the handler from make-app, no server or socket.\n;; Run: scm tests/test_pure_web.scm\n\n(import (scheme base)\n        (scheme file)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm log)\n        (scm string)\n        (scm test)\n        (scm crypto)\n        (scm crypto password)\n        (scm net http request)\n        (scm net http response))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app users) (app web))\n\n(test-runner-factory scm-test-runner)\n(test-begin \"starter-login web\")\n\n(define tmp (mktempdir '(prefix . \"starter-login-test\")))\n(define users-file (string-append tmp \"/data/users.scm\"))\n\n(define (app-with prefix)\n  (make-app `((url-prefix . ,prefix)\n              (static-dir . ,(string-append root \"/static\"))\n              (items-file . ,(string-append root \"/data/items.json\"))\n              (users-file . ,users-file)\n              (session-secret . ,(base64-encode (random-bytes 32)))\n              (session-max-age . 3600)\n              (secure-cookies? . #f))))\n\n;; Fast hashes keep the test quick; production uses the 600k default.\n(define fast-iterations 1000)\n\n;; Requests are logged to the log port; keep the test output clean.\n(define (send app method url cookie . form)\n  (parameterize ((log-port (open-output-string))\n                 (password-pbkdf2-iterations fast-iterations))\n    (app (make-http-request\n          method url\n          (append (if cookie (list (cons \"Cookie\" cookie)) '())\n                  (if (pair? form)\n                      '((\"Content-Type\" . \"application/x-www-form-urlencoded\"))\n                      '()))\n          (if (pair? form) (car form) #f)))))\n\n(define (status r) (http-response-status r))\n(define (location r) (http-response-header r \"Location\"))\n(define (body r)\n  (let ((b (http-response-body r)))\n    (if (bytevector? b) (utf8->string b) b)))\n(define (has? s part) (and (string? s) (string-contains-from s part 0) #t))\n\n;; \"name=value\" from the response's Set-Cookie header, for the next request.\n(define (cookie-of r)\n  (let ((h (http-response-header r \"Set-Cookie\")))\n    (and h (car (string-split-char h #\\;)))))\n\n(parameterize ((password-pbkdf2-iterations fast-iterations))\n  (save-user! users-file \"alice\" (password-hash \"correct horse\")))\n(define app (app-with \"\"))\n\n(test-group \"signed out\"\n  (let ((r (send app \"GET\" \"/\" #f)))\n    (test-equal 303 (status r))\n    (test-equal \"/login\" (location r)))\n  (test-equal 200 (status (send app \"GET\" \"/login\" #f)))\n  (test-equal \"ok\\n\" (body (send app \"GET\" \"/healthz\" #f))))\n\n(test-group \"failed sign-in\"\n  (let ((r (send app \"POST\" \"/login\" #f \"username=alice&password=wrong\")))\n    (test-equal 200 (status r))\n    (test-assert (has? (body r) \"Invalid username or password\"))\n    (test-equal #f (http-response-header r \"Set-Cookie\")))\n  (test-assert \"unknown user\"\n    (has? (body (send app \"POST\" \"/login\" #f \"username=bob&password=x\"))\n          \"Invalid username or password\")))\n\n(define cookie\n  (let ((r (send app \"POST\" \"/login\" #f \"username=alice&password=correct+horse\")))\n    (test-equal \"sign-in redirects home\" \"/\" (location r))\n    (let ((h (http-response-header r \"Set-Cookie\")))\n      (test-assert \"HttpOnly\" (has? h \"HttpOnly\"))\n      (test-assert \"SameSite\" (has? h \"SameSite=Strict\"))\n      (test-assert \"Path\" (has? h \"Path=/\")))\n    (cookie-of r)))\n\n(test-group \"signed in\"\n  (let ((r (send app \"GET\" \"/\" cookie)))\n    (test-equal 200 (status r))\n    (test-assert (has? (body r) \"Signed in as <strong>alice</strong>\"))\n    (test-assert \"no inline script\" (not (has? (body r) \"<script>\")))\n    (test-assert \"no style attribute\" (not (has? (body r) \" style=\"))))\n  (test-equal \"/\" (location (send app \"GET\" \"/login\" cookie)))\n  (test-equal 200 (status (send app \"GET\" \"/profile\" cookie)))\n  (test-equal 303 (status (send app \"GET\" \"/\" \"starter_login_session=forged.token\"))))\n\n(test-group \"change password\"\n  (test-assert \"wrong current password\"\n    (has? (body (send app \"POST\" \"/profile/password\" cookie\n                      \"current=nope&new=newpassword&confirm=newpassword\"))\n          \"Current password is incorrect\"))\n  (test-assert \"too short\"\n    (has? (body (send app \"POST\" \"/profile/password\" cookie\n                      \"current=correct+horse&new=short&confirm=short\"))\n          \"at least 8\"))\n  (test-assert \"mismatch\"\n    (has? (body (send app \"POST\" \"/profile/password\" cookie\n                      \"current=correct+horse&new=newpassword&confirm=other\"))\n          \"do not match\"))\n  (let* ((r (send app \"POST\" \"/profile/password\" cookie\n                  \"current=correct+horse&new=newpassword&confirm=newpassword\"))\n         (fresh (cookie-of r)))\n    (test-equal \"/profile?updated\" (location r))\n    (test-assert \"old session ended\" (equal? \"/login\" (location (send app \"GET\" \"/\" cookie))))\n    (test-equal \"new session works\" 200 (status (send app \"GET\" \"/\" fresh)))\n    (test-assert (has? (body (send app \"GET\" \"/profile?updated\" fresh)) \"Password updated\"))\n    (test-equal \"new password signs in\" \"/\"\n      (location (send app \"POST\" \"/login\" #f \"username=alice&password=newpassword\")))\n    (test-group \"sign out\"\n      (let ((r (send app \"POST\" \"/logout\" fresh)))\n        (test-equal \"/login\" (location r))\n        (test-assert \"cookie cleared\" (has? (http-response-header r \"Set-Cookie\") \"Max-Age=0\"))))\n    (test-group \"deleted user\"\n      (delete-user! users-file \"alice\")\n      (test-equal \"/login\" (location (send app \"GET\" \"/\" fresh))))))\n\n(test-group \"outdated hashes are upgraded at sign-in\"\n  (parameterize ((password-pbkdf2-iterations 500))\n    (save-user! users-file \"carol\" (password-hash \"carols password\")))\n  (test-assert (password-needs-rehash? (user-hash (find-user users-file \"carol\"))))\n  (send app \"POST\" \"/login\" #f \"username=carol&password=carols+password\")\n  (test-assert (not (parameterize ((password-pbkdf2-iterations fast-iterations))\n                      (password-needs-rehash? (user-hash (find-user users-file \"carol\")))))))\n\n(test-group \"url prefix\"\n  (let* ((app (app-with \"/team\"))\n         (r (send app \"POST\" \"/team/login\" #f \"username=carol&password=carols+password\")))\n    (test-equal \"/team/\" (location r))\n    (test-assert \"cookie scoped to the prefix\"\n      (has? (http-response-header r \"Set-Cookie\") \"Path=/team/\"))\n    (test-equal \"/team/login\" (location (send app \"GET\" \"/team/\" #f)))\n    (test-assert (has? (body (send app \"GET\" \"/team/\" (cookie-of r)))\n                       \"href=\\\"/team/static/css/app.css?v=\"))\n    (test-equal 404 (status (send app \"GET\" \"/login\" #f)))))\n\n(delete-file users-file)\n(delete-directory (string-append tmp \"/data\"))\n(delete-directory tmp)\n\n(test-end \"starter-login web\")\n"))
        ("starter-admin"
         (".gitignore" . "# Local config (database password, session secret).\nconfig.scm\n\n# Config for tests/test_live_web.scm.\ntests/test-config.scm\n")
         ("README.md" . "# starter-admin\n\nA web app with **user and role management**, backed by **PostgreSQL** with\nSQL migrations. Everything in `starter-login` plus an admin console to add and\ndelete users, create roles, and assign or remove them, and a script that\nseeds the first admin. The privileged role is named `admin`.\n\nUse it as a starting point for a multi-user application that needs accounts,\nauthorization and a real database.\n\n## What it demonstrates\n\n- **PostgreSQL access** through a connection pool with thin, fully\n  parameterized query helpers: no string-built SQL (`src/app-db.sld`,\n  `src/app-users.sld`).\n- **Transactions** with `with-db-transaction` (on top of\n  `with-pg-transaction`): creating a user together with the admin role, and\n  seeding the first admin, happen completely or not at all.\n- **Forward-only SQL migrations**, applied at every start and tracked in\n  `schema_migrations` (`migrations/0001_init.sql`).\n- **Role-based authorization**: `admin-only` gates the console; users can hold\n  any number of roles (`users` / `roles` / `user_roles`). An admin cannot\n  delete their own account or remove their own admin role.\n- From `starter-login`: `(scm crypto password)` hashes with upgrades at\n  sign-in and a dummy check for unknown usernames, signed-cookie sessions\n  that end when the user is deleted or changes the password, and the profile\n  page.\n- From `starter-public`: the middleware stack (access log, strict CSP,\n  logged 500s), cache-busted static files, `light-dark()` theming without\n  inline JavaScript, the URL prefix, the config created on the first run,\n  and tests that call the app without a server.\n\n## Layout\n\n```\nbin/server.scm        load the config, run migrations, serve\nbin/dev-server.scm    auto-reloading dev supervisor\nbin/seed-admin.scm    create the first admin (prompts for a password)\nbin/init-config.scm   write a new config file (used by deploy/install.sh)\nbin/gen-secret.scm    print a new session secret (for key rotation)\nsrc/app-config.sld    config reading and first-run creation\nsrc/app-site.sld      URL prefix: url, asset, cookie-path\nsrc/app-db.sld        pool, query helpers, transactions, migrations\nsrc/app-users.sld     user / role / user-role queries\nsrc/app-auth.sld      sign-in, sessions, password changes\nsrc/app-views.sld     HTML rendering (login, home, profile, admin console)\nsrc/app-web.sld       routes and middleware: make-app\nmigrations/           NNNN_*.sql, applied in order at startup\nconfig.example.scm    the config template, with every setting\nstatic/               CSS, theme scripts, favicon\ntests/                test_pure_*.scm (no database), test_live_web.scm\ndeploy/               systemd units, health probe, nginx example, install script\n```\n\n## Setup\n\n1. Create a database and a login role for the app:\n\n   ```sql\n   CREATE ROLE starter_admin LOGIN PASSWORD 'choose-a-password';\n   CREATE DATABASE starter_admin OWNER starter_admin;\n   ```\n\n2. Create `config.scm`, with a fresh `session-secret`, and set\n   `db-password` (and the other `db-` settings if needed) in it:\n\n   ```sh\n   scm bin/init-config.scm config.scm\n   ```\n\n3. Seed the first admin. This also applies the migrations:\n\n   ```sh\n   scm bin/seed-admin.scm admin       # prompts for a password\n   ```\n\n## Run\n\n```sh\nscm bin/server.scm             # http://127.0.0.1:8072\nscm bin/dev-server.scm         # same, restarts when src/, migrations/ or the config change\n```\n\nSign in as the seeded admin, open the **Admin** console, and add users and\nroles.\n\n## Test\n\n```sh\nfor t in tests/test_pure_*.scm; do scm \"$t\" || exit 1; done\n```\n\n`tests/test_live_web.scm` runs the full flows against a real database. It\ndrops the app's tables first, so it only runs against a database whose name\nends in `_test`:\n\n```sh\ncreatedb -O starter_admin starter_admin_test\nsed 's/(define db-name \"starter_admin\")/(define db-name \"starter_admin_test\")/' \\\n    config.scm > tests/test-config.scm\nSTARTER_ADMIN_TEST_CONFIG=tests/test-config.scm scm tests/test_live_web.scm\n```\n\n## Adapt\n\n- Add tables with a new `migrations/NNNN_*.sql` file; it is applied at the\n  next start.\n- Add queries in `src/app-users.sld` (or a new `src/app-*.sld` module) with\n  `db-rows` / `db-row` / `db-scalar` / `db-exec`; always pass values as\n  `$1, $2, ...` parameters. Wrap statements that belong together in\n  `with-db-transaction` and use its handle for each of them.\n- Gate routes with `signed-in` or `admin-only` in `src/app-web.sld`. To use\n  a different privileged role name, change `admin-role` there.\n\n## Deploy\n\nThe app binds loopback only; put a TLS-terminating reverse proxy in front\n(`deploy/nginx.conf.example`). Then, on the server, from the app directory:\n\n```sh\nsudo deploy/install.sh               # SCM=/path/to/scm if not /usr/local/bin/scm\n```\n\nThis copies the app to `/opt/starter-admin` and adds a `starter-admin`\nsystem user and the systemd units. The first install also creates\n`/etc/starter-admin/config.scm` (fresh secret, `secure-cookies?` on) and\nstops there: set the database settings, seed the admin and start the units\nas it tells you. Later installs restart the service, which applies new\nmigrations. The service orders after `postgresql.service`; a per-minute\nprobe restarts it if `/healthz` fails twice, and a timer restarts it daily\nat 04:00.\n")
         ("config.example.scm" . ";; starter-admin configuration: a list of (define name value) forms, read\n;; as data by src/app-config.sld. bin/server.scm reads config.scm; the first\n;; run creates it from this file, with a fresh session-secret. Set the\n;; database password before you start the server.\n\n;; Bind loopback only; a reverse proxy (deploy/nginx.conf.example) fronts\n;; the public interface and terminates TLS.\n(define http-host \"127.0.0.1\")\n(define http-port 8072)\n\n;; Path the app is mounted under, e.g. \"/team\"; \"\" for the host root. The\n;; reverse proxy must pass paths through unchanged.\n(define url-prefix \"\")\n\n;; PostgreSQL over TCP. The role needs CREATE on the database the first\n;; time, so the migrations can build the schema.\n(define db-host \"127.0.0.1\")\n(define db-port 5432)\n(define db-user \"starter_admin\")\n(define db-password \"change-me\")\n(define db-name \"starter_admin\")\n(define db-pool-size 8)\n\n;; Signs the session cookies (base64 of 32 random bytes). To rotate it,\n;; list the new key first: (\"new\" \"old\"); sessions signed with the old key\n;; stay valid until you remove it. bin/gen-secret.scm prints a new key.\n(define session-secret \"REPLACE_WITH_BASE64_SECRET\")\n(define session-max-age (* 60 60 24 7))   ; 7 days\n\n;; Cookies are sent over HTTPS only when #t. Keep #f for http://127.0.0.1\n;; during development; deploy/install.sh sets #t.\n(define secure-cookies? #f)\n\n;; Relative to the app directory.\n(define static-dir \"static\")\n")
         ("bin/dev-server.scm" . ";; Development supervisor: restarts bin/server.scm whenever a watched file\n;; changes (src/*.sld, migrations/*.sql, bin/server.scm, config.scm), and\n;; auto-retries on a backoff if it exits on its own. Static files need no\n;; restart.\n;;\n;; Usage: scm bin/dev-server.scm\n\n(import (scheme base)\n        (scheme process-context)\n        (scm fs)\n        (scm reloader))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n\n(define (watched)\n  (append (files-with-suffix (string-append root \"/src\") \".sld\")\n          (files-with-suffix (string-append root \"/migrations\") \".sql\")\n          (list (string-append root \"/bin/server.scm\")\n                (string-append root \"/config.scm\"))))\n\n(supervise (list \"scm\" (string-append root \"/bin/server.scm\"))\n           watched\n           `((label . \"starter-admin\")\n             (work-dir . ,root)\n             (root . ,root)))\n")
         ("bin/gen-secret.scm" . ";; Usage: scm bin/gen-secret.scm\n;;\n;; Prints a fresh base64 secret (32 random bytes) for session-secret.\n\n(import (scheme base)\n        (scheme write)\n        (scm crypto))\n\n(display (base64-encode (random-bytes 32)))\n(newline)\n")
         ("bin/init-config.scm" . ";; Usage: scm bin/init-config.scm <target>\n;;\n;; Writes a new config file at target from config.example.scm. Used by\n;; deploy/install.sh; refuses to overwrite an existing file.\n\n(import (scheme base)\n        (scheme write)\n        (scheme process-context)\n        (scm module)\n        (scm fs))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config))\n\n(define args (cdr (command-line)))\n(when (null? args)\n  (display \"usage: scm bin/init-config.scm <target>\\n\")\n  (exit 1))\n\n(create-config! (string-append root \"/config.example.scm\") (car args))\n(display (string-append \"created \" (car args) \"\\n\"))\n")
         ("bin/seed-admin.scm" . ";; Usage: scm bin/seed-admin.scm [--config path] <username>\n;;\n;; Sets up the first admin: applies migrations, ensures the \"admin\" role\n;; exists, and creates username with that role (prompting for a password),\n;; all in one transaction. If the user already exists, it only gets the\n;; role. Safe to run again.\n\n(import (scheme base)\n        (scheme write)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm terminal))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (scm crypto password) (app config) (app db) (app users) (app auth) (app web))\n\n(define (fail msg) (display msg (current-error-port)) (newline (current-error-port)) (exit 1))\n\n(define args (cdr (command-line)))\n(define config-args\n  (if (and (pair? args) (string=? (car args) \"--config\") (pair? (cdr args)))\n      (list (cadr args))\n      '()))\n(define rest-args (if (null? config-args) args (cddr args)))\n(unless (and (pair? rest-args) (null? (cdr rest-args)))\n  (fail \"usage: scm bin/seed-admin.scm [--config path] <username>\"))\n(define username (car rest-args))\n(unless (valid-username? username)\n  (fail \"invalid username (letters, digits, . _ -; at most 64)\"))\n\n(define cfg (load-config root config-args))\n(define db\n  (make-db (config-ref cfg 'db-host \"127.0.0.1\")\n           (config-ref cfg 'db-port 5432)\n           (config-ref cfg 'db-user \"starter_admin\")\n           (config-ref cfg 'db-password \"\")\n           (config-ref cfg 'db-name \"starter_admin\")\n           1))\n\n(migrate! db (resolve-path root \"migrations\"))\n\n(define (ask-new-password)\n  (let* ((a (read-password \"Password: \"))\n         (b (if (eof-object? a) a (read-password \"Confirm:  \"))))\n    (cond ((or (eof-object? a) (eof-object? b)) (fail \"aborted\"))\n          ((not (string=? a b)) (fail \"passwords do not match\"))\n          ((< (string-length a) min-password-length)\n           (fail \"password must be at least 8 characters\"))\n          (else a))))\n\n(define existing (find-user-by-name db username))\n(define hash (if existing #f (password-hash (ask-new-password))))\n\n(with-db-transaction db\n  (lambda (tx)\n    (create-role! tx admin-role)\n    (let ((id (if existing (col existing \"id\") (create-user! tx username hash))))\n      (assign-role-by-name! tx id admin-role))))\n\n(display (if existing\n             (string-append username \" exists; it has the admin role now\\n\")\n             (string-append \"created admin \" username \"\\n\")))\n")
         ("bin/server.scm" . ";; Usage: scm bin/server.scm [config-path]\n;;\n;; Reads the config (config-path, or else config.scm, which the first run\n;; creates from config.example.scm with a fresh secret), applies pending\n;; migrations, then serves the app.\n\n(import (scheme base)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm log)\n        (scm net http server))\n\n;; Resolve the project root from this script's path so it runs from anywhere,\n;; and make src/ importable.\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config) (app db) (app web))\n\n(define cfg (load-config root (cdr (command-line))))\n(define host (config-ref cfg 'http-host \"127.0.0.1\"))\n(define port (config-ref cfg 'http-port 8072))\n(define prefix (config-ref cfg 'url-prefix \"\"))\n\n(define db\n  (make-db (config-ref cfg 'db-host \"127.0.0.1\")\n           (config-ref cfg 'db-port 5432)\n           (config-ref cfg 'db-user \"starter_admin\")\n           (config-ref cfg 'db-password \"\")\n           (config-ref cfg 'db-name \"starter_admin\")\n           (config-ref cfg 'db-pool-size 8)))\n\n(migrate! db (resolve-path root \"migrations\"))\n\n(define app\n  (make-app\n   `((url-prefix      . ,prefix)\n     (static-dir      . ,(resolve-path root (config-ref cfg 'static-dir \"static\")))\n     (db              . ,db)\n     (session-secret  . ,(config-secret cfg 'session-secret))\n     (session-max-age . ,(config-ref cfg 'session-max-age (* 60 60 24 7)))\n     (secure-cookies? . ,(config-ref cfg 'secure-cookies? #t)))))\n\n(log-info \"app\" (string-append \"starter-admin listening on http://\" host \":\"\n                               (number->string port) prefix \"/\"))\n(serve-forever port app 0 host)\n")
         ("deploy/healthcheck.sh" . "#!/bin/sh\n# Health probe for starter-admin, run every minute by\n# starter-admin-health.service: GET /healthz on the host/port from the\n# config. Two strikes: on failure wait 5s and probe again; only then restart\n# the unit, so one slow request cannot bounce the daemon.\n#\n# Usage: healthcheck.sh <config.scm> <unit>\nconf=$1\nunit=$2\n\n# The string or number of a (define name value) line in the config.\nvalue() {\n  sed -n \"s/^[[:space:]]*(define[[:space:]][[:space:]]*$1[[:space:]][[:space:]]*\\\"\\{0,1\\}\\([^\\\" )]*\\).*/\\1/p\" \"$conf\" | head -n 1\n}\n\nport=$(value http-port)\nhost=$(value http-host)\ncase \"$host\" in ''|0.0.0.0|::) host=127.0.0.1 ;; esac\nurl=\"http://$host:${port:-8072}/healthz\"\n\nprobe() { curl -fsS --max-time 5 \"$url\" >/dev/null; }\n\nif ! probe; then\n  sleep 5\n  if ! probe; then\n    echo \"$unit: $url failed twice; restarting\"\n    systemctl restart \"$unit\"\n  fi\nfi\n")
         ("deploy/install.sh" . "#!/bin/sh\n# Installs starter-admin as a systemd service. Run as root on the target\n# host from the app directory: sudo deploy/install.sh. Idempotent: rerun it\n# to deploy a new version (the config in /etc is kept).\n#\n#   /opt/starter-admin               the app (replaced on each install)\n#   /etc/starter-admin/config.scm    the config (created once, then yours)\n#\n# The service runs as the system user starter-admin. Set SCM to the scm\n# launcher if it is not /usr/local/bin/scm.\nset -eu\n\nAPP=starter-admin\nSCM=${SCM:-/usr/local/bin/scm}\nSRC=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n\nid -u \"$APP\" >/dev/null 2>&1 ||\n  useradd --system --home-dir /nonexistent --no-create-home \\\n          --shell /usr/sbin/nologin \"$APP\"\n\n# The app: code, static files and data, owned by root, readable by all.\nrm -rf \"/opt/$APP.new\"\nmkdir -p \"/opt/$APP.new\"\ncp -r \"$SRC/bin\" \"$SRC/src\" \"$SRC/static\" \"$SRC/migrations\" \"$SRC/deploy\" \\\n      \"$SRC/config.example.scm\" \"/opt/$APP.new/\"\nrm -rf \"/opt/$APP\"\nmv \"/opt/$APP.new\" \"/opt/$APP\"\n\n# The config: created from config.example.scm on the first install only,\n# with a fresh session secret and HTTPS-only cookies. Set db-password in it.\nmkdir -p \"/etc/$APP\"\nif [ ! -f \"/etc/$APP/config.scm\" ]; then\n  \"$SCM\" \"/opt/$APP/bin/init-config.scm\" \"/etc/$APP/config.scm\"\n  sed -i 's|^(define secure-cookies? #f)|(define secure-cookies? #t)|' \\\n         \"/etc/$APP/config.scm\"\n  NEW_CONFIG=1\nfi\nchown root:\"$APP\" \"/etc/$APP/config.scm\"\nchmod 640 \"/etc/$APP/config.scm\"\n\nfor unit in \"$APP.service\" \\\n            \"$APP-health.service\" \"$APP-health.timer\" \\\n            \"$APP-restart.service\" \"$APP-restart.timer\"; do\n  sed \"s|/usr/local/bin/scm|$SCM|\" \"$SRC/deploy/systemd/$unit\" \\\n    > \"/etc/systemd/system/$unit\"\ndone\n\nsystemctl daemon-reload\nsystemctl enable \"$APP.service\" \"$APP-health.timer\" \"$APP-restart.timer\"\n\nif [ -n \"${NEW_CONFIG:-}\" ]; then\n  echo \"Set the database settings in /etc/$APP/config.scm, then:\"\n  echo \"  sudo -u $APP $SCM /opt/$APP/bin/seed-admin.scm --config /etc/$APP/config.scm <name>\"\n  echo \"  sudo systemctl start $APP.service $APP-health.timer $APP-restart.timer\"\n  exit 0\nfi\n\nsystemctl restart \"$APP.service\"\nsystemctl start \"$APP-health.timer\" \"$APP-restart.timer\"\n\necho \"Installed. Config: /etc/$APP/config.scm. Logs: journalctl -u $APP -f\"\n")
         ("deploy/nginx.conf.example" . "# Reverse proxy in front of starter-admin. The app binds 127.0.0.1 only;\n# nginx terminates TLS on the public interface and forwards to it.\n\nupstream starter_admin_backend {\n    server 127.0.0.1:8072;\n    keepalive 16;\n}\n\nserver {\n    listen 443 ssl;\n    http2 on;\n    server_name example.com;\n\n    # ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;\n    # ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;\n\n    # At the host root. To mount the app under a path instead, set\n    # (define url-prefix \"/team\") in the config and use\n    # \"location /team/\" here. proxy_pass without a URI part passes\n    # the path through unchanged, which is what the app expects.\n    location / {\n        proxy_pass         http://starter_admin_backend;\n        proxy_http_version 1.1;\n        proxy_set_header   Connection        \"\";\n        proxy_set_header   Host              $host;\n        proxy_set_header   X-Real-IP         $remote_addr;\n        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;\n        proxy_set_header   X-Forwarded-Proto $scheme;\n        proxy_read_timeout 30s;\n    }\n}\n")
         ("deploy/systemd/starter-admin-health.service" . "[Unit]\nDescription=starter-admin health probe (restarts the app if /healthz fails)\nAfter=starter-admin.service\n\n[Service]\nType=oneshot\nExecCondition=/usr/bin/systemctl is-active --quiet starter-admin.service\n# Host/port come from the config; two strikes before a restart.\nExecStart=/opt/starter-admin/deploy/healthcheck.sh /etc/starter-admin/config.scm starter-admin.service\n")
         ("deploy/systemd/starter-admin-health.timer" . "[Unit]\nDescription=Run the starter-admin health probe every minute\n\n[Timer]\nOnBootSec=60s\nOnUnitActiveSec=60s\nAccuracySec=15s\nUnit=starter-admin-health.service\n\n[Install]\nWantedBy=timers.target\n")
         ("deploy/systemd/starter-admin-restart.service" . "[Unit]\nDescription=Daily restart of starter-admin (clears slow leaks, picks up config)\n\n[Service]\nType=oneshot\nExecStart=/bin/systemctl try-restart starter-admin.service\n")
         ("deploy/systemd/starter-admin-restart.timer" . "[Unit]\nDescription=Daily restart of starter-admin at 04:00\n\n[Timer]\nOnCalendar=*-*-* 04:00:00\nPersistent=true\nRandomizedDelaySec=2m\nUnit=starter-admin-restart.service\n\n[Install]\nWantedBy=timers.target\n")
         ("deploy/systemd/starter-admin.service" . "[Unit]\nDescription=starter-admin scheme webapp\nAfter=network-online.target postgresql.service\nWants=network-online.target\n# Allow a few quick restarts, but if we crash-loop more than 5 times in\n# 60s, give up rather than burn CPU.\nStartLimitIntervalSec=60\nStartLimitBurst=5\n\n[Service]\nType=simple\nUser=starter-admin\nGroup=starter-admin\nWorkingDirectory=/opt/starter-admin\n# deploy/install.sh replaces the scm path with $SCM. Pending migrations\n# are applied at each start.\nExecStart=/usr/local/bin/scm bin/server.scm /etc/starter-admin/config.scm\n\n# Restart on any exit. Combined with the daily restart timer this makes\n# the service self-healing across OOMs and unexpected exceptions.\nRestart=always\nRestartSec=3s\n# The JVM exits with 128+SIGTERM on a normal stop.\nSuccessExitStatus=143\n# Give the HTTP server (10s graceful drain by default) time to finish.\nTimeoutStopSec=15s\n\n# Logs go to journald: journalctl -u starter-admin -f\nStandardOutput=journal\nStandardError=journal\n\n# --- hardening ---\n# All state lives in PostgreSQL: the whole file system is read-only for\n# the app.\nNoNewPrivileges=yes\nPrivateTmp=yes\nProtectSystem=strict\nProtectHome=yes\n\n[Install]\nWantedBy=multi-user.target\n")
         ("migrations/0001_init.sql" . "-- Initial schema: users, roles, and the many-to-many between them.\n-- Applied once at startup and recorded in schema_migrations.\n\nCREATE TABLE users (\n  id          bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n  username    text        NOT NULL UNIQUE,\n  pass_hash   text        NOT NULL,\n  created_at  timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE roles (\n  id    bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n  name  text NOT NULL UNIQUE\n);\n\nCREATE TABLE user_roles (\n  user_id  bigint NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n  role_id  bigint NOT NULL REFERENCES roles(id) ON DELETE CASCADE,\n  PRIMARY KEY (user_id, role_id)\n);\n")
         ("src/app-auth.sld" . ";; (app auth) — sign-in, sessions and password changes.\n;;\n;; As in starter-login: (scm crypto password) hashes, a dummy check for\n;; unknown usernames, hash upgrades at sign-in, and signed-cookie sessions\n;; from (scm net http session). The cookie carries the user id and a stamp\n;; of the password hash; every request loads the user again, so deleting a\n;; user or changing a password ends their other sessions.\n\n(define-library (app auth)\n  (import (scheme base)\n          (scm crypto)\n          (scm crypto password)\n          (scm net http session)\n          (app db)\n          (app users))\n  (export make-auth\n          sign-in\n          session-user\n          start-session\n          end-session\n          change-password!\n          min-password-length)\n  (begin\n\n    (define min-password-length 8)\n\n    (define-record-type auth\n      (%make-auth session db)\n      auth?\n      (session auth-session)\n      (db auth-db))\n\n    (define (make-auth session-config db)\n      \"Syntax: (make-auth session-config db)\nLibrary: (app auth)\nDescription: Ties a (scm net http session) config to the database.\"\n      (%make-auth session-config db))\n\n    ;; Changes whenever the password (and so the hash) changes.\n    (define (password-stamp hash)\n      (base64-encode (bytevector-copy (sha256-hash (string->utf8 hash)) 0 12)))\n\n    (define (sign-in auth username password)\n      \"Syntax: (sign-in auth username password)\nLibrary: (app auth)\nDescription: The user row if password is right for username, else #f.\n  Upgrades an outdated password hash on success.\"\n      (let* ((db (auth-db auth))\n             (user (find-user-by-name db username)))\n        (cond\n          ((not (password-verify password (and user (col user \"pass_hash\")))) #f)\n          ((password-needs-rehash? (col user \"pass_hash\"))\n           (set-password-hash! db (col user \"id\") (password-hash password))\n           (load-user db (col user \"id\")))\n          (else user))))\n\n    (define (session-user auth req)\n      \"Syntax: (session-user auth req)\nLibrary: (app auth)\nDescription: The signed-in user's row, or #f if there is no valid session\n  or the user was deleted or changed the password since.\"\n      (let ((s (session-ref (auth-session auth) req)))\n        (and (pair? s)\n             (let* ((uid (assq 'uid s))\n                    (stamp (assq 'stamp s))\n                    (user (and uid (load-user (auth-db auth) (cdr uid)))))\n               (and user stamp\n                    (equal? (cdr stamp) (password-stamp (col user \"pass_hash\")))\n                    user)))))\n\n    (define (start-session auth user)\n      \"Syntax: (start-session auth user)\nLibrary: (app auth)\nDescription: The Set-Cookie header pair that signs user in.\"\n      (session-set-cookie (auth-session auth)\n                          `((uid . ,(col user \"id\"))\n                            (stamp . ,(password-stamp (col user \"pass_hash\"))))))\n\n    (define (end-session auth)\n      \"Syntax: (end-session auth)\nLibrary: (app auth)\nDescription: The Set-Cookie header pair that signs out.\"\n      (session-clear-cookie (auth-session auth)))\n\n    (define (change-password! auth user new-password)\n      \"Syntax: (change-password! auth user new-password)\nLibrary: (app auth)\nDescription: Stores a new hash for user and returns the updated row. Other\n  sessions of the user end; start a new one for this browser.\"\n      (set-password-hash! (auth-db auth) (col user \"id\") (password-hash new-password))\n      (load-user (auth-db auth) (col user \"id\")))))\n")
         ("src/app-config.sld" . ";; (app config) — reads config.scm and creates it on the first run.\n;;\n;; The config file is a list of (define name expression) forms. It is read\n;; as data, not loaded: each expression is evaluated on its own in a\n;; (scheme base) environment, so (* 60 60 24 7) works but the file cannot\n;; reach into the app. The result is an alist, read with config-ref.\n\n(define-library (app config)\n  (import (scheme base)\n          (scheme eval)\n          (scheme file)\n          (scheme read)\n          (scheme write)\n          (scm crypto)\n          (scm fs)\n          (scm io)\n          (scm string))\n  (export load-config\n          read-config\n          create-config!\n          config-ref\n          config-secret\n          resolve-path)\n  (begin\n\n    ;; config.example.scm carries this placeholder where a secret belongs;\n    ;; create-config! replaces it with a fresh random key.\n    (define secret-placeholder \"REPLACE_WITH_BASE64_SECRET\")\n\n    (define (read-config path)\n      \"Syntax: (read-config path)\nLibrary: (app config)\nDescription: Reads the (define name expression) forms in path and returns\n  an alist of (name . value). Any other form is an error.\"\n      (let ((env (environment '(scheme base))))\n        (call-with-input-file path\n          (lambda (port)\n            (let loop ((acc '()))\n              (let ((form (read port)))\n                (cond\n                  ((eof-object? form) (reverse acc))\n                  ((and (pair? form) (eq? (car form) 'define)\n                        (pair? (cdr form)) (symbol? (cadr form))\n                        (pair? (cddr form)) (null? (cdddr form)))\n                   (loop (cons (cons (cadr form) (eval (caddr form) env)) acc)))\n                  (else (error \"config: expected (define name value)\" form)))))))))\n\n    (define (create-config! example target)\n      \"Syntax: (create-config! example target)\nLibrary: (app config)\nDescription: Writes target as a copy of example, with each secret\n  placeholder replaced by a fresh base64 key, readable by the owner only.\n  Refuses to overwrite an existing file.\"\n      (when (file-exists? target)\n        (error \"config already exists\" target))\n      (let ((text (string-replace-all (read-file-string example)\n                                      secret-placeholder\n                                      (base64-encode (random-bytes 32)))))\n        (call-with-output-file target\n          (lambda (p) (write-string text p)))\n        (chmod target \"600\")))\n\n    (define (load-config root args)\n      \"Syntax: (load-config root args)\nLibrary: (app config)\nDescription: Reads the config named by the first command-line argument in\n  args, or else root/config.scm. On the first run, when root/config.scm\n  does not exist yet, it is created from config.example.scm.\"\n      (if (pair? args)\n          (read-config (car args))\n          (let ((path (string-append root \"/config.scm\")))\n            (unless (file-exists? path)\n              (create-config! (string-append root \"/config.example.scm\") path)\n              (display (string-append \"created \" path \"\\n\") (current-error-port)))\n            (read-config path))))\n\n    (define (config-ref cfg name default)\n      \"Syntax: (config-ref cfg name default)\nLibrary: (app config)\nDescription: The value of name in cfg, or default if the file has none.\"\n      (let ((p (assq name cfg)))\n        (if p (cdr p) default)))\n\n    (define (config-secret cfg name)\n      \"Syntax: (config-secret cfg name)\nLibrary: (app config)\nDescription: The secret stored under name: a base64 string, or a list of\n  them (newest first) while rotating keys. Raises if it is missing or still\n  the placeholder from config.example.scm.\"\n      (let* ((s (config-ref cfg name #f))\n             (keys (if (string? s) (list s) s)))\n        (unless (and (pair? keys)\n                     (let loop ((ks keys))\n                       (or (null? ks)\n                           (and (string? (car ks))\n                                (not (string=? (car ks) secret-placeholder))\n                                (loop (cdr ks))))))\n          (error \"config: set a secret (scm bin/gen-secret.scm prints one)\" name))\n        s))\n\n    (define (resolve-path root path)\n      \"Syntax: (resolve-path root path)\nLibrary: (app config)\nDescription: path itself if absolute, else path relative to root.\"\n      (if (and (> (string-length path) 0) (char=? (string-ref path 0) #\\/))\n          path\n          (string-append root \"/\" path)))))\n")
         ("src/app-db.sld" . ";; (app db) — database access: a connection pool, thin query helpers,\n;; transactions and the migration runner. Every query is parameterized\n;; ($1, $2, ...); values are never spliced into SQL strings, so there is no\n;; injection surface. Higher layers call db-rows / db-exec and never touch\n;; the driver.\n;;\n;; A db handle is either the pool or, inside with-db-transaction, the one\n;; connection the transaction runs on. The helpers accept both, so query\n;; functions work the same in and out of a transaction.\n\n(define-library (app db)\n  (import (scheme base)\n          (scm log)\n          (scm database postgres)\n          (rename (scm database migrations)\n                  (run-migrations! pg-migrations-run!)))\n  (export make-db with-db-transaction db-rows db-row db-scalar db-exec migrate!)\n  (begin\n\n    (define-record-type db\n      (%make-db pool conn)\n      db?\n      (pool db-pool)\n      (conn db-conn))\n\n    (define (make-db host port user password database pool-size)\n      \"Syntax: (make-db host port user password database pool-size)\nLibrary: (app db)\nDescription: A pooled database handle for the query helpers. Connections\n  are opened on first use.\"\n      (%make-db (make-pg-pool host port user password database pool-size) #f))\n\n    (define (with-conn db proc)\n      (if (db-conn db)\n          (proc (db-conn db))\n          (with-pg-pool-connection (db-pool db) proc)))\n\n    (define (with-db-transaction db proc)\n      \"Syntax: (with-db-transaction db proc)\nLibrary: (app db)\nDescription: Calls (proc tx) inside a transaction, where tx is a db handle\n  for the transaction's connection. Commits when proc returns; rolls back\n  and re-raises when it raises.\"\n      (if (db-conn db)\n          (proc db)                     ; already in one: join it\n          (with-pg-pool-connection (db-pool db)\n            (lambda (conn)\n              (with-pg-transaction conn\n                (lambda (conn) (proc (%make-db (db-pool db) conn))))))))\n\n    (define (db-rows db sql . params)\n      \"Syntax: (db-rows db sql [param ...])\nLibrary: (app db)\nDescription: Runs a parameterized query; returns the rows as a list of\n  alists keyed by column name.\"\n      (with-conn db\n        (lambda (c) (pg-result->alist-list (apply pg-query c sql params)))))\n\n    (define (db-row db sql . params)\n      \"Syntax: (db-row db sql [param ...])\nLibrary: (app db)\nDescription: The first row alist of the query, or #f if it has none.\"\n      (let ((rows (apply db-rows db sql params)))\n        (and (pair? rows) (car rows))))\n\n    (define (db-scalar db sql . params)\n      \"Syntax: (db-scalar db sql [param ...])\nLibrary: (app db)\nDescription: The first column of the first row (a count, a RETURNING id),\n  or #f if the query produced no rows.\"\n      (let ((row (apply db-row db sql params)))\n        (and row (cdr (car row)))))\n\n    (define (db-exec db sql . params)\n      \"Syntax: (db-exec db sql [param ...])\nLibrary: (app db)\nDescription: Runs a parameterized statement (INSERT/UPDATE/DELETE/DDL).\"\n      (with-conn db (lambda (c) (apply pg-exec c sql params))))\n\n    (define (migrate! db dir)\n      \"Syntax: (migrate! db dir)\nLibrary: (app db)\nDescription: Applies the pending .sql migrations in dir in lexical order,\n  each in its own transaction, and records them in schema_migrations.\"\n      (with-conn db\n        (lambda (conn)\n          (pg-migrations-run!\n            (lambda (sql) (pg-exec conn sql))\n            (lambda (sql) (pg-result-rows (pg-query conn sql)))\n            dir\n            `((log-proc ,(lambda (m) (log-info \"migrate\" m))))))))))\n")
         ("src/app-site.sld" . ";; (app site) — the URL prefix and asset URLs.\n;;\n;; The app can be mounted under a path (\"/team\"), with the reverse proxy\n;; passing paths through unchanged. Every route, link and redirect goes\n;; through url, and static files through asset. make-app in (app web) makes\n;; its site current for each request with with-site.\n\n(define-library (app site)\n  (import (scheme base)\n          (scm net http static))\n  (export make-site\n          site-prefix\n          with-site\n          url\n          asset\n          cookie-path)\n  (begin\n\n    (define-record-type site\n      (%make-site prefix static-url)\n      site?\n      (prefix site-prefix)\n      (static-url site-static-url))\n\n    (define current-site (make-parameter #f))\n\n    ;; \"\" or \"/\" -> \"\"; \"team/\" -> \"/team\"\n    (define (normalize-prefix p)\n      (let* ((s (if (and (> (string-length p) 0) (char=? (string-ref p 0) #\\/))\n                    p\n                    (string-append \"/\" p)))\n             (n (string-length s)))\n        (if (char=? (string-ref s (- n 1)) #\\/)\n            (substring s 0 (- n 1))\n            s)))\n\n    (define (make-site prefix static-dir)\n      \"Syntax: (make-site prefix static-dir)\nLibrary: (app site)\nDescription: A site mounted at prefix (\\\"\\\" for the host root) that serves\n  static-dir under prefix/static.\"\n      (let ((p (normalize-prefix prefix)))\n        (%make-site p (make-static-url static-dir (string-append p \"/static\")))))\n\n    (define (with-site site handler)\n      \"Syntax: (with-site site handler)\nLibrary: (app site)\nDescription: Wraps handler so url and asset refer to site while it runs.\"\n      (lambda (req)\n        (parameterize ((current-site site))\n          (handler req))))\n\n    (define (url path)\n      \"Syntax: (url path)\nLibrary: (app site)\nDescription: path under the current site's prefix: (url \\\"/login\\\").\"\n      (string-append (site-prefix (current-site)) path))\n\n    (define (asset rel)\n      \"Syntax: (asset rel)\nLibrary: (app site)\nDescription: The URL of static/rel with a ?v=<mtime> cache buster.\"\n      ((site-static-url (current-site)) rel))\n\n    (define (cookie-path site)\n      \"Syntax: (cookie-path site)\nLibrary: (app site)\nDescription: The cookie Path for site: \\\"/\\\", or \\\"/prefix/\\\" so that the\n  session cookie stays with this app when several share a host.\"\n      (string-append (site-prefix site) \"/\"))))\n")
         ("src/app-users.sld" . ";; (app users) — user, role and user-role queries. All SQL is parameterized\n;; through (app db), and every function takes a db handle, so it works the\n;; same inside a transaction. Rows are alists keyed by column name; read a\n;; field with (col row \"name\"). Password hashing lives in (app auth).\n\n(define-library (app users)\n  (import (scheme base)\n          (scheme char)\n          (app db))\n  (export col\n          valid-username? valid-role-name?\n          find-user-by-name load-user\n          list-users all-user-roles create-user! delete-user! set-password-hash!\n          list-roles create-role!\n          assign-role! assign-role-by-name! unassign-role!\n          user-role-names user-has-role? role-name)\n  (begin\n\n    (define (col row name) (cdr (assoc name row)))\n\n    ;; ids arrive from forms and the database as strings; bigint parameters\n    ;; take numbers.\n    (define (->int x)\n      (cond ((string? x) (string->number x))\n            ((exact-integer? x) x)\n            (else #f)))\n\n    (define (valid-name? s)\n      (and (string? s)\n           (<= 1 (string-length s) 64)\n           (let loop ((i 0))\n             (or (= i (string-length s))\n                 (let ((c (string-ref s i)))\n                   (and (or (char-alphabetic? c) (char-numeric? c)\n                            (memv c '(#\\. #\\_ #\\-)))\n                        (loop (+ i 1))))))))\n\n    (define (valid-username? s)\n      \"Syntax: (valid-username? s)\nLibrary: (app users)\nDescription: True if s is 1-64 characters of letters, digits and . _ -\"\n      (valid-name? s))\n\n    (define (valid-role-name? s)\n      \"Syntax: (valid-role-name? s)\nLibrary: (app users)\nDescription: Same rule as valid-username?.\"\n      (valid-name? s))\n\n    ;; --- users --------------------------------------------------------\n\n    (define (find-user-by-name db name)\n      (db-row db \"SELECT id, username, pass_hash FROM users WHERE username = $1\"\n              name))\n\n    (define (load-user db id)\n      (let ((n (->int id)))\n        (and n (db-row db \"SELECT id, username, pass_hash FROM users WHERE id = $1\" n))))\n\n    (define (list-users db)\n      \"Syntax: (list-users db)\nLibrary: (app users)\nDescription: All users, ordered by username. Pair with all-user-roles to\n  attach each user's roles.\"\n      (db-rows db \"SELECT id, username, created_at FROM users ORDER BY username\"))\n\n    (define (all-user-roles db)\n      \"Syntax: (all-user-roles db)\nLibrary: (app users)\nDescription: Every (user_id, role_id, name) assignment, so callers can\n  group roles by user without one query per user.\"\n      (db-rows db\n        (string-append\n         \"SELECT ur.user_id, r.id AS role_id, r.name \"\n         \"FROM user_roles ur JOIN roles r ON r.id = ur.role_id \"\n         \"ORDER BY r.name\")))\n\n    (define (create-user! db username hash)\n      \"Syntax: (create-user! db username hash)\nLibrary: (app users)\nDescription: Inserts a user with a password hash and returns the new id.\n  Raises on a duplicate username.\"\n      (db-scalar db\n        \"INSERT INTO users (username, pass_hash) VALUES ($1, $2) RETURNING id\"\n        username hash))\n\n    (define (delete-user! db id)\n      (db-exec db \"DELETE FROM users WHERE id = $1\" (->int id)))\n\n    (define (set-password-hash! db id hash)\n      (db-exec db \"UPDATE users SET pass_hash = $1 WHERE id = $2\" hash (->int id)))\n\n    ;; --- roles --------------------------------------------------------\n\n    (define (list-roles db)\n      (db-rows db \"SELECT id, name FROM roles ORDER BY name\"))\n\n    (define (role-name db id)\n      (let ((n (->int id)))\n        (and n (db-scalar db \"SELECT name FROM roles WHERE id = $1\" n))))\n\n    (define (create-role! db name)\n      \"Syntax: (create-role! db name)\nLibrary: (app users)\nDescription: Inserts a role; does nothing if it already exists.\"\n      (db-exec db\n        \"INSERT INTO roles (name) VALUES ($1) ON CONFLICT (name) DO NOTHING\"\n        name))\n\n    (define (assign-role! db user-id role-id)\n      (db-exec db\n        (string-append \"INSERT INTO user_roles (user_id, role_id) \"\n                       \"VALUES ($1, $2) ON CONFLICT DO NOTHING\")\n        (->int user-id) (->int role-id)))\n\n    (define (assign-role-by-name! db user-id role-name)\n      (db-exec db\n        (string-append\n         \"INSERT INTO user_roles (user_id, role_id) \"\n         \"SELECT $1, id FROM roles WHERE name = $2 ON CONFLICT DO NOTHING\")\n        (->int user-id) role-name))\n\n    (define (unassign-role! db user-id role-id)\n      (db-exec db \"DELETE FROM user_roles WHERE user_id = $1 AND role_id = $2\"\n               (->int user-id) (->int role-id)))\n\n    (define (user-role-names db user-id)\n      \"Syntax: (user-role-names db user-id)\nLibrary: (app users)\nDescription: The names of the user's roles.\"\n      (map (lambda (r) (col r \"name\"))\n           (db-rows db\n             (string-append\n              \"SELECT r.name FROM roles r \"\n              \"JOIN user_roles ur ON ur.role_id = r.id \"\n              \"WHERE ur.user_id = $1 ORDER BY r.name\")\n             (->int user-id))))\n\n    (define (user-has-role? db user-id name)\n      \"Syntax: (user-has-role? db user-id name)\nLibrary: (app users)\nDescription: True if the user holds the named role.\"\n      (and (db-row db\n             (string-append\n              \"SELECT 1 FROM user_roles ur \"\n              \"JOIN roles r ON r.id = ur.role_id \"\n              \"WHERE ur.user_id = $1 AND r.name = $2\")\n             (->int user-id) name)\n           #t))))\n")
         ("src/app-views.sld" . ";; (app views) — HTML rendering. All dynamic values flow through the\n;; auto-escaping (scm html builder); only fixed strings (the SVG icons) are\n;; emitted raw. No inline scripts or style attributes: the\n;; Content-Security-Policy forbids them.\n\n(define-library (app views)\n  (import (scheme base)\n          (scm html builder)\n          (app site)\n          (app users))            ; col\n  (export login-page home-page profile-page admin-page error-page)\n  (begin\n\n    (define theme-icons\n      (raw (string-append\n            \"<svg class=\\\"i-sun\\\" viewBox=\\\"0 0 24 24\\\" width=\\\"20\\\" height=\\\"20\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" aria-hidden=\\\"true\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\"/><path d=\\\"M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4\\\"/></svg>\"\n            \"<svg class=\\\"i-moon\\\" viewBox=\\\"0 0 24 24\\\" width=\\\"20\\\" height=\\\"20\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" aria-hidden=\\\"true\\\"><path d=\\\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\\\"/></svg>\")))\n\n    ;; who: #f when signed out, else (username admin?).\n    (define (page title who body)\n      (string-append\n       (html->string\n        (html5\n         '(@ (lang \"en\"))\n         `(head\n           (meta (@ (charset \"utf-8\")))\n           (meta (@ (name \"viewport\") (content \"width=device-width, initial-scale=1\")))\n           (title ,(string-append title \" · Starter Admin\"))\n           (link (@ (rel \"icon\") (href ,(asset \"favicon.svg\"))))\n           (link (@ (rel \"stylesheet\") (href ,(asset \"css/app.css\"))))\n           (script (@ (src ,(asset \"js/theme-init.js\"))))\n           (script (@ (src ,(asset \"js/theme-toggle.js\")) (defer #t))))\n         `(body\n           (header (@ (class \"app-header\"))\n             (h1 (a (@ (href ,(url \"/\"))) \"Starter Admin\"))\n             (nav (@ (class \"nav\"))\n               ;; The username links to the profile page, which is where\n               ;; signing out lives. Admins also get the console.\n               ,@(if who\n                     `(,@(if (cadr who) `((a (@ (href ,(url \"/admin\"))) \"Admin\")) '())\n                       (a (@ (href ,(url \"/profile\")) (class \"who\")) ,(car who)))\n                     '())\n               (button (@ (class \"icon-btn js-theme-toggle\") (type \"button\")\n                          (aria-label \"Toggle dark mode\"))\n                 ,theme-icons)))\n           (main ,body))))\n       \"\\n\"))\n\n    ;; msg: #f, or (kind . text) with kind 'error or 'success.\n    (define (notice msg)\n      (if msg\n          `(p (@ (class ,(string-append \"notice \" (symbol->string (car msg)))))\n              ,(cdr msg))\n          \"\"))\n\n    (define (login-page error?)\n      (page \"Sign in\" #f\n        `(section (@ (class \"card narrow\"))\n           (h2 \"Sign in\")\n           ,(notice (and error? '(error . \"Invalid username or password.\")))\n           (form (@ (method \"post\") (action ,(url \"/login\")))\n             (label \"Username\"\n               (input (@ (name \"username\") (autocomplete \"username\")\n                         (autofocus #t) (required #t))))\n             (label \"Password\"\n               (input (@ (name \"password\") (type \"password\")\n                         (autocomplete \"current-password\") (required #t))))\n             (button (@ (type \"submit\") (class \"primary\")) \"Sign in\")))))\n\n    (define (comma-list items)\n      (let loop ((xs items) (acc \"\"))\n        (cond ((null? xs) acc)\n              ((string=? acc \"\") (loop (cdr xs) (car xs)))\n              (else (loop (cdr xs) (string-append acc \", \" (car xs)))))))\n\n    (define (home-page username roles admin?)\n      (page \"Home\" (list username admin?)\n        `(section\n           (h2 \"Welcome, \" ,username)\n           (p \"Your roles: \"\n              ,(if (null? roles) '(em \"none\") (comma-list roles)))\n           ,(if admin?\n                `(p (a (@ (href ,(url \"/admin\"))) \"Open the admin console →\"))\n                \"\"))))\n\n    (define (profile-page username admin? msg)\n      (page \"Profile\" (list username admin?)\n        `(section (@ (class \"card narrow\"))\n           (h2 \"Profile\")\n           ,(notice msg)\n           (p \"Change the password for \" (strong ,username) \".\")\n           (form (@ (method \"post\") (action ,(url \"/profile/password\")))\n             (label \"Current password\"\n               (input (@ (name \"current\") (type \"password\")\n                         (autocomplete \"current-password\") (required #t))))\n             (label \"New password\"\n               (input (@ (name \"new\") (type \"password\") (minlength \"8\")\n                         (autocomplete \"new-password\") (required #t))))\n             (label \"Confirm new password\"\n               (input (@ (name \"confirm\") (type \"password\") (minlength \"8\")\n                         (autocomplete \"new-password\") (required #t))))\n             (button (@ (type \"submit\") (class \"primary\")) \"Update password\"))\n           (form (@ (method \"post\") (action ,(url \"/logout\")) (class \"logout-form\"))\n             (button (@ (type \"submit\")) \"Sign out\")))))\n\n    ;; --- admin console ------------------------------------------------\n\n    (define (id->string x) (if (number? x) (number->string x) x))\n\n    (define (role-chip user-id assignment)\n      ;; assignment: alist (user_id role_id name); removed via a small form.\n      `(form (@ (method \"post\")\n                (action ,(url (string-append \"/admin/users/\" user-id \"/roles/\"\n                                             (id->string (col assignment \"role_id\"))\n                                             \"/delete\")))\n                (class \"chip\"))\n         (span ,(col assignment \"name\"))\n         (button (@ (class \"chip-x\") (type \"submit\") (title \"Remove role\")\n                    (aria-label ,(string-append \"Remove role \" (col assignment \"name\"))))\n                 \"×\")))\n\n    (define (assign-form user-id roles)\n      `(form (@ (method \"post\")\n                (action ,(url (string-append \"/admin/users/\" user-id \"/roles\")))\n                (class \"assign\"))\n         (select (@ (name \"role_id\") (aria-label \"Role\"))\n           ,@(map (lambda (r)\n                    `(option (@ (value ,(id->string (col r \"id\")))) ,(col r \"name\")))\n                  roles))\n         (button (@ (type \"submit\")) \"Assign\")))\n\n    (define (user-row user roles assignments self-id)\n      (let* ((uid (id->string (col user \"id\")))\n             (self? (string=? uid self-id))\n             (mine (let loop ((as assignments))\n                     (cond ((null? as) '())\n                           ((string=? (id->string (col (car as) \"user_id\")) uid)\n                            (cons (car as) (loop (cdr as))))\n                           (else (loop (cdr as)))))))\n        `(tr\n          (td ,(col user \"username\")\n              ,(if self? '(span (@ (class \"muted\")) \" (you)\") \"\"))\n          (td (div (@ (class \"chips\"))\n                ,@(if (null? mine)\n                      '((span (@ (class \"muted\")) \"—\"))\n                      (map (lambda (a) (role-chip uid a)) mine))))\n          (td ,(if (null? roles) \"\" (assign-form uid roles)))\n          (td ,(if self?\n                   \"\"                   ; never offer to delete yourself\n                   `(form (@ (method \"post\")\n                             (action ,(url (string-append \"/admin/users/\" uid \"/delete\")))\n                             (class \"inline\"))\n                      (button (@ (class \"danger\") (type \"submit\")) \"Delete\")))))))\n\n    (define (admin-page username self-id users roles assignments msg)\n      (page \"Admin\" (list username #t)\n        `(section\n           (h2 \"Users\")\n           ,(notice msg)\n           (table (@ (class \"data\"))\n             (thead (tr (th \"User\") (th \"Roles\") (th \"Assign\") (th \"\")))\n             (tbody\n              ,@(map (lambda (u) (user-row u roles assignments (id->string self-id)))\n                     users)))\n\n           (h3 \"Add user\")\n           (form (@ (method \"post\") (action ,(url \"/admin/users\")) (class \"row-form\"))\n             (input (@ (name \"username\") (placeholder \"username\")\n                       (aria-label \"Username\") (required #t)))\n             (input (@ (name \"password\") (type \"password\") (minlength \"8\")\n                       (autocomplete \"new-password\")\n                       (placeholder \"password (min 8)\") (aria-label \"Password\")\n                       (required #t)))\n             (label (@ (class \"check\"))\n               (input (@ (type \"checkbox\") (name \"admin\") (value \"1\")))\n               \" admin\")\n             (button (@ (type \"submit\") (class \"primary\")) \"Create user\"))\n\n           (h2 \"Roles\")\n           ,(if (null? roles)\n                '(p (@ (class \"muted\")) \"No roles yet.\")\n                `(ul (@ (class \"roles\"))\n                   ,@(map (lambda (r) `(li ,(col r \"name\"))) roles)))\n           (h3 \"Add role\")\n           (form (@ (method \"post\") (action ,(url \"/admin/roles\")) (class \"row-form\"))\n             (input (@ (name \"name\") (placeholder \"role name\")\n                       (aria-label \"Role name\") (required #t)))\n             (button (@ (type \"submit\") (class \"primary\")) \"Create role\")))))\n\n    (define (error-page)\n      (page \"Error\" #f\n        '(section (h2 \"Something went wrong\")\n                  (p \"The error has been logged.\"))))))\n")
         ("src/app-web.sld" . ";; (app web) — routes, request handlers and the middleware stack.\n;;\n;; make-app returns the server-level handler (lambda (req) resp): bin/server.scm\n;; serves it, and the tests call it directly with a request.\n;;\n;; The privileged role is \"admin\"; bin/seed-admin.scm creates it and grants\n;; it to the first user. Forms need no CSRF token: the session cookie is\n;; SameSite=Strict, so the browser never sends it with a request that\n;; another site started.\n\n(define-library (app web)\n  (import (scheme base)\n          (srfi 18)\n          (scm crypto password)\n          (scm net http request)\n          (scm net http response)\n          (scm net http route)\n          (scm net http forms)\n          (scm net http static)\n          (scm net http session)\n          (scm net http middleware)\n          (app site)\n          (app db)\n          (app users)\n          (app auth)\n          (app views))\n  (export make-app admin-role)\n  (begin\n\n    (define admin-role \"admin\")\n    (define cookie-name \"starter_admin_session\")\n\n    (define (setting settings key)\n      (let ((p (assq key settings)))\n        (if p (cdr p) (error \"make-app: missing setting\" key))))\n\n    ;; 303 to a path in the app, optionally with header pairs (cookies).\n    (define (redirect path . headers)\n      (make-http-response 303 (cons (cons \"Location\" (url path)) headers) \"\"))\n\n    ;; A failed password check costs the client half a second, which slows\n    ;; down guessing.\n    (define (penalty) (thread-sleep! 0.5))\n\n    (define (id->string x) (if (number? x) (number->string x) x))\n\n    ;; Admin console results travel across the POST/redirect/GET as a code\n    ;; in the query string: /admin?m=<code>.\n    (define notices\n      '((\"user-created\"   success . \"User created.\")\n        (\"user-deleted\"   success . \"User deleted.\")\n        (\"role-created\"   success . \"Role created.\")\n        (\"role-assigned\"  success . \"Role assigned.\")\n        (\"role-removed\"   success . \"Role removed.\")\n        (\"dup-user\"       error   . \"That username is already taken.\")\n        (\"bad-username\"   error   . \"Invalid username (letters, digits, . _ -).\")\n        (\"short-password\" error   . \"Password must be at least 8 characters.\")\n        (\"bad-role\"       error   . \"Invalid role name.\")\n        (\"self-delete\"    error   . \"You cannot delete your own account.\")\n        (\"self-admin\"     error   . \"You cannot remove your own admin role.\")))\n\n    (define (notice-from-query req)\n      (let* ((q (url-query-params (http-request-url req)))\n             (code (assoc \"m\" q))\n             (n (and code (assoc (cdr code) notices))))\n        (and n (cons (cadr n) (cddr n)))))\n\n    (define (to-admin code) (redirect (string-append \"/admin?m=\" code)))\n\n    (define (make-app settings)\n      \"Syntax: (make-app settings)\nLibrary: (app web)\nDescription: Builds the app's request handler. settings is an alist:\n  url-prefix, static-dir (absolute path), db (from make-db),\n  session-secret, session-max-age (seconds), secure-cookies?.\"\n      (let* ((site (make-site (setting settings 'url-prefix)\n                              (setting settings 'static-dir)))\n             (prefix (site-prefix site))\n             (db (setting settings 'db))\n             (auth (make-auth\n                    (make-session-config\n                     cookie-name\n                     (setting settings 'session-secret)\n                     (setting settings 'session-max-age)\n                     `((path . ,(cookie-path site))\n                       (secure? . ,(setting settings 'secure-cookies?))))\n                    db))\n             (router (make-router)))\n\n        (define (route! method path handler)\n          (router-add! router method (string-append prefix path) handler))\n\n        (define (admin? user)\n          (user-has-role? db (col user \"id\") admin-role))\n\n        ;; Runs handler with the signed-in user row as a third argument, or\n        ;; sends the browser to the sign-in page.\n        (define (signed-in handler)\n          (lambda (req params)\n            (let ((user (session-user auth req)))\n              (if user (handler req params user) (redirect \"/login\")))))\n\n        (define (admin-only handler)\n          (signed-in\n            (lambda (req params user)\n              (if (admin? user)\n                  (handler req params user)\n                  (http-forbidden \"Admins only\")))))\n\n        (route! \"GET\" \"/static/*\" (make-static-handler (setting settings 'static-dir)))\n\n        (route! \"GET\" \"/\"\n          (signed-in\n            (lambda (req params user)\n              (let ((roles (user-role-names db (col user \"id\"))))\n                (html-response\n                 (home-page (col user \"username\") roles\n                            (and (member admin-role roles) #t)))))))\n\n        ;; --- sign-in ---\n\n        (route! \"GET\" \"/login\"\n          (lambda (req params)\n            (if (session-user auth req)\n                (redirect \"/\")\n                (html-response (login-page #f)))))\n\n        (route! \"POST\" \"/login\"\n          (lambda (req params)\n            (let* ((form (http-request-form req))\n                   (user (sign-in auth (form-ref form \"username\" \"\")\n                                  (form-ref form \"password\" \"\"))))\n              (if user\n                  (redirect \"/\" (start-session auth user))\n                  (begin (penalty) (html-response (login-page #t)))))))\n\n        (route! \"POST\" \"/logout\"\n          (lambda (req params) (redirect \"/login\" (end-session auth))))\n\n        ;; --- profile ---\n\n        (route! \"GET\" \"/profile\"\n          (signed-in\n            (lambda (req params user)\n              (let ((done? (assoc \"updated\" (url-query-params (http-request-url req)))))\n                (html-response\n                 (profile-page (col user \"username\") (admin? user)\n                               (and done? '(success . \"Password updated.\"))))))))\n\n        (route! \"POST\" \"/profile/password\"\n          (signed-in\n            (lambda (req params user)\n              (let* ((form (http-request-form req))\n                     (new (form-ref form \"new\" \"\"))\n                     (fail (lambda (text)\n                             (html-response\n                              (profile-page (col user \"username\") (admin? user)\n                                            (cons 'error text))))))\n                (cond\n                  ((not (sign-in auth (col user \"username\") (form-ref form \"current\" \"\")))\n                   (penalty)\n                   (fail \"Current password is incorrect.\"))\n                  ((< (string-length new) min-password-length)\n                   (fail \"New password must be at least 8 characters.\"))\n                  ((not (string=? new (form-ref form \"confirm\" \"\")))\n                   (fail \"New passwords do not match.\"))\n                  (else\n                   ;; The new hash ends all other sessions; this browser\n                   ;; gets a fresh cookie.\n                   (let ((user (change-password! auth user new)))\n                     (redirect \"/profile?updated\" (start-session auth user)))))))))\n\n        ;; --- admin console ---\n\n        (route! \"GET\" \"/admin\"\n          (admin-only\n            (lambda (req params user)\n              (html-response\n               (admin-page (col user \"username\") (col user \"id\")\n                           (list-users db) (list-roles db)\n                           (all-user-roles db) (notice-from-query req))))))\n\n        (route! \"POST\" \"/admin/users\"\n          (admin-only\n            (lambda (req params user)\n              (let* ((form (http-request-form req))\n                     (username (form-ref form \"username\" \"\"))\n                     (password (form-ref form \"password\" \"\")))\n                (cond\n                  ((not (valid-username? username)) (to-admin \"bad-username\"))\n                  ((< (string-length password) min-password-length)\n                   (to-admin \"short-password\"))\n                  ((find-user-by-name db username) (to-admin \"dup-user\"))\n                  (else\n                   ;; The user and the admin role together, or neither.\n                   (with-db-transaction db\n                     (lambda (tx)\n                       (let ((id (create-user! tx username (password-hash password))))\n                         (when (form-ref form \"admin\" #f)\n                           (create-role! tx admin-role)\n                           (assign-role-by-name! tx id admin-role)))))\n                   (to-admin \"user-created\")))))))\n\n        (route! \"POST\" \"/admin/users/:id/delete\"\n          (admin-only\n            (lambda (req params user)\n              (if (equal? (params-ref params \"id\") (id->string (col user \"id\")))\n                  (to-admin \"self-delete\")\n                  (begin\n                    (delete-user! db (params-ref params \"id\"))\n                    (to-admin \"user-deleted\"))))))\n\n        (route! \"POST\" \"/admin/roles\"\n          (admin-only\n            (lambda (req params user)\n              (let ((name (form-ref (http-request-form req) \"name\" \"\")))\n                (if (valid-role-name? name)\n                    (begin (create-role! db name) (to-admin \"role-created\"))\n                    (to-admin \"bad-role\"))))))\n\n        (route! \"POST\" \"/admin/users/:id/roles\"\n          (admin-only\n            (lambda (req params user)\n              (assign-role! db (params-ref params \"id\")\n                            (form-ref (http-request-form req) \"role_id\" \"\"))\n              (to-admin \"role-assigned\"))))\n\n        (route! \"POST\" \"/admin/users/:id/roles/:rid/delete\"\n          (admin-only\n            (lambda (req params user)\n              (let ((uid (params-ref params \"id\"))\n                    (rid (params-ref params \"rid\")))\n                ;; Keep at least the admin who is doing this.\n                (if (and (equal? uid (id->string (col user \"id\")))\n                         (equal? (role-name db rid) admin-role))\n                    (to-admin \"self-admin\")\n                    (begin\n                      (unassign-role! db uid rid)\n                      (to-admin \"role-removed\")))))))\n\n        ;; Outside the prefix: the health probe talks to the app directly.\n        (router-add! router \"GET\" \"/healthz\"\n          (lambda (req params) (text-response \"ok\\n\")))\n\n        ;; Outermost first: log every request, add the security headers,\n        ;; make the site current for url/asset, and turn errors into a\n        ;; logged 500 page.\n        (with-access-log\n         (with-security-headers\n          (with-site site\n           (with-error-handler (router->handler router)\n                               (lambda (req) (html-response (error-page)))))))))))\n")
         ("static/favicon.svg" . "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\"><rect width=\"32\" height=\"32\" rx=\"6\" fill=\"#2563eb\"/><path d=\"M9 11h14M9 16h14M9 21h9\" stroke=\"#fff\" stroke-width=\"2.5\" stroke-linecap=\"round\"/></svg>\n")
         ("static/css/app.css" . "/* Theme tokens. Colours are only written here, each as\n   light-dark(<light>, <dark>). The palette follows the OS setting unless\n   the user pinned one with the toggle: theme-init.js / theme-toggle.js\n   set data-theme on <html>, which fixes color-scheme. Works without\n   JavaScript too (then it simply follows the OS). */\n:root {\n  color-scheme: light dark;\n\n  --bg:     light-dark(#ffffff, #16181d);\n  --fg:     light-dark(#1a1a1a, #e8e8e8);\n  --muted:  light-dark(#666666, #9aa0aa);\n  --border: light-dark(#e2e2e2, #2c2f36);\n  --row:    light-dark(#fafafa, #1d2026);\n  --accent: light-dark(#2563eb, #6ea8fe);\n  --card:   light-dark(#fbfbfb, #1b1e24);\n  --danger: light-dark(#b91c1c, #f87171);\n  --ok:     light-dark(#15803d, #4ade80);\n  --chip:    light-dark(#eef2ff, #232a3d);\n  --chip-fg: light-dark(#3730a3, #c7d2fe);\n  --on-accent: light-dark(#ffffff, #0f172a);\n}\n:root[data-theme=\"light\"] { color-scheme: light; }\n:root[data-theme=\"dark\"]  { color-scheme: dark; }\n\n/* The toggle shows a moon in light mode and a sun in dark mode. */\n.i-sun { display: none; }\n:root[data-theme=\"dark\"] .i-sun  { display: inline; }\n:root[data-theme=\"dark\"] .i-moon { display: none; }\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"]) .i-sun  { display: inline; }\n  :root:not([data-theme=\"light\"]) .i-moon { display: none; }\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  font: 16px/1.5 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  color: var(--fg);\n  background: var(--bg);\n}\n\na { color: var(--accent); }\n\n.app-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding: 0.75rem 1.25rem;\n  border-bottom: 1px solid var(--border);\n}\n.app-header h1 { font-size: 1.25rem; margin: 0; }\n.app-header h1 a { color: inherit; text-decoration: none; }\n\n.nav { display: flex; align-items: center; gap: 1rem; }\n.nav a { color: var(--accent); text-decoration: none; }\n.nav a:hover { text-decoration: underline; }\n/* The username link is quieter than a regular nav link. */\n.nav a.who { color: var(--muted); }\n.nav a.who:hover { color: var(--accent); }\n\n.icon-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 2.25rem;\n  height: 2.25rem;\n  padding: 0;\n  color: var(--fg);\n  background: transparent;\n  border: 1px solid var(--border);\n  border-radius: 0.5rem;\n  cursor: pointer;\n}\n.icon-btn:hover { border-color: var(--accent); color: var(--accent); }\n\nmain { max-width: 860px; margin: 2rem auto; padding: 0 1.25rem; }\nh2 { margin-top: 2rem; }\n.card h2 { margin-top: 0; }\n.muted { color: var(--muted); }\n.inline { display: inline; margin: 0; }\n\ntable.data { width: 100%; border-collapse: collapse; }\ntable.data th, table.data td {\n  padding: 0.5rem 0.75rem;\n  text-align: left;\n  border-bottom: 1px solid var(--border);\n}\ntable.data thead th { color: var(--muted); font-weight: 600; }\ntable.data td { vertical-align: middle; }\ntable.data tbody tr:nth-child(even) { background: var(--row); }\ntable.data .num { text-align: right; font-variant-numeric: tabular-nums; }\n\n.card {\n  background: var(--card);\n  border: 1px solid var(--border);\n  border-radius: 0.75rem;\n  padding: 1.5rem;\n}\n.narrow { max-width: 22rem; margin: 3rem auto; }\n\nform label { display: block; margin-bottom: 0.85rem; font-weight: 600; }\nform input, form select {\n  display: block;\n  width: 100%;\n  margin-top: 0.25rem;\n  padding: 0.5rem 0.6rem;\n  font: inherit;\n  color: var(--fg);\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 0.4rem;\n}\nform input:focus, form select:focus { outline: 2px solid var(--accent); outline-offset: 1px; }\n\nbutton.primary {\n  margin-top: 0.5rem;\n  padding: 0.55rem 1.1rem;\n  font: inherit;\n  font-weight: 600;\n  color: var(--on-accent);\n  background: var(--accent);\n  border: 0;\n  border-radius: 0.4rem;\n  cursor: pointer;\n}\nbutton.primary:hover { filter: brightness(1.05); }\n\n/* Sign out, separated from the password form at the bottom of the card. */\n.logout-form {\n  margin-top: 1.25rem;\n  padding-top: 1rem;\n  border-top: 1px solid var(--border);\n}\n.logout-form button {\n  padding: 0.5rem 1.1rem;\n  font: inherit;\n  color: var(--fg);\n  background: transparent;\n  border: 1px solid var(--border);\n  border-radius: 0.4rem;\n  cursor: pointer;\n}\n.logout-form button:hover { border-color: var(--accent); color: var(--accent); }\n\n.notice { padding: 0.6rem 0.8rem; border-radius: 0.4rem; margin: 0 0 1rem; }\n.notice.error { color: var(--danger); border: 1px solid var(--danger); }\n.notice.success { color: var(--ok); border: 1px solid var(--ok); }\n\nbutton.danger {\n  padding: 0.3rem 0.7rem;\n  font: inherit;\n  color: var(--danger);\n  background: transparent;\n  border: 1px solid var(--danger);\n  border-radius: 0.4rem;\n  cursor: pointer;\n}\nbutton.danger:hover { color: var(--on-accent); background: var(--danger); }\n\n/* One-line \"add\" forms under each section. */\n.row-form {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.6rem;\n  align-items: center;\n  margin: 0.75rem 0 0;\n}\n.row-form input { width: auto; flex: 1 1 12rem; margin-top: 0; }\n.row-form button { flex: 0 0 auto; margin-top: 0; }\n.row-form label.check {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.3rem;\n  margin: 0;\n  font-weight: normal;\n}\n.row-form label.check input { flex: none; width: auto; margin: 0; }\n\n/* Role chips with an inline remove button. */\n.chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }\n.chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.25rem;\n  margin: 0;\n  padding: 0.1rem 0.2rem 0.1rem 0.5rem;\n  color: var(--chip-fg);\n  background: var(--chip);\n  border-radius: 999px;\n  font-size: 0.85rem;\n}\n.chip-x {\n  padding: 0 0.25rem;\n  font: inherit;\n  font-size: 1rem;\n  line-height: 1;\n  color: inherit;\n  background: none;\n  border: 0;\n  cursor: pointer;\n}\n.chip-x:hover { color: var(--danger); }\n\n.assign { display: flex; gap: 0.35rem; align-items: center; margin: 0; }\n.assign select { width: auto; margin-top: 0; }\n.assign button {\n  padding: 0.35rem 0.7rem;\n  font: inherit;\n  color: var(--accent);\n  background: transparent;\n  border: 1px solid var(--border);\n  border-radius: 0.4rem;\n  cursor: pointer;\n}\n\nul.roles { margin: 0.5rem 0 0; padding-left: 1.2rem; }\n")
         ("static/js/theme-init.js" . "// Loaded in <head> without defer: applies a theme the user pinned with the\n// toggle before the first paint, so the page never flashes the wrong\n// palette. Nothing pinned: the CSS follows the OS setting.\n(function () {\n  try {\n    var t = localStorage.getItem(\"theme\");\n    if (t === \"dark\" || t === \"light\") {\n      document.documentElement.setAttribute(\"data-theme\", t);\n    }\n  } catch (e) {}\n})();\n")
         ("static/js/theme-toggle.js" . "// Wires every .js-theme-toggle button: flips the theme in effect (the\n// pinned one, else the OS setting) and remembers the choice.\n(function () {\n  function current() {\n    var t = document.documentElement.getAttribute(\"data-theme\");\n    if (t === \"dark\" || t === \"light\") return t;\n    return window.matchMedia(\"(prefers-color-scheme: dark)\").matches\n      ? \"dark\"\n      : \"light\";\n  }\n  document.querySelectorAll(\".js-theme-toggle\").forEach(function (btn) {\n    btn.addEventListener(\"click\", function () {\n      var next = current() === \"dark\" ? \"light\" : \"dark\";\n      document.documentElement.setAttribute(\"data-theme\", next);\n      try {\n        localStorage.setItem(\"theme\", next);\n      } catch (e) {}\n    });\n  });\n})();\n")
         ("tests/test_live_web.scm" . ";; Tests against a real PostgreSQL database: sign-in, sessions, the admin\n;; console, transactions. They DROP the app's tables first, so they only run\n;; against a database whose name ends in \"_test\", given by a config file:\n;;\n;;   STARTER_ADMIN_TEST_CONFIG=tests/test-config.scm scm tests/test_live_web.scm\n;;\n;; (a copy of config.scm with db-name \"starter_admin_test\"). Without the\n;; variable the tests are skipped.\n\n(import (scheme base)\n        (scheme process-context)\n        (scheme write)\n        (scm module)\n        (scm fs)\n        (scm log)\n        (scm string)\n        (scm test)\n        (scm crypto)\n        (scm crypto password)\n        (scm net http request)\n        (scm net http response))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config) (app db) (app users) (app web))\n\n(test-runner-factory scm-test-runner)\n(test-begin \"starter-admin web (live database)\")\n\n(define config-path (get-environment-variable \"STARTER_ADMIN_TEST_CONFIG\"))\n\n(define (run-tests cfg)\n  (define fast-iterations 1000)\n  (define db\n    (make-db (config-ref cfg 'db-host \"127.0.0.1\") (config-ref cfg 'db-port 5432)\n             (config-ref cfg 'db-user \"\") (config-ref cfg 'db-password \"\")\n             (config-ref cfg 'db-name \"\") 2))\n  (define app\n    (make-app `((url-prefix . \"\")\n                (static-dir . ,(string-append root \"/static\"))\n                (db . ,db)\n                (session-secret . ,(base64-encode (random-bytes 32)))\n                (session-max-age . 3600)\n                (secure-cookies? . #f))))\n  (define (send method url cookie . form)\n    (parameterize ((log-port (open-output-string))\n                   (password-pbkdf2-iterations fast-iterations))\n      (app (make-http-request\n            method url\n            (append (if cookie (list (cons \"Cookie\" cookie)) '())\n                    (if (pair? form)\n                        '((\"Content-Type\" . \"application/x-www-form-urlencoded\"))\n                        '()))\n            (if (pair? form) (car form) #f)))))\n  (define (location r) (http-response-header r \"Location\"))\n  (define (body r)\n    (let ((b (http-response-body r)))\n      (if (bytevector? b) (utf8->string b) b)))\n  (define (has? s part) (and (string? s) (string-contains-from s part 0) #t))\n  (define (cookie-of r)\n    (let ((h (http-response-header r \"Set-Cookie\")))\n      (and h (car (string-split-char h #\\;)))))\n  (define (sign-in name password)\n    (cookie-of (send \"POST\" \"/login\" #f\n                     (string-append \"username=\" name \"&password=\" password))))\n  (define (user-id name) (let ((id (col (find-user-by-name db name) \"id\")))\n                           (if (number? id) (number->string id) id)))\n\n  ;; A fresh schema, and an admin as bin/seed-admin.scm makes one.\n  (db-exec db \"DROP TABLE IF EXISTS user_roles, roles, users, schema_migrations\")\n  (parameterize ((log-port (open-output-string)))\n    (migrate! db (string-append root \"/migrations\")))\n  (with-db-transaction db\n    (lambda (tx)\n      (create-role! tx admin-role)\n      (assign-role-by-name!\n       tx\n       (create-user! tx \"root\"\n                     (parameterize ((password-pbkdf2-iterations fast-iterations))\n                       (password-hash \"rootpassword\")))\n       admin-role)))\n\n  (let ((admin (sign-in \"root\" \"rootpassword\")))\n    (test-group \"admin signs in\"\n      (test-assert admin)\n      (test-assert (has? (body (send \"GET\" \"/\" admin)) \"Welcome, root\"))\n      (test-equal 200 (http-response-status (send \"GET\" \"/admin\" admin))))\n\n    (test-group \"create users\"\n      (test-equal \"/admin?m=user-created\"\n        (location (send \"POST\" \"/admin/users\" admin \"username=bob&password=bobpassword\")))\n      (test-equal \"/admin?m=dup-user\"\n        (location (send \"POST\" \"/admin/users\" admin \"username=bob&password=bobpassword\")))\n      (test-equal \"/admin?m=bad-username\"\n        (location (send \"POST\" \"/admin/users\" admin \"username=b+b&password=bobpassword\")))\n      (test-equal \"/admin?m=short-password\"\n        (location (send \"POST\" \"/admin/users\" admin \"username=eve&password=short\")))\n      (test-equal \"/admin?m=user-created\"\n        (location (send \"POST\" \"/admin/users\" admin \"username=ann&password=annpassword&admin=1\")))\n      (test-equal '(\"admin\") (user-role-names db (user-id \"ann\")))\n      (test-equal '() (user-role-names db (user-id \"bob\")))\n      (test-assert (has? (body (send \"GET\" \"/admin?m=user-created\" admin)) \"User created.\")))\n\n    (test-group \"a failed transaction leaves nothing behind\"\n      (test-error\n       (with-db-transaction db\n         (lambda (tx)\n           (create-user! tx \"ghost\" \"x\")\n           (error \"boom\"))))\n      (test-equal #f (find-user-by-name db \"ghost\")))\n\n    (test-group \"non-admins are kept out\"\n      (let ((bob (sign-in \"bob\" \"bobpassword\")))\n        (test-equal 200 (http-response-status (send \"GET\" \"/\" bob)))\n        (test-equal 403 (http-response-status (send \"GET\" \"/admin\" bob)))\n        (test-equal 403 (http-response-status\n                         (send \"POST\" \"/admin/roles\" bob \"name=hackers\")))\n        (test-assert (not (has? (body (send \"GET\" \"/\" bob)) \"/admin\\\"\")))))\n\n    (test-group \"roles\"\n      (test-equal \"/admin?m=role-created\"\n        (location (send \"POST\" \"/admin/roles\" admin \"name=editor\")))\n      (test-equal \"/admin?m=bad-role\"\n        (location (send \"POST\" \"/admin/roles\" admin \"name=a+b\")))\n      (let ((rid (let ((r (assoc \"editor\" (map (lambda (r) (cons (col r \"name\") (col r \"id\")))\n                                               (list-roles db)))))\n                   (if (number? (cdr r)) (number->string (cdr r)) (cdr r)))))\n        (send \"POST\" (string-append \"/admin/users/\" (user-id \"bob\") \"/roles\") admin\n              (string-append \"role_id=\" rid))\n        (test-equal '(\"editor\") (user-role-names db (user-id \"bob\")))\n        (send \"POST\" (string-append \"/admin/users/\" (user-id \"bob\") \"/roles/\" rid \"/delete\") admin)\n        (test-equal '() (user-role-names db (user-id \"bob\")))))\n\n    (test-group \"an admin cannot lock themselves out\"\n      (let ((admin-rid (let ((id (db-scalar db \"SELECT id FROM roles WHERE name = $1\" admin-role)))\n                         (if (number? id) (number->string id) id))))\n        (test-equal \"/admin?m=self-admin\"\n          (location (send \"POST\" (string-append \"/admin/users/\" (user-id \"root\")\n                                                \"/roles/\" admin-rid \"/delete\")\n                          admin)))\n        (test-equal \"/admin?m=self-delete\"\n          (location (send \"POST\" (string-append \"/admin/users/\" (user-id \"root\") \"/delete\")\n                          admin)))))\n\n    (test-group \"sessions end with the user or the password\"\n      (let ((bob (sign-in \"bob\" \"bobpassword\"))\n            (bob2 (sign-in \"bob\" \"bobpassword\")))\n        (let ((fresh (cookie-of (send \"POST\" \"/profile/password\" bob\n                                      \"current=bobpassword&new=bobsnewpass&confirm=bobsnewpass\"))))\n          (test-assert fresh)\n          (test-equal \"/login\" (location (send \"GET\" \"/\" bob2)))\n          (test-equal 200 (http-response-status (send \"GET\" \"/\" fresh)))\n          (send \"POST\" (string-append \"/admin/users/\" (user-id \"bob\") \"/delete\") admin)\n          (test-equal #f (find-user-by-name db \"bob\"))\n          (test-equal \"/login\" (location (send \"GET\" \"/\" fresh))))))\n\n    (test-group \"outdated hashes are upgraded at sign-in\"\n      (parameterize ((password-pbkdf2-iterations 500))\n        (create-user! db \"old\" (password-hash \"oldpassword\")))\n      (test-assert (sign-in \"old\" \"oldpassword\"))\n      (test-assert\n       (not (parameterize ((password-pbkdf2-iterations fast-iterations))\n              (password-needs-rehash? (col (find-user-by-name db \"old\") \"pass_hash\"))))))))\n\n(cond\n  ((not config-path)\n   (display \"skipped: set STARTER_ADMIN_TEST_CONFIG to a config for a *_test database\\n\"))\n  (else\n   (let* ((cfg (read-config config-path))\n          (name (config-ref cfg 'db-name \"\")))\n     (if (and (>= (string-length name) 5)\n              (string=? (substring name (- (string-length name) 5) (string-length name))\n                        \"_test\"))\n         (run-tests cfg)\n         (error \"refusing to run: db-name must end in _test\" name)))))\n\n(test-end \"starter-admin web (live database)\")\n")
         ("tests/test_pure_config.scm" . ";; Tests for (app config). Run: scm tests/test_pure_config.scm\n\n(import (scheme base)\n        (scheme file)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm io)\n        (scm string)\n        (scm test))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config))\n\n(test-runner-factory scm-test-runner)\n(test-begin \"starter-admin config\")\n\n(define tmp (mktempdir '(prefix . \"starter-admin-config\")))\n(define (tmp-file name content)\n  (let ((path (string-append tmp \"/\" name)))\n    (call-with-output-file path (lambda (p) (write-string content p)))\n    path))\n\n(test-group \"read-config\"\n  (let ((cfg (read-config (tmp-file \"a.scm\" \"(define port 8072)\\n(define ttl (* 60 60))\\n(define name \\\"x\\\")\"))))\n    (test-equal 8072 (config-ref cfg 'port 0))\n    (test-equal 3600 (config-ref cfg 'ttl 0))\n    (test-equal \"x\" (config-ref cfg 'name #f))\n    (test-equal 'none (config-ref cfg 'missing 'none)))\n  (test-error (read-config (tmp-file \"b.scm\" \"(display 1)\"))))\n\n(test-group \"the example config reads\"\n  (let ((cfg (read-config (string-append root \"/config.example.scm\"))))\n    (test-equal 8072 (config-ref cfg 'http-port 0))\n    (test-equal \"\" (config-ref cfg 'url-prefix #f))))\n\n(test-group \"create-config!\"\n  (let ((ex (tmp-file \"example.scm\" \"(define secret \\\"REPLACE_WITH_BASE64_SECRET\\\")\"))\n        (target (string-append tmp \"/config.scm\")))\n    (create-config! ex target)\n    (let ((s (config-ref (read-config target) 'secret #f)))\n      (test-assert \"secret replaced\" (not (string=? s \"REPLACE_WITH_BASE64_SECRET\")))\n      (test-equal 44 (string-length s)))\n    (test-error \"no overwrite\" (create-config! ex target))\n    (delete-file target)\n    (delete-file ex)))\n\n(test-group \"load-config creates config.scm on the first run\"\n  (let ((app (string-append tmp \"/app\")))\n    (make-directory app)\n    (call-with-output-file (string-append app \"/config.example.scm\")\n      (lambda (p) (write-string \"(define http-port 1234)\" p)))\n    (test-equal 1234\n      (config-ref (load-config app '()) 'http-port 0))\n    (test-assert (file-exists? (string-append app \"/config.scm\")))\n    (delete-file (string-append app \"/config.scm\"))\n    (delete-file (string-append app \"/config.example.scm\"))\n    (delete-directory app)))\n\n(test-group \"config-secret\"\n  (test-equal \"abc\" (config-secret '((s . \"abc\")) 's))\n  (test-equal '(\"new\" \"old\") (config-secret '((s . (\"new\" \"old\"))) 's))\n  (test-error (config-secret '() 's))\n  (test-error (config-secret '((s . \"REPLACE_WITH_BASE64_SECRET\")) 's))\n  (test-error (config-secret '((s . (\"new\" \"REPLACE_WITH_BASE64_SECRET\"))) 's)))\n\n(test-group \"resolve-path\"\n  (test-equal \"/etc/x\" (resolve-path \"/app\" \"/etc/x\"))\n  (test-equal \"/app/data/x\" (resolve-path \"/app\" \"data/x\")))\n\n(delete-file (string-append tmp \"/a.scm\"))\n(delete-file (string-append tmp \"/b.scm\"))\n(delete-directory tmp)\n\n(test-end \"starter-admin config\")\n")
         ("tests/test_pure_web.scm" . ";; Tests for the web app that need no database: everything up to the point\n;; where a valid session would be looked up. The pool connects lazily, so a\n;; db handle for an unused port is fine here. tests/test_live_web.scm covers\n;; the rest against a real database.\n;; Run: scm tests/test_pure_web.scm\n\n(import (scheme base)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm log)\n        (scm string)\n        (scm test)\n        (scm crypto)\n        (scm net http request)\n        (scm net http response))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app db) (app web))\n\n(test-runner-factory scm-test-runner)\n(test-begin \"starter-admin web (no database)\")\n\n(define (app-with prefix)\n  (make-app `((url-prefix . ,prefix)\n              (static-dir . ,(string-append root \"/static\"))\n              (db . ,(make-db \"127.0.0.1\" 1 \"nobody\" \"\" \"nothing\" 1))\n              (session-secret . ,(base64-encode (random-bytes 32)))\n              (session-max-age . 3600)\n              (secure-cookies? . #f))))\n\n(define (send app method url cookie)\n  (parameterize ((log-port (open-output-string)))\n    (app (make-http-request method url\n                            (if cookie (list (cons \"Cookie\" cookie)) '())\n                            #f))))\n\n(define (status r) (http-response-status r))\n(define (location r) (http-response-header r \"Location\"))\n(define (body r)\n  (let ((b (http-response-body r)))\n    (if (bytevector? b) (utf8->string b) b)))\n(define (has? s part) (and (string? s) (string-contains-from s part 0) #t))\n\n(define app (app-with \"\"))\n\n(test-group \"signed out\"\n  (test-equal \"/login\" (location (send app \"GET\" \"/\" #f)))\n  (test-equal \"/login\" (location (send app \"GET\" \"/admin\" #f)))\n  (test-equal \"/login\" (location (send app \"POST\" \"/admin/users\" #f)))\n  (test-equal \"/login\" (location (send app \"GET\" \"/admin\" \"starter_admin_session=forged.x\")))\n  (test-equal 200 (status (send app \"GET\" \"/login\" #f)))\n  (test-equal \"ok\\n\" (body (send app \"GET\" \"/healthz\" #f)))\n  (test-equal 200 (status (send app \"GET\" \"/static/css/app.css\" #f))))\n\n(test-group \"strict CSP holds\"\n  (let ((r (send app \"GET\" \"/login\" #f)))\n    (test-assert (has? (http-response-header r \"Content-Security-Policy\") \"style-src 'self'\"))\n    (test-assert \"no inline script\" (not (has? (body r) \"<script>\")))\n    (test-assert \"no style attribute\" (not (has? (body r) \" style=\")))))\n\n(test-group \"url prefix\"\n  (let ((app (app-with \"/team\")))\n    (test-equal \"/team/login\" (location (send app \"GET\" \"/team/admin\" #f)))\n    (test-assert (has? (body (send app \"GET\" \"/team/login\" #f)) \"action=\\\"/team/login\\\"\"))\n    (test-equal 404 (status (send app \"GET\" \"/login\" #f)))))\n\n(test-end \"starter-admin web (no database)\")\n"))
        ("starter-api"
         (".gitignore" . "# Local config (holds the token secret), the user store, temp files.\nconfig.scm\ndata/users.scm\ndata/*.tmp\n")
         ("README.md" . "# starter-api\n\nA **headless JSON/REST API** with bearer-token authentication: no HTML, no\ncookies. Clients sign in to get a signed token and send it as\n`Authorization: Bearer <token>` with every request. Includes a small CRUD\nresource (`items`) stored in a Scheme data file.\n\nUse it as a starting point for a backend behind a single-page app, a mobile\nclient, or service-to-service calls.\n\n## What it demonstrates\n\n- **Bearer tokens** with `(scm crypto token)`: signed, expiring, URL-safe,\n  bound to the purpose `\"api\"`, no server-side store. Every request looks the\n  user up again, and the token carries a stamp of the password hash, so\n  deleting a user or changing a password revokes their tokens\n  (`src/app-auth.sld`). `http-request-bearer-token` reads the header.\n- **Password hashing** with `(scm crypto password)`, as in `starter-login`:\n  a dummy check for unknown usernames and hash upgrades at sign-in.\n- A **JSON request/response** style with one error envelope for everything,\n  including unknown routes (404), wrong methods (405, with `Allow`) and\n  internal errors (500, logged in full but answered generically)\n  (`src/app-api.sld`).\n- The middleware stack for an API: access log, `Cache-Control: no-store`,\n  and security headers with `default-src 'none'`.\n- **File-backed stores** with atomic, mutex-guarded writes\n  (`src/app-users.sld`, `src/app-items.sld`); swap them for a database when\n  you outgrow them.\n- From `starter-public`: the URL prefix, the config created on the first\n  run, and tests that call the app without a server.\n\n## Endpoints\n\n| Method | Path             | Auth | Body / result |\n|--------|------------------|------|---------------|\n| POST   | `/api/login`     | —    | `{username,password}` → `{token,token_type,expires_in}` |\n| GET    | `/api/me`        | yes  | `{username}` |\n| GET    | `/api/items`     | yes  | `[{id,name,count}, ...]` |\n| POST   | `/api/items`     | yes  | `{name,count}` → `201 {id,name,count}` |\n| GET    | `/api/items/:id` | yes  | `{id,name,count}` or `404` |\n| DELETE | `/api/items/:id` | yes  | `204` or `404` |\n| GET    | `/healthz`       | —    | `ok` |\n\nErrors are always `{ \"error\": { \"code\": \"...\", \"message\": \"...\" } }`.\n\n## Layout\n\n```\nbin/server.scm        load the config, serve the API\nbin/dev-server.scm    auto-reloading dev supervisor\nbin/user.scm          add / passwd / delete / list API users (CLI)\nbin/init-config.scm   write a new config file (used by deploy/install.sh)\nbin/gen-secret.scm    print a new token secret (for key rotation)\nsrc/app-config.sld    config reading and first-run creation\nsrc/app-users.sld     the user store\nsrc/app-items.sld     the items store\nsrc/app-auth.sld      sign-in and bearer tokens\nsrc/app-api.sld       routes, JSON, error envelope, middleware: make-app\nconfig.example.scm    the config template, with every setting\ndata/items.scm        sample items\ntests/                test_pure_*.scm, run without a server\ndeploy/               systemd units, health probe, nginx example, install script\n```\n\n## Run\n\n```sh\nscm bin/user.scm add alice       # prompts for a password (at least 8 characters)\nscm bin/server.scm               # http://127.0.0.1:8073\nscm bin/dev-server.scm           # same, restarts when src/ or the config changes\n```\n\nThe first run of either creates `config.scm` from `config.example.scm`, with\na fresh random `token-secret`. Try it:\n\n```sh\nTOKEN=$(curl -s -d '{\"username\":\"alice\",\"password\":\"<pw>\"}' \\\n        http://127.0.0.1:8073/api/login | sed 's/.*\"token\":\"\\([^\"]*\\)\".*/\\1/')\n\ncurl -s -H \"Authorization: Bearer $TOKEN\" http://127.0.0.1:8073/api/items\ncurl -s -H \"Authorization: Bearer $TOKEN\" -d '{\"name\":\"Cogs\",\"count\":7}' \\\n     http://127.0.0.1:8073/api/items\n```\n\n## Test\n\n```sh\nfor t in tests/test_*.scm; do scm \"$t\" || exit 1; done\n```\n\n## Adapt\n\n- Add resources with `route!` in `make-app` (`src/app-api.sld`) and storage\n  functions in a new `src/app-*.sld` module. Wrap a handler in `with-token`\n  to require a token; it then receives the user entry as a third argument.\n- Swap the file stores for a database module (see `starter-admin`) when a\n  flat file no longer fits.\n- The API sends no CORS headers: a browser app should be served from the\n  same origin (e.g. behind the same reverse proxy). Add an\n  `Access-Control-Allow-Origin` wrapper only for origins you trust.\n- To rotate the token secret, make `token-secret` a list with a new key\n  (`scm bin/gen-secret.scm`) first; drop the old key once its tokens have\n  expired.\n\n## Deploy\n\nThe API binds loopback only; put a TLS-terminating reverse proxy in front\n(`deploy/nginx.conf.example`): clients send passwords and tokens, which must\nnot travel in the clear. Then, on the server, from the app directory:\n\n```sh\nsudo deploy/install.sh               # SCM=/path/to/scm if not /usr/local/bin/scm\nsudo -u starter-api /usr/local/bin/scm /opt/starter-api/bin/user.scm \\\n     --config /etc/starter-api/config.scm add alice\n```\n\nThis copies the app to `/opt/starter-api` and creates\n`/etc/starter-api/config.scm` on the first install, with a fresh secret and\nthe data in `/var/lib/starter-api`. It adds a `starter-api` system user and\nenables the service (`Restart=always`, read-only file system except its\nstate directory), a per-minute health probe that restarts the API if\n`/healthz` fails twice, and a daily 04:00 restart. Rerun it to deploy a new\nversion; the config and data are kept.\n")
         ("config.example.scm" . ";; starter-api configuration: a list of (define name value) forms, read as\n;; data by src/app-config.sld. bin/server.scm reads config.scm; the first\n;; run creates it from this file, with a fresh token-secret.\n\n;; Bind loopback only; a reverse proxy (deploy/nginx.conf.example) fronts\n;; the public interface and terminates TLS.\n(define http-host \"127.0.0.1\")\n(define http-port 8073)\n\n;; Path the API is mounted under, e.g. \"/inventory\" for /inventory/api/...;\n;; \"\" for the host root. The reverse proxy must pass paths through unchanged.\n(define url-prefix \"\")\n\n;; Signs the bearer tokens (base64 of 32 random bytes). To rotate it, list\n;; the new key first: (\"new\" \"old\"); tokens signed with the old key stay\n;; valid until you remove it. bin/gen-secret.scm prints a new key.\n(define token-secret \"REPLACE_WITH_BASE64_SECRET\")\n(define token-max-age (* 60 60 12))   ; 12 hours\n\n;; Holds users.scm and items.scm and must be writable. Relative paths are\n;; relative to the app directory.\n(define data-dir \"data\")\n")
         ("bin/dev-server.scm" . ";; Development supervisor: restarts bin/server.scm whenever a watched file\n;; changes (all .sld under src/, bin/server.scm, and the config file), and\n;; auto-retries on a backoff if it exits on its own.\n;;\n;; Usage: scm bin/dev-server.scm\n\n(import (scheme base)\n        (scheme process-context)\n        (scm fs)\n        (scm reloader))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n\n(define (watched)\n  (append (files-with-suffix (string-append root \"/src\") \".sld\")\n          (list (string-append root \"/bin/server.scm\")\n                (string-append root \"/config.scm\"))))\n\n(supervise (list \"scm\" (string-append root \"/bin/server.scm\"))\n           watched\n           `((label . \"starter-api\")\n             (work-dir . ,root)\n             (root . ,root)))\n")
         ("bin/gen-secret.scm" . ";; Usage: scm bin/gen-secret.scm\n;;\n;; Prints a fresh base64 secret (32 random bytes) for token-secret.\n\n(import (scheme base)\n        (scheme write)\n        (scm crypto))\n\n(display (base64-encode (random-bytes 32)))\n(newline)\n")
         ("bin/init-config.scm" . ";; Usage: scm bin/init-config.scm <target>\n;;\n;; Writes a new config file at target from config.example.scm. Used by\n;; deploy/install.sh; refuses to overwrite an existing file.\n\n(import (scheme base)\n        (scheme write)\n        (scheme process-context)\n        (scm module)\n        (scm fs))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config))\n\n(define args (cdr (command-line)))\n(when (null? args)\n  (display \"usage: scm bin/init-config.scm <target>\\n\")\n  (exit 1))\n\n(create-config! (string-append root \"/config.example.scm\") (car args))\n(display (string-append \"created \" (car args) \"\\n\"))\n")
         ("bin/server.scm" . ";; Usage: scm bin/server.scm [config-path]\n;;\n;; Reads the config (config-path, or else config.scm, which the first run\n;; creates from config.example.scm with a fresh secret) and serves the API.\n\n(import (scheme base)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm log)\n        (scm net http server))\n\n;; Resolve the project root from this script's path so it runs from anywhere,\n;; and make src/ importable.\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config) (app api))\n\n(define cfg (load-config root (cdr (command-line))))\n(define host (config-ref cfg 'http-host \"127.0.0.1\"))\n(define port (config-ref cfg 'http-port 8073))\n(define prefix (config-ref cfg 'url-prefix \"\"))\n(define data-dir (resolve-path root (config-ref cfg 'data-dir \"data\")))\n\n(define app\n  (make-app\n   `((url-prefix    . ,prefix)\n     (users-file    . ,(string-append data-dir \"/users.scm\"))\n     (items-file    . ,(string-append data-dir \"/items.scm\"))\n     (token-secret  . ,(config-secret cfg 'token-secret))\n     (token-max-age . ,(config-ref cfg 'token-max-age (* 60 60 12))))))\n\n(log-info \"app\" (string-append \"starter-api listening on http://\" host \":\"\n                               (number->string port) prefix \"/api/\"))\n(serve-forever port app 0 host)\n")
         ("bin/user.scm" . ";; Usage: scm bin/user.scm [--config path] add <username>\n;;        scm bin/user.scm [--config path] passwd <username>\n;;        scm bin/user.scm [--config path] delete <username>\n;;        scm bin/user.scm [--config path] list\n;;\n;; Manages the user store. There is no sign-up page: users exist only once\n;; added here. Passwords are prompted for twice and read without echo.\n;; Changing or deleting a user revokes their tokens.\n\n(import (scheme base)\n        (scheme write)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm terminal))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (scm crypto password) (app config) (app users) (app auth))\n\n(define (fail msg) (display msg (current-error-port)) (newline (current-error-port)) (exit 1))\n\n(define usage\n  \"usage: scm bin/user.scm [--config path] add|passwd|delete <username> | list\")\n\n(define args (cdr (command-line)))\n(define config-args\n  (if (and (pair? args) (string=? (car args) \"--config\") (pair? (cdr args)))\n      (list (cadr args))\n      '()))\n(define command-args (if (null? config-args) args (cddr args)))\n\n(define cfg (load-config root config-args))\n(define users-file\n  (string-append (resolve-path root (config-ref cfg 'data-dir \"data\")) \"/users.scm\"))\n\n(define (ask-new-password)\n  (let* ((a (read-password \"Password: \"))\n         (b (if (eof-object? a) a (read-password \"Confirm:  \"))))\n    (cond ((or (eof-object? a) (eof-object? b)) (fail \"aborted\"))\n          ((not (string=? a b)) (fail \"passwords do not match\"))\n          ((< (string-length a) min-password-length)\n           (fail \"password must be at least 8 characters\"))\n          (else a))))\n\n(define (the-name)\n  (if (and (pair? (cdr command-args)) (null? (cddr command-args)))\n      (cadr command-args)\n      (fail usage)))\n\n(if (null? command-args)\n    (fail usage)\n    (let ((cmd (car command-args)))\n      (cond\n        ((string=? cmd \"add\")\n         (let ((name (the-name)))\n           (unless (valid-username? name)\n             (fail \"invalid username (letters, digits, . _ -; at most 64)\"))\n           (when (find-user users-file name)\n             (fail (string-append \"user exists: \" name \" (use passwd)\")))\n           (save-user! users-file name (password-hash (ask-new-password)))\n           (display (string-append \"added \" name \"\\n\"))))\n        ((string=? cmd \"passwd\")\n         (let ((name (the-name)))\n           (unless (find-user users-file name) (fail (string-append \"no such user: \" name)))\n           (save-user! users-file name (password-hash (ask-new-password)))\n           (display (string-append \"password changed for \" name \"\\n\"))))\n        ((string=? cmd \"delete\")\n         (let ((name (the-name)))\n           (unless (find-user users-file name) (fail (string-append \"no such user: \" name)))\n           (delete-user! users-file name)\n           (display (string-append \"deleted \" name \"\\n\"))))\n        ((string=? cmd \"list\")\n         (for-each (lambda (u) (display (user-name u)) (newline))\n                   (load-users users-file)))\n        (else (fail usage)))))\n")
         ("data/items.scm" . "((1 \"Widgets\" 42) (2 \"Gadgets\" 17) (3 \"Cogs\" 7))\n")
         ("deploy/healthcheck.sh" . "#!/bin/sh\n# Health probe for starter-api, run every minute by\n# starter-api-health.service: GET /healthz on the host/port from the\n# config. Two strikes: on failure wait 5s and probe again; only then restart\n# the unit, so one slow request cannot bounce the daemon.\n#\n# Usage: healthcheck.sh <config.scm> <unit>\nconf=$1\nunit=$2\n\n# The string or number of a (define name value) line in the config.\nvalue() {\n  sed -n \"s/^[[:space:]]*(define[[:space:]][[:space:]]*$1[[:space:]][[:space:]]*\\\"\\{0,1\\}\\([^\\\" )]*\\).*/\\1/p\" \"$conf\" | head -n 1\n}\n\nport=$(value http-port)\nhost=$(value http-host)\ncase \"$host\" in ''|0.0.0.0|::) host=127.0.0.1 ;; esac\nurl=\"http://$host:${port:-8073}/healthz\"\n\nprobe() { curl -fsS --max-time 5 \"$url\" >/dev/null; }\n\nif ! probe; then\n  sleep 5\n  if ! probe; then\n    echo \"$unit: $url failed twice; restarting\"\n    systemctl restart \"$unit\"\n  fi\nfi\n")
         ("deploy/install.sh" . "#!/bin/sh\n# Installs starter-api as a systemd service. Run as root on the target\n# host from the app directory: sudo deploy/install.sh. Idempotent: rerun it\n# to deploy a new version (the config in /etc is kept).\n#\n#   /opt/starter-api               the app (replaced on each install)\n#   /etc/starter-api/config.scm    the config (created once, then yours)\n#   /var/lib/starter-api            users and items (systemd StateDirectory)\n#\n# The service runs as the system user starter-api. Set SCM to the scm\n# launcher if it is not /usr/local/bin/scm.\nset -eu\n\nAPP=starter-api\nSCM=${SCM:-/usr/local/bin/scm}\nSRC=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n\nid -u \"$APP\" >/dev/null 2>&1 ||\n  useradd --system --home-dir /nonexistent --no-create-home \\\n          --shell /usr/sbin/nologin \"$APP\"\n\n# The app code, owned by root, readable by all.\nrm -rf \"/opt/$APP.new\"\nmkdir -p \"/opt/$APP.new\"\ncp -r \"$SRC/bin\" \"$SRC/src\" \"$SRC/deploy\" \"$SRC/config.example.scm\" \\\n      \"/opt/$APP.new/\"\nrm -rf \"/opt/$APP\"\nmv \"/opt/$APP.new\" \"/opt/$APP\"\n\n# The config: created from config.example.scm on the first install only,\n# with a fresh token secret and the data in /var/lib.\nmkdir -p \"/etc/$APP\"\nif [ ! -f \"/etc/$APP/config.scm\" ]; then\n  \"$SCM\" \"/opt/$APP/bin/init-config.scm\" \"/etc/$APP/config.scm\"\n  sed -i \"s|^(define data-dir \\\"data\\\")|(define data-dir \\\"/var/lib/$APP\\\")|\" \\\n         \"/etc/$APP/config.scm\"\nfi\nchown root:\"$APP\" \"/etc/$APP/config.scm\"\nchmod 640 \"/etc/$APP/config.scm\"\n\nfor unit in \"$APP.service\" \\\n            \"$APP-health.service\" \"$APP-health.timer\" \\\n            \"$APP-restart.service\" \"$APP-restart.timer\"; do\n  sed \"s|/usr/local/bin/scm|$SCM|\" \"$SRC/deploy/systemd/$unit\" \\\n    > \"/etc/systemd/system/$unit\"\ndone\n\nsystemctl daemon-reload\nsystemctl enable \"$APP.service\" \"$APP-health.timer\" \"$APP-restart.timer\"\nsystemctl restart \"$APP.service\"\nsystemctl start \"$APP-health.timer\" \"$APP-restart.timer\"\n\necho \"Installed. Config: /etc/$APP/config.scm. Logs: journalctl -u $APP -f\"\necho \"Add a user: sudo -u $APP $SCM /opt/$APP/bin/user.scm --config /etc/$APP/config.scm add <name>\"\n")
         ("deploy/nginx.conf.example" . "# Reverse proxy in front of starter-api. The app binds 127.0.0.1 only;\n# nginx terminates TLS on the public interface and forwards to it.\n\nupstream starter_api_backend {\n    server 127.0.0.1:8073;\n    keepalive 16;\n}\n\nserver {\n    listen 443 ssl;\n    http2 on;\n    server_name example.com;\n\n    # ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;\n    # ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;\n\n    # At the host root. To mount the app under a path instead, set\n    # (define url-prefix \"/inventory\") in the config and use\n    # \"location /inventory/\" here. proxy_pass without a URI part passes\n    # the path through unchanged, which is what the app expects.\n    location / {\n        proxy_pass         http://starter_api_backend;\n        proxy_http_version 1.1;\n        proxy_set_header   Connection        \"\";\n        proxy_set_header   Host              $host;\n        proxy_set_header   X-Real-IP         $remote_addr;\n        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;\n        proxy_set_header   X-Forwarded-Proto $scheme;\n        proxy_read_timeout 30s;\n    }\n}\n")
         ("deploy/systemd/starter-api-health.service" . "[Unit]\nDescription=starter-api health probe (restarts the app if /healthz fails)\nAfter=starter-api.service\n\n[Service]\nType=oneshot\nExecCondition=/usr/bin/systemctl is-active --quiet starter-api.service\n# Host/port come from the config; two strikes before a restart.\nExecStart=/opt/starter-api/deploy/healthcheck.sh /etc/starter-api/config.scm starter-api.service\n")
         ("deploy/systemd/starter-api-health.timer" . "[Unit]\nDescription=Run the starter-api health probe every minute\n\n[Timer]\nOnBootSec=60s\nOnUnitActiveSec=60s\nAccuracySec=15s\nUnit=starter-api-health.service\n\n[Install]\nWantedBy=timers.target\n")
         ("deploy/systemd/starter-api-restart.service" . "[Unit]\nDescription=Daily restart of starter-api (clears slow leaks, picks up config)\n\n[Service]\nType=oneshot\nExecStart=/bin/systemctl try-restart starter-api.service\n")
         ("deploy/systemd/starter-api-restart.timer" . "[Unit]\nDescription=Daily restart of starter-api at 04:00\n\n[Timer]\nOnCalendar=*-*-* 04:00:00\nPersistent=true\nRandomizedDelaySec=2m\nUnit=starter-api-restart.service\n\n[Install]\nWantedBy=timers.target\n")
         ("deploy/systemd/starter-api.service" . "[Unit]\nDescription=starter-api scheme webapp\nAfter=network-online.target\nWants=network-online.target\n# Allow a few quick restarts, but if we crash-loop more than 5 times in\n# 60s, give up rather than burn CPU.\nStartLimitIntervalSec=60\nStartLimitBurst=5\n\n[Service]\nType=simple\nUser=starter-api\nGroup=starter-api\nWorkingDirectory=/opt/starter-api\n# deploy/install.sh replaces the scm path with $SCM.\nExecStart=/usr/local/bin/scm bin/server.scm /etc/starter-api/config.scm\n\n# Restart on any exit. Combined with the daily restart timer this makes\n# the service self-healing across OOMs and unexpected exceptions.\nRestart=always\nRestartSec=3s\n# The JVM exits with 128+SIGTERM on a normal stop.\nSuccessExitStatus=143\n# Give the HTTP server (10s graceful drain by default) time to finish.\nTimeoutStopSec=15s\n\n# Logs go to journald: journalctl -u starter-api -f\nStandardOutput=journal\nStandardError=journal\n\n# The user and item stores: /var/lib/starter-api, created and owned by the\n# service user. The rest of the file system is read-only for the app.\nStateDirectory=starter-api\nStateDirectoryMode=0700\n\n# --- hardening ---\nNoNewPrivileges=yes\nPrivateTmp=yes\nProtectSystem=strict\nProtectHome=yes\n\n[Install]\nWantedBy=multi-user.target\n")
         ("src/app-api.sld" . ";; (app api) — JSON/REST routes, the bearer-token guard, and the\n;; middleware stack. Every response is JSON; errors use one envelope:\n;;\n;;   { \"error\": { \"code\": \"...\", \"message\": \"...\" } }\n;;\n;; make-app returns the server-level handler (lambda (req) resp):\n;; bin/server.scm serves it, and the tests call it directly.\n\n(define-library (app api)\n  (import (scheme base)\n          (srfi 18)\n          (scm net http request)\n          (scm net http response)\n          (scm net http route)\n          (scm net http middleware)\n          (scm json simple)\n          (app users)\n          (app items)\n          (app auth))\n  (export make-app)\n  (begin\n\n    ;; --- JSON responses ----------------------------------------------\n\n    (define (json-status status value)\n      (make-http-response\n       status '((\"Content-Type\" . \"application/json; charset=utf-8\"))\n       (json->string value)))\n\n    (define (json-ok value) (json-status 200 value))\n\n    (define (api-error status code message)\n      (json-status status\n        (list (cons \"error\" (list (cons \"code\" code)\n                                  (cons \"message\" message))))))\n\n    ;; The request body as a JSON object (an alist), or #f if it is not one.\n    (define (json-body req)\n      (let ((body (guard (e (#t #f))\n                    (json-parse (or (http-request-body req) \"\")))))\n        (and (list? body) body)))\n\n    (define (add-header resp name value)\n      (make-http-response (http-response-status resp)\n                          (cons (cons name value) (http-response-headers resp))\n                          (http-response-body resp)))\n\n    ;; The router answers unknown paths and methods in plain text; give\n    ;; them the JSON envelope (keeping the Allow header of a 405).\n    (define (with-json-errors handler)\n      (lambda (req)\n        (let ((resp (handler req)))\n          (case (http-response-status resp)\n            ((404) (api-error 404 \"not_found\" \"No such endpoint\"))\n            ((405) (add-header (api-error 405 \"method_not_allowed\" \"Method not allowed\")\n                               \"Allow\" (http-response-header resp \"Allow\")))\n            (else resp)))))\n\n    ;; A JSON API needs no scripts, styles or frames at all.\n    (define api-csp \"default-src 'none'; frame-ancestors 'none'\")\n\n    ;; A failed password check costs the client half a second, which slows\n    ;; down guessing.\n    (define (penalty) (thread-sleep! 0.5))\n\n    (define (setting settings key)\n      (let ((p (assq key settings)))\n        (if p (cdr p) (error \"make-app: missing setting\" key))))\n\n    (define (make-app settings)\n      \"Syntax: (make-app settings)\nLibrary: (app api)\nDescription: Builds the API's request handler. settings is an alist:\n  url-prefix (\\\"\\\" at the host root), users-file and items-file (absolute\n  paths), token-secret, token-max-age (seconds).\"\n      (let* ((prefix (setting settings 'url-prefix))\n             (items-file (setting settings 'items-file))\n             (auth (make-auth (setting settings 'token-secret)\n                              (setting settings 'token-max-age)\n                              (setting settings 'users-file)))\n             (router (make-router)))\n\n        (define (route! method path handler)\n          (router-add! router method (string-append prefix path) handler))\n\n        ;; Runs handler with the token's user as a third argument, or\n        ;; answers 401.\n        (define (with-token handler)\n          (lambda (req params)\n            (let ((user (token-user auth (http-request-bearer-token req))))\n              (if user\n                  (handler req params user)\n                  (add-header (api-error 401 \"unauthorized\" \"Missing or invalid bearer token\")\n                              \"WWW-Authenticate\" \"Bearer\")))))\n\n        (define (item-id params)\n          (let ((n (string->number (or (params-ref params \"id\") \"\"))))\n            (and (exact-integer? n) n)))\n\n        ;; POST /api/login  {\"username\": ..., \"password\": ...}\n        (route! \"POST\" \"/api/login\"\n          (lambda (req params)\n            (let ((body (json-body req)))\n              (if (not body)\n                  (api-error 400 \"bad_request\" \"Body must be a JSON object\")\n                  (let ((username (json-ref body \"username\" #f))\n                        (password (json-ref body \"password\" #f)))\n                    (if (not (and (string? username) (string? password)))\n                        (api-error 400 \"bad_request\" \"username and password are required\")\n                        (let ((user (sign-in auth username password)))\n                          (if user\n                              (json-ok (list (cons \"token\" (issue-token auth user))\n                                             (cons \"token_type\" \"Bearer\")\n                                             (cons \"expires_in\" (auth-max-age auth))))\n                              (begin\n                                (penalty)\n                                (api-error 401 \"invalid_credentials\"\n                                           \"Invalid username or password\"))))))))))\n\n        ;; GET /api/me\n        (route! \"GET\" \"/api/me\"\n          (with-token\n            (lambda (req params user)\n              (json-ok (list (cons \"username\" (user-name user)))))))\n\n        ;; GET /api/items\n        (route! \"GET\" \"/api/items\"\n          (with-token\n            (lambda (req params user)\n              (json-ok (list->vector (map item->json (load-items items-file)))))))\n\n        ;; POST /api/items  {\"name\": ..., \"count\": ...}\n        (route! \"POST\" \"/api/items\"\n          (with-token\n            (lambda (req params user)\n              (let ((body (json-body req)))\n                (if (not body)\n                    (api-error 400 \"bad_request\" \"Body must be a JSON object\")\n                    (let ((name (json-ref body \"name\" #f))\n                          (count (json-ref body \"count\" #f)))\n                      (cond\n                        ((not (and (string? name) (<= 1 (string-length name) 200)))\n                         (api-error 422 \"invalid_field\"\n                                    \"name must be a string of 1 to 200 characters\"))\n                        ((not (and (exact-integer? count) (>= count 0)))\n                         (api-error 422 \"invalid_field\"\n                                    \"count must be a non-negative integer\"))\n                        (else\n                         (json-status 201\n                           (item->json (add-item! items-file name count)))))))))))\n\n        ;; GET /api/items/:id\n        (route! \"GET\" \"/api/items/:id\"\n          (with-token\n            (lambda (req params user)\n              (let* ((id (item-id params))\n                     (it (and id (find-item items-file id))))\n                (if it\n                    (json-ok (item->json it))\n                    (api-error 404 \"not_found\" \"No item with that id\"))))))\n\n        ;; DELETE /api/items/:id\n        (route! \"DELETE\" \"/api/items/:id\"\n          (with-token\n            (lambda (req params user)\n              (let ((id (item-id params)))\n                (if (and id (delete-item! items-file id))\n                    (make-http-response 204 '() \"\")\n                    (api-error 404 \"not_found\" \"No item with that id\"))))))\n\n        ;; Outside the prefix: the health probe talks to the app directly.\n        (router-add! router \"GET\" \"/healthz\"\n          (lambda (req params) (text-response \"ok\\n\")))\n\n        ;; Outermost first: log every request; add the security headers and\n        ;; keep responses (tokens, data) out of caches; JSON envelopes for\n        ;; unknown routes; errors logged in full but answered with a\n        ;; generic 500.\n        (with-access-log\n         (with-response-headers\n          (with-security-headers\n           (with-json-errors\n            (with-error-handler\n             (router->handler router)\n             (lambda (req) (api-error 500 \"internal_error\" \"Internal server error\"))))\n           api-csp)\n          '((\"Cache-Control\" . \"no-store\"))))))))\n")
         ("src/app-auth.sld" . ";; (app auth) — sign-in and bearer tokens for the JSON API.\n;;\n;; Passwords: (scm crypto password), as in starter-login, with a dummy\n;; check for unknown usernames and hash upgrades at sign-in.\n;;\n;; Tokens: (scm crypto token), signed and expiring, with the purpose \"api\"\n;; so that no other token made with the same key passes as one. No server-\n;; side store. A token carries the username and a stamp of the password\n;; hash, and every request looks the user up again: deleting a user or\n;; changing a password revokes their tokens.\n\n(define-library (app auth)\n  (import (scheme base)\n          (scm crypto)\n          (scm crypto password)\n          (scm crypto token)\n          (app users))\n  (export make-auth\n          auth-max-age\n          sign-in\n          issue-token\n          token-user\n          min-password-length)\n  (begin\n\n    (define min-password-length 8)\n\n    (define token-options '((purpose . \"api\")))\n\n    (define-record-type auth\n      (%make-auth keys max-age users-file)\n      auth?\n      (keys auth-keys)\n      (max-age auth-max-age)\n      (users-file auth-users-file))\n\n    (define (make-auth secret max-age users-file)\n      \"Syntax: (make-auth secret max-age users-file)\nLibrary: (app auth)\nDescription: Token settings: secret (base64, or a list for key rotation),\n  token lifetime in seconds, and the user store. A bad secret raises here,\n  at startup.\"\n      (%make-auth (token-secrets secret) max-age users-file))\n\n    ;; Changes whenever the password (and so the hash) changes.\n    (define (password-stamp hash)\n      (base64-encode (bytevector-copy (sha256-hash (string->utf8 hash)) 0 12)))\n\n    (define (sign-in auth username password)\n      \"Syntax: (sign-in auth username password)\nLibrary: (app auth)\nDescription: The user entry if password is right for username, else #f.\n  Upgrades an outdated password hash on success.\"\n      (let* ((path (auth-users-file auth))\n             (user (find-user path username)))\n        (cond\n          ((not (password-verify password (and user (user-hash user)))) #f)\n          ((password-needs-rehash? (user-hash user))\n           (save-user! path username (password-hash password))\n           (find-user path username))\n          (else user))))\n\n    (define (issue-token auth user)\n      \"Syntax: (issue-token auth user)\nLibrary: (app auth)\nDescription: A bearer token for user, valid for the configured lifetime.\"\n      (token-sign (auth-keys auth)\n                  `((sub . ,(user-name user))\n                    (stamp . ,(password-stamp (user-hash user))))\n                  (auth-max-age auth)\n                  token-options))\n\n    (define (token-user auth token)\n      \"Syntax: (token-user auth token)\nLibrary: (app auth)\nDescription: The user entry for a valid, unexpired token, or #f (also when\n  the user was deleted or changed the password since).\"\n      (let ((t (and token (token-verify (auth-keys auth) token token-options))))\n        (and (pair? t)\n             (let* ((sub (assq 'sub t))\n                    (stamp (assq 'stamp t))\n                    (user (and sub (string? (cdr sub))\n                               (find-user (auth-users-file auth) (cdr sub)))))\n               (and user stamp\n                    (equal? (cdr stamp) (password-stamp (user-hash user)))\n                    user)))))))\n")
         ("src/app-config.sld" . ";; (app config) — reads config.scm and creates it on the first run.\n;;\n;; The config file is a list of (define name expression) forms. It is read\n;; as data, not loaded: each expression is evaluated on its own in a\n;; (scheme base) environment, so (* 60 60 24 7) works but the file cannot\n;; reach into the app. The result is an alist, read with config-ref.\n\n(define-library (app config)\n  (import (scheme base)\n          (scheme eval)\n          (scheme file)\n          (scheme read)\n          (scheme write)\n          (scm crypto)\n          (scm fs)\n          (scm io)\n          (scm string))\n  (export load-config\n          read-config\n          create-config!\n          config-ref\n          config-secret\n          resolve-path)\n  (begin\n\n    ;; config.example.scm carries this placeholder where a secret belongs;\n    ;; create-config! replaces it with a fresh random key.\n    (define secret-placeholder \"REPLACE_WITH_BASE64_SECRET\")\n\n    (define (read-config path)\n      \"Syntax: (read-config path)\nLibrary: (app config)\nDescription: Reads the (define name expression) forms in path and returns\n  an alist of (name . value). Any other form is an error.\"\n      (let ((env (environment '(scheme base))))\n        (call-with-input-file path\n          (lambda (port)\n            (let loop ((acc '()))\n              (let ((form (read port)))\n                (cond\n                  ((eof-object? form) (reverse acc))\n                  ((and (pair? form) (eq? (car form) 'define)\n                        (pair? (cdr form)) (symbol? (cadr form))\n                        (pair? (cddr form)) (null? (cdddr form)))\n                   (loop (cons (cons (cadr form) (eval (caddr form) env)) acc)))\n                  (else (error \"config: expected (define name value)\" form)))))))))\n\n    (define (create-config! example target)\n      \"Syntax: (create-config! example target)\nLibrary: (app config)\nDescription: Writes target as a copy of example, with each secret\n  placeholder replaced by a fresh base64 key, readable by the owner only.\n  Refuses to overwrite an existing file.\"\n      (when (file-exists? target)\n        (error \"config already exists\" target))\n      (let ((text (string-replace-all (read-file-string example)\n                                      secret-placeholder\n                                      (base64-encode (random-bytes 32)))))\n        (call-with-output-file target\n          (lambda (p) (write-string text p)))\n        (chmod target \"600\")))\n\n    (define (load-config root args)\n      \"Syntax: (load-config root args)\nLibrary: (app config)\nDescription: Reads the config named by the first command-line argument in\n  args, or else root/config.scm. On the first run, when root/config.scm\n  does not exist yet, it is created from config.example.scm.\"\n      (if (pair? args)\n          (read-config (car args))\n          (let ((path (string-append root \"/config.scm\")))\n            (unless (file-exists? path)\n              (create-config! (string-append root \"/config.example.scm\") path)\n              (display (string-append \"created \" path \"\\n\") (current-error-port)))\n            (read-config path))))\n\n    (define (config-ref cfg name default)\n      \"Syntax: (config-ref cfg name default)\nLibrary: (app config)\nDescription: The value of name in cfg, or default if the file has none.\"\n      (let ((p (assq name cfg)))\n        (if p (cdr p) default)))\n\n    (define (config-secret cfg name)\n      \"Syntax: (config-secret cfg name)\nLibrary: (app config)\nDescription: The secret stored under name: a base64 string, or a list of\n  them (newest first) while rotating keys. Raises if it is missing or still\n  the placeholder from config.example.scm.\"\n      (let* ((s (config-ref cfg name #f))\n             (keys (if (string? s) (list s) s)))\n        (unless (and (pair? keys)\n                     (let loop ((ks keys))\n                       (or (null? ks)\n                           (and (string? (car ks))\n                                (not (string=? (car ks) secret-placeholder))\n                                (loop (cdr ks))))))\n          (error \"config: set a secret (scm bin/gen-secret.scm prints one)\" name))\n        s))\n\n    (define (resolve-path root path)\n      \"Syntax: (resolve-path root path)\nLibrary: (app config)\nDescription: path itself if absolute, else path relative to root.\"\n      (if (and (> (string-length path) 0) (char=? (string-ref path 0) #\\/))\n          path\n          (string-append root \"/\" path)))))\n")
         ("src/app-items.sld" . ";; (app items) — the sample REST resource, a plain Scheme data file.\n;;\n;; items.scm holds a list of (id name count) entries. Writes go through a\n;; temp file + rename (a reader never sees a partial file) and are\n;; serialized with a mutex, since the HTTP server is threaded. A flat file\n;; is fine for a starter; swap this module for a database when you outgrow\n;; it (see starter-admin).\n\n(define-library (app items)\n  (import (scheme base)\n          (scheme file)\n          (scheme read)\n          (scheme write)\n          (scm fs)\n          (srfi 18))\n  (export load-items find-item item->json add-item! delete-item!)\n  (begin\n\n    (define (item-id it) (car it))\n    (define (item-name it) (cadr it))\n    (define (item-count it) (caddr it))\n\n    (define (load-items path)\n      \"Syntax: (load-items path)\nLibrary: (app items)\nDescription: The list of (id name count) entries, or '() if the file does\n  not exist yet.\"\n      (if (file-exists? path)\n          (let ((d (call-with-input-file path read)))\n            (if (eof-object? d) '() d))\n          '()))\n\n    (define (find-item path id)\n      (let loop ((items (load-items path)))\n        (cond ((null? items) #f)\n              ((= (item-id (car items)) id) (car items))\n              (else (loop (cdr items))))))\n\n    (define (item->json it)\n      \"Syntax: (item->json it)\nLibrary: (app items)\nDescription: The item as a JSON object alist for (scm json simple).\"\n      (list (cons \"id\" (item-id it))\n            (cons \"name\" (item-name it))\n            (cons \"count\" (item-count it))))\n\n    (define write-lock (make-mutex))\n\n    ;; Calls (proc items) under the lock and stores the list it returns as\n    ;; its first value; the second value is the call's result.\n    (define (update-items! path proc)\n      (dynamic-wind\n        (lambda () (mutex-lock! write-lock))\n        (lambda ()\n          (let-values (((items result) (proc (load-items path))))\n            (let ((dir (directory-name path))\n                  (tmp (string-append path \".tmp\")))\n              (unless (directory-exists? dir) (make-directory dir))\n              (call-with-output-file tmp\n                (lambda (p) (write items p) (newline p)))\n              (move-file tmp path))\n            result))\n        (lambda () (mutex-unlock! write-lock))))\n\n    (define (add-item! path name count)\n      \"Syntax: (add-item! path name count)\nLibrary: (app items)\nDescription: Appends a new item with the next free id and returns it.\"\n      (update-items! path\n        (lambda (items)\n          (let* ((next (+ 1 (let loop ((xs items) (m 0))\n                              (if (null? xs) m (loop (cdr xs) (max m (item-id (car xs))))))))\n                 (it (list next name count)))\n            (values (append items (list it)) it)))))\n\n    (define (delete-item! path id)\n      \"Syntax: (delete-item! path id)\nLibrary: (app items)\nDescription: Removes the item with id. #t if there was one, else #f.\"\n      (update-items! path\n        (lambda (items)\n          (let ((kept (let loop ((xs items))\n                        (cond ((null? xs) '())\n                              ((= (item-id (car xs)) id) (loop (cdr xs)))\n                              (else (cons (car xs) (loop (cdr xs))))))))\n            (values kept (< (length kept) (length items)))))))))\n")
         ("src/app-users.sld" . ";; (app users) — the user store, a plain Scheme data file.\n;;\n;; users.scm holds one datum: a list of (username hash created) entries. It\n;; is written by the CLI (bin/user.scm) and by the app (password changes,\n;; hash upgrades), never by hand. Writes go through a temp file + rename so\n;; a reader never sees a half-written file, and a mutex serializes the\n;; app's own writes. (The CLI is a separate process; the last write wins.)\n;;\n;; This module is storage only; passwords and sessions live in (app auth).\n\n(define-library (app users)\n  (import (scheme base)\n          (scheme char)\n          (scheme file)\n          (scheme read)\n          (scheme time)\n          (scheme write)\n          (scm fs)\n          (srfi 18))\n  (export load-users\n          find-user\n          user-name\n          user-hash\n          user-created\n          save-user!\n          delete-user!\n          valid-username?)\n  (begin\n\n    (define (user-name u) (car u))\n    (define (user-hash u) (cadr u))\n    (define (user-created u) (caddr u))\n\n    (define (load-users path)\n      \"Syntax: (load-users path)\nLibrary: (app users)\nDescription: The list of (username hash created) entries in path, or '()\n  if the file does not exist yet.\"\n      (if (file-exists? path)\n          (let ((datum (call-with-input-file path read)))\n            (if (eof-object? datum) '() datum))\n          '()))\n\n    (define (find-user path name)\n      \"Syntax: (find-user path name)\nLibrary: (app users)\nDescription: The (username hash created) entry for name, or #f.\"\n      (assoc name (load-users path)))\n\n    (define write-lock (make-mutex))\n\n    (define (update-users! path proc)\n      (dynamic-wind\n        (lambda () (mutex-lock! write-lock))\n        (lambda ()\n          (let ((dir (directory-name path))\n                (tmp (string-append path \".tmp\")))\n            (unless (directory-exists? dir) (make-directory dir))\n            (call-with-output-file tmp\n              (lambda (p) (write (proc (load-users path)) p) (newline p)))\n            (move-file tmp path)))\n        (lambda () (mutex-unlock! write-lock))))\n\n    (define (save-user! path name hash)\n      \"Syntax: (save-user! path name hash)\nLibrary: (app users)\nDescription: Stores hash for name: replaces the entry (keeping its created\n  time) or appends a new one.\"\n      (update-users! path\n        (lambda (users)\n          (let loop ((us users))\n            (cond\n              ((null? us)\n               (list (list name hash (exact (floor (current-second))))))\n              ((string=? (user-name (car us)) name)\n               (cons (list name hash (user-created (car us))) (cdr us)))\n              (else (cons (car us) (loop (cdr us)))))))))\n\n    (define (delete-user! path name)\n      \"Syntax: (delete-user! path name)\nLibrary: (app users)\nDescription: Removes name's entry, if there is one.\"\n      (update-users! path\n        (lambda (users)\n          (let loop ((us users))\n            (cond ((null? us) '())\n                  ((string=? (user-name (car us)) name) (cdr us))\n                  (else (cons (car us) (loop (cdr us)))))))))\n\n    (define (valid-username? s)\n      \"Syntax: (valid-username? s)\nLibrary: (app users)\nDescription: True if s is 1-64 characters of letters, digits and . _ -\"\n      (and (string? s)\n           (<= 1 (string-length s) 64)\n           (let loop ((i 0))\n             (or (= i (string-length s))\n                 (let ((c (string-ref s i)))\n                   (and (or (char-alphabetic? c) (char-numeric? c)\n                            (memv c '(#\\. #\\_ #\\-)))\n                        (loop (+ i 1))))))))))\n")
         ("tests/test_pure_api.scm" . ";; Tests for the JSON API: sign-in, tokens, the items resource, the error\n;; envelope, the URL prefix. Requests go straight to the handler from\n;; make-app, no server or socket. Run: scm tests/test_pure_api.scm\n\n(import (scheme base)\n        (scheme file)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm log)\n        (scm string)\n        (scm test)\n        (scm crypto)\n        (scm crypto password)\n        (scm crypto token)\n        (scm json simple)\n        (scm net http request)\n        (scm net http response))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app users) (app api))\n\n(test-runner-factory scm-test-runner)\n(test-begin \"starter-api\")\n\n(define tmp (mktempdir '(prefix . \"starter-api-test\")))\n(define users-file (string-append tmp \"/users.scm\"))\n(define items-file (string-append tmp \"/items.scm\"))\n(define secret (base64-encode (random-bytes 32)))\n\n(define (app-with prefix)\n  (make-app `((url-prefix . ,prefix)\n              (users-file . ,users-file)\n              (items-file . ,items-file)\n              (token-secret . ,secret)\n              (token-max-age . 3600))))\n\n;; Fast hashes keep the test quick; production uses the 600k default.\n(define fast-iterations 1000)\n\n;; (send app method url token [json-body]); requests are logged to the log\n;; port, kept out of the test output.\n(define (send app method url token . body)\n  (parameterize ((log-port (open-output-string))\n                 (password-pbkdf2-iterations fast-iterations))\n    (app (make-http-request\n          method url\n          (append (if token (list (cons \"Authorization\" (string-append \"Bearer \" token))) '())\n                  (if (pair? body) '((\"Content-Type\" . \"application/json\")) '()))\n          (if (pair? body) (car body) #f)))))\n\n(define (status r) (http-response-status r))\n(define (json r)\n  (let ((b (http-response-body r)))\n    (json-parse (if (bytevector? b) (utf8->string b) b))))\n(define (error-code r) (json-ref (json-ref (json r) \"error\" '()) \"code\" #f))\n\n(parameterize ((password-pbkdf2-iterations fast-iterations))\n  (save-user! users-file \"alice\" (password-hash \"alicepassword\")))\n(define app (app-with \"\"))\n\n(define (login app name password)\n  (send app \"POST\" \"/api/login\" #f\n        (string-append \"{\\\"username\\\":\\\"\" name \"\\\",\\\"password\\\":\\\"\" password \"\\\"}\")))\n\n(define token (json-ref (json (login app \"alice\" \"alicepassword\")) \"token\" #f))\n\n(test-group \"login\"\n  (test-assert (string? token))\n  (let ((r (login app \"alice\" \"alicepassword\")))\n    (test-equal 200 (status r))\n    (test-equal \"Bearer\" (json-ref (json r) \"token_type\" #f))\n    (test-equal 3600 (json-ref (json r) \"expires_in\" #f))\n    (test-equal \"no-store\" (http-response-header r \"Cache-Control\")))\n  (test-equal \"invalid_credentials\" (error-code (login app \"alice\" \"wrong\")))\n  (test-equal \"invalid_credentials\" (error-code (login app \"nobody\" \"x\")))\n  (test-equal \"bad_request\" (error-code (send app \"POST\" \"/api/login\" #f \"[1,2]\")))\n  (test-equal \"bad_request\" (error-code (send app \"POST\" \"/api/login\" #f \"{\\\"username\\\":1}\")))\n  (test-equal \"bad_request\" (error-code (send app \"POST\" \"/api/login\" #f \"not json\"))))\n\n(test-group \"tokens\"\n  (test-equal \"alice\" (json-ref (json (send app \"GET\" \"/api/me\" token)) \"username\" #f))\n  (let ((r (send app \"GET\" \"/api/me\" #f)))\n    (test-equal 401 (status r))\n    (test-equal \"unauthorized\" (error-code r))\n    (test-equal \"Bearer\" (http-response-header r \"WWW-Authenticate\")))\n  (test-equal 401 (status (send app \"GET\" \"/api/me\" \"garbage\")))\n  (test-equal 401 (status (send app \"GET\" \"/api/me\" (string-append token \"x\"))))\n  ;; Same key, other purpose: not an API token.\n  (test-equal 401 (status (send app \"GET\" \"/api/me\"\n                                (token-sign secret '((sub . \"alice\")) 60\n                                            '((purpose . \"session\")))))))\n\n(test-group \"items\"\n  (test-equal '#() (json (send app \"GET\" \"/api/items\" token)))\n  (let ((r (send app \"POST\" \"/api/items\" token \"{\\\"name\\\":\\\"Cogs\\\",\\\"count\\\":7}\")))\n    (test-equal 201 (status r))\n    (test-equal '((\"id\" . 1) (\"name\" . \"Cogs\") (\"count\" . 7)) (json r)))\n  (send app \"POST\" \"/api/items\" token \"{\\\"name\\\":\\\"Gears\\\",\\\"count\\\":2}\")\n  (test-equal 2 (vector-length (json (send app \"GET\" \"/api/items\" token))))\n  (test-equal \"Gears\" (json-ref (json (send app \"GET\" \"/api/items/2\" token)) \"name\" #f))\n  (test-equal \"not_found\" (error-code (send app \"GET\" \"/api/items/9\" token)))\n  (test-equal \"not_found\" (error-code (send app \"GET\" \"/api/items/x\" token)))\n  (test-equal \"invalid_field\"\n    (error-code (send app \"POST\" \"/api/items\" token \"{\\\"name\\\":\\\"\\\",\\\"count\\\":1}\")))\n  (test-equal \"invalid_field\"\n    (error-code (send app \"POST\" \"/api/items\" token \"{\\\"name\\\":\\\"A\\\",\\\"count\\\":1.5}\")))\n  (test-equal \"invalid_field\"\n    (error-code (send app \"POST\" \"/api/items\" token \"{\\\"name\\\":\\\"A\\\",\\\"count\\\":-1}\")))\n  (test-equal 204 (status (send app \"DELETE\" \"/api/items/1\" token)))\n  (test-equal 404 (status (send app \"DELETE\" \"/api/items/1\" token)))\n  (test-equal 401 (status (send app \"DELETE\" \"/api/items/2\" #f))))\n\n(test-group \"error envelope\"\n  (test-equal \"not_found\" (error-code (send app \"GET\" \"/api/nothing\" token)))\n  (let ((r (send app \"PUT\" \"/api/items\" token \"{}\")))\n    (test-equal 405 (status r))\n    (test-equal \"method_not_allowed\" (error-code r))\n    (test-equal \"GET, HEAD, POST\" (http-response-header r \"Allow\")))\n  (test-assert (string-contains-from\n                (http-response-header (send app \"GET\" \"/api/me\" token) \"Content-Security-Policy\")\n                \"default-src 'none'\" 0)))\n\n(test-group \"tokens are revoked with the password or the user\"\n  (parameterize ((password-pbkdf2-iterations fast-iterations))\n    (save-user! users-file \"alice\" (password-hash \"anotherpassword\")))\n  (test-equal 401 (status (send app \"GET\" \"/api/me\" token)))\n  (let ((fresh (json-ref (json (login app \"alice\" \"anotherpassword\")) \"token\" #f)))\n    (test-equal 200 (status (send app \"GET\" \"/api/me\" fresh)))\n    (delete-user! users-file \"alice\")\n    (test-equal 401 (status (send app \"GET\" \"/api/me\" fresh)))))\n\n(test-group \"errors are logged, not shown\"\n  (call-with-output-file items-file (lambda (p) (write-string \"(((\" p)))\n  (parameterize ((password-pbkdf2-iterations fast-iterations))\n    (save-user! users-file \"bob\" (password-hash \"bobspassword\")))\n  (let* ((t (json-ref (json (login app \"bob\" \"bobspassword\")) \"token\" #f))\n         (log (open-output-string))\n         (r (parameterize ((log-port log))\n              (app (make-http-request \"GET\" \"/api/items\" \n                                      (list (cons \"Authorization\" (string-append \"Bearer \" t)))\n                                      #f)))))\n    (test-equal 500 (status r))\n    (test-equal \"internal_error\" (error-code r))\n    (test-assert (string-contains-from (get-output-string log) \"ERROR [http] GET /api/items\" 0))))\n\n(test-group \"url prefix\"\n  (let* ((app (app-with \"/inventory\"))\n         (t (json-ref (json (send app \"POST\" \"/inventory/api/login\" #f\n                                  \"{\\\"username\\\":\\\"bob\\\",\\\"password\\\":\\\"bobspassword\\\"}\"))\n                      \"token\" #f)))\n    (test-equal \"bob\" (json-ref (json (send app \"GET\" \"/inventory/api/me\" t)) \"username\" #f))\n    (test-equal 404 (status (send app \"GET\" \"/api/me\" t)))\n    (test-equal 200 (status (send app \"GET\" \"/healthz\" #f)))))\n\n(for-each (lambda (f) (when (file-exists? f) (delete-file f))) (list users-file items-file))\n(delete-directory tmp)\n\n(test-end \"starter-api\")\n")
         ("tests/test_pure_config.scm" . ";; Tests for (app config). Run: scm tests/test_pure_config.scm\n\n(import (scheme base)\n        (scheme file)\n        (scheme process-context)\n        (scm module)\n        (scm fs)\n        (scm io)\n        (scm string)\n        (scm test))\n\n(define root\n  (directory-name (directory-name (absolute-path (car (command-line))))))\n(module-search-path! (cons (string-append root \"/src\") (module-search-path)))\n\n(import (app config))\n\n(test-runner-factory scm-test-runner)\n(test-begin \"starter-api config\")\n\n(define tmp (mktempdir '(prefix . \"starter-api-config\")))\n(define (tmp-file name content)\n  (let ((path (string-append tmp \"/\" name)))\n    (call-with-output-file path (lambda (p) (write-string content p)))\n    path))\n\n(test-group \"read-config\"\n  (let ((cfg (read-config (tmp-file \"a.scm\" \"(define port 8073)\\n(define ttl (* 60 60))\\n(define name \\\"x\\\")\"))))\n    (test-equal 8073 (config-ref cfg 'port 0))\n    (test-equal 3600 (config-ref cfg 'ttl 0))\n    (test-equal \"x\" (config-ref cfg 'name #f))\n    (test-equal 'none (config-ref cfg 'missing 'none)))\n  (test-error (read-config (tmp-file \"b.scm\" \"(display 1)\"))))\n\n(test-group \"the example config reads\"\n  (let ((cfg (read-config (string-append root \"/config.example.scm\"))))\n    (test-equal 8073 (config-ref cfg 'http-port 0))\n    (test-equal \"\" (config-ref cfg 'url-prefix #f))))\n\n(test-group \"create-config!\"\n  (let ((ex (tmp-file \"example.scm\" \"(define secret \\\"REPLACE_WITH_BASE64_SECRET\\\")\"))\n        (target (string-append tmp \"/config.scm\")))\n    (create-config! ex target)\n    (let ((s (config-ref (read-config target) 'secret #f)))\n      (test-assert \"secret replaced\" (not (string=? s \"REPLACE_WITH_BASE64_SECRET\")))\n      (test-equal 44 (string-length s)))\n    (test-error \"no overwrite\" (create-config! ex target))\n    (delete-file target)\n    (delete-file ex)))\n\n(test-group \"load-config creates config.scm on the first run\"\n  (let ((app (string-append tmp \"/app\")))\n    (make-directory app)\n    (call-with-output-file (string-append app \"/config.example.scm\")\n      (lambda (p) (write-string \"(define http-port 1234)\" p)))\n    (test-equal 1234\n      (config-ref (load-config app '()) 'http-port 0))\n    (test-assert (file-exists? (string-append app \"/config.scm\")))\n    (delete-file (string-append app \"/config.scm\"))\n    (delete-file (string-append app \"/config.example.scm\"))\n    (delete-directory app)))\n\n(test-group \"config-secret\"\n  (test-equal \"abc\" (config-secret '((s . \"abc\")) 's))\n  (test-equal '(\"new\" \"old\") (config-secret '((s . (\"new\" \"old\"))) 's))\n  (test-error (config-secret '() 's))\n  (test-error (config-secret '((s . \"REPLACE_WITH_BASE64_SECRET\")) 's))\n  (test-error (config-secret '((s . (\"new\" \"REPLACE_WITH_BASE64_SECRET\"))) 's)))\n\n(test-group \"resolve-path\"\n  (test-equal \"/etc/x\" (resolve-path \"/app\" \"/etc/x\"))\n  (test-equal \"/app/data/x\" (resolve-path \"/app\" \"data/x\")))\n\n(delete-file (string-append tmp \"/a.scm\"))\n(delete-file (string-append tmp \"/b.scm\"))\n(delete-directory tmp)\n\n(test-end \"starter-api config\")\n"))))))

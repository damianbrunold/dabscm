(define-library (scm data r)
  (import (scheme base)
          (scheme char)
          (scheme cxr)
          (scheme file)
          (scheme read)
          (scheme write)
          (srfi 1)
          (except (srfi 13) string-hash))
  (export r-parse
          r-deparse
          r->scm
          r->scm-string
          r-file->scm
          scm->r
          scm->r-string
          scm-file->r
          report->rmd
          scm-pretty)
  (begin

    ;; ================================================================
    ;; (scm data r) — translates analysis code between R (tidyverse:
    ;; dplyr, tidyr, readr, readxl, ggplot2, sf, stringr, lubridate,
    ;; the stats tests) and (scm data), best effort, in both directions.
    ;;
    ;; R -> Scheme: r-parse reads R into an R syntax tree (calls as
    ;; (:call f (name . arg) …), as R itself sees them), r->scm turns its
    ;; statements into (scm data) code: pipes become ->, verbs and their
    ;; arguments map one to one where they can, ggplot + chains become
    ;; ggplot forms, tests and lm keep their options. Inside verbs a name
    ;; is a column unless the script assigned it, then it is spliced in
    ;; with unquote. What has no counterpart becomes (r:unsupported "R
    ;; code") inline, or a ;; TODO comment for a whole statement or
    ;; pipeline step; the translation never fails, and the unsupported
    ;; pieces are returned as a list.
    ;;
    ;; Scheme -> R: scm->r reads (scm data) code (as data) and writes R in
    ;; pipe style with the libraries it needs; reports become R Markdown
    ;; (report->rmd). Unknown forms are written as R calls with their
    ;; names made R-like, or as # TODO comments.
    ;; ================================================================

    ;; --- R tokens --------------------------------------------------------

    ;; a token: #(type value line); type num str sym op nl eof
    (define (tok type value line) (vector type value line))
    (define (tok-type t) (vector-ref t 0))
    (define (tok-value t) (vector-ref t 1))
    (define (tok-line t) (vector-ref t 2))

    (define r-operators
      ;; longest first
      '("<<-" "->>" ":::" "|>" "<-" "->" "<=" ">=" "==" "!=" "&&" "||" "::" "[["
        "+" "-" "*" "/" "^" "<" ">" "!" "&" "|" "~" "?" ":" "=" "$" "@"
        "(" ")" "{" "}" "[" "]" "," ";" "\\"))

    (define (ident-start? c) (or (char-alphabetic? c) (char=? c #\.) (char=? c #\_)))
    (define (ident-char? c) (or (char-alphabetic? c) (char-numeric? c) (char=? c #\.) (char=? c #\_)))

    (define (r-tokenize text)
      (let ((n (string-length text)))
        (define (at i) (if (< i n) (string-ref text i) #\null))
        (define (starts? i s)
          (and (<= (+ i (string-length s)) n) (string=? (substring text i (+ i (string-length s))) s)))
        (define (read-string-lit i q line)
          ;; -> (values string next-i line)
          (let loop ((j (+ i 1)) (acc '()) (line line))
            (cond ((>= j n) (values (list->string (reverse acc)) j line))
                  ((char=? (at j) q) (values (list->string (reverse acc)) (+ j 1) line))
                  ((char=? (at j) #\\)
                   (let ((e (at (+ j 1))))
                     (case e
                       ((#\n) (loop (+ j 2) (cons #\newline acc) line))
                       ((#\t) (loop (+ j 2) (cons #\tab acc) line))
                       ((#\r) (loop (+ j 2) (cons #\return acc) line))
                       ((#\0) (loop (+ j 2) (cons #\null acc) line))
                       ((#\u #\U)
                        (let* ((brace? (char=? (at (+ j 2)) #\{))
                               (s (+ j (if brace? 3 2)))
                               (e2 (let hex ((k s)) (if (and (< k n) (< (- k s) 8) (char? (at k))
                                                             (string->number (string (at k)) 16))
                                                        (hex (+ k 1)) k)))
                               (code (string->number (substring text s e2) 16)))
                          (loop (if brace? (+ e2 1) e2) (if code (cons (integer->char code) acc) acc) line)))
                       (else (loop (+ j 2) (cons e acc) line)))))
                  ((char=? (at j) #\newline) (loop (+ j 1) (cons #\newline acc) (+ line 1)))
                  (else (loop (+ j 1) (cons (at j) acc) line)))))
        (define (read-number i)
          (let* ((hex? (and (char=? (at i) #\0) (memv (at (+ i 1)) '(#\x #\X))))
                 (e (if hex?
                        (let loop ((j (+ i 2))) (if (and (< j n) (string->number (string (at j)) 16)) (loop (+ j 1)) j))
                        (let loop ((j i) (seen-e #f))
                          (let ((c (at j)))
                            (cond ((or (char-numeric? c) (char=? c #\.)) (loop (+ j 1) seen-e))
                                  ((and (memv c '(#\e #\E)) (not seen-e)) (loop (+ j (if (memv (at (+ j 1)) '(#\+ #\-)) 2 1)) #t))
                                  (else j))))))
                 (s (substring text i e))
                 (suffix (memv (at e) '(#\L #\i)))
                 (v (if hex? (string->number (substring s 2 (string-length s)) 16)
                        (let ((v (string->number (if (string-prefix? "." s) (string-append "0" s) s))))
                          (cond ((not v) 0)
                                ((and (exact? v) (integer? v)) v)
                                ((and (integer? v) (not (string-index s #\.)) (not (string-index s #\e)) (not (string-index s #\E))) (exact v))
                                (else (inexact v)))))))
            (values v (if suffix (+ e 1) e))))
        (let loop ((i 0) (line 1) (acc '()))
          (if (>= i n)
              (reverse (cons (tok 'eof #f line) acc))
              (let ((c (at i)))
                (cond
                 ((char=? c #\newline) (loop (+ i 1) (+ line 1) (cons (tok 'nl #f line) acc)))
                 ((char-whitespace? c) (loop (+ i 1) line acc))
                 ((char=? c #\#) (let skip ((j i)) (if (and (< j n) (not (char=? (at j) #\newline))) (skip (+ j 1)) (loop j line acc))))
                 ((or (char-numeric? c) (and (char=? c #\.) (char-numeric? (at (+ i 1)))))
                  (let-values (((v j) (read-number i))) (loop j line (cons (tok 'num v line) acc))))
                 ((and (memv c '(#\r #\R)) (memv (at (+ i 1)) '(#\" #\')) (memv (at (+ i 2)) '(#\( #\[ #\{ #\-)))
                  ;; raw string r"(...)"
                  (let* ((q (at (+ i 1)))
                         (dashes (let d ((j (+ i 2)) (k 0)) (if (char=? (at j) #\-) (d (+ j 1) (+ k 1)) k)))
                         (open (at (+ i 2 dashes)))
                         (close (case open ((#\() #\)) ((#\[) #\]) (else #\})))
                         (end (string-append (string close) (make-string dashes #\-) (string q)))
                         (s (+ i 3 dashes))
                         (e (or (string-contains text end s) n)))
                    (loop (min n (+ e (string-length end))) line (cons (tok 'str (substring text s e) line) acc))))
                 ((or (char=? c #\") (char=? c #\'))
                  (let-values (((s j line2) (read-string-lit i c line)))
                    (loop j line2 (cons (tok 'str s line) acc))))
                 ((char=? c #\`)
                  (let ((e (or (string-index text #\` (+ i 1)) n)))
                    (loop (+ e 1) line (cons (tok 'sym (string->symbol (substring text (+ i 1) e)) line) acc))))
                 ((ident-start? c)
                  (let* ((e (let id ((j i)) (if (and (< j n) (ident-char? (at j))) (id (+ j 1)) j)))
                         (s (substring text i e)))
                    (loop e line
                          (cons (cond ((string=? s "TRUE") (tok 'num #t line))
                                      ((string=? s "FALSE") (tok 'num #f line))
                                      ((string=? s "T") (tok 'sym 'T line))
                                      ((member s '("NA_integer_" "NA_real_" "NA_character_")) (tok 'sym 'NA line))
                                      (else (tok 'sym (string->symbol s) line)))
                                acc))))
                 ((char=? c #\%)
                  (let ((e (or (string-index text #\% (+ i 1)) (- n 1))))
                    (loop (+ e 1) line (cons (tok 'op (substring text i (+ e 1)) line) acc))))
                 (else
                  (let ((op (find (lambda (o) (starts? i o)) r-operators)))
                    (if op
                        (loop (+ i (string-length op)) line (cons (tok 'op op line) acc))
                        (loop (+ i 1) line acc))))))))))

    ;; --- R syntax tree ---------------------------------------------------------

    ;; numbers, strings, #t/#f and symbols stand for themselves (NULL, NA,
    ;; Inf are symbols); a call is (:call f (name . arg) …) with name #f
    ;; for positional arguments, f a symbol or a tree; an operator is a
    ;; call of its symbol (+, %>%, <-, ~, $, [, [[, (, {, if, for …); a
    ;; function is (:function ((param . default-or-#f) …) body); an empty
    ;; argument is (:missing).

    (define (call? x) (and (pair? x) (eq? (car x) ':call)))
    (define (call-fn x) (cadr x))
    (define (call-args x) (cddr x))
    (define (mk-call f . args) (cons* ':call f args))
    (define (pos x) (cons #f x))
    (define (fn? x) (and (pair? x) (eq? (car x) ':function)))
    (define (missing? x) (equal? x '(:missing)))

    ;; the function's name, without a package prefix (dplyr::filter)
    (define (call-name x)
      (and (call? x)
           (let ((f (call-fn x)))
             (cond ((symbol? f) f)
                   ((and (call? f) (memq (call-fn f) '(:: :::))) (cdr (cadr (call-args f))))
                   (else #f)))))

    (define (op-call? x op) (and (call? x) (eq? (call-fn x) op)))

    (define (positional args) (map cdr (filter (lambda (a) (not (car a))) args)))
    (define (named args key)
      (let ((p (find (lambda (a) (and (car a) (eq? (car a) key))) args))) (and p (cdr p))))
    (define (arg-n args i)
      (let ((ps (positional args))) (and (> (length ps) i) (list-ref ps i))))

    ;; binding powers: (left . right); right-associative operators bind
    ;; their right operand one lower
    (define binary-ops
      '(("?" 1 . 1) ("=" 2 . 1) ("<-" 3 . 2) ("<<-" 3 . 2) ("->" 4 . 4) ("->>" 4 . 4)
        ("~" 5 . 5) ("||" 6 . 6) ("|" 6 . 6) ("&&" 7 . 7) ("&" 7 . 7)
        ("==" 9 . 9) ("!=" 9 . 9) ("<" 9 . 9) (">" 9 . 9) ("<=" 9 . 9) (">=" 9 . 9)
        ("+" 10 . 10) ("-" 10 . 10) ("*" 11 . 11) ("/" 11 . 11) ("|>" 12 . 12)
        (":" 13 . 13) ("^" 15 . 14)))

    (define (binary-bp op)
      (cond ((assoc op binary-ops) => cadr)
            ((and (> (string-length op) 1) (char=? (string-ref op 0) #\%)) 12)
            (else #f)))
    (define (binary-rbp op)
      (cond ((assoc op binary-ops) => cddr)
            (else 12)))

    (define (r-parse text)
      "Syntax: (r-parse text)
Library: (scm data r)
Description: Parses R source text into a list of statements, as R syntax
  trees: numbers, strings, #t/#f and symbols as themselves, calls as
  (:call f (name . argument) …) — operators too, as R sees them, e.g.
  x + 1 is (:call + (#f . x) (#f . 1)) — and functions as (:function
  ((parameter . default) …) body).
Example:
  (r-parse \"x <- 1 + 2\") => ((:call <- (#f . x) (#f . (:call + (#f . 1) (#f . 2)))))"
      (let* ((toks (list->vector (r-tokenize text)))
             (i 0)
             (stack '()))       ; 'paren / 'brace: newlines matter outside parens
        (define (peek) (vector-ref toks i))
        (define (peek-at k) (vector-ref toks (min (+ i k) (- (vector-length toks) 1))))
        (define (advance!) (let ((t (peek))) (set! i (min (+ i 1) (- (vector-length toks) 1))) t))
        (define (op? t s) (and (eq? (tok-type t) 'op) (string=? (tok-value t) s)))
        (define (skip-nl!) (let loop () (when (eq? (tok-type (peek)) 'nl) (advance!) (loop))))
        (define (in-paren?) (and (pair? stack) (eq? (car stack) 'paren)))
        (define (expect! s)
          (skip-nl!)
          (if (op? (peek) s)
              (advance!)
              (error (string-append "R syntax: expected " s " on line " (number->string (tok-line (peek))))
                     (tok-value (peek)))))
        (define (with-ctx ctx thunk)
          (set! stack (cons ctx stack))
          (let ((v (thunk))) (set! stack (cdr stack)) v))
        ;; the next token that may continue an expression
        (define (peek-infix)
          (when (in-paren?) (skip-nl!))
          (peek))
        (define (lbp t)
          (if (eq? (tok-type t) 'op)
              (let ((s (tok-value t)))
                (cond ((member s '("(" "[" "[[" "$" "@")) 16)
                      ((member s '("::" ":::")) 17)
                      ((binary-bp s) => (lambda (b) b))
                      (else 0)))
              0))
        (define (parse-expr rbp)
          (let loop ((left (nud)))
            (let ((t (peek-infix)))
              (if (> (lbp t) rbp)
                  (begin (advance!) (loop (led t left)))
                  left))))
        (define (nud)
          (skip-nl!)
          (let ((t (advance!)))
            (case (tok-type t)
              ((num str) (tok-value t))
              ((sym)
               (case (tok-value t)
                 ((function) (parse-function))
                 ((if) (parse-if))
                 ((for) (parse-for))
                 ((while) (expect! "(")
                          (let* ((c (with-ctx 'paren (lambda () (parse-expr 0)))))
                            (expect! ")")
                            (mk-call 'while (pos c) (pos (parse-expr 2)))))
                 ((repeat) (mk-call 'repeat (pos (parse-expr 2))))
                 ((break next) (mk-call (tok-value t)))
                 (else (tok-value t))))
              ((op)
               (let ((s (tok-value t)))
                 (cond
                  ((string=? s "(")
                   (let ((e (with-ctx 'paren (lambda () (parse-expr 0)))))
                     (expect! ")")
                     (mk-call '|(| (pos e))))
                  ((string=? s "{")
                   (with-ctx 'brace
                     (lambda ()
                       (let loop ((acc '()))
                         (let skip () (when (or (eq? (tok-type (peek)) 'nl) (op? (peek) ";")) (advance!) (skip)))
                         (if (op? (peek) "}")
                             (begin (advance!) (apply mk-call '|{| (map pos (reverse acc))))
                             (loop (cons (parse-expr 0) acc)))))))
                  ((member s '("-" "+")) (mk-call (string->symbol s) (pos (parse-expr 14))))
                  ((string=? s "!") (mk-call '! (pos (parse-expr 8))))
                  ((string=? s "~") (mk-call '~ (pos (parse-expr 5))))
                  ((string=? s "?") (parse-expr 1))
                  ((string=? s "\\") (parse-function))
                  (else (error (string-append "R syntax: unexpected " s " on line " (number->string (tok-line t))))))))
              ((eof) (error "R syntax: unexpected end of input"))
              (else (error "R syntax: unexpected token" (tok-value t))))))
        (define (led t left)
          (let ((s (tok-value t)))
            (cond
             ((string=? s "(") (apply mk-call left (parse-args ")")))
             ((string=? s "[") (apply mk-call '|[| (pos left) (parse-args "]")))
             ((string=? s "[[")
              (let ((args (parse-args "]")))
                (expect! "]")
                (apply mk-call '|[[| (pos left) args)))
             ((member s '("$" "@"))
              (let ((r (advance!)))
                (mk-call (string->symbol s) (pos left)
                         (pos (if (eq? (tok-type r) 'str) (string->symbol (tok-value r)) (tok-value r))))))
             ((member s '("::" ":::"))
              (mk-call (string->symbol s) (pos left) (pos (tok-value (advance!)))))
             (else (mk-call (string->symbol s) (pos left) (pos (parse-expr (binary-rbp s))))))))
        ;; arguments up to the closing token (consumed): ((name . value) …)
        (define (parse-args close)
          (with-ctx 'paren
            (lambda ()
              (let loop ((acc '()))
                (skip-nl!)
                (cond
                 ((op? (peek) close) (advance!) (reverse acc))
                 ((op? (peek) ",") (advance!) (loop (cons (pos '(:missing)) acc)))
                 (else
                  (let* ((t (peek)) (t2 (let ((k 1)) (peek-at k)))
                         (arg (if (and (memq (tok-type t) '(sym str)) (op? t2 "="))
                                  (begin (advance!) (advance!) (skip-nl!)
                                         (cons (if (eq? (tok-type t) 'str) (string->symbol (tok-value t)) (tok-value t))
                                               (if (or (op? (peek) ",") (op? (peek) close)) '(:missing) (parse-expr 2))))
                                  (pos (parse-expr 2)))))
                    (skip-nl!)
                    (when (op? (peek) ",") (advance!))
                    (loop (cons arg acc)))))))))
        (define (parse-function)
          (expect! "(")
          (let ((params (with-ctx 'paren
                          (lambda ()
                            (let loop ((acc '()))
                              (skip-nl!)
                              (cond ((op? (peek) ")") (advance!) (reverse acc))
                                    ((op? (peek) ",") (advance!) (loop acc))
                                    (else
                                     (let ((name (tok-value (advance!))))
                                       (skip-nl!)
                                       (if (op? (peek) "=")
                                           (begin (advance!) (loop (cons (cons name (parse-expr 2)) acc)))
                                           (loop (cons (cons name #f) acc)))))))))))
            (list ':function params (parse-expr 2))))
        (define (parse-if)
          (expect! "(")
          (let ((c (with-ctx 'paren (lambda () (parse-expr 0)))))
            (expect! ")")
            (let* ((a (parse-expr 2))
                   ;; else may follow on a later line
                   (save i)
                   (_ (skip-nl!)))
              (if (and (eq? (tok-type (peek)) 'sym) (eq? (tok-value (peek)) 'else))
                  (begin (advance!) (mk-call 'if (pos c) (pos a) (pos (parse-expr 2))))
                  (begin (set! i save) (mk-call 'if (pos c) (pos a)))))))
        (define (parse-for)
          (expect! "(")
          (let* ((v (tok-value (advance!)))
                 (_ (advance!))           ; in
                 (seq (with-ctx 'paren (lambda () (parse-expr 0)))))
            (expect! ")")
            (mk-call 'for (pos v) (pos seq) (pos (parse-expr 2)))))
        ;; statements
        (let loop ((acc '()))
          (let skip () (when (or (eq? (tok-type (peek)) 'nl) (op? (peek) ";")) (advance!) (skip)))
          (if (eq? (tok-type (peek)) 'eof)
              (reverse acc)
              (loop (cons (parse-expr 0) acc))))))

    ;; --- R syntax tree -> text ---------------------------------------------------

    (define (syntactic-name? s)
      (and (> (string-length s) 0)
           (ident-start? (string-ref s 0))
           (not (and (char=? (string-ref s 0) #\.) (> (string-length s) 1) (char-numeric? (string-ref s 1))))
           (string-every ident-char? s)
           (not (member s '("if" "else" "for" "while" "function" "repeat" "in" "next" "break" "TRUE" "FALSE")))))

    (define (r-name sym)
      (let ((s (symbol->string sym)))
        (if (or (syntactic-name? s) (member s '("NULL" "NA" "Inf" "NaN" "..."))) s (string-append "`" s "`"))))

    (define (r-string s)
      (let ((out (open-output-string)))
        (write-char #\" out)
        (string-for-each (lambda (c)
                           (case c
                             ((#\") (write-string "\\\"" out))
                             ((#\\) (write-string "\\\\" out))
                             ((#\newline) (write-string "\\n" out))
                             ((#\tab) (write-string "\\t" out))
                             (else (write-char c out))))
                         s)
        (write-char #\" out)
        (get-output-string out)))

    (define (r-number x)
      (cond ((and (exact? x) (integer? x)) (number->string x))
            ((exact? x) (r-number (inexact x)))
            ((= x +inf.0) "Inf") ((= x -inf.0) "-Inf") ((not (= x x)) "NaN")
            ((and (integer? x) (< (abs x) 1e15)) (number->string (exact x)))
            (else (number->string x))))

    (define (infix-op? f)
      (and (symbol? f)
           (let ((s (symbol->string f)))
             (or (binary-bp s) (member s '("$" "@" "::" ":::"))))))

    (define (op-bp f)
      (let ((s (symbol->string f)))
        (cond ((member s '("$" "@")) 16) ((member s '("::" ":::")) 17) (else (binary-bp s)))))

    (define (r-deparse x . bp)
      "Syntax: (r-deparse tree)
Library: (scm data r)
Description: R source text of an R syntax tree as r-parse returns it (one
  line; parentheses added where precedence needs them).
Example:
  (r-deparse (car (r-parse \"f(x = 1) + 2\"))) => \"f(x = 1) + 2\""
      (let ((ctx (if (pair? bp) (car bp) 0)))
        (cond
         ((eq? x #t) "TRUE") ((eq? x #f) "FALSE")
         ((number? x) (r-number x))
         ((string? x) (r-string x))
         ((symbol? x) (r-name x))
         ((missing? x) "")
         ((fn? x)
          (string-append "function("
                         (string-join (map (lambda (p) (if (cdr p) (string-append (r-name (car p)) " = " (r-deparse (cdr p))) (r-name (car p))))
                                           (cadr x))
                                      ", ")
                         ") " (r-deparse (caddr x))))
         ((and (pair? x) (eq? (car x) ':comment)) (string-append "# " (cadr x)))
         ((not (call? x)) (let ((p (open-output-string))) (write x p) (get-output-string p)))
         (else
          (let ((f (call-fn x)) (args (call-args x)))
            (cond
             ((eq? f '|(|) (string-append "(" (r-deparse (cdar args)) ")"))
             ((eq? f '|{|)
              (string-append "{ " (string-join (map (lambda (a) (r-deparse (cdr a))) args) "; ") " }"))
             ((eq? f 'if)
              (string-append "if (" (r-deparse (cdar args)) ") " (r-deparse (cdadr args))
                             (if (pair? (cddr args)) (string-append " else " (r-deparse (cdaddr args))) "")))
             ((eq? f 'for)
              (string-append "for (" (r-deparse (cdar args)) " in " (r-deparse (cdadr args)) ") " (r-deparse (cdaddr args))))
             ((eq? f 'while) (string-append "while (" (r-deparse (cdar args)) ") " (r-deparse (cdadr args))))
             ((eq? f '|[|)
              (string-append (r-deparse (cdar args) 16) "[" (deparse-args (cdr args)) "]"))
             ((eq? f '|[[|)
              (string-append (r-deparse (cdar args) 16) "[[" (deparse-args (cdr args)) "]]"))
             ((and (infix-op? f) (= (length args) 2) (not (car (car args))) (not (car (cadr args))))
              (let* ((b (op-bp f))
                     (s (symbol->string f))
                     (right? (member s '("^" "<-" "<<-" "=")))
                     (l (r-deparse (cdar args) (if right? (+ b 1) b)))
                     (r (r-deparse (cdadr args) (if right? b (+ b 1))))
                     (sep (if (member s '("$" "@" "::" ":::" ":" "^")) "" " "))
                     (text (string-append l sep s sep r)))
                (if (< b ctx) (string-append "(" text ")") text)))
             ((and (eq? f '!) (= (length args) 1) (op-call? (cdar args) '!!))
              (string-append "!!" (r-deparse (cdar (call-args (cdar args))) 8)))
             ((and (memq f '(- + ! ~)) (= (length args) 1))
              (let* ((b (case f ((!) 8) ((~) 5) (else 14)))
                     (text (string-append (symbol->string f) (r-deparse (cdar args) b))))
                (if (< b ctx) (string-append "(" text ")") text)))
             (else
              (string-append (if (symbol? f) (r-name f) (r-deparse f 16)) "(" (deparse-args args) ")"))))))))

    (define (deparse-args args)
      (string-join (map (lambda (a)
                          (if (car a)
                              (string-append (r-name (car a)) " = " (r-deparse (cdr a) 2))
                              (r-deparse (cdr a) 2)))
                        args)
                   ", "))

    ;; R text broken over lines where it does not fit in 80 columns:
    ;; pipes and ggplot chains one step per line, long calls one argument
    ;; per line, blocks indented. col is where the text starts.
    (define (r-pretty x ind . start)
      ;; ind: the indentation of the current line; start: the column the
      ;; text starts at (default ind)
      (let* ((at (if (pair? start) (car start) ind))
             (flat (r-deparse x))
             (pad (lambda (n) (make-string n #\space))))
        (define (chain v op)
          (if (op-call? v op)
              (append (chain (cdar (call-args v)) op) (list (cdadr (call-args v))))
              (list v)))
        (cond
         ((and (<= (+ at (string-length flat)) 80)
               (not (and (call? x) (eq? (call-fn x) '|{|) (> (length (call-args x)) 1)))
               (not (must-break? x)))
          flat)
         ((and (pair? x) (eq? (car x) ':comment)) (string-append "# " (cadr x)))
         ((and (call? x) (memq (call-fn x) '(<- = <<-)) (= (length (call-args x)) 2))
          (let ((prefix (string-append (r-deparse (cdar (call-args x))) " " (symbol->string (call-fn x)) " ")))
            (string-append prefix (r-pretty (cdadr (call-args x)) ind (+ at (string-length prefix))))))
         ((fn? x)
          (let ((head (string-append "function("
                                     (string-join (map (lambda (p) (if (cdr p) (string-append (r-name (car p)) " = " (r-deparse (cdr p))) (r-name (car p))))
                                                       (cadr x))
                                                  ", ")
                                     ") ")))
            (string-append head (r-pretty (caddr x) ind (+ at (string-length head))))))
         ((op-call? x '|{|)
          (string-append "{\n"
                         (string-concatenate (map (lambda (a) (string-append (pad (+ ind 2)) (r-pretty (cdr a) (+ ind 2)) "\n")) (call-args x)))
                         (pad ind) "}"))
         ((op-call? x 'if)
          (let* ((args (call-args x))
                 (head (string-append "if (" (r-deparse (cdar args)) ") ")))
            (string-append head (r-pretty (cdadr args) ind (+ at (string-length head)))
                           (if (pair? (cddr args)) (string-append " else " (r-pretty (cdaddr args) ind (+ ind 7))) ""))))
         ((op-call? x 'for)
          (let* ((args (call-args x))
                 (head (string-append "for (" (r-deparse (cdar args)) " in " (r-deparse (cdadr args)) ") ")))
            (string-append head (r-pretty (cdaddr args) ind (+ at (string-length head))))))
         ((and (call? x) (memq (call-fn x) '(|\|>| %>% +)) (= (length (call-args x)) 2)
               (or (not (eq? (call-fn x) '+)) (gg-r-chain? x)))
          (let ((parts (chain x (call-fn x))))
            (string-append (r-pretty (car parts) ind at)
                           (string-concatenate
                            (map (lambda (p) (string-append " " (symbol->string (call-fn x)) "\n" (pad (+ ind 2)) (r-pretty p (+ ind 2))))
                                 (cdr parts))))))
         ((and (call? x) (symbol? (call-fn x)) (not (infix-op? (call-fn x))) (pair? (call-args x))
               (not (memq (call-fn x) '(|(| |[| |[[| ! - while))))
          (string-append (r-name (call-fn x)) "(\n"
                         (string-join (map (lambda (a)
                                             (let ((prefix (if (car a) (string-append (r-name (car a)) " = ") "")))
                                               (string-append (pad (+ ind 2)) prefix
                                                              (r-pretty (cdr a) (+ ind 2) (+ ind 2 (string-length prefix))))))
                                           (call-args x))
                                      ",\n")
                         "\n" (pad ind) ")"))
         (else flat))))

    ;; ggplot chains go one layer per line from two layers on, also as
    ;; the value of an assignment
    (define (must-break? x)
      (cond ((and (call? x) (memq (call-fn x) '(<- = <<-)) (= (length (call-args x)) 2))
             (must-break? (cdadr (call-args x))))
            (else (and (op-call? x '+) (op-call? (cdar (call-args x)) '+) (gg-r-chain? x)))))

    (define (gg-r-chain? x)
      (let loop ((x x))
        (cond ((op-call? x '+) (loop (cdar (call-args x))))
              ((call? x) (eq? (call-fn x) 'ggplot))
              (else #f))))

    (define (deparse-statement x) (r-pretty x 0))

    ;; --- tables shared by both directions ------------------------------------

    ;; column-expression functions: (scheme-name r-name) — one to one
    (define fn-table
      '((mean mean) (sum sum) (median median) (min min) (max max) (sd sd) (var var)
        (n-distinct n_distinct) (first first) (last last) (any any) (all all)
        (lag lag) (lead lead) (cumsum cumsum) (row-number row_number) (rank min_rank)
        (dense-rank dense_rank) (abs abs) (sqrt sqrt) (exp exp) (floor floor)
        (ceiling ceiling) (round round) (pmin pmin) (pmax pmax) (quantile quantile)
        (coalesce coalesce) (between between) (is-na is.na) (str-detect str_detect)
        (str-replace str_replace_all) (str-upper str_to_upper) (str-lower str_to_lower)
        (str-trim str_trim) (str-len str_length) (str-starts str_starts) (str-ends str_ends)
        (str-pad str_pad) (->number as.numeric) (->int as.integer) (->string as.character)
        (year year) (month month) (day day) (weekday wday) (parse-date as.Date)
        (days-between days_between) (share share) (pct-change pct_change)))

    ;; R aliases: (r-name scheme-name)
    (define fn-aliases
      '((nchar str-len) (toupper str-upper) (tolower str-lower) (trimws str-trim)
        (str_replace str-replace) (str_length str-len) (startsWith str-starts) (endsWith str-ends)
        (as.double ->number) (as.Date parse-date) (ymd parse-date) (as_date parse-date)
        (rank rank) (percent_rank rank) (cummean #f) (n_distinct n-distinct) (length #f)))

    (define (scm-fn-of r)
      (cond ((assq r fn-aliases) => cadr)
            ((find (lambda (e) (eq? (cadr e) r)) fn-table) => car)
            (else #f)))

    (define (r-fn-of s) (let ((e (assq s fn-table))) (and e (cadr e))))

    ;; test options: (r-name scheme-name)
    (define test-options
      '((alternative alternative) (mu mu) (paired paired) (var.equal var-equal)
        (conf.level conf-level) (exact exact) (correct correct) (p p) (method method)
        (rescale.p rescale-p) (or or)))

    ;; tests: (r-name scheme-name)
    (define test-table
      '((t.test t-test) (wilcox.test wilcox-test) (chisq.test chisq-test) (fisher.test fisher-test)
        (binom.test binom-test) (prop.test prop-test) (cor.test cor-test) (shapiro.test shapiro-test)
        (ks.test ks-test) (kruskal.test kruskal-test) (oneway.test oneway-test)))

    ;; ggplot palettes: (scheme-name brewer-name)
    (define palette-table
      '((blue "Blues") (green "Greens") (orange "Oranges") (red "Reds") (violet "Purples")
        (red-blue "RdBu") (blue-red "BuRd") (orange-blue "OrBu") (blue-orange "PuOr")
        (green-violet "PRGn") (violet-green "PiYG")))

    ;; --- R -> Scheme ---------------------------------------------------------------

    ;; translation state: the script's variables with what they hold
    ;; (frame, plot, htest, lm, function, value), the libraries, and what
    ;; could not be translated
    (define-record-type <rx>
      (make-rx vars unsupported)
      rx?
      (vars rx-vars set-rx-vars!)
      (unsupported rx-unsupported set-rx-unsupported!))

    (define (var-kind st name) (let ((p (assq name (rx-vars st)))) (and p (cdr p))))
    (define (set-var! st name kind) (set-rx-vars! st (cons (cons name kind) (rx-vars st))))

    (define (unsupported! st x)
      (let ((text (if (string? x) x (r-deparse x))))
        (set-rx-unsupported! st (cons text (rx-unsupported st)))
        `(r:unsupported ,text)))

    (define (comment text) (list ':comment text))
    (define (comment? x) (and (pair? x) (eq? (car x) ':comment)))

    (define (todo st x)
      (let ((text (if (string? x) x (r-deparse x))))
        (set-rx-unsupported! st (cons text (rx-unsupported st)))
        (comment (string-append "TODO (R): " text))))

    (define (sym-of x) (cond ((symbol? x) x) ((string? x) (string->symbol x)) (else #f)))

    (define (string-arg x) (cond ((string? x) x) ((symbol? x) (symbol->string x)) (else #f)))

    ;; c("a", "b") / c(a, b) / "a" / a -> list of symbols (column names)
    (define (name-list x)
      (cond ((and (call? x) (eq? (call-name x) 'c)) (append-map (lambda (a) (name-list (cdr a))) (call-args x)))
            ((sym-of x) => list)
            (else '())))

    ;; a formula tree -> datum (y ~ x1 + x2)
    (define (formula->datum x)
      (define (flat e)
        (cond ((and (call? e) (memq (call-fn e) '(+ - *)) (= (length (call-args e)) 2))
               (append (flat (cdar (call-args e))) (list (call-fn e)) (flat (cdadr (call-args e)))))
              ((and (call? e) (eq? (call-fn e) '|(|)) (flat (cdar (call-args e))))
              ((eq? e '|.|) (list '|.|))
              ((symbol? e) (list e))
              ((number? e) (list e))
              (else (list (string->symbol (r-deparse e))))))
      (let ((args (call-args x)))
        (if (= (length args) 2)
            (append (flat (cdar args)) '(~) (flat (cdadr args)))
            (cons '~ (flat (cdar args))))))

    (define (formula? x) (op-call? x '~))

    ;; Scheme value of an R constant vector c(…) of literals, or #f
    (define (literal x)
      (cond ((or (number? x) (string? x) (boolean? x)) x)
            ((and (op-call? x '-) (= (length (call-args x)) 1) (number? (cdar (call-args x)))) (- (cdar (call-args x))))
            ((eq? x 'NA) 'na)
            (else ':none)))

    (define (literal-vector x)
      (cond ((not (eq? (literal x) ':none)) (list (literal x)))
            ((and (call? x) (eq? (call-name x) 'c)
                  (every (lambda (a) (not (eq? (literal (cdr a)) ':none))) (call-args x)))
             (map (lambda (a) (literal (cdr a))) (call-args x)))
            (else #f)))

    ;; --- column expressions (inside verbs) ---

    (define (cx st x)
      (cond
       ((or (number? x) (string? x) (boolean? x)) x)
       ((symbol? x)
        (case x
          ((NA) '(unquote na))
          ((Inf) '+inf.0)
          ((T) #t)
          ((F) #f)
          (else (if (var-kind st x) (list 'unquote x) x))))
       ((fn? x) (list 'unquote (tx st x)))
       ((call? x) (cx-call st x))
       (else (unsupported! st x))))

    (define binary-map
      '((+ . +) (- . -) (* . *) (/ . /) (%% . modulo) (%/% . quotient) (== . =) (!= . !=)
        (< . <) (> . >) (<= . <=) (>= . >=) (& . and) (&& . and) (|\|| . or) (|\|\|| . or)))

    (define (cx-call st x)
      (let* ((f (call-fn x)) (args (call-args x)) (name (call-name x))
             (ps (positional args))
             (c (lambda (e) (cx st e))))
        (cond
         ((eq? f '|(|) (c (cdar args)))
         ((and (assq f binary-map) (= (length ps) 2))
          (list (cdr (assq f binary-map)) (c (car ps)) (c (cadr ps))))
         ((and (eq? f '-) (= (length ps) 1)) (list '- (c (car ps))))
         ((eq? f '!) (list 'not (c (car ps))))
         ((eq? f '^) (list '(unquote expt) (c (car ps)) (c (cadr ps))))
         ((eq? f '%in%) (list 'in (c (car ps)) (list 'unquote (tx st (cadr ps)))))
         ((and (eq? f '$) (eq? (car ps) '|.data|)) (cadr ps))
         ((eq? f 'if) (list 'if (c (car ps)) (c (cadr ps)) (if (pair? (cddr ps)) (c (caddr ps)) '(unquote na))))
         ((not name) (unsupported! st x))
         ((memq name '(ifelse if_else)) (list 'if (c (car ps)) (c (cadr ps)) (c (caddr ps))))
         ((eq? name 'case_when)
          (cons 'case-when
                (map (lambda (a)
                       (let ((e (cdr a)))
                         (if (formula? e)
                             (let ((l (cdar (call-args e))) (r (cdadr (call-args e))))
                               (if (memq l '(#t TRUE T)) (list 'else (c r)) (list (c l) (c r))))
                             (list 'else (c e)))))
                     (filter (lambda (a) (not (car a))) args))))
         ((eq? name 'n) '(n))
         ((memq name '(paste0 str_c str_glue))
          (cons 'str (map c (positional args))))
         ((eq? name 'paste)
          (let ((sep (let ((s (named args 'sep))) (if (string? s) s " "))))
            (cons 'str (let loop ((xs (map c ps)) (acc '()))
                         (cond ((null? xs) (reverse acc))
                               ((null? acc) (loop (cdr xs) (list (car xs))))
                               ((string=? sep "") (loop (cdr xs) (cons (car xs) acc)))
                               (else (loop (cdr xs) (cons (car xs) (cons sep acc)))))))))
         ((memq name '(log10 log2)) (list 'log (c (car ps)) (if (eq? name 'log10) 10 2)))
         ((eq? name 'log) (if (named args 'base) (list 'log (c (car ps)) (c (named args 'base))) (cons 'log (map c ps))))
         ((eq? name 'round) (cons 'round (map c (append ps (let ((d (named args 'digits))) (if d (list d) '()))))))
         ((memq name '(substr str_sub substring))
          (let* ((s (car ps)) (a (or (named args 'start) (cadr* ps 1))) (b (or (named args 'stop) (named args 'end) (cadr* ps 2))))
            (append (list 'str-sub (c s) (if (number? a) (- a 1) (list '- (c a) 1)))
                    (if b (list (c b)) '()))))
         ((memq name '(grepl)) (list 'str-detect (c (cadr ps)) (c (car ps))))
         ((memq name '(gsub sub)) (list 'str-replace (c (caddr ps)) (c (car ps)) (c (cadr ps))))
         ((eq? name 'desc) (list 'desc (c (car ps))))
         ((memq name '(factor as.factor)) (list '->string (c (car ps))))
         ((eq? name 'c) (list 'unquote (tx st x)))
         ((eq? name 'quantile)
          (list 'quantile (c (car ps)) (c (or (named args 'probs) (cadr* ps 1) 0.5))))
         ((scm-fn-of name)
          => (lambda (s) (cons s (map c ps))))
         ((eq? (var-kind st name) 'function) (cons (list 'unquote name) (map c ps)))
         (else (unsupported! st x)))))

    (define (cadr* l k) (and (> (length l) k) (list-ref l k)))

    ;; --- verbs ---

    (define verbs
      '(filter mutate transmute summarise summarize group_by ungroup arrange select rename
        relocate distinct count add_count tally slice slice_head slice_tail slice_max slice_min
        slice_sample head tail pull left_join inner_join full_join right_join semi_join anti_join
        bind_rows bind_cols pivot_longer pivot_wider separate drop_na replace_na fill
        unnest_longer rowwise))

    (define (verb-call? x) (and (call? x) (memq (call-name x) verbs) #t))

    ;; select helpers and column specs
    (define (select-spec st x)
      (cond
       ((symbol? x) (list x))
       ((string? x) (list (string->symbol x)))
       ((and (call? x) (eq? (call-fn x) '-) (= (length (call-args x)) 1))
        (list (cons 'except (append-map (lambda (s) (select-spec st s)) (list (cdar (call-args x)))))))
       ((and (call? x) (eq? (call-name x) 'c)) (append-map (lambda (a) (select-spec st (cdr a))) (call-args x)))
       ((and (call? x) (memq (call-name x) '(starts_with ends_with contains matches)))
        (list (list (case (call-name x) ((starts_with) 'starts-with) ((ends_with) 'ends-with) ((contains) 'contains) (else 'matches))
                    (cdar (call-args x)))))
       ((and (call? x) (eq? (call-name x) 'everything)) '((everything)))
       ((and (call? x) (eq? (call-name x) 'all_of)) (map (lambda (v) (list 'unquote v)) (list (tx st (cdar (call-args x))))))
       (else (list (unsupported! st x)))))

    ;; one verb with its arguments (the data argument left out) -> steps
    (define (verb-steps st name args)
      (let* ((ps (positional args))
             (named-args (filter car args))
             (c (lambda (e) (cx st e))))
        (case name
          ((filter) (list (cons 'where (map c ps))))
          ((mutate transmute summarise summarize)
           (let* ((by (named args '|.by|))
                  (body (filter (lambda (a) (not (memq (car a) '(|.groups| |.by| |.keep| |.before| |.after|)))) args))
                  (specs (append-map
                          (lambda (a)
                            (cond ((car a) (list (list (car a) (c (cdr a)))))
                                  ((and (call? (cdr a)) (eq? (call-name (cdr a)) 'across)) (across-specs st (cdr a)))
                                  (else (list (list (string->symbol (r-deparse (cdr a))) (c (cdr a)))))))
                          body))
                  (head (case name ((summarize) 'summarise) (else name))))
             (append (if by (list (cons 'group-by (name-list by))) '())
                     (list (cons head specs)))))
          ((group_by) (list (cons 'group-by (append-map (lambda (e) (select-spec st e)) ps))))
          ((ungroup) '((ungroup)))
          ((arrange)
           (list (cons 'arrange (map (lambda (e)
                                       (if (and (call? e) (eq? (call-fn e) '-) (= (length (call-args e)) 1))
                                           (list 'desc (c (cdar (call-args e))))
                                           (c e)))
                                     ps))))
          ((select) (list (cons 'select (append-map (lambda (a) (if (car a) (list (list 'rename (car a) (sym-of (cdr a))))
                                                                  (select-spec st (cdr a))))
                                                    args))))
          ((rename) (list (cons 'rename (map (lambda (a) (list (car a) (sym-of (cdr a)))) named-args))))
          ((relocate) (list (cons 'relocate (append-map (lambda (e) (select-spec st e)) ps))))
          ((distinct) (list (cons 'distinct (append-map (lambda (e) (select-spec st e)) ps))))
          ((count tally)
           (let ((sort? (memq (named args 'sort) '(#t T)))
                 (nm (named args 'name)))
             (append (list (cons 'tally (append-map (lambda (e) (select-spec st e)) ps)))
                     (if sort? '((arrange (desc n))) '())
                     (if (string? nm) (list (list 'rename (list (string->symbol nm) 'n))) '()))))
          ((add_count) (list (cons 'add-count (append-map (lambda (e) (select-spec st e)) ps))))
          ((head slice_head) (list (list 'head (or (named args 'n) (car* ps) 6))))
          ((tail slice_tail) (list (list 'tail (or (named args 'n) (car* ps) 6))))
          ((slice)
           (let ((r (car* ps)))
             (if (and (op-call? r ':) (number? (cdar (call-args r))) (number? (cdadr (call-args r))))
                 (list (list 'slice (- (cdar (call-args r)) 1) (cdadr (call-args r))))
                 (list (todo st (mk-call 'slice (pos r)))))))
          ((slice_max slice_min)
           (let ((by (or (named args 'order_by) (car* ps))) (n (or (named args 'n) 1)))
             (list (list 'arrange (if (eq? name 'slice_max) (list 'desc (c by)) (c by)))
                   (list 'head n))))
          ((slice_sample) (list (list 'sample-n (or (named args 'n) (car* ps) 1))))
          ((pull) (list (list 'pull (or (sym-of (car* ps)) (sym-of (named args 'var)) 'TODO))))
          ((left_join inner_join full_join semi_join anti_join right_join)
           (let* ((y (tx st (car ps)))
                  (by (named args 'by))
                  (by-spec (cond ((not by) '())
                                 ((and (call? by) (eq? (call-name by) 'join_by))
                                  (list (cons 'by (map (lambda (a)
                                                         (let ((e (cdr a)))
                                                           (if (op-call? e '==)
                                                               (cons (sym-of (cdar (call-args e))) (sym-of (cdadr (call-args e))))
                                                               (sym-of e))))
                                                       (call-args by)))))
                                 ((and (call? by) (eq? (call-name by) 'c))
                                  (list (cons 'by (map (lambda (a) (if (car a) (cons (car a) (sym-of (cdr a))) (sym-of (cdr a))))
                                                       (call-args by)))))
                                 (else (list (list 'by (sym-of by))))))
                  (verb (case name
                          ((left_join) 'left-join) ((inner_join) 'inner-join) ((full_join) 'full-join)
                          ((semi_join) 'semi-join) ((anti_join) 'anti-join) (else #f))))
             (if verb
                 (list (cons* verb y by-spec))
                 (list (todo st (apply mk-call name args))))))
          ((bind_rows bind_cols)
           (list (cons (if (eq? name 'bind_rows) 'bind-rows 'bind-cols) (map (lambda (e) (tx st e)) ps))))
          ((pivot_longer)
           (let ((cols (or (named args 'cols) (car* ps))))
             (list (append (list 'pivot-longer (cons 'cols (append-map (lambda (e) (select-spec st e)) (list cols))))
                           (let ((n (named args 'names_to))) (if n (list (list 'names-to (sym-of n))) '()))
                           (let ((v (named args 'values_to))) (if v (list (list 'values-to (sym-of v))) '()))))))
          ((pivot_wider)
           (list (append (list 'pivot-wider)
                         (let ((n (named args 'names_from))) (if n (list (cons 'names-from (name-list n))) '()))
                         (let ((v (named args 'values_from))) (if v (list (list 'values-from (sym-of v))) '()))
                         (let ((f (named args 'values_fill))) (if f (list (list 'values-fill (c f))) '())))))
          ((separate)
           (list (append (list 'separate (sym-of (or (named args 'col) (car ps))))
                         (let ((into (named args 'into))) (if into (list (cons 'into (name-list into))) '()))
                         (let ((sep (named args 'sep))) (if (string? sep) (list (list 'sep sep)) '())))))
          ((drop_na) (list (cons 'drop-na (append-map (lambda (e) (select-spec st e)) ps))))
          ((replace_na)
           (let ((l (car* ps)))
             (if (and (call? l) (eq? (call-name l) 'list))
                 (list (cons 'replace-na (map (lambda (a) (list (car a) (c (cdr a)))) (call-args l))))
                 (list (todo st (apply mk-call name args))))))
          ((fill)
           (let ((dir (named args '|.direction|)))
             (list (cons (if (equal? dir "up") 'fill-up 'fill-down) (append-map (lambda (e) (select-spec st e)) ps)))))
          ((unnest_longer) (list (list 'unnest-longer (sym-of (car ps)))))
          (else (list (todo st (apply mk-call name args)))))))

    (define (car* l) (and (pair? l) (car l)))

    ;; across(c(a, b), f) / across(c(a, b), ~ .x * 2) -> one spec per column
    (define (across-specs st x)
      (let* ((args (call-args x))
             (cols (append-map (lambda (e) (select-spec st e)) (list (or (named args '|.cols|) (cdar args)))))
             (fun (or (named args '|.fns|) (cadr* (positional args) 1))))
        (if (and (every symbol? cols) fun)
            (map (lambda (col)
                   (list col
                         (cond ((symbol? fun) (cx st (mk-call fun (pos col))))
                               ((formula? fun) (cx st (substitute (cdar (call-args fun)) '(|.x| |.|) col)))
                               ((fn? fun) (cx st (substitute (caddr fun) (list (caar (cadr fun))) col)))
                               (else (unsupported! st fun)))))
                 cols)
            (list (list 'TODO (unsupported! st x))))))

    (define (substitute x names value)
      (cond ((and (symbol? x) (memq x names)) value)
            ((call? x) (cons* ':call (substitute (call-fn x) names value)
                              (map (lambda (a) (cons (car a) (substitute (cdr a) names value))) (call-args x))))
            (else x)))

    ;; --- ggplot ---

    (define (gg-aes st x)
      ;; aes(x, y, fill = …) -> (aes (x e) …)
      (let loop ((args (call-args x)) (k 0) (acc '()))
        (if (null? args)
            (cons 'aes (reverse acc))
            (let* ((a (car args))
                   (key (cond ((car a) (case (car a) ((colour) 'color) (else (car a))))
                              ((= k 0) 'x)
                              (else 'y))))
              (loop (cdr args) (if (car a) k (+ k 1)) (cons (list key (cx st (cdr a))) acc))))))

    (define gg-geoms
      '((geom_col geom-col) (geom_bar geom-bar) (geom_line geom-line) (geom_point geom-point)
        (geom_jitter geom-point) (geom_area geom-area) (geom_histogram geom-histogram)
        (geom_boxplot geom-boxplot) (geom_text geom-text) (geom_label geom-text)
        (geom_hline geom-hline) (geom_vline geom-vline) (geom_sf geom-sf)
        (geom_sf_text geom-sf-text) (geom_sf_label geom-sf-text)))

    (define (position-of x)
      (cond ((string? x) (string->symbol x))
            ((and (call? x) (memq (call-name x) '(position_dodge position_dodge2))) 'dodge)
            ((and (call? x) (eq? (call-name x) 'position_stack)) 'stack)
            ((and (call? x) (eq? (call-name x) 'position_fill)) 'fill)
            (else 'identity)))

    (define (label-format x)
      (let ((n (cond ((symbol? x) x)
                     ((and (call? x) (memq (call-fn x) '(:: :::))) (cdadr (call-args x)))
                     ((call? x) (call-name x))
                     (else #f))))
        (case n
          ((percent label_percent percent_format) 'pct)
          ((comma label_comma comma_format number label_number) 'int)
          (else #f))))

    (define (gg-spec st x)
      ;; one ggplot component -> list of specs (or a comment)
      (let* ((name (call-name x)) (args (call-args x)) (ps (positional args)))
        (cond
         ((assq name gg-geoms)
          => (lambda (g)
               (list (cons (cadr g)
                           (append-map
                            (lambda (a)
                              (let ((k (car a)) (v (cdr a)))
                                (cond
                                 ((and (not k) (call? v) (eq? (call-name v) 'aes)) (list (gg-aes st v)))
                                 ((eq? k 'mapping) (list (gg-aes st v)))
                                 ((eq? k 'data) (list (list 'data (list 'unquote (tx st v)))))
                                 ((eq? k 'position) (list (list 'position (position-of v))))
                                 ((memq k '(bins binwidth yintercept xintercept)) (list (list k (tx st v))))
                                 ((and (eq? k 'fill) (memq v '(NA NULL)) (eq? (cadr g) 'geom-sf)) '((fill none)))
                                 ((and (eq? k 'linewidth) (eq? (cadr g) 'geom-sf)) (list (list 'size (tx st v))))
                                 ((eq? k 'stat) (if (equal? v "identity") '() (begin (unsupported! st x) '())))
                                 (else '()))))   ; constant colours, sizes, alpha: left to the theme
                            args)))))
         ((eq? name 'labs)
          (list (cons 'labs (map (lambda (a) (list (case (car a) ((colour) 'color) (else (car a)))
                                                   (if (memq (cdr a) '(NULL)) #f (tx st (cdr a)))))
                                 (filter car args)))))
         ((eq? name 'xlab) (list (list 'labs (list 'x (tx st (car ps))))))
         ((eq? name 'ylab) (list (list 'labs (list 'y (tx st (car ps))))))
         ((eq? name 'ggtitle) (list (list 'labs (list 'title (tx st (car ps))))))
         ((eq? name 'facet_wrap)
          (let* ((f (or (named args 'facets) (car ps)))
                 (col (cond ((formula? f) (let ((d (formula->datum f))) (last d)))
                            ((and (call? f) (eq? (call-name f) 'vars)) (cdar (call-args f)))
                            (else (sym-of f))))
                 (ncol (named args 'ncol)))
            (list (append (list 'facet-wrap col) (if ncol (list (list 'ncol ncol)) '())))))
         ((eq? name 'coord_flip) '((coord-flip)))
         ((eq? name 'coord_sf) '((coord-sf)))
         ((memq name '(scale_y_continuous scale_x_continuous scale_y_log10 scale_x_log10 scale_x_discrete scale_y_discrete))
          (let* ((axis (if (memq name '(scale_y_continuous scale_y_log10 scale_y_discrete)) 'scale-y 'scale-x))
                 (labels (named args 'labels))
                 (limits (named args 'limits))
                 (opts (append (if (and labels (label-format labels)) (list (list 'labels (label-format labels))) '())
                               (cond ((not limits) '())
                                     ((memq name '(scale_x_discrete scale_y_discrete))
                                      (list (cons 'levels (or (literal-vector limits) '()))))
                                     (else (list (cons 'limits (or (literal-vector limits) '())))))
                               (if (or (memq name '(scale_y_log10 scale_x_log10)) (equal? (named args 'trans) "log10")) '((log10)) '()))))
            (if (null? opts) '() (list (cons axis opts)))))
         ((memq name '(scale_fill_steps scale_fill_binned scale_fill_fermenter scale_fill_distiller
                       scale_fill_brewer scale_fill_viridis_c scale_fill_viridis_b scale_fill_gradient
                       scale_fill_gradient2 scale_fill_continuous scale_fill_steps2))
          (let* ((pal (named args 'palette))
                 (pal-sym (and (string? pal) (let ((e (find (lambda (p) (string=? (cadr p) pal)) palette-table))) (and e (car e)))))
                 (n (or (named args 'n.breaks) (named args 'n)))
                 (breaks (named args 'breaks))
                 (labels (named args 'labels))
                 (continuous? (memq name '(scale_fill_continuous scale_fill_gradient scale_fill_distiller scale_fill_viridis_c))))
            (list (append (list (if continuous? 'scale-fill-continuous 'scale-fill-steps))
                          (if pal-sym (list (list 'palette pal-sym))
                              (if (memq name '(scale_fill_gradient2 scale_fill_steps2)) '((palette blue-red)) '()))
                          (if (memq name '(scale_fill_gradient2 scale_fill_steps2))
                              (let ((m (named args 'midpoint))) (if m (list (list 'midpoint m)) '()))
                              '())
                          (if n (list (list 'n n)) '())
                          (if (and breaks (literal-vector breaks)) (list (cons 'breaks (literal-vector breaks))) '())
                          (if (and labels (label-format labels)) (list (list 'labels (label-format labels))) '())))))
         ((eq? name 'theme)
          (let ((pos (named args 'legend.position)))
            (if (string? pos) (list (list 'theme (list 'legend (string->symbol pos)))) '())))
         ((and name (or (string-prefix? "theme_" (symbol->string name)) (memq name '(guides))))
          (list (comment (string-append "R: " (r-deparse x) " (the look is fixed)"))))
         (else (list (todo st x))))))

    ;; ggplot(data, aes(…)) + … : the components, left to right
    (define (gg-chain x)
      (if (op-call? x '+)
          (append (gg-chain (cdar (call-args x))) (list (cdadr (call-args x))))
          (list x)))

    (define (gg-root x)
      ;; the ggplot call at the root of a chain, maybe behind a pipe
      (cond ((and (call? x) (eq? (call-name x) 'ggplot)) x)
            ((pipe? x) (gg-root (last (pipe-parts x))))
            (else #f)))

    (define (ggplot-chain? x) (gg-root (car (gg-chain x))))

    (define (translate-ggplot st x)
      (let* ((parts (gg-chain x))
             (root (car parts))
             (call (gg-root root))
             (args (call-args call))
             (data-arg (or (named args 'data) (let ((p (car* (positional args)))) (and p (not (and (call? p) (eq? (call-name p) 'aes))) p))))
             (aes-arg (or (named args 'mapping) (find (lambda (e) (and (call? e) (eq? (call-name e) 'aes))) (positional args))))
             (layer-data (find (lambda (p) (and (call? p) (assq (call-name p) gg-geoms) (named (call-args p) 'data))) (cdr parts)))
             (data (cond (data-arg (tx st data-arg))
                         ((pipe? root) (translate-pipe st (pipe-parts root) #t))
                         (layer-data (tx st (named (call-args layer-data) 'data)))
                         (else '(empty-df))))
             (specs (append (if aes-arg (list (gg-aes st aes-arg)) '())
                            (append-map (lambda (p) (gg-spec st p)) (cdr parts)))))
        (cons* 'ggplot data specs)))

    ;; --- pipes ---

    (define (pipe? x) (or (op-call? x '%>%) (op-call? x '|\|>|)))

    (define (pipe-parts x)
      (if (pipe? x)
          (append (pipe-parts (cdar (call-args x))) (list (cdadr (call-args x))))
          (list x)))

    ;; does a step use the placeholder (. or _)?
    (define (placeholder-arg? x)
      (and (call? x) (any (lambda (a) (memq (cdr a) '(|.| _))) (call-args x))))

    ;; parts (head step …) -> (-> head step …); without-ggplot? drops a
    ;; final ggplot step (its caller handles it)
    (define (translate-pipe st parts . without-ggplot)
      (let ((parts (if (and (pair? without-ggplot) (car without-ggplot)) (drop-right parts 1) parts)))
        (pipe-steps st (tx st (car parts)) (cdr parts))))

    (define (marker? x) (eq? x ':piped))
    (define (has-marker? x) (or (marker? x) (and (pair? x) (or (has-marker? (car x)) (has-marker? (cdr x))))))
    (define (replace-marker x v)
      (cond ((marker? x) v)
            ((pair? x) (cons (replace-marker (car x) v) (replace-marker (cdr x) v)))
            (else x)))

    (define (pipe-steps st head steps)
      (let loop ((steps steps) (acc '()))
        (define (so-far) (if (null? acc) head (cons* '-> head (reverse acc))))
        (if (null? steps)
            (so-far)
            (let* ((s (car steps))
                   (s (if (symbol? s) (mk-call s) s)))
              (cond
               ((placeholder-arg? s)
                ;; x |> f(a, data = _): the steps so far go in its place
                (pipe-steps st (replace-marker (tx st (substitute s '(|.| _) ':piped)) (so-far)) (cdr steps)))
               ((verb-call? s) (loop (cdr steps) (append (reverse (verb-steps st (call-name s) (call-args s))) acc)))
               ((and (call? s) (eq? (call-name s) 'ggplot))
                (loop (cdr steps) (cons (let ((g (translate-ggplot st s))) (cons 'ggplot (cddr g))) acc)))
               ((call? s)
                (let ((r (tx st (apply mk-call (call-fn s) (pos ':piped) (call-args s)))))
                  (cond ((and (pair? r) (pair? (cdr r)) (marker? (cadr r)) (not (has-marker? (cddr r))))
                         (loop (cdr steps) (cons (cons (car r) (cddr r)) acc)))
                        ((has-marker? r) (pipe-steps st (replace-marker r (so-far)) (cdr steps)))
                        (else
                         (when (and (pair? r) (eq? (car r) 'r:unsupported))
                           (set-rx-unsupported! st (cdr (rx-unsupported st))))
                         (loop (cdr steps) (cons (todo st s) acc))))))
               (else (loop (cdr steps) (cons (todo st s) acc))))))))

    ;; --- Scheme expressions (outside verbs) ---

    (define (tx st x)
      (cond
       ((eq? x ':done) x)
       ((or (number? x) (string? x) (boolean? x)) x)
       ((symbol? x)
        (case x
          ((NULL) ''())
          ((NA) 'na)
          ((Inf) '+inf.0)
          ((T) #t) ((F) #f)
          (else x)))
       ((fn? x)
        (list 'lambda (map car (cadr x)) (tx st (caddr x))))
       ((call? x) (tx-call st x))
       (else (unsupported! st x))))

    (define test-name-map test-table)

    (define (test-opts st args skip)
      (append-map (lambda (a)
                    (let ((o (assq (car a) test-options)))
                      (cond ((not (car a)) '())
                            ((memq (car a) skip) '())
                            ((not o) (begin (unsupported! st (string-append (symbol->string (car a)) " = " (r-deparse (cdr a)))) '()))
                            (else
                             (list (list 'quote (cadr o))
                                   (let ((v (cdr a)))
                                     (cond ((and (string? v) (memq (car a) '(alternative method)))
                                            (list 'quote (string->symbol (if (string=? v "two.sided") "two-sided" v))))
                                           (else (tx st v)))))))))
                  args))

    ;; matrix(c(…), nrow = 2[, byrow = TRUE]) -> '((…) (…))
    (define (matrix-literal x)
      (and (call? x) (memq (call-name x) '(matrix rbind cbind))
           (case (call-name x)
             ((rbind) (let ((rows (map (lambda (a) (literal-vector (cdr a))) (call-args x)))) (and (every list? rows) rows)))
             ((cbind) (let ((cols (map (lambda (a) (literal-vector (cdr a))) (call-args x))))
                        (and (every list? cols) (apply map list cols))))
             (else
              (let* ((v (literal-vector (or (named (call-args x) 'data) (car* (positional (call-args x))))))
                     (nrow (or (named (call-args x) 'nrow) (cadr* (positional (call-args x)) 1)))
                     (ncol (named (call-args x) 'ncol))
                     (byrow (memq (named (call-args x) 'byrow) '(#t T))))
                (and v (or nrow ncol)
                     (let* ((n (length v)) (nr (or nrow (quotient n ncol))) (nc (quotient n nr)))
                       (if byrow
                           (map (lambda (r) (map (lambda (c) (list-ref v (+ (* r nc) c))) (iota nc))) (iota nr))
                           (map (lambda (r) (map (lambda (c) (list-ref v (+ (* c nr) r))) (iota nc))) (iota nr))))))))))

    (define (tx-call st x)
      (let* ((f (call-fn x)) (args (call-args x)) (name (call-name x))
             (ps (positional args))
             (t (lambda (e) (tx st e)))
             (c (lambda (e) (cx st e))))
        (cond
         ((eq? f '|(|) (t (cdar args)))
         ((eq? f '|{|) (let ((body (map (lambda (a) (t (cdr a))) args)))
                         (if (= (length body) 1) (car body) (cons 'begin body))))
         ((pipe? x)
          (let ((parts (pipe-parts x)))
            (if (and (call? (last parts)) (eq? (call-name (last parts)) 'ggplot))
                (translate-ggplot st x)
                (translate-pipe st parts))))
         ((and (op-call? x '+) (ggplot-chain? x)) (translate-ggplot st x))
         ((memq f '(<- = <<-)) (list 'set! (t (car ps)) (t (cadr ps))))
         ((eq? f '$)
          (let ((obj (car ps)) (field (cadr ps)))
            (case (var-kind st obj)
              ((htest) (list 'htest-ref obj (list 'quote (case field
                                                           ((p.value) 'p-value) ((conf.int) 'conf-int) ((null.value) 'null-value)
                                                           (else field)))))
              ((lm) (case field
                      ((coefficients) (list 'lm-coefficients obj))
                      ((residuals) (list 'lm-residuals obj))
                      ((fitted.values) (list 'lm-fitted obj))
                      (else (unsupported! st x))))
              (else (list 'df-column (t obj) (list 'quote field))))))
         ((assq f binary-map)
          (let ((op (cdr (assq f binary-map))))
            (case op
              ((=) (list 'equal? (t (car ps)) (t (cadr ps))))
              ((!=) (list 'not (list 'equal? (t (car ps)) (t (cadr ps)))))
              ((modulo quotient) (list op (t (car ps)) (t (cadr ps))))
              (else (if (= (length ps) 1) (list op (t (car ps))) (list op (t (car ps)) (t (cadr ps))))))))
         ((eq? f '^) (list 'expt (t (car ps)) (t (cadr ps))))
         ((eq? f '!) (list 'not (t (car ps))))
         ((eq? f ':) (if (and (number? (car ps)) (number? (cadr ps)))
                         (list 'iota (+ 1 (- (cadr ps) (car ps))) (car ps))
                         (list 'iota (list '+ 1 (list '- (t (cadr ps)) (t (car ps)))) (t (car ps)))))
         ((eq? f '%in%) (list 'member (t (car ps)) (t (cadr ps))))
         ((eq? f '~) (list 'quote (formula->datum x)))
         ((eq? f 'if) (if (= (length ps) 3)
                          (list 'if (t (car ps)) (t (cadr ps)) (t (caddr ps)))
                          (list 'when (t (car ps)) (t (cadr ps)))))
         ((eq? f 'for) (list 'for-each (list 'lambda (list (car ps)) (t (caddr ps))) (t (cadr ps))))
         ((eq? f 'while) (list 'let 'loop '() (list 'when (t (car ps)) (t (cadr ps)) '(loop))))
         ((not name) (unsupported! st x))
         ;; verbs called directly: the first argument is the data
         ((verb-call? x)
          (let* ((data (car* ps))
                 (rest (let loop ((as args) (dropped? #f))
                         (cond ((null? as) '())
                               ((and (not dropped?) (not (car (car as)))) (loop (cdr as) #t))
                               (else (cons (car as) (loop (cdr as) dropped?))))))
                 (steps (verb-steps st name rest)))
            (if (and (= (length steps) 1) (not (comment? (car steps))))
                (cons* (car (car steps)) (t data) (cdr (car steps)))
                (cons* '-> (t data) steps))))
         ((eq? name 'ggplot) (translate-ggplot st x))
         ;; reading and writing
         ((memq name '(read_csv read.csv read_csv2 read.csv2 read_delim read_tsv read.delim read.table))
          (append (list 'read-csv (t (car ps)))
                  (let ((sep (or (named args 'delim) (named args 'sep)
                                 (case name ((read_csv2 read.csv2) ";") ((read_tsv read.delim) "\t") (else #f)))))
                    (if (and (string? sep) (= (string-length sep) 1)) (list ''sep (string-ref sep 0)) '()))
                  (if (memq name '(read_csv2 read.csv2)) (list ''decimal #\,) '())
                  (let ((s (named args 'skip))) (if s (list ''skip s) '()))
                  (let ((n (named args 'n_max))) (if n (list ''n-max n) '()))
                  (let ((na (named args 'na))) (if (and na (literal-vector na)) (list ''na (list 'quote (literal-vector na))) '()))))
         ((memq name '(read_excel read_xlsx read.xlsx))
          (append (list 'read-xlsx (t (car ps)))
                  (let ((s (or (named args 'sheet) (cadr* ps 1)))) (if s (list ''sheet (t s)) '()))
                  (let ((s (or (named args 'skip) (named args 'startRow)))) (if s (list ''skip (if (eq? name 'read.xlsx) (- s 1) s)) '()))))
         ((memq name '(write_csv write.csv write_csv2 write.csv2 write_delim))
          (append (list 'write-csv (t (car ps)) (t (or (named args 'file) (cadr* ps 1))))
                  (let ((sep (or (named args 'delim) (case name ((write_csv2 write.csv2) ";") (else #f)))))
                    (if (string? sep) (list ''sep (string-ref sep 0)) '()))
                  (if (memq name '(write_csv2 write.csv2)) (list ''decimal #\,) '())))
         ((memq name '(write_xlsx write.xlsx))
          (list 'write-xlsx (t (car ps)) (t (or (named args 'path) (named args 'file) (cadr* ps 1)))))
         ((memq name '(read_json fromJSON)) (list 'read-json-records (t (car ps))))
         ((eq? name 'write_json) (list 'write-json-records (t (car ps)) (t (cadr ps))))
         ((memq name '(st_read read_sf))
          (append (list 'read-sf (t (or (named args 'dsn) (car ps))))
                  (let ((l (named args 'layer))) (if l (list ''layer (t l)) '()))))
         ((memq name '(st_write write_sf)) (list 'write-geojson (t (car ps)) (t (or (named args 'dsn) (cadr ps)))))
         ((eq? name 'ggsave)
          (let ((file (or (named args 'filename) (car ps)))
                (plot (or (named args 'plot) (cadr* ps 1)
                          (let ((p (find (lambda (v) (eq? (cdr v) 'plot)) (rx-vars st)))) (and p (car p))))))
            (list 'save-plot (if plot (t plot) '(r:unsupported "last_plot()")) (t file))))
         ;; tests and models
         ((assq name test-name-map)
          => (lambda (e)
               (let ((s (cadr e)))
                 (cond
                  ((and (pair? ps) (formula? (car ps)))
                   (cons* s (t (named args 'data)) (list 'quote (formula->datum (car ps))) (test-opts st args '(data))))
                  ((and (eq? s 'chisq-test) (matrix-literal (car* ps)))
                   (cons* s (list 'quote (matrix-literal (car ps))) (test-opts st args '())))
                  ((and (eq? s 'fisher-test) (matrix-literal (car* ps)))
                   (cons* s (list 'quote (matrix-literal (car ps))) (test-opts st args '())))
                  ((and (eq? s 'chisq-test) (call? (car* ps)) (eq? (call-name (car ps)) 'table))
                   (cons* s (append (map t (positional (call-args (car ps)))) (test-opts st args '()))))
                  ((and (eq? s 'ks-test) (string? (cadr* ps 1)))
                   (let ((dist (string->symbol (cadr ps))) (extra (map t (drop ps 2))))
                     (cons* s (t (car ps)) (if (null? extra) dist (list 'lambda '(q) (cons* dist 'q extra)))
                            (test-opts st args '()))))
                  ((and (eq? s 'kruskal-test) (call? (car* ps)) (eq? (call-name (car ps)) 'list))
                   (list s (cons 'list (map t (positional (call-args (car ps)))))))
                  (else (append (list s) (map t ps) (test-opts st args '())))))))
         ((eq? name 'p.adjust)
          (append (list 'p-adjust (t (car ps)))
                  (let ((m (or (named args 'method) (cadr* ps 1)))) (if (string? m) (list (list 'quote (string->symbol m))) '()))))
         ((eq? name 'lm) (list 'lm (t (named args 'data)) (list 'quote (formula->datum (car ps)))))
         ((eq? name 'predict) (list 'predict (t (car ps)) (t (or (named args 'newdata) (cadr* ps 1)))))
         ((eq? name 'coef) (list 'lm-coefficients (t (car ps))))
         ((memq name '(residuals resid)) (list 'lm-residuals (t (car ps))))
         ((eq? name 'fitted) (list 'lm-fitted (t (car ps))))
         ((eq? name 'tidy) (list 'tidy (t (car ps))))
         ((eq? name 'summary)
          (case (and (symbol? (car ps)) (var-kind st (car ps)))
            ((lm) (list 'lm-print (car ps)))
            ((htest) (list 'htest-print (car ps)))
            (else (unsupported! st x))))
         ;; printing and inspecting
         ((memq name '(print show)) (print-form st (car ps)))
         ((eq? name 'glimpse) (list 'df-glimpse (t (car ps))))
         ((memq name '(View)) (list 'df-print (t (car ps))))
         ((memq name '(cat message))
          (cons 'begin (append (map (lambda (e) (list 'display (t e))) ps) (if (eq? name 'message) '((newline)) '()))))
         ((eq? name 'nrow) (list 'df-nrow (t (car ps))))
         ((eq? name 'ncol) (list 'df-ncol (t (car ps))))
         ((memq name '(names colnames)) (list 'df-names (t (car ps))))
         ((eq? name 'table) (if (= (length ps) 1) (list 'freq (t (car ps))) (list 'crosstab (t (car ps)) (t (cadr ps)))))
         ;; values
         ((eq? name 'c) (cons 'list (map t ps)))
         ((eq? name 'list) (if (any car args)
                               (cons 'list (map (lambda (a) (list 'cons (list 'quote (car a)) (t (cdr a)))) args))
                               (cons 'list (map t ps))))
         ((memq name '(paste0 paste str_c))
          (cons 'string-append (map (lambda (e) (if (string? e) e (list 'fmt-value (t e)))) ps)))
         ((memq name '(data.frame tibble))
          (if (every (lambda (a) (and (car a) (literal-vector (cdr a)))) args)
              (cons 'tibble (map (lambda (a) (cons (car a) (literal-vector (cdr a)))) args))
              (list 'make-df (cons 'list (map (lambda (a) (list 'cons (list 'quote (car a)) (list 'list->vector (t (cdr a))))) args)))))
         ((memq name '(library require suppressPackageStartupMessages requireNamespace)) ':skip)
         ((eq? name 'function) (unsupported! st x))
         ((memq name '(mean sum median min max sd var length round abs sqrt exp log)) (cons name (map t ps)))
         ((eq? name 'quantile) (list 'quantile (t (car ps)) (t (or (named args 'probs) (cadr* ps 1) 0.5))))
         ((memq name '(is.na)) (list 'na? (t (car ps))))
         ((memq name '(seq_len seq_along)) (list 'iota (t (car ps))))
         ((var-kind st name) (cons name (map t ps)))   ; the script's own function
         (else (unsupported! st x)))))

    ;; printing a value: by what the script put in it
    (define (print-form st x)
      (case (and (symbol? x) (var-kind st x))
        ((plot) (list 'save-plot x (string-append (symbol->string x) ".png")))
        ((htest) (list 'htest-print x))
        ((lm) (list 'lm-print x))
        ((frame) (list 'df-print x))
        (else
         (cond ((and (call? x) (or (verb-call? x) (pipe? x) (memq (call-name x) '(head tail))))
                (list 'df-print (tx st x)))
               ((and (call? x) (assq (call-name x) test-name-map)) (list 'htest-print (tx st x)))
               (else (list 'begin (list 'display (tx st x)) '(newline)))))))

    ;; what an expression's value is, for print and $
    (define (kind-of x)
      (cond ((pipe? x) (let ((l (last (pipe-parts x)))) (if (and (call? l) (eq? (call-name l) 'ggplot)) 'plot 'frame)))
            ((and (op-call? x '+) (ggplot-chain? x)) 'plot)
            ((fn? x) 'function)
            ((call? x)
             (let ((n (call-name x)))
               (cond ((memq n verbs) 'frame)
                     ((memq n '(ggplot)) 'plot)
                     ((assq n test-name-map) 'htest)
                     ((eq? n 'lm) 'lm)
                     ((memq n '(read_csv read.csv read_csv2 read_delim read_tsv read_excel read_xlsx st_read read_sf
                                data.frame tibble read_json fromJSON tidy)) 'frame)
                     (else 'value))))
            (else 'value)))

    (define (translate-statement st x)
      (cond
       ((and (call? x) (memq (call-fn x) '(<- = <<- -> ->>)))
        (let* ((ps (positional (call-args x)))
               (target (if (memq (call-fn x) '(-> ->>)) (cadr ps) (car ps)))
               (value (if (memq (call-fn x) '(-> ->>)) (car ps) (cadr ps))))
          (if (symbol? target)
              (let* ((known? (var-kind st target))
                     (v (tx st value)))
                (set-var! st target (kind-of value))
                (list (if known? (list 'set! target v) (list 'define target v))))
              (list (todo st x)))))
       ((and (call? x) (memq (call-name x) '(library require suppressPackageStartupMessages))) '())
       ((and (symbol? x) (var-kind st x)) (list (print-form st x)))
       ((and (call? x) (or (verb-call? x) (and (pipe? x) (eq? (kind-of x) 'frame))))
        (list (list 'df-print (tx st x))))
       ((and (call? x) (memq (kind-of x) '(plot)))
        (list (list 'save-plot (tx st x) "plot.png")))
       ((and (call? x) (eq? (kind-of x) 'htest)) (list (list 'htest-print (tx st x))))
       (else
        (let ((v (tx st x)))
          (cond ((eq? v ':skip) '())
                ((and (pair? v) (eq? (car v) 'r:unsupported))
                 (set-rx-unsupported! st (cdr (rx-unsupported st)))
                 (list (todo st x)))
                ;; R prints the value of a top-level expression
                ((and (pair? v) (memq (car v) statement-heads)) (list v))
                (else (list (list 'begin (list 'display v) '(newline)))))))))

    (define statement-heads
      '(display newline df-print df-glimpse htest-print lm-print save-plot write-csv write-xlsx
        write-json-records write-geojson write-report begin for-each when unless if set! define let))

    (define (r->scm r . opts)
      "Syntax: (r->scm r-source)
Library: (scm data r)
Description: Translates R source text (or a list of R syntax trees from
  r-parse) to (scm data) code: returns two values, the list of top-level
  forms (an import first; comments as (:comment text), see scm-pretty)
  and the list of R snippets that had no translation. See
  r->scm-string for text.
Example:
  (r->scm \"d <- read_csv('a.csv') |> filter(x > 1)\")"
      (let* ((stmts (if (string? r) (r-parse r) r))
             (st (make-rx '() '()))
             (forms (append-map (lambda (s)
                                  (guard (e (#t (list (todo st s))))
                                    (translate-statement st s)))
                                stmts)))
        (values (cons '(import (scheme base) (scheme write) (srfi 1) (scm data)) forms)
                (reverse (rx-unsupported st)))))

    (define (r->scm-string r)
      "Syntax: (r->scm-string r-source)
Library: (scm data r)
Description: Translates R source text to (scm data) code as text,
  pretty-printed; returns two values, the text and the list of R snippets
  without a translation (also marked in the text as TODO or
  r:unsupported).
Example:
  (r->scm-string \"mtcars |> group_by(cyl) |> summarise(m = mean(mpg))\")"
      (let-values (((forms unsupported) (r->scm r)))
        (values (string-append ";; translated from R by (scm data r)\n"
                               (string-concatenate (map (lambda (f) (string-append (scm-pretty f) "\n")) forms)))
                unsupported)))

    (define (r-file->scm path)
      "Syntax: (r-file->scm path)
Library: (scm data r)
Description: r->scm-string on the contents of an R script.
Example:
  (r-file->scm \"analysis.R\")"
      (r->scm-string (call-with-input-file path (lambda (p) (read-all-string p)))))

    (define (read-all-string p)
      (let loop ((acc '()))
        (let ((s (read-string 4096 p)))
          (if (eof-object? s) (string-concatenate (reverse acc)) (loop (cons s acc))))))

    ;; --- Scheme pretty printer ------------------------------------------------

    (define (flat x)
      (cond
       ((comment? x) (string-append "#| " (cadr x) " |#"))
       ((and (pair? x) (memq (car x) '(quote quasiquote unquote unquote-splicing)) (pair? (cdr x)) (null? (cddr x)))
        (string-append (case (car x) ((quote) "'") ((quasiquote) "`") ((unquote) ",") (else ",@")) (flat (cadr x))))
       ((pair? x)
        (let loop ((x x) (acc '()))
          (cond ((null? x) (string-append "(" (string-join (reverse acc) " ") ")"))
                ((pair? x) (loop (cdr x) (cons (flat (car x)) acc)))
                (else (string-append "(" (string-join (reverse acc) " ") " . " (flat x) ")")))))
       ((vector? x) (string-append "#" (flat (vector->list x))))
       ((and (symbol? x)
             (let ((str (symbol->string x)))
               (and (> (string-length str) 0)
                    (not (string-any (lambda (c) (or (char-whitespace? c) (memv c '(#\( #\) #\" #\; #\' #\` #\| #\,)))) str))
                    (not (string->number str)))))
        (symbol->string x))
       (else (let ((p (open-output-string))) (write x p) (get-output-string p)))))

    ;; forms whose arguments after the first k go on their own lines, two
    ;; columns in
    (define body-forms
      '((define . 1) (lambda . 1) (let . 1) (when . 1) (unless . 1) (begin . 0)
        (report . 0) (for-each . 1) (define-syntax . 1)))

    ;; forms whose arguments line up under the first one
    (define aligned-forms '(-> ggplot mutate summarise transmute where select arrange case-when tibble))

    (define (scm-pretty x . indent)
      "Syntax: (scm-pretty datum [indent])
Library: (scm data r)
Description: A Scheme datum as code text, broken over lines and indented
  where it does not fit in 80 columns; (:comment text) as ;; comment
  lines (where a list breaks) or #| |# (inside a line).
Example:
  (display (scm-pretty '(define x (-> df (where (> a 1)) (mutate (b (* a 2)))))))"
      (let ((col (if (pair? indent) (car indent) 0)))
        (cond
         ((comment? x) (string-append ";; " (cadr x)))
         ((and (pair? x) (memq (car x) '(quote quasiquote unquote)) (pair? (cdr x)) (null? (cddr x)))
          (let ((p (case (car x) ((quote) "'") ((quasiquote) "`") (else ","))))
            (string-append p (scm-pretty (cadr x) (+ col 1)))))
         ((not (and (pair? x) (list? x)))
          (flat x))
         ((and (<= (+ col (string-length (flat x))) 80) (not (any comment? x)))
          (flat x))
         (else
          (let* ((head (flat (car x)))
                 (b (assq (car x) body-forms))
                 (pad (lambda (n) (make-string n #\space))))
            (cond
             (b
              (let* ((k (min (cdr b) (length (cdr x))))
                     (first (take (cdr x) k))
                     (rest (drop (cdr x) k))
                     (line1 (string-append "(" head
                                           (string-concatenate (map (lambda (a) (string-append " " (scm-pretty a (+ col 2 (string-length head))))) first)))))
                (string-append line1
                               (string-concatenate
                                (map (lambda (a) (string-append "\n" (pad (+ col 2)) (scm-pretty a (+ col 2)))) rest))
                               (close x col))))
             ((and (symbol? (car x)) (pair? (cdr x)) (not (comment? (cadr x))) (< (string-length head) 20))
              ;; (f a
              ;;    b)
              (let* ((c2 (+ col 2 (string-length head)))
                     (first (scm-pretty (cadr x) c2)))
                (string-append "(" head " " first
                               (string-concatenate (map (lambda (a) (string-append "\n" (pad c2) (scm-pretty a c2))) (cddr x)))
                               (close x col))))
             (else
              (string-append "(" (scm-pretty (car x) (+ col 1))
                             (string-concatenate (map (lambda (a) (string-append "\n" (pad (+ col 1)) (scm-pretty a (+ col 1)))) (cdr x)))
                             (close x col)))))))))

    ;; a comment as the last element would swallow the closing parenthesis
    (define (close x col)
      (if (comment? (last x)) (string-append "\n" (make-string col #\space) ")") ")"))

    ;; --- Scheme -> R ----------------------------------------------------------------

    (define (r-var s)
      ;; a Scheme variable name as an R one: - and other marks become _
      (let ((str (symbol->string s)))
        (string->symbol
         (string-map (lambda (c) (if (or (char-alphabetic? c) (char-numeric? c) (memv c '(#\. #\_))) c #\_))
                     (if (string-suffix? "?" str) (string-append "is_" (substring str 0 (- (string-length str) 1))) str)))))

    (define (unquoted? x) (and (pair? x) (eq? (car x) 'unquote)))
    (define (quoted? x) (and (pair? x) (eq? (car x) 'quote)))

    ;; R value of a quoted Scheme datum
    (define (datum->r x)
      (cond ((and (list? x) (memq '~ x)) (formula-tree x))
            ((and (list? x) (pair? x) (every list? x) (every (lambda (e) (every (lambda (v) (not (pair? v))) e)) x))
             (apply mk-call 'rbind (map (lambda (e) (pos (datum->r e))) x)))
            ((and (list? x) (every (lambda (e) (not (pair? e))) x)) (apply mk-call 'c (map (lambda (e) (pos (datum->r e))) x)))
            ((list? x) (apply mk-call 'list (map (lambda (e) (pos (datum->r e))) x)))
            ((pair? x) (mk-call 'list (pos (datum->r (car x))) (pos (datum->r (cdr x)))))
            ((symbol? x) (symbol->string x))
            ((char? x) (string x))
            ((na? x) 'NA)
            (else x)))

    (define (na? x) (eq? x 'na))

    ;; (y ~ x1 + x2) -> R tree
    (define (formula-tree d)
      (define (side l)
        (let loop ((l (cdr l)) (acc (term (car l))))
          (if (or (null? l) (null? (cdr l))) acc
              (loop (cddr l) (mk-call (car l) (pos acc) (pos (term (cadr l))))))))
      (define (term t) (cond ((eq? t '|.|) '|.|) (else t)))
      (let* ((i (list-index (lambda (e) (eq? e '~)) d))
             (lhs (take d i)) (rhs (drop d (+ i 1))))
        (if (null? lhs)
            (mk-call '~ (pos (side rhs)))
            (mk-call '~ (pos (side lhs)) (pos (side rhs))))))

    (define libs-used '())
    (define (use-lib! l) (unless (member l libs-used) (set! libs-used (cons l libs-used))))

    (define scm-binary
      '((+ . +) (- . -) (* . *) (/ . /) (modulo . %%) (quotient . %/%) (= . ==) (!= . !=)
        (< . <) (> . >) (<= . <=) (>= . >=) (and . &) (or . |\||)))

    ;; column expression -> R
    (define (rx-col x)
      (cond
       ((unquoted? x)
        ;; a value injected into the expression, as dplyr's !!
        (if (or (symbol? (cadr x)) (not (pair? (cadr x))))
            (rx-val (cadr x))
            (mk-call '! (pos (mk-call '!! (pos (rx-val (cadr x))))))))
       ((symbol? x) (if (eq? x 'na) 'NA x))
       ((or (number? x) (string? x) (boolean? x)) x)
       ((char? x) (string x))
       ((quoted? x) (datum->r (cadr x)))
       ((not (pair? x)) (rx-val x))
       ((and (unquoted? (car x)) (eq? (cadr (car x)) 'expt)) (mk-call '^ (pos (rx-col (cadr x))) (pos (rx-col (caddr x)))))
       ((unquoted? (car x)) (apply mk-call (r-var* (cadr (car x))) (map (lambda (a) (pos (rx-col a))) (cdr x))))
       ((assq (car x) scm-binary)
        (let ((op (cdr (assq (car x) scm-binary))) (args (map rx-col (cdr x))))
          (cond ((and (eq? (car x) '-) (= (length args) 1)) (mk-call '- (pos (car args))))
                (else (fold (lambda (a acc) (mk-call op (pos acc) (pos a))) (car args) (cdr args))))))
       ((eq? (car x) 'not) (mk-call '! (pos (rx-col (cadr x)))))
       ((eq? (car x) 'if) (use-lib! "dplyr") (mk-call 'if_else (pos (rx-col (cadr x))) (pos (rx-col (caddr x))) (pos (rx-col (cadddr x)))))
       ((eq? (car x) 'case-when)
        (use-lib! "dplyr")
        (apply mk-call 'case_when
               (map (lambda (c) (pos (mk-call '~ (pos (if (eq? (car c) 'else) #t (rx-col (car c)))) (pos (rx-col (cadr c))))))
                    (cdr x))))
       ((eq? (car x) 'in)
        (let ((set (caddr x)))
          (mk-call '%in% (pos (rx-col (cadr x))) (pos (if (unquoted? set) (rx-val (cadr set)) (rx-col set))))))
       ((eq? (car x) 'n) (mk-call 'n))
       ((eq? (car x) 'str) (apply mk-call 'paste0 (map (lambda (a) (pos (rx-col a))) (cdr x))))
       ((and (eq? (car x) 'log) (= (length x) 3) (memv (caddr x) '(10 2)))
        (mk-call (if (= (caddr x) 10) 'log10 'log2) (pos (rx-col (cadr x)))))
       ((eq? (car x) 'str-sub)
        (use-lib! "stringr")
        (apply mk-call 'str_sub (pos (rx-col (cadr x)))
               (pos (if (number? (caddr x)) (+ 1 (caddr x)) (mk-call '+ (pos (rx-col (caddr x))) (pos 1))))
               (if (pair? (cdddr x)) (list (pos (rx-col (cadddr x)))) '())))
       ((eq? (car x) 'desc) (mk-call 'desc (pos (rx-col (cadr x)))))
       ((eq? (car x) 'list) (apply mk-call 'c (map (lambda (a) (pos (rx-col a))) (cdr x))))
       ((r-fn-of (car x))
        => (lambda (r)
             (when (string-prefix? "str_" (symbol->string r)) (use-lib! "stringr"))
             (when (memq r '(year month day wday)) (use-lib! "lubridate"))
             (apply mk-call r (map (lambda (a) (pos (rx-col a))) (cdr x)))))
       (else (apply mk-call (r-var* (car x)) (map (lambda (a) (pos (rx-col a))) (cdr x))))))

    (define (r-var* x) (if (symbol? x) (r-var x) x))

    ;; option plist 'key value … -> named R arguments
    (define (plist->args opts table)
      (let loop ((o opts) (acc '()))
        (if (or (null? o) (null? (cdr o)))
            (reverse acc)
            (let* ((k (if (quoted? (car o)) (cadr (car o)) (car o)))
                   (v (if (quoted? (cadr o)) (cadr (cadr o)) (cadr o)))
                   (e (find (lambda (p) (eq? (cadr p) k)) table))
                   (rk (if e (car e) (r-var k)))
                   (rv (cond ((and (symbol? v) (eq? rk 'alternative)) (if (eq? v 'two-sided) "two.sided" (symbol->string v)))
                             ((symbol? v) (if (memq k '(method)) (symbol->string v) (rx-val v)))
                             (else (rx-val v)))))
              (loop (cddr o) (cons (cons rk rv) acc))))))

    (define (verb->r step)
      ;; one pipeline step (verb with the data left out) -> R call
      (let ((v (car step)) (args (cdr step)))
        (define (cols l) (map (lambda (c) (pos (if (symbol? c) c (rx-col c)))) l))
        (use-lib! "dplyr")
        (case v
          ((where) (apply mk-call 'filter (map (lambda (e) (pos (rx-col e))) args)))
          ((mutate transmute summarise summarize)
           (apply mk-call (if (eq? v 'summarize) 'summarise v)
                  (map (lambda (s) (cons (car s) (rx-col (cadr s)))) args)))
          ((group-by) (apply mk-call 'group_by (cols args)))
          ((ungroup) (mk-call 'ungroup))
          ((arrange) (apply mk-call 'arrange (map (lambda (e) (pos (rx-col e))) args)))
          ((select)
           (apply mk-call 'select
                  (map (lambda (s)
                         (cond ((symbol? s) (pos s))
                               ((eq? (car s) 'except) (pos (mk-call '- (pos (if (= (length (cdr s)) 1) (cadr s) (apply mk-call 'c (map pos (cdr s))))))))
                               ((eq? (car s) 'rename) (cons (cadr s) (caddr s)))
                               ((eq? (car s) 'everything) (pos (mk-call 'everything)))
                               ((memq (car s) '(starts-with ends-with contains matches))
                                (pos (mk-call (r-var (car s)) (pos (cadr s)))))
                               (else (pos (rx-col s)))))
                       args)))
          ((rename) (apply mk-call 'rename (map (lambda (p) (cons (car p) (cadr p))) args)))
          ((relocate distinct) (apply mk-call v (cols args)))
          ((tally) (apply mk-call 'count (cols args)))
          ((add-count) (apply mk-call 'add_count (cols args)))
          ((pull) (mk-call 'pull (pos (car args))))
          ((head tail) (apply mk-call v (map (lambda (a) (pos (rx-val a))) args)))
          ((slice) (mk-call 'slice (pos (mk-call ': (pos (+ 1 (car args))) (pos (if (pair? (cdr args)) (cadr args) 'n))))))
          ((sample-n) (mk-call 'slice_sample (cons 'n (car args))))
          ((left-join inner-join full-join semi-join anti-join)
           (let* ((y (car args))
                  (by (find (lambda (o) (and (pair? o) (eq? (car o) 'by))) (cdr args))))
             (apply mk-call (r-var v) (pos (rx-val y))
                    (if by
                        (list (cons 'by (if (and (= (length (cdr by)) 1) (symbol? (cadr by)))
                                            (symbol->string (cadr by))
                                            (apply mk-call 'c (map (lambda (k) (if (pair? k) (cons (car k) (symbol->string (cdr k))) (pos (symbol->string k))))
                                                                   (cdr by))))))
                        '()))))
          ((bind-rows bind-cols) (apply mk-call (r-var v) (map (lambda (a) (pos (rx-val a))) args)))
          ((pivot-longer pivot-wider separate unnest-longer drop-na fill-down fill-up replace-na)
           (use-lib! "tidyr")
           (let ((o (lambda (k) (let ((p (find (lambda (a) (and (pair? a) (eq? (car a) k))) args))) (and p (cdr p))))))
             (case v
               ((pivot-longer)
                (apply mk-call 'pivot_longer
                       (append (list (pos (let ((cs (or (o 'cols) '())))
                                            (if (= (length cs) 1) (car cs) (apply mk-call 'c (map pos cs))))))
                               (if (o 'names-to) (list (cons 'names_to (symbol->string (car (o 'names-to))))) '())
                               (if (o 'values-to) (list (cons 'values_to (symbol->string (car (o 'values-to))))) '()))))
               ((pivot-wider)
                (apply mk-call 'pivot_wider
                       (append (if (o 'names-from) (list (cons 'names_from (car (o 'names-from)))) '())
                               (if (o 'values-from) (list (cons 'values_from (car (o 'values-from)))) '())
                               (if (o 'values-fill) (list (cons 'values_fill (rx-col (car (o 'values-fill))))) '()))))
               ((separate)
                (apply mk-call 'separate (pos (car args))
                       (append (if (o 'into) (list (cons 'into (apply mk-call 'c (map (lambda (s) (pos (symbol->string s))) (o 'into))))) '())
                               (if (o 'sep) (list (cons 'sep (car (o 'sep)))) '()))))
               ((unnest-longer) (mk-call 'unnest_longer (pos (car args))))
               ((drop-na) (apply mk-call 'drop_na (cols args)))
               ((fill-down) (apply mk-call 'fill (cols args)))
               ((fill-up) (apply mk-call 'fill (append (cols args) (list (cons '|.direction| "up")))))
               ((replace-na) (mk-call 'replace_na (pos (apply mk-call 'list (map (lambda (p) (cons (car p) (rx-col (cadr p)))) args))))))))
          (else #f))))

    (define verb-heads
      '(where mutate transmute summarise summarize group-by ungroup arrange select rename relocate
        distinct tally add-count pull head tail slice sample-n left-join inner-join full-join
        semi-join anti-join bind-rows bind-cols pivot-longer pivot-wider separate unnest-longer
        drop-na fill-down fill-up replace-na))

    (define (ggplot->r x)
      (use-lib! "ggplot2")
      (let* ((data (cadr x))
             (specs (cddr x))
             (aes (find (lambda (s) (and (pair? s) (eq? (car s) 'aes))) specs))
             (aes->r (lambda (a) (apply mk-call 'aes (map (lambda (p) (cons (car p) (rx-col (cadr p)))) (cdr a)))))
             (root (apply mk-call 'ggplot (pos (rx-val data)) (if aes (list (pos (aes->r aes))) '())))
             (geom-names (map (lambda (g) (cons (cadr g) (car g))) gg-geoms))
             (parts
              (filter-map
               (lambda (s)
                 (and (pair? s)
                      (case (car s)
                        ((aes) #f)
                        ((labs) (apply mk-call 'labs (map (lambda (o) (cons (car o) (if (eq? (cadr o) #f) 'NULL (rx-val (cadr o))))) (cdr s))))
                        ((coord-flip) (mk-call 'coord_flip))
                        ((coord-sf) (use-lib! "sf") (mk-call 'coord_sf))
                        ((facet-wrap)
                         (apply mk-call 'facet_wrap (pos (mk-call '~ (pos (cadr s))))
                                (filter-map (lambda (o) (and (pair? o) (eq? (car o) 'ncol) (cons 'ncol (cadr o)))) (cddr s))))
                        ((scale-x scale-y)
                         (let* ((levels (find (lambda (o) (and (pair? o) (eq? (car o) 'levels))) (cdr s)))
                                (axis (if (eq? (car s) 'scale-x) "x" "y")))
                           (if levels
                               (mk-call (string->symbol (string-append "scale_" axis "_discrete"))
                                        (cons 'limits (apply mk-call 'c (map (lambda (v) (pos (datum->r v))) (cdr levels)))))
                               (apply mk-call (string->symbol (string-append "scale_" axis "_continuous"))
                                      (filter-map
                                       (lambda (o)
                                         (and (pair? o)
                                              (case (car o)
                                                ((labels) (cons 'labels (case (cadr o) ((pct) (mk-call ':: (pos 'scales) (pos 'percent)))
                                                                          ((int num) (mk-call ':: (pos 'scales) (pos 'comma)))
                                                                          (else (rx-val (cadr o))))))
                                                ((limits) (cons 'limits (apply mk-call 'c (map pos (cdr o)))))
                                                ((log10) (cons 'trans "log10"))
                                                (else #f))))
                                       (cdr s))))))
                        ((scale-fill-steps scale-fill-continuous)
                         (let* ((o (lambda (k) (let ((p (find (lambda (a) (and (pair? a) (eq? (car a) k))) (cdr s)))) (and p (cadr p)))))
                                (pal (or (o 'palette) 'blue))
                                (brewer (cadr (or (assq pal palette-table) '(blue "Blues")))))
                           (apply mk-call (if (eq? (car s) 'scale-fill-steps) 'scale_fill_fermenter 'scale_fill_distiller)
                                  (append (list (cons 'palette brewer) (cons 'direction 1))
                                          (if (o 'n) (list (cons 'n.breaks (o 'n))) '())))))
                        ((theme)
                         (let ((legend (find (lambda (o) (and (pair? o) (eq? (car o) 'legend))) (cdr s))))
                           (if legend (mk-call 'theme (cons 'legend.position (symbol->string (cadr legend)))) #f)))
                        (else
                         (let ((g (assq (car s) geom-names)))
                           (and g
                                (begin
                                  (when (memq (car s) '(geom-sf geom-sf-text)) (use-lib! "sf"))
                                  (apply mk-call (cdr g)
                                         (filter-map
                                          (lambda (o)
                                            (and (pair? o)
                                                 (case (car o)
                                                   ((aes) (pos (aes->r o)))
                                                   ((data) (cons 'data (rx-val (if (unquoted? (cadr o)) (cadr (cadr o)) (cadr o)))))
                                                   ((position) (cons 'position (symbol->string (cadr o))))
                                                   ((fill) (and (eq? (cadr o) 'none) (cons 'fill 'NA)))
                                                   ((size) (cons 'linewidth (cadr o)))
                                                   ((bins binwidth yintercept xintercept) (cons (car o) (rx-val (cadr o))))
                                                   (else #f))))
                                          (cdr s))))))))))
               specs)))
        (fold (lambda (p acc) (mk-call '+ (pos acc) (pos p))) root parts)))

    (define test-heads (map cadr test-table))

    ;; Scheme value expression -> R
    (define (rx-val x)
      (cond
       ((eq? x ':pipe) x)
       ((assq x scm-binary) (cdr (assq x scm-binary)))     ; an operator as a value: `<`
       ((symbol? x) (if (eq? x 'na) 'NA (r-var x)))
       ((or (number? x) (string? x) (boolean? x)) x)
       ((char? x) (string x))
       ((null? x) 'NULL)
       ((quoted? x) (datum->r (cadr x)))
       ((unquoted? x) (rx-val (cadr x)))
       ((and (pair? x) (eq? (car x) 'quasiquote)) (qq->r (cadr x)))
       ((not (pair? x)) (string-append "TODO scheme: " (flat x)))
       ((builtin->r x) => (lambda (r) r))
       ((eq? (car x) '->)
        (let loop ((steps (cddr x)) (acc (rx-val (cadr x))))
          (if (null? steps)
              acc
              (loop (cdr steps)
                    (mk-call '|\|>| (pos acc) (pos (step->r (car steps))))))))
       ((memq (car x) verb-heads)
        (let ((r (verb->r (cons (car x) (cddr x)))))
          (if (and r (not (memq (car x) '(bind-rows bind-cols))))
              (apply mk-call (call-fn r) (pos (rx-val (cadr x))) (call-args r))
              (or r (todo-r x)))))
       ((eq? (car x) 'ggplot) (ggplot->r x))
       ((memq (car x) test-heads)
        (let* ((rname (car (find (lambda (e) (eq? (cadr e) (car x))) test-table)))
               (args (cdr x))
               (formula? (and (>= (length args) 2) (quoted? (cadr args)) (list? (cadr (cadr args))) (memq '~ (cadr (cadr args)))))
               (opts-start (let loop ((as args) (i 0)) (if (or (null? as) (and (quoted? (car as)) (symbol? (cadr (car as))))) i (loop (cdr as) (+ i 1)))))
               (opts-start (if formula? 2 opts-start)))
          (apply mk-call rname
                 (append (if formula?
                             (list (pos (formula-tree (cadr (cadr args)))) (cons 'data (rx-val (car args))))
                             (map (lambda (a) (pos (rx-val a))) (take args opts-start)))
                         (plist->args (drop args opts-start) test-options)))))
       ((eq? (car x) 'lm)
        (mk-call 'lm (pos (formula-tree (cadr (caddr x)))) (cons 'data (rx-val (cadr x)))))
       ((eq? (car x) 'p-adjust)
        (apply mk-call 'p.adjust (pos (rx-val (cadr x)))
               (if (pair? (cddr x)) (list (cons 'method (symbol->string (cadr (caddr x))))) '())))
       ((eq? (car x) 'htest-ref)
        (mk-call '$ (pos (rx-val (cadr x)))
                 (pos (case (cadr (caddr x)) ((p-value) 'p.value) ((conf-int) 'conf.int) ((null-value) 'null.value) (else (cadr (caddr x)))))))
       ((eq? (car x) 'tidy) (use-lib! "broom") (mk-call 'tidy (pos (rx-val (cadr x)))))
       ((eq? (car x) 'lm-coefficients) (mk-call 'coef (pos (rx-val (cadr x)))))
       ((eq? (car x) 'lm-residuals) (mk-call 'residuals (pos (rx-val (cadr x)))))
       ((eq? (car x) 'lm-fitted) (mk-call 'fitted (pos (rx-val (cadr x)))))
       ((eq? (car x) 'predict) (mk-call 'predict (pos (rx-val (cadr x))) (cons 'newdata (rx-val (caddr x)))))
       ((eq? (car x) 'read-csv)
        (use-lib! "readr")
        (let* ((opts (cddr x))
               (sep (let ((m (member ''sep opts))) (and m (cadr m))))
               (dec (let ((m (member ''decimal opts))) (and m (cadr m))))
               (args (plist->args (filter-plist opts '(sep decimal)) '((skip skip) (n_max n-max) (na na)))))
          (cond ((and (eqv? sep #\;) (eqv? dec #\,)) (apply mk-call 'read_csv2 (pos (rx-val (cadr x))) args))
                ((and sep (not (char=? sep #\,)))
                 (apply mk-call 'read_delim (pos (rx-val (cadr x))) (cons 'delim (string sep))
                        (append (if dec (list (cons 'locale (mk-call 'locale (cons 'decimal_mark (string dec))))) '()) args)))
                (else (apply mk-call 'read_csv (pos (rx-val (cadr x))) args)))))
       ((eq? (car x) 'write-csv)
        (use-lib! "readr")
        (let ((sep (let ((m (member ''sep (cdddr x)))) (and m (cadr m)))))
          (if (and sep (not (char=? sep #\,)))
              (mk-call 'write_delim (pos (rx-val (cadr x))) (pos (rx-val (caddr x))) (cons 'delim (string sep)))
              (mk-call 'write_csv (pos (rx-val (cadr x))) (pos (rx-val (caddr x)))))))
       ((eq? (car x) 'read-xlsx)
        (use-lib! "readxl")
        (apply mk-call 'read_excel (pos (rx-val (cadr x))) (plist->args (cddr x) '((sheet sheet) (skip skip)))))
       ((eq? (car x) 'write-xlsx) (use-lib! "writexl") (mk-call 'write_xlsx (pos (rx-val (cadr x))) (pos (rx-val (caddr x)))))
       ((eq? (car x) 'read-sf) (use-lib! "sf") (apply mk-call 'st_read (pos (rx-val (cadr x))) (plist->args (cddr x) '((layer layer)))))
       ((eq? (car x) 'write-geojson) (use-lib! "sf") (mk-call 'st_write (pos (rx-val (cadr x))) (pos (rx-val (caddr x)))))
       ((eq? (car x) 'read-json-records) (use-lib! "jsonlite") (mk-call 'fromJSON (pos (rx-val (cadr x)))))
       ((eq? (car x) 'write-json-records) (use-lib! "jsonlite") (mk-call 'write_json (pos (rx-val (cadr x))) (pos (rx-val (caddr x)))))
       ((eq? (car x) 'save-plot) (use-lib! "ggplot2") (mk-call 'ggsave (pos (rx-val (caddr x))) (cons 'plot (rx-val (cadr x)))))
       ((memq (car x) '(df-print htest-print lm-print display write))
        (if (eq? (car x) 'lm-print) (mk-call 'print (pos (mk-call 'summary (pos (rx-val (cadr x))))))
            (mk-call 'print (pos (rx-val (cadr x))))))
       ((eq? (car x) 'df-glimpse) (use-lib! "dplyr") (mk-call 'glimpse (pos (rx-val (cadr x)))))
       ((eq? (car x) 'df-column) (mk-call '$ (pos (rx-val (cadr x))) (pos (let ((c (caddr x))) (if (quoted? c) (cadr c) c)))))
       ((eq? (car x) 'df-nrow) (mk-call 'nrow (pos (rx-val (cadr x)))))
       ((eq? (car x) 'df-ncol) (mk-call 'ncol (pos (rx-val (cadr x)))))
       ((eq? (car x) 'df-names) (mk-call 'names (pos (rx-val (cadr x)))))
       ((eq? (car x) 'freq) (mk-call 'table (pos (rx-val (cadr x)))))
       ((eq? (car x) 'crosstab) (mk-call 'table (pos (rx-val (cadr x))) (pos (rx-val (caddr x)))))
       ((eq? (car x) 'tibble)
        (use-lib! "tibble")
        (apply mk-call 'tibble (map (lambda (c) (cons (car c) (apply mk-call 'c (map (lambda (v) (pos (rx-val v))) (cdr c))))) (cdr x))))
       ((memq (car x) '(list vector)) (apply mk-call 'c (map (lambda (a) (pos (rx-val a))) (cdr x))))
       ((eq? (car x) 'string-append) (apply mk-call 'paste0 (map (lambda (a) (pos (rx-val a))) (cdr x))))
       ((eq? (car x) 'fmt-value) (rx-val (cadr x)))
       ((assq (car x) scm-binary)
        (let ((op (case (car x) ((and) '&&) ((or) '|\|\||) (else (cdr (assq (car x) scm-binary)))))
              (args (map rx-val (cdr x))))
          (if (and (eq? (car x) '-) (= (length args) 1))
              (mk-call '- (pos (car args)))
              (fold (lambda (a acc) (mk-call op (pos acc) (pos a))) (car args) (cdr args)))))
       ((eq? (car x) 'equal?) (mk-call '== (pos (rx-val (cadr x))) (pos (rx-val (caddr x)))))
       ((eq? (car x) 'expt) (mk-call '^ (pos (rx-val (cadr x))) (pos (rx-val (caddr x)))))
       ((eq? (car x) 'not) (mk-call '! (pos (rx-val (cadr x)))))
       ((eq? (car x) 'if)
        (apply mk-call 'if (pos (rx-val (cadr x))) (pos (rx-val (caddr x)))
               (if (pair? (cdddr x)) (list (pos (rx-val (cadddr x)))) '())))
       ((memq (car x) '(when unless))
        (mk-call 'if (pos (if (eq? (car x) 'when) (rx-val (cadr x)) (mk-call '! (pos (rx-val (cadr x))))))
                 (pos (body->r (cddr x)))))
       ((and (eq? (car x) 'begin) (= (length x) 3) (pair? (cadr x)) (eq? (car (cadr x)) 'display) (equal? (caddr x) '(newline)))
        (mk-call 'print (pos (rx-val (cadr (cadr x))))))
       ((eq? (car x) 'begin) (body->r (cdr x)))
       ((eq? (car x) 'lambda) (function->r (cadr x) (cddr x)))
       ((and (eq? (car x) 'for-each) (pair? (cadr x)) (eq? (car (cadr x)) 'lambda) (= (length (cadr (cadr x))) 1))
        (mk-call 'for (pos (r-var (car (cadr (cadr x))))) (pos (rx-val (caddr x))) (pos (body->r (cddr (cadr x))))))
       ((memq (car x) '(let let* letrec letrec*))
        (if (symbol? (cadr x))
            (todo-r x)
            (apply mk-call '|{|
                   (append (map (lambda (b) (pos (mk-call '<- (pos (r-var (car b))) (pos (rx-val (cadr b)))))) (cadr x))
                           (map (lambda (e) (pos (rx-val e))) (cddr x))))))
       ((eq? (car x) 'newline) (mk-call 'cat (pos "\n")))
       ((eq? (car x) 'iota)
        (if (and (= (length x) 2) (number? (cadr x)))
            (mk-call ': (pos 0) (pos (- (cadr x) 1)))
            (mk-call 'seq_len (pos (rx-val (cadr x))))))
       ((eq? (car x) 'r:unsupported) (if (string? (cadr x)) (car (r-parse (cadr x))) (todo-r x)))
       ((symbol? (car x))
        (apply mk-call (r-var (car x)) (map (lambda (a) (pos (rx-val a))) (cdr x))))
       (else (todo-r x))))

    ;; (a b . rest) -> a, b, ...
    (define (params->r ps)
      (cond ((null? ps) '())
            ((symbol? ps) (list (cons '... #f)))
            (else (cons (cons (r-var (car ps)) #f) (params->r (cdr ps))))))

    (define (rest-param ps)
      (cond ((symbol? ps) ps) ((pair? ps) (rest-param (cdr ps))) (else #f)))

    ;; a function: a rest parameter becomes ... and list(...) in the body
    (define (function->r params body)
      (let* ((rest (rest-param params))
             (forms (if rest (cons (list 'define rest '(:dots)) body) body)))
        (list ':function (params->r params) (body->r forms))))

    (define (qq->r x)
      (cond ((unquoted? x) (rx-val (cadr x)))
            ((and (pair? x) (list? x))
             (apply mk-call (if (every (lambda (e) (not (pair? e))) x) 'c 'list) (map (lambda (e) (pos (qq->r e))) x)))
            ((pair? x) (mk-call 'list (pos (qq->r (car x))) (pos (qq->r (cdr x)))))
            (else (datum->r x))))

    ;; common Scheme procedures -> R, or #f
    (define (builtin->r x)
      (let* ((h (car x)) (args (cdr x)) (a (lambda (i) (rx-val (list-ref args i)))) (n (length args)))
        (define (call f . xs) (apply mk-call f (map pos xs)))
        (case h
          ((:dots) (call 'list '...))
          ((car first) (and (= n 1) (call '|[[| (a 0) 1)))
          ((cadr second) (and (= n 1) (call '|[[| (a 0) 2)))
          ((caddr third) (and (= n 1) (call '|[[| (a 0) 3)))
          ((cdr) (and (= n 1)
                      (let ((e (car args)))
                        (if (and (pair? e) (memq (car e) '(assq assoc assv)) (= (length e) 3))
                            (call '|[[| (rx-val (caddr e)) (rx-val (cadr e)))   ; (cdr (assq k a)) -> a[[k]]
                            (call '|[| (a 0) (call '- 1))))))
          ((null?) (and (= n 1) (call '== (call 'length (a 0)) 0)))
          ((zero?) (and (= n 1) (call '== (a 0) 0)))
          ((pair? list?) (and (= n 1) (call '> (call 'length (a 0)) 0)))
          ((length vector-length string-length) (and (= n 1) (call (if (eq? h 'string-length) 'nchar 'length) (a 0))))
          ((number->string symbol->string) (and (= n 1) (call 'as.character (a 0))))
          ((string->number) (and (= n 1) (call 'as.numeric (a 0))))
          ((string->symbol) (and (= n 1) (call 'as.name (a 0))))
          ((string-upcase) (call 'toupper (a 0)))
          ((string-downcase) (call 'tolower (a 0)))
          ((string=? eq? eqv? equal?) (and (= n 2) (call '== (a 0) (a 1))))
          ((map) (and (= n 2) (call 'lapply (a 1) (a 0))))
          ((filter) (and (= n 2) (call 'Filter (a 0) (a 1))))
          ((remove) (and (= n 2) (call 'Filter (call '! (a 0)) (a 1))))
          ((apply) (and (= n 2) (call 'do.call (a 0) (a 1))))
          ((append cons) (apply call 'c (map rx-val args)))
          ((list-sort sort) (and (= n 2) (if (eq? (list-ref args 0) '>) (mk-call 'sort (pos (a 1)) (cons 'decreasing #t)) (call 'sort (a 1)))))
          ((error) (call 'stop (apply call 'paste0 (map rx-val args))))
          ((exit) (mk-call 'quit (cons 'status (if (pair? args) (a 0) 0))))
          ((string-join) (mk-call 'paste (pos (a 0)) (cons 'collapse (if (> n 1) (a 1) " "))))
          ((assq assoc assv) (and (= n 2) (call '|[[| (a 1) (a 0))))
          ((display) (call 'cat (a 0)))
          ((vector-ref list-ref) (and (= n 2) (call '|[[| (a 0) (call '+ (a 1) 1))))
          (else #f))))

    (define (filter-plist opts keys)
      (let loop ((o opts) (acc '()))
        (cond ((or (null? o) (null? (cdr o))) (reverse acc))
              ((and (quoted? (car o)) (memq (cadr (car o)) keys)) (loop (cddr o) acc))
              (else (loop (cddr o) (cons (cadr o) (cons (car o) acc)))))))

    (define (step->r s)
      (cond ((comment? s) (mk-call 'identity (pos (list ':comment (cadr s)))))
            ((symbol? s) (mk-call (r-var s)))
            ((and (pair? s) (memq (car s) verb-heads)) (or (verb->r s) (todo-r s)))
            ((and (pair? s) (eq? (car s) 'ggplot)) (ggplot->r (cons* 'ggplot '|.| (cdr s))))
            ((and (pair? s) (symbol? (car s))) (let ((r (rx-val (cons* (car s) ':pipe (cdr s)))))
                                                 (if (and (call? r) (pair? (call-args r)) (eq? (cdar (call-args r)) ':pipe))
                                                     (apply mk-call (call-fn r) (cdr (call-args r)))
                                                     r)))
            (else (todo-r s))))

    (define (body->r forms)
      (let ((stmts (append-map (lambda (f)
                                 (if (and (pair? f) (memq (car f) '(define set!)))
                                     (statement->r f)
                                     (list (rx-val f))))
                               forms)))
        (if (= (length stmts) 1)
            (car stmts)
            (apply mk-call '|{| (map pos stmts)))))

    (define todo-count 0)
    (define (todo-r x)
      (set! todo-count (+ todo-count 1))
      (mk-call 'stop (pos (string-append "TODO scheme: " (flat x)))))

    (define (statement->r x)
      (cond
       ((and (pair? x) (eq? (car x) 'import)) '())
       ((and (pair? x) (eq? (car x) 'define) (pair? (cadr x)))
        (list (mk-call '<- (pos (r-var (car (cadr x))))
                       (pos (function->r (cdr (cadr x)) (cddr x))))))
       ((and (pair? x) (eq? (car x) 'define))
        (if (and (pair? (caddr x)) (memq (car (caddr x)) '(report make-report)))
            (report-statements (cadr x) (caddr x))
            (list (mk-call '<- (pos (r-var (cadr x))) (pos (rx-val (caddr x)))))))
       ((and (pair? x) (eq? (car x) 'set!))
        (list (mk-call '<- (pos (r-var (cadr x))) (pos (rx-val (caddr x))))))
       ((and (pair? x) (eq? (car x) 'write-report))
        (list (list ':comment (string-append "report written to " (if (string? (caddr x)) (caddr x) "?")
                                             ": see the R Markdown above (knit it with rmarkdown::render)"))))
       (else (list (rx-val x)))))

    (define (report-statements name r)
      (let ((rmd (report->rmd r)))
        (cons (list ':comment (string-append (symbol->string name) " is a report; as R Markdown:"))
              (map (lambda (line) (list ':comment (string-append "  " line))) (string-split-lines rmd)))))

    (define (string-split-lines s)
      (let loop ((i 0) (start 0) (acc '()))
        (cond ((= i (string-length s)) (reverse (if (< start i) (cons (substring s start i) acc) acc)))
              ((char=? (string-ref s i) #\newline) (loop (+ i 1) (+ i 1) (cons (substring s start i) acc)))
              (else (loop (+ i 1) start acc)))))

    (define (scm->r forms)
      "Syntax: (scm->r forms)
Library: (scm data r)
Description: Translates (scm data) code, a list of top-level forms (or a
  string to read them from), to R: returns two values, the list of R
  statements as R syntax trees (comments as (:comment text)) and the
  library names they need.
Example:
  (scm->r '((define d (-> (read-csv \"a.csv\") (where (> x 1))))))"
      (let ((forms (if (string? forms) (read-forms (open-input-string forms)) forms)))
        (set! libs-used '())
        (let ((stmts (append-map (lambda (f)
                                   (guard (e (#t (list (list ':comment (string-append "TODO scheme: " (flat f))))))
                                     (statement->r f)))
                                 forms)))
          (values stmts (reverse libs-used)))))

    (define (read-forms port)
      (let loop ((acc '()))
        (let ((x (read port)))
          (if (eof-object? x) (reverse acc) (loop (cons x acc))))))

    (define (scm->r-string forms)
      "Syntax: (scm->r-string forms)
Library: (scm data r)
Description: Translates (scm data) code (a list of forms, or Scheme
  source text) to R source text: library() calls for what it uses, then
  the statements, pipes and ggplot chains broken over lines.
Example:
  (display (scm->r-string \"(define d (-> (read-csv \\\"a.csv\\\") (where (> x 1))))\"))"
      (let-values (((stmts libs) (scm->r forms)))
        (string-append
         "# translated from Scheme by (scm data r)\n"
         (string-concatenate (map (lambda (l) (string-append "library(" l ")\n")) libs))
         (if (null? libs) "" "\n")
         (string-concatenate
          (map (lambda (s)
                 (if (comment? s)
                     (string-append "# " (cadr s) "\n")
                     (string-append (deparse-statement s) "\n")))
               stmts)))))

    (define (scm-file->r path)
      "Syntax: (scm-file->r path)
Library: (scm data r)
Description: scm->r-string on the forms of a Scheme file.
Example:
  (display (scm-file->r \"analysis.scm\"))"
      (scm->r-string (call-with-input-file path read-forms)))

    ;; --- reports as R Markdown ------------------------------------------------

    (define (report->rmd r)
      "Syntax: (report->rmd report-form)
Library: (scm data r)
Description: R Markdown text for a report written as a (report …) form
  (as data): the title in the YAML header, headings and text as
  Markdown, tables as knitr::kable chunks and figures as chunks printing
  the plot.
Example:
  (report->rmd '(report (title \"T\") (h2 \"A\") (p \"text\") (table ,df)))"
      (let* ((blocks (cdr r))
             (out (open-output-string)))
        (define (w . xs) (for-each (lambda (x) (write-string x out)) xs))
        (define (inline x)
          (cond ((string? x) x)
                ((unquoted? x) (string-append "`r " (deparse-statement (rx-val (cadr x))) "`"))
                ((and (pair? x) (eq? (car x) 'b)) (string-append "**" (string-concatenate (map inline (cdr x))) "**"))
                ((and (pair? x) (eq? (car x) 'i)) (string-append "*" (string-concatenate (map inline (cdr x))) "*"))
                ((and (pair? x) (eq? (car x) 'code)) (string-append "`" (string-concatenate (map inline (cdr x))) "`"))
                ((and (pair? x) (eq? (car x) 'link)) (string-append "[" (if (pair? (cddr x)) (string-concatenate (map inline (cddr x))) (cadr x)) "](" (cadr x) ")"))
                (else (flat x))))
        (let ((title (find (lambda (b) (and (pair? b) (eq? (car b) 'title))) blocks))
              (sub (find (lambda (b) (and (pair? b) (eq? (car b) 'subtitle))) blocks)))
          (w "---\n")
          (when title (w "title: " (r-string (string-concatenate (map inline (cdr title)))) "\n"))
          (when sub (w "subtitle: " (r-string (string-concatenate (map inline (cdr sub)))) "\n"))
          (w "output: html_document\n---\n\n"))
        (for-each
         (lambda (b)
           (when (pair? b)
             (case (car b)
               ((title subtitle) #f)
               ((date) (w "*" (if (pair? (cdr b)) (inline (cadr b)) "`r Sys.Date()`") "*\n\n"))
               ((h1) (w "# " (string-concatenate (map inline (cdr b))) "\n\n"))
               ((h2) (w "## " (string-concatenate (map inline (cdr b))) "\n\n"))
               ((h3) (w "### " (string-concatenate (map inline (cdr b))) "\n\n"))
               ((p) (w (string-concatenate (map inline (cdr b))) "\n\n"))
               ((note) (w "> " (string-concatenate (map inline (cdr b))) "\n\n"))
               ((ul ol) (for-each (lambda (item k)
                                    (w (if (eq? (car b) 'ul) "- " (string-append (number->string k) ". "))
                                       (if (and (pair? item) (eq? (car item) 'li)) (string-concatenate (map inline (cdr item))) (inline item))
                                       "\n"))
                                  (cdr b) (iota (length (cdr b)) 1))
                        (w "\n"))
               ((pre) (w "```\n" (string-join (map (lambda (x) (if (string? x) x (inline x))) (cdr b)) "\n") "\n```\n\n"))
               ((hr page-break) (w "---\n\n"))
               ((table)
                (let ((caption (find (lambda (o) (and (pair? o) (eq? (car o) 'caption))) (cddr b))))
                  (w "```{r, echo = FALSE}\nknitr::kable(" (deparse-statement (rx-val (if (unquoted? (cadr b)) (cadr (cadr b)) (cadr b))))
                     (if caption (string-append ", caption = " (r-string (cadr caption))) "")
                     ")\n```\n\n")))
               ((figure)
                (let ((caption (find (lambda (o) (and (pair? o) (eq? (car o) 'caption))) (cddr b))))
                  (w "```{r, echo = FALSE" (if caption (string-append ", fig.cap = " (r-string (cadr caption))) "") "}\n"
                     (deparse-statement (rx-val (if (unquoted? (cadr b)) (cadr (cadr b)) (cadr b)))) "\n```\n\n")))
               (else (w "<!-- TODO scheme: " (flat b) " -->\n\n")))))
         blocks)
        (get-output-string out)))))

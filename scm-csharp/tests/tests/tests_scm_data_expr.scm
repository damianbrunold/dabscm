(import (scheme base) (scm data core) (scm data frame) (scm data expr) (scm test))

(test-runner-factory scm-test-runner)

(test-begin "scm-data-expr")

(define df (tibble (splg 'BEW8 'GYN2 'BEW8 'URO1.1.1)
                   (pts 2.0 1.0 na 4.0)
                   (n 1 2 3 4)
                   (name "Anna" "bob" "Carl" na)
                   (d (ymd->day 2024 1 31) (ymd->day 2024 2 1) na (ymd->day 2025 1 1))))

(define rows (all-rows df))
(define (ev e) (let ((f (compile-expr df e))) (map (lambda (i) (f i rows)) '(0 1 2 3))))
(define (ev1 e) ((compile-expr df e) 0 rows))

(test-group "columns, constants, arithmetic"
  (test-equal '(1 2 3 4) (ev 'n))
  (test-equal 5 (ev1 5))
  (test-equal 'x (ev1 ''x))
  (test-equal '(3 4 5 6) (ev '(+ n 2)))
  (test-equal 0.5 (ev1 '(/ n 2)))
  (test-assert (na? (list-ref (ev '(* pts 2)) 2)))
  (test-assert (na? (ev1 '(/ n 0))))
  (test-equal 2.5 (ev1 '(round 2.45 1)))
  (test-equal 3.0 (ev1 '(round 2.5)))
  (test-equal 3 (ev1 '(round 5/2)))
  (test-equal 8.0 (ev1 '(log 256.0 2)))
  (test-equal '(2.0 2 na 4.0) (map (lambda (x) (if (na? x) 'na x)) (ev '(pmax pts 2))))
  (test-error (ev1 'nope))
  (test-error (ev1 '(frobnicate n))))

(test-group "comparison and logic"
  (test-equal '(#t #f #t #f) (ev '(= splg 'BEW8)))
  (test-equal '(#f #f #f #t) (ev '(> n 3)))
  (test-equal '(#t #f #f na) (map (lambda (x) (if (na? x) 'na x)) (ev '(< name "Bob"))))
  (test-equal '(#t #f) (list (ev1 '(< d (parse-date "2024-02-01")))
                             ((compile-expr df '(< d (parse-date "2024-02-01"))) 1 rows)))
  (test-assert (na? (list-ref (ev '(> pts 1)) 2)))
  (test-equal '(#f #f #f #t) (ev '(and (> n 1) (is-na name))))
  (test-equal '(#t #t #f #t) (ev '(or (> pts 0) (= n 2))))
  (test-equal '(#t #f #t #f) (ev `(in splg ,'(BEW8 X))))
  (test-equal '(#t #f #t #f) (ev '(in splg (list 'BEW8 'Y))))
  (test-equal '(#t #t #t #f) (ev '(between n 1 3)))
  (test-equal '("hi" "lo" "lo" "hi") (ev '(if (or (= n 1) (= n 4)) "hi" "lo")))
  (test-equal '(big small none big)
              (ev '(case-when ((> pts 1.5) 'big) ((is-na pts) 'none) (else 'small))))
  (test-equal '(2.0 1.0 0 4.0) (ev '(coalesce pts 0))))

(test-group "strings and dates"
  (test-equal '("ANNA" "BOB") (list (ev1 '(str-upper name)) ((compile-expr df '(str-upper name)) 1 rows)))
  (test-equal "BEW8-1" (ev1 '(str splg "-" n)))
  (test-equal "An" (ev1 '(str-sub name 0 2)))
  (test-equal '(#t #f #t #f) (ev '(str-detect splg "^BEW")))
  (test-equal "B_W8" (ev1 '(str-replace splg "E" "_")))
  (test-equal "007" (ev1 '(str-pad "7" 3 #\0)))
  (test-equal 12 (ev1 '(->int "12")))
  (test-equal 2024 (ev1 '(year d)))
  (test-equal 3 (ev1 '(weekday d)))
  (test-equal 1 (ev1 '(days-between d (parse-date "2024-02-01"))))
  (test-equal "2024-02-01" (day->string (ev1 '(date-add-days d 1)))))

(test-group "aggregates and windows"
  (test-equal 7.0 (ev1 '(sum pts)))
  (test-equal 4 (ev1 '(n)))
  (test-equal 2.5 (ev1 '(mean n)))
  (test-equal 2.0 (ev1 '(median pts)))
  (test-equal 1.75 (ev1 '(quantile n 0.25)))
  (test-equal 4.0 (ev1 '(max pts)))
  (test-equal 'BEW8 (ev1 '(min splg)))
  (test-equal 3 (ev1 '(n-distinct splg)))
  (test-approximate 1.2909944 (ev1 '(sd n)) 1e-6)
  (test-equal '(0.1 0.2 0.3 0.4) (ev '(/ n (sum n))))
  (test-equal '(na 1 2 3) (map (lambda (x) (if (na? x) 'na x)) (ev '(lag n))))
  (test-equal '(1 3 6 10) (ev '(cumsum n)))
  (test-equal '(1 2 3 4) (ev '(row-number)))
  (test-equal '(2 1 na 3) (map (lambda (x) (if (na? x) 'na x)) (ev '(rank pts))))
  (test-equal '(1 2 1 3) (ev '(dense-rank splg)))
  (test-equal '(0.1 0.2 0.3 0.4) (ev '(share n)))
  ;; aggregate over a group subset
  (test-equal 4 ((compile-expr df '(sum n)) 0 #(0 2))))

(test-group "extending and helpers"
  (define-df-function 'sq 'scalar (lambda (x) (* x x)))
  (test-equal '(1 4 9 16) (ev '(sq n)))
  (test-equal '(2 3 4 5) (ev `(,(lambda (x) (+ x 1)) n)))
  (test-assert (expr-uses-aggregate? '(/ (sum pts) (n))))
  (test-assert (not (expr-uses-aggregate? '(+ pts 1))))
  (test-assert (value<? 1 "a"))
  (test-assert (value<? 'a 'b))
  (test-assert (value<? 3 na))
  (test-assert (value=? 1 1.0)))

(test-end "scm-data-expr")
